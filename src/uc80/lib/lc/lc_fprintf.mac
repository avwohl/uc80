; lc_fprintf.mac - fprintf, vfprintf, vprintf, vsprintf.
;
; Each of these carried its own formatter, so a conversion the printf
; table knew about was invisible here.  fprintf had no float handler at
; all -- fprintf(stdout, "%f", 1.5) printed an empty field and desynced
; the rest of the argument list -- and none of the four knew %e, %g or
; %F.  See lc_sprintf.mac for why there is only one formatter now.
;
; A va_list in uc80 is a pointer to the arguments, which is exactly the
; base the engine indexes from, so the v* forms set IX = ap and C = 0 and
; are otherwise identical to their variadic counterparts.
	.Z80

	EXTRN	_fputc
	EXTRN	__conout
	EXTRN	_printf_engine
	EXTRN	_printf_sink
	EXTRN	_printf_count
	EXTRN	_sprintf_sink
	EXTRN	_sprintf_out

	CSEG

	PUBLIC	_fprintf
	PUBLIC	_vfprintf
	PUBLIC	_vprintf
	PUBLIC	_vsprintf

; int fprintf(FILE *stream, const char *fmt, ...)
_fprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_fprintf_stream),HL

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,_fprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	C,8			; first vararg at IX+8
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL
	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; int vfprintf(FILE *stream, const char *fmt, va_list ap)
_vfprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_fprintf_stream),HL

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,_fprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	E,(IX+8)
	LD	D,(IX+9)		; DE = va_list
	PUSH	HL
	PUSH	DE
	POP	IX			; IX = ap, the argument base
	POP	HL
	LD	C,0
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL
	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; int vprintf(const char *fmt, va_list ap)
_vprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,__conout
	LD	(_printf_sink),HL

	LD	L,(IX+4)
	LD	H,(IX+5)		; HL = format string
	LD	E,(IX+6)
	LD	D,(IX+7)		; DE = va_list
	PUSH	HL
	PUSH	DE
	POP	IX
	POP	HL
	LD	C,0
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL
	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; int vsprintf(char *str, const char *fmt, va_list ap)
_vsprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_sprintf_out),HL

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,_sprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	E,(IX+8)
	LD	D,(IX+9)		; DE = va_list
	PUSH	HL
	PUSH	DE
	POP	IX
	POP	HL
	LD	C,0
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL
	LD	HL,(_sprintf_out)
	LD	(HL),0			; NUL terminate
	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; Sink: character in E, out through fputc so the stream's own buffering
; and its text/binary handling stay in charge.  _printf_putc has already
; saved the registers and counts the byte when we return.
_fprintf_sink:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	D,0			; DE = (int)ch, E already holds it
	LD	HL,(_fprintf_stream)
	PUSH	HL			; stream argument
	PUSH	DE			; char argument
	CALL	_fputc
	POP	DE
	POP	DE
	POP	HL
	POP	DE
	POP	BC
	RET

	DSEG

_fprintf_stream: DS	2

	END
