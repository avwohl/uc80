; lc_clock.mac - split from lc_time.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	CSEG

; ============================================================
; clock_t clock(void)
; Return CPU time used (stub - returns 0)
; ============================================================
	PUBLIC	_clock
_clock:
	LD	HL,0
	LD	DE,0
	RET

; ============================================================

	END
