; lc_strtoint.mac - _strtoint, the core of strtol, strtoul, strtoll and
; strtoull
;
; void _strtoint(const char *nptr, char **endptr, int base,
;                unsigned char *r, int nb, int is_signed)
;
; Reads an integer of nb bytes (4 or 8) into r, little endian.  The digits
; go into the byte array one at a time (_sc_muladd), so no 32-bit or
; 64-bit multiply routine of the runtime library is linked.
;
; *endptr is set as the C standard requires.  errno is set to ERANGE on
; overflow (the value is then the limit) and to EINVAL for a base that is
; not 0 or 2 to 36.  The prefixes 0x and 0b need a digit after them.
	.Z80

	CSEG

	EXTRN	_errno
	EXTRN	__sc_muladd
	EXTRN	__sc_negate
	EXTRN	__sc_dv

EINVAL	EQU	22
ERANGE	EQU	34

	PUBLIC	__strtoint
__strtoint:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+10)
	LD	H,(IX+11)	; HL = r
	LD	A,(IX+12)
	LD	(_sti_nb),A
	LD	B,A
_sti_clr:
	LD	(HL),0
	INC	HL
	DJNZ	_sti_clr
	XOR	A
	LD	(_sti_fl),A	; bit 0 negative, bit 1 overflow, bit 2 any digit
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = s
_sti_ws:
	LD	A,(HL)
	INC	HL
	CP	' '
	JR	Z,_sti_ws
	CP	9
	JR	C,_sti_w1
	CP	14
	JR	C,_sti_ws
_sti_w1:
	DEC	HL
	LD	A,(HL)
	CP	'-'
	JR	NZ,_sti_plus
	LD	A,1
	LD	(_sti_fl),A
	JR	_sti_sg
_sti_plus:
	CP	'+'
	JR	NZ,_sti_nosg
_sti_sg:
	INC	HL
_sti_nosg:
	LD	E,(IX+8)	; E = base
	LD	A,(IX+9)
	OR	A
	JR	NZ,_sti_badb
	LD	A,E
	OR	A
	JR	Z,_sti_bok
	CP	2
	JR	C,_sti_badb
	CP	37
	JR	C,_sti_bok
_sti_badb:
	LD	HL,EINVAL
	LD	(_errno),HL
	LD	L,(IX+4)
	LD	H,(IX+5)
	CALL	_sti_pe
	JR	_sti_ret
_sti_bok:
	; a prefix 0x (base 0 or 16) or 0b (base 0 or 2) with a digit after it
	LD	A,(HL)
	CP	'0'
	JR	NZ,_sti_nopre
	INC	HL
	LD	A,(HL)
	OR	20H
	CP	'x'
	JR	NZ,_sti_chkb
	LD	A,E
	OR	A
	JR	Z,_sti_hx
	CP	16
	JR	NZ,_sti_chkb
_sti_hx:
	INC	HL
	LD	A,(HL)
	CALL	__sc_dv
	CP	16
	JR	NC,_sti_back
	LD	E,16
	JR	_sti_loop
_sti_chkb:
	LD	A,(HL)
	OR	20H
	CP	'b'
	JR	NZ,_sti_back1
	LD	A,E
	OR	A
	JR	Z,_sti_bn
	CP	2
	JR	NZ,_sti_back1
_sti_bn:
	INC	HL
	LD	A,(HL)
	CALL	__sc_dv
	CP	2
	JR	NC,_sti_back
	LD	E,2
	JR	_sti_loop
_sti_back:
	DEC	HL
_sti_back1:
	DEC	HL
_sti_nopre:
	LD	A,E
	OR	A
	JR	NZ,_sti_loop
	LD	E,10
	LD	A,(HL)
	CP	'0'
	JR	NZ,_sti_loop
	LD	E,8
_sti_loop:
	LD	A,E
	LD	(_sti_base),A
_sti_dl:
	LD	A,(HL)
	CALL	__sc_dv
	LD	D,A
	LD	A,(_sti_base)
	LD	C,A
	LD	A,D
	CP	C
	JR	NC,_sti_dend
	LD	A,(_sti_fl)
	OR	4
	LD	(_sti_fl),A
	BIT	1,A
	JR	NZ,_sti_nx
	PUSH	HL
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	A,(_sti_nb)
	LD	B,A
	LD	A,D
	CALL	__sc_muladd
	POP	HL
	OR	A
	JR	Z,_sti_nx
	LD	A,(_sti_fl)
	OR	2
	LD	(_sti_fl),A
_sti_nx:
	INC	HL
	JR	_sti_dl
_sti_dend:
	LD	A,(_sti_fl)
	BIT	2,A
	JR	NZ,_sti_any
	LD	L,(IX+4)
	LD	H,(IX+5)
	CALL	_sti_pe
	JR	_sti_ret
_sti_any:
	CALL	_sti_pe
	; the magnitude of a signed number must be below 2^(8*nb-1), or equal
	; to it for a negative number
	LD	A,(_sti_fl)
	BIT	1,A
	JR	NZ,_sti_ovf
	LD	A,(IX+14)
	OR	A
	JR	Z,_sti_neg
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	A,(_sti_nb)
	LD	C,A
	LD	B,0
	ADD	HL,BC
	DEC	HL
	LD	A,(HL)		; the top byte
	CP	80H
	JR	C,_sti_neg
	JR	NZ,_sti_ovf
	LD	A,(_sti_fl)
	RRA
	JR	NC,_sti_ovf
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	A,(_sti_nb)
	DEC	A
	JR	Z,_sti_neg
	LD	B,A
_sti_lz:
	LD	A,(HL)
	OR	A
	JR	NZ,_sti_ovf
	INC	HL
	DJNZ	_sti_lz
_sti_neg:
	LD	A,(_sti_fl)
	RRA
	JR	NC,_sti_ret
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	A,(_sti_nb)
	LD	B,A
	CALL	__sc_negate
_sti_ret:
	POP	IX
	RET
_sti_ovf:
	LD	HL,ERANGE
	LD	(_errno),HL
	LD	E,0FFH		; the fill byte
	LD	D,0FFH		; the top byte
	LD	A,(IX+14)
	OR	A
	JR	Z,_sti_fill
	LD	D,7FH
	LD	A,(_sti_fl)
	RRA
	JR	NC,_sti_fill
	LD	E,0
	LD	D,80H
_sti_fill:
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	A,(_sti_nb)
	LD	B,A
_sti_f1:
	LD	(HL),E
	INC	HL
	DJNZ	_sti_f1
	DEC	HL
	LD	(HL),D
	JR	_sti_ret

; *endptr = HL when endptr is not NULL
_sti_pe:
	LD	E,(IX+6)
	LD	D,(IX+7)
	LD	A,D
	OR	E
	RET	Z
	EX	DE,HL
	LD	(HL),E
	INC	HL
	LD	(HL),D
	RET

	COMMON	/lc_strtoint/
_sti_nb:
	DS	1
_sti_fl:
	DS	1
_sti_base:
	DS	1

	END
