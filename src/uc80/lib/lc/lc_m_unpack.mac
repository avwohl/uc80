; lc_m_unpack.mac - _m_unpack (see csrc/m.h)
;
; unsigned long _m_unpack(float x, int *e)
; The normalized mantissa (bit 23 set) of a finite x and its biased
; exponent, which is zero or less for a subnormal x.  For x = 0 the
; mantissa is 0 and the exponent is 0.  The sign is not used.
	.Z80

	CSEG

	PUBLIC	__m_unpack
__m_unpack:
	LD	HL,2
	ADD	HL,SP
	LD	C,(HL)		; x, byte 0
	INC	HL
	LD	B,(HL)		; byte 1
	INC	HL
	LD	E,(HL)		; byte 2
	INC	HL
	LD	D,(HL)		; byte 3
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	PUSH	HL		; the pointer e
	LD	A,E
	RLA			; carry = the low bit of the exponent
	LD	A,D
	RLA			; A = the biased exponent
	LD	D,0
	LD	H,B
	LD	L,C		; DEHL = the mantissa without the implied bit
	LD	B,0
	LD	C,A		; BC = the exponent
	OR	A
	JR	Z,_mun_sub
	SET	7,E
_mun_store:
	EX	(SP),HL		; HL = e, the mantissa is on the stack
	LD	(HL),C
	INC	HL
	LD	(HL),B
	POP	HL
	RET

_mun_sub:
	; exponent 0: zero, or a subnormal number
	LD	A,E
	OR	H
	OR	L
	JR	Z,_mun_store	; 0, exponent 0
	INC	C		; the exponent of the subnormal numbers is 1
_mun_norm:
	BIT	7,E
	JR	NZ,_mun_store
	SLA	L
	RL	H
	RL	E
	DEC	BC
	JR	_mun_norm

	END
