; lc_math_getarg2.mac - _math_getarg2
; Split from lc_math_helper.mac

	.Z80

	EXTRN	__tmp32

	CSEG
; ============================================================
; Helper: Load second float argument into __tmp32
; ============================================================
	PUBLIC	_math_getarg2
_math_getarg2:
	LD	A,(IX+10)
	LD	(__tmp32),A
	LD	A,(IX+11)
	LD	(__tmp32+1),A
	LD	A,(IX+12)
	LD	(__tmp32+2),A
	LD	A,(IX+13)
	LD	(__tmp32+3),A
	RET

	END
