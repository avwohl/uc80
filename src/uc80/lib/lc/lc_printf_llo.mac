; lc_printf_llo.mac - printf %llo handler (unsigned long long octal)
;
; The compiler writes no table entry for 'llo'.  The printf hook of uc80
; (printf_hook.py) adds one to the long long table when a format has %llo.
	.Z80

	EXTRN	_printf_loop
	EXTRN	_printf_alt
	EXTRN	_printf_prec
	EXTRN	_printf_decbuf
	EXTRN	_printf_dstart
	EXTRN	_printf_dcnt
	EXTRN	_printf_numout
	EXTRN	_printf_ll_w0
	EXTRN	_printf_ll_w1
	EXTRN	_printf_ll_w2
	EXTRN	_printf_ll_w3

	CSEG

	PUBLIC	__printf_handle_llo
__printf_handle_llo:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w0),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w1),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_printf_ll_w3),DE
	PUSH	IX
	LD	IX,_printf_decbuf+24
	LD	B,0		; digit counter
_pllo_cvt:
	LD	A,(_printf_ll_w0)
	AND	07H
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	LD	D,3		; shift the 64-bit value right by 3
_pllo_sh:
	LD	HL,(_printf_ll_w3)
	SRL	H
	RR	L
	LD	(_printf_ll_w3),HL
	LD	HL,(_printf_ll_w2)
	RR	H
	RR	L
	LD	(_printf_ll_w2),HL
	LD	HL,(_printf_ll_w1)
	RR	H
	RR	L
	LD	(_printf_ll_w1),HL
	LD	HL,(_printf_ll_w0)
	RR	H
	RR	L
	LD	(_printf_ll_w0),HL
	DEC	D
	JR	NZ,_pllo_sh
	LD	HL,(_printf_ll_w0)
	LD	A,H
	OR	L
	LD	HL,(_printf_ll_w1)
	OR	H
	OR	L
	LD	HL,(_printf_ll_w2)
	OR	H
	OR	L
	LD	HL,(_printf_ll_w3)
	OR	H
	OR	L
	JR	NZ,_pllo_cvt
	; '#' flag: force the first digit to be '0'
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_pllo_set
	LD	A,(IX+0)
	CP	'0'
	JR	Z,_pllo_z
	DEC	IX
	LD	(IX+0),'0'
	INC	B
	JR	_pllo_set
_pllo_z:
	; value 0 with '#': "%#.0llo" still prints "0"
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_pllo_set
	INC	A
	LD	(_printf_prec),A
_pllo_set:
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	IX
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,8
	LD	C,A
	POP	HL
	JP	_printf_loop

	END
