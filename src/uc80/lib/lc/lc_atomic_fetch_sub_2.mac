; lc_atomic_fetch_sub_2.mac - ___atomic_fetch_sub_2
; Split from lc_atomic.mac

	.Z80

	CSEG
; unsigned int __atomic_fetch_sub_2(volatile void *obj, unsigned int val)
	PUBLIC	___atomic_fetch_sub_2
___atomic_fetch_sub_2:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	LD	L,(IX+4)
	LD	H,(IX+5)

	DI
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = old
	DEC	HL
	PUSH	DE

	LD	C,(IX+6)
	LD	B,(IX+7)
	EX	DE,HL
	OR	A
	SBC	HL,BC		; HL = old - val
	EX	DE,HL

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	EI

	POP	HL
	POP	BC
	POP	IX
	RET

	END
