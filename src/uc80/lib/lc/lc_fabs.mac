; lc_fabs.mac - _fabs, _fabsf, _fabsl
; Split from lc_fabs.mac

	.Z80

	CSEG
; ============================================================
; fabs(x) - return absolute value
; For 32-bit float, clear sign bit (bit 31)
; ============================================================
	PUBLIC	_fabs
_fabs:
	PUBLIC	_fabsf
_fabsf:
	PUBLIC	_fabsl
_fabsl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	E,(IX+6)
	LD	A,(IX+7)
	AND	7FH		; Clear sign bit
	LD	D,A
	POP	IX
	RET

	END
