; lc_putchar.mac - putchar
	.Z80

; CP/M BDOS function numbers
BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	EXTRN	__conout

	CSEG

; ============================================================
; int putchar(int c)
; Output a character to console
; Argument: character on stack at IX+4
; Returns: the character written, or EOF (-1) on error
; ============================================================
	PUBLIC	_putchar
_putchar:
	; Minimal implementation - doesn't touch IX.  __conout preserves
	; BC, DE and HL, so DE still holds the character on return.
	LD	HL,2
	ADD	HL,SP		; Points to arg (after ret addr)
	LD	E,(HL)		; character in E

	CALL	__conout

	LD	L,E		; return value is the character
	LD	H,0
	RET

	END
