; lc_fmax.mac - _fmax, _fmaxf
; Split from lc_fmax.mac

	.Z80

	EXTRN	__fcmp
	EXTRN	__tmp32

	CSEG
; ============================================================
; fmax(x, y) - return larger of x, y
; ============================================================
	PUBLIC	_fmax
_fmax:
	PUBLIC	_fmaxf
_fmaxf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	; Load x into DEHL
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	E,(IX+6)
	LD	D,(IX+7)

	; Load y into __tmp32
	LD	A,(IX+8)
	LD	(__tmp32),A
	LD	A,(IX+9)
	LD	(__tmp32+1),A
	LD	A,(IX+10)
	LD	(__tmp32+2),A
	LD	A,(IX+11)
	LD	(__tmp32+3),A

	CALL	__fcmp
	JR	NC,_fmax_ret	; x >= y, keep x in DEHL

	; x < y, return y
	LD	L,(IX+8)
	LD	H,(IX+9)
	LD	E,(IX+10)
	LD	D,(IX+11)

_fmax_ret:
	POP	IX
	RET

	END
