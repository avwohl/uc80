; lc_isalpha.mac - split from lc_ctype.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	CSEG

; int isalpha(int c)
	PUBLIC	_isalpha
_isalpha:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	A,(IX+4)
	; Check uppercase
	CP	'A'
	JR	C,_isalpha_lower
	CP	'Z'+1
	JR	C,_isalpha_yes
_isalpha_lower:
	; Check lowercase
	CP	'a'
	JR	C,_isalpha_no
	CP	'z'+1
	JR	NC,_isalpha_no
_isalpha_yes:
	LD	HL,1
	POP	IX
	RET
_isalpha_no:
	LD	HL,0
	POP	IX
	RET

	END
