; lc_isupper.mac - split from lc_ctype.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	CSEG

; int isupper(int c)
	PUBLIC	_isupper
_isupper:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	A,(IX+4)
	CP	'A'
	JR	C,_isupper_no
	CP	'Z'+1
	JR	NC,_isupper_no
	LD	HL,1
	POP	IX
	RET
_isupper_no:
	LD	HL,0
	POP	IX
	RET

	END
