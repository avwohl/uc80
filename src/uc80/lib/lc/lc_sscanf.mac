; lc_sscanf.mac - _sscanf
; Split from lc_scanf.mac

	.Z80

	EXTRN	_scanf_count
	EXTRN	_scanf_loop
	EXTRN	_scanf_mode
	EXTRN	_scanf_src
	EXTRN	_scanf_ungot

	CSEG
; ============================================================
; sscanf - read from string
; ============================================================
	PUBLIC	_sscanf
_sscanf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	; str at IX+4, fmt at IX+6, args at IX+8
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_scanf_src),HL
	XOR	A
	LD	(_scanf_ungot),A
	LD	A,1
	LD	(_scanf_mode),A
	; Setup format and args offset
	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = format
	LD	C,8		; args start at IX+8
	XOR	A
	LD	(_scanf_count),A
	JP	_scanf_loop

	END
