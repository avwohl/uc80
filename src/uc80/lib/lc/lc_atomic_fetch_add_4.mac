; lc_atomic_fetch_add_4.mac - ___atomic_fetch_add_4
; Split from lc_atomic.mac

	.Z80

	CSEG
; unsigned long __atomic_fetch_add_4(volatile void *obj, unsigned long val)
	PUBLIC	___atomic_fetch_add_4
___atomic_fetch_add_4:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	LD	L,(IX+4)
	LD	H,(IX+5)	; obj

	DI
	; Load current into temp
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	PUSH	DE		; Save low word of old
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	PUSH	DE		; Save high word of old

	; Add val
	POP	DE		; high
	POP	HL		; low
	PUSH	DE
	PUSH	HL		; Save old for return

	LD	C,(IX+6)
	LD	B,(IX+7)
	ADD	HL,BC		; Add low
	EX	DE,HL
	LD	C,(IX+8)
	LD	B,(IX+9)
	ADC	HL,BC		; Add high with carry
	EX	DE,HL		; DEHL = result

	; Store result
	PUSH	HL
	PUSH	DE
	LD	L,(IX+4)
	LD	H,(IX+5)
	POP	DE
	POP	BC		; DEBC = result
	LD	(HL),C
	INC	HL
	LD	(HL),B
	INC	HL
	LD	(HL),E
	INC	HL
	LD	(HL),D
	EI

	; Return old value
	POP	HL		; low
	POP	DE		; high
	POP	BC
	POP	IX
	RET

	END
