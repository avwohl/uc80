; lc_mem.mac - memory functions
	.Z80

; CP/M BDOS function numbers
BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	CSEG

; ============================================================
; void *memcpy(void *dest, const void *src, size_t n)
; Copy n bytes from src to dest
; Returns: dest
; ============================================================
	PUBLIC	_memcpy
_memcpy:
	POP	AF		; return address
	POP	DE		; DE = dest
	POP	HL		; HL = src
	POP	BC		; BC = n
	PUSH	BC
	PUSH	HL
	PUSH	DE
	PUSH	AF
	PUSH	DE		; return value
	LD	A,B
	OR	C
	JR	Z,_memcpy_done
	LDIR
_memcpy_done:
	POP	HL
	RET

; ============================================================
; void *mempcpy(void *dest, const void *src, size_t n)
; Copy n bytes from src to dest, return dest + n.
; GNU extension some torture tests reach for.
; ============================================================
	PUBLIC	_mempcpy
_mempcpy:
	POP	AF		; return address
	POP	DE		; DE = dest
	POP	HL		; HL = src
	POP	BC		; BC = n
	PUSH	BC
	PUSH	HL
	PUSH	DE
	PUSH	AF
	LD	A,B
	OR	C
	JR	Z,_mempcpy_done
	LDIR			; DE ends at dest + n
_mempcpy_done:
	EX	DE,HL
	RET

; ============================================================
; void *memset(void *s, int c, size_t n)
; Fill n bytes of s with c
; Returns: s
; ============================================================
	PUBLIC	_memset
_memset:
	POP	AF		; return address
	POP	HL		; HL = s
	POP	DE		; E = fill byte
	POP	BC		; BC = n
	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	A,B
	OR	C
	RET	Z		; HL = s
	PUSH	HL		; return value
	LD	(HL),E
	DEC	BC
	LD	A,B
	OR	C
	JR	Z,_memset_done
	LD	D,H
	LD	E,L
	INC	DE
	LDIR			; copy the first byte along
_memset_done:
	POP	HL
	RET

; ============================================================
; int memcmp(const void *s1, const void *s2, size_t n)
; Compare n bytes of s1 and s2
; Returns: <0 if s1<s2, 0 if s1==s2, >0 if s1>s2
; ============================================================
	PUBLIC	_memcmp
_memcmp:
	POP	AF		; return address
	POP	DE		; DE = s1
	POP	HL		; HL = s2
	POP	BC		; BC = n
	PUSH	BC
	PUSH	HL
	PUSH	DE
	PUSH	AF
	LD	A,B
	OR	C
	JR	Z,_memcmp_equal
_memcmp_loop:
	LD	A,(DE)
	INC	DE
	CPI			; compare with (HL), HL++, BC--
	JR	NZ,_memcmp_diff
	JP	PE,_memcmp_loop	; BC != 0
_memcmp_equal:
	LD	HL,0
	RET
_memcmp_diff:
	; Return s1[i] - s2[i] as unsigned chars (-255..255)
	DEC	HL
	SUB	(HL)
	LD	L,A
	SBC	A,A
	LD	H,A
	RET

; ============================================================
; void *malloc(size_t size)
; Allocate memory from heap
; Simple bump allocator - memory is never freed
; Argument: size on stack at IX+4
; Returns: pointer to allocated memory, or NULL (0) if failed

; ============================================================
; void *memmove(void *dest, const void *src, size_t n)
; Copy n bytes, handles overlapping regions
; Returns: dest
; ============================================================
	PUBLIC	_memmove
_memmove:
	POP	AF		; return address
	POP	DE		; DE = dest
	POP	HL		; HL = src
	POP	BC		; BC = n
	PUSH	BC
	PUSH	HL
	PUSH	DE
	PUSH	AF
	PUSH	DE		; return value
	LD	A,B
	OR	C
	JR	Z,_memmove_done
	; src >= dest: copy forward.  src < dest: copy backward from the
	; ends, which is right whether or not the regions overlap.
	OR	A
	SBC	HL,DE
	ADD	HL,DE
	JR	NC,_memmove_fwd
	ADD	HL,BC
	DEC	HL		; HL = src + n - 1
	EX	DE,HL
	ADD	HL,BC
	DEC	HL		; HL = dest + n - 1
	EX	DE,HL
	LDDR
	JR	_memmove_done
_memmove_fwd:
	LDIR
_memmove_done:
	POP	HL
	RET

; ============================================================
; void *memchr(const void *s, int c, size_t n)
; Find first occurrence of c in first n bytes of s
; Returns: pointer to byte, or NULL if not found
; ============================================================
	PUBLIC	_memchr
_memchr:
	POP	AF		; return address
	POP	HL		; HL = s
	POP	DE		; E = char to find
	POP	BC		; BC = n
	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	A,B
	OR	C
	JR	Z,_memchr_notfound
	LD	A,E
	CPIR			; stops after the match, or with BC = 0
	JR	NZ,_memchr_notfound
	DEC	HL
	RET
_memchr_notfound:
	LD	HL,0
	RET

; ============================================================
; int sprintf(char *str, const char *fmt, ...)
; Format string into buffer
; Supports %d, %s, %c, %x, %%
; Returns: number of characters written (excluding null)

	END
