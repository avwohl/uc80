; lc_system.mac - split from lc_misc.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	CSEG

; ============================================================
; int system(const char *command)
; Execute shell command (stub - returns -1 on CP/M)
; ============================================================
	PUBLIC	_system
_system:
	LD	HL,-1		; Return -1 (failure)
	RET

; ============================================================

	END
