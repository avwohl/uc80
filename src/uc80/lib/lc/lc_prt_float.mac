; lc_prt_float.mac - the %f float printer (_prt_float)
; Only lc_printf_f links this module, with the soft-float runtime it needs.
; _printf_putc, _printf_upper, __ftmp and _prt_float_prec stay in
; lc_printf_core because the %e and %g handlers share them.

	.Z80

	EXTRN	_printf_putc
	EXTRN	_printf_upper
	EXTRN	_printf_alt
	EXTRN	__ftmp
	EXTRN	_prt_float_prec
	EXTRN	__fmul
	EXTRN	__fsub
	EXTRN	__ftoi
	EXTRN	__itof
	EXTRN	__fadd
	EXTRN	__tmp32
	EXTRN	_prt_dec32

	PUBLIC	_prt_float

	CSEG

; ============================================================
; Internal: print float from __ftmp (IEEE 754 single precision)
; This is included in core since it's complex and shares state
; ============================================================

_prt_float:
	PUSH	BC
	PUSH	DE
	PUSH	IX

	; Load float from __ftmp into HLDE
	LD	DE,(__ftmp)
	LD	HL,(__ftmp+2)

	; Sign first, then zero.  The zero test masks the sign bit off, so
	; testing it first sent -0.0 to _prt_float_zero with the '-' never
	; emitted: printf("%f", -0.0) printed "0.000000".  C 7.21.6.1 says
	; the sign of a negative value is always printed, and negative zero
	; is a negative value.
	BIT	7,H
	JR	Z,_prt_float_signdone

	PUSH	HL
	PUSH	DE
	LD	E,'-'
	CALL	_printf_putc
	POP	DE
	POP	HL
	RES	7,H

_prt_float_signdone:
	; An all-ones exponent is an infinity or a NaN.  Test it here, on
	; the value as it arrived: the rounding pass below runs the bits
	; through __fadd, which does not preserve the mantissa that tells
	; the two apart, so a NaN reaching that point printed as "inf".
	LD	A,H
	ADD	A,A
	LD	B,A
	LD	A,L
	RLCA
	LD	A,B
	ADC	A,0
	CP	255
	JP	Z,_prt_float_inf

	; Check for zero (the sign bit is already cleared)
	LD	A,H
	OR	L
	OR	D
	OR	E
	JP	Z,_prt_float_zero

_prt_float_pos:
	EX	DE,HL
	LD	(__fwork),HL
	LD	(__fwork+2),DE

	; Pre-round
	PUSH	DE
	PUSH	HL
	LD	DE,3F00H
	LD	HL,0
	LD	A,(_prt_float_prec)
	OR	A
	JR	Z,_prt_round_add
	LD	B,A
_prt_round_lp:
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,3DCCH
	LD	HL,0CCCDH
	CALL	__fmul
	DJNZ	_prt_round_lp
_prt_round_add:
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	_prt_addz
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	POP	HL
	POP	DE

	; Reload rounded value
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	EX	DE,HL

	; Extract exponent
	LD	A,H
	ADD	A,A
	LD	B,A
	LD	A,L
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A

	CP	255
	JP	Z,_prt_float_inf

	OR	A
	JP	Z,_prt_float_zero

	; Above 2^31 the integer no longer fits the int32 that __ftoi
	; returns -- it saturates at 2147483647 and the fraction loop then
	; emits bytes that are not even digits.  Such a value is an exact
	; integer (a float has 24 mantissa bits), so print it exactly.
	; Compare the BIASED exponent: 127+31 = 158.  Subtracting the bias
	; first and comparing against 31 would be a signed test written
	; with an unsigned CP, and every |value| < 1 (negative unbiased
	; exponent, so 0xFF..0x80 as a byte) would take the big path.
	LD	A,B
	CP	158			; unbiased exponent >= 31, i.e. >= 2^31
	JP	NC,_prt_float_big

	; ---- Integer part ----
	; __ftoi truncates the pre-rounded value to a 32-bit integer and
	; _prt_dec32 prints all 32 bits of it, which is what the %ld
	; handler already does.
	;
	; This replaces a hand-rolled mantissa walk that assembled the
	; integer part in H:L:E and then printed it with the 16-bit
	; _prt_dec, dropping E: every |value| >= 65536 came out wrong,
	; and often not even as digits, because the leftover low byte
	; was emitted as a character.  1000000.0 printed as "3906.00///".
	; The >= 2^24 path shifted a 16-bit HL left and yielded 0.
	; sprintf in this same libc has always done it the way below.
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__ftoi
	LD	(__fint),HL
	LD	(__fint+2),DE
	CALL	_prt_dec32

	CALL	_prt_float_point

	; frac = value - (float)int
	LD	HL,(__fint)
	LD	DE,(__fint+2)
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__fsub
	LD	(__fwork),HL
	LD	(__fwork+2),DE

	LD	A,(_prt_float_prec)
	LD	B,A
	OR	A
	JP	Z,_prt_float_done
	JP	_prt_float_frac

_prt_float_frac:
	PUSH	BC
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,4120H
	LD	HL,0
	CALL	__fmul
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	CALL	__ftoi
	LD	A,L
	PUSH	AF
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	POP	AF
	LD	L,A
	LD	H,0
	LD	DE,0
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__fsub
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	POP	BC
	DJNZ	_prt_float_frac
	JP	_prt_float_done

; ============================================================
; %f for |value| >= 2^31.
;
; value = mantissa * 2^(e-23) with a 24-bit mantissa, so it is a whole
; number and its decimal form is exact.  Feed the mantissa's bits into
; a decimal accumulator most significant first, then double (e-23) more
; times.  Doubling a decimal digit string is exact at every step, so the
; digits printed are the value's own -- unlike scaling by powers of ten
; in float, which runs out of precision after about seven digits.
;
; Entry: HL = high half of |value| (L holds the top mantissa bits),
;        DE = low half, A = biased exponent.
; ============================================================
_prt_float_big:
	PUSH	AF
	LD	A,E
	LD	(_pbig_m),A
	LD	A,D
	LD	(_pbig_m+1),A
	LD	A,L
	AND	7FH
	OR	80H			; restore the implicit leading 1
	LD	(_pbig_m+2),A

	XOR	A
	LD	HL,_prt_big
	LD	B,40
_pbig_clr:
	LD	(HL),A
	INC	HL
	DJNZ	_pbig_clr
	LD	A,1
	LD	(_prt_biglen),A

	LD	B,24
_pbig_bits:
	PUSH	BC
	LD	A,(_pbig_m)
	ADD	A,A
	LD	(_pbig_m),A
	LD	A,(_pbig_m+1)
	ADC	A,A
	LD	(_pbig_m+1),A
	LD	A,(_pbig_m+2)
	ADC	A,A
	LD	(_pbig_m+2),A
	LD	A,0
	ADC	A,0			; A = the bit shifted out of the top
	CALL	_pbig_dbl
	POP	BC
	DJNZ	_pbig_bits

	POP	AF
	SUB	150			; (e - 127) - 23, straight off the biased form
	JR	Z,_pbig_print
	LD	B,A
_pbig_more:
	PUSH	BC
	XOR	A
	CALL	_pbig_dbl
	POP	BC
	DJNZ	_pbig_more

_pbig_print:
	LD	A,(_prt_biglen)
	LD	B,A
	LD	HL,_prt_big
	LD	D,0
	LD	E,A
	ADD	HL,DE
	DEC	HL			; most significant digit
_pbig_po:
	PUSH	BC
	PUSH	HL
	LD	A,(HL)
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	POP	HL
	DEC	HL
	POP	BC
	DJNZ	_pbig_po
	JP	_prt_float_dot_zeros

; Double the decimal accumulator, adding the carry-in in A.
_pbig_dbl:
	LD	C,A
	LD	HL,_prt_big
	LD	A,(_prt_biglen)
	LD	B,A
_pbig_dl:
	LD	A,(HL)
	ADD	A,A
	ADD	A,C
	LD	C,0
	CP	10
	JR	C,_pbig_nc
	SUB	10
	LD	C,1
_pbig_nc:
	LD	(HL),A
	INC	HL
	DJNZ	_pbig_dl
	LD	A,C
	OR	A
	RET	Z
	LD	(HL),1
	LD	A,(_prt_biglen)
	INC	A
	LD	(_prt_biglen),A
	RET

; Emit the decimal point, unless there are no digits to follow it.
; C 7.21.6.1: for %f the point appears only when the precision is
; non-zero, or when the # flag asks for it.  printf("%.0f", 2.0) was
; printing "2." , which no conforming implementation produces and which
; %e and %g in this same libc already got right.
_prt_float_point:
	LD	A,(_prt_float_prec)
	OR	A
	JR	NZ,_prt_float_point_yes
	LD	A,(_printf_alt)
	OR	A
	RET	Z
_prt_float_point_yes:
	LD	E,'.'
	JP	_printf_putc

_prt_float_zero:
	LD	E,'0'
	CALL	_printf_putc
_prt_float_dot_zeros:
	CALL	_prt_float_point
	LD	A,(_prt_float_prec)
	LD	B,A
	OR	A
	JR	Z,_prt_float_done
_prt_float_z2:
	PUSH	BC
	LD	E,'0'
	CALL	_printf_putc
	POP	BC
	DJNZ	_prt_float_z2
	JR	_prt_float_done

; HL holds the high word and DE the low word, sign already emitted.  A
; zero mantissa is an infinity, anything else a NaN; C17 7.21.6.1 p8 wants
; the uppercase spellings for %F.
_prt_float_inf:
	LD	A,L
	AND	7FH
	OR	D
	OR	E
	LD	HL,_prt_float_sinf
	JR	Z,_prt_float_spec
	LD	HL,_prt_float_snan
_prt_float_spec:
	LD	B,3
_prt_float_spec1:
	LD	A,(HL)
	PUSH	HL
	PUSH	BC
	LD	B,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,B
	JR	NZ,_prt_float_specu
	OR	20H			; lowercase unless %F
_prt_float_specu:
	LD	E,A
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	DJNZ	_prt_float_spec1

_prt_float_done:
	POP	IX
	POP	DE
	POP	BC
	RET

; ============================================================
; _prt_addz - DEHL = DEHL + (__tmp32), both positive, rounded toward zero.
; __fadd rounds to nearest.  The pre-round step above adds half a unit of
; the last printed digit, and the digit loop then cuts the result off, so
; the sum has to be the largest float that is not above the exact sum.
; The error of the nearest sum is found with the exact subtractions
; s - x and d - (s - x); if it is negative, the sum is one float too high.
; ============================================================
_prt_addz:
	LD	(_pz_x),HL
	LD	(_pz_x+2),DE
	LD	HL,(__tmp32)
	LD	(_pz_d),HL
	LD	HL,(__tmp32+2)
	LD	(_pz_d+2),HL
	LD	HL,(_pz_x)
	CALL	__fadd			; DEHL = s (DE still holds the high word)
	LD	(_pz_s),HL
	LD	(_pz_s+2),DE
	LD	HL,(_pz_x)
	LD	(__tmp32),HL
	LD	HL,(_pz_x+2)
	LD	(__tmp32+2),HL
	LD	HL,(_pz_s)
	LD	DE,(_pz_s+2)
	CALL	__fsub			; s - x
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_pz_d)
	LD	DE,(_pz_d+2)
	CALL	__fsub			; d - (s - x), the error of s
	LD	A,D
	LD	HL,(_pz_s)
	LD	DE,(_pz_s+2)
	OR	A
	RET	P			; the error is not negative
	LD	A,D			; the sum is one float too high
	OR	E
	OR	H
	OR	L
	RET	Z
	DEC	HL
	LD	A,H
	AND	L
	INC	A
	RET	NZ
	DEC	DE
	RET


	DSEG

_prt_float_sinf:	DB	'INF'
_prt_float_snan:	DB	'NAN'
__fwork:	DS	4
_pz_x:		DS	4
_pz_d:		DS	4
_pz_s:		DS	4
__fint:		DS	4	; %f integer part, as a 32-bit integer
_pbig_m:	DS	3	; %f >= 2^31: the 24-bit mantissa, shifted out MSB first
_prt_big:	DS	40	; %f >= 2^31: decimal digits, least significant first
_prt_biglen:	DB	1

	END
