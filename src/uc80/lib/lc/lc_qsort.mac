; lc_qsort.mac - qsort, bsearch
	.Z80

; CP/M BDOS function numbers
BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	CSEG

; ============================================================
; void qsort(void *base, size_t nmemb, size_t size,
;            int (*compar)(const void *, const void *))
;
; Calling convention (uc80): arguments are pushed right to left, so the
; FIRST argument is the LAST one pushed and sits nearest the return
; address; the result comes back in HL.  To call compar(a, b):
;	PUSH b / PUSH a / CALL compar / POP / POP
; The comparator may clobber every register except IX and SP, and it may
; also change its own argument slots (C parameters are writable), so a
; value that must survive the call is pushed separately, under the
; arguments, and popped after them.
;
; Algorithm:
;  - nmemb <= QS_THR: insertion sort only.
;  - Otherwise first check for one run: if the array is already in
;    order (non-decreasing), return; if it is in reverse order
;    (non-increasing), reverse it and return.  This costs nmemb-1
;    comparisons at most, and on random input it stops after two or three.
;  - Then a non-recursive quicksort: parts of more than QS_THR elements
;    are split with a Hoare partition around a median-of-three pivot.
;    The pivot stays in the array (QS_MID follows it when it is swapped).
;    Both scans stop on keys equal to the pivot, so all-equal input splits
;    in the middle and stays O(n log n).
;  - The larger part is pushed on the machine stack as (lo, hi) and the
;    loop continues with the smaller part, so the stack holds at most
;    log2(nmemb) entries (4 bytes each, at most 64 bytes).
;  - Parts of QS_THR elements or fewer are left alone; one final
;    insertion sort over the whole array finishes them (each element is
;    then less than QS_THR places from its final position).
;  - Elements are addressed with byte pointers stepped by size.  There is
;    no multiplication or division in the loops: part lengths are kept in
;    bytes, and the middle element is lo + ((hi-lo) - (k odd ? size : 0))/2
;    where k = (hi-lo)/size; k is odd when (hi-lo) AND (size AND -size)
;    is not zero.
;
; Reentrancy: the working variables live in static storage (fast 16-bit
; absolute loads), but qsort copies them to its stack frame on entry and
; copies them back on exit.  So a comparator that itself calls qsort (or
; calls a function that calls qsort) works.  An interrupt handler that
; calls qsort while another qsort runs is NOT supported (the static copy
; is live between the save and the restore).
;
; Stack on entry (after PUSH IX): base(IX+4), nmemb(IX+6), size(IX+8),
; compar(IX+10).  Preserves BC and IX.
; ============================================================
QS_THR	EQU	8		; parts of <= QS_THR elements go to insertion sort

	PUBLIC	_qsort
_qsort:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	; Save the static working area on the stack (for nested calls).
	LD	HL,-QS_NV
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL			; DE = save area
	LD	HL,QS_VARS
	LD	BC,QS_NV
	LDIR

	; size == 0 or nmemb < 2: nothing to do
	LD	L,(IX+8)
	LD	H,(IX+9)
	LD	A,H
	OR	L
	JP	Z,qs_exit
	LD	(QS_SIZE),HL
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	DE,2
	OR	A
	SBC	HL,DE
	JP	C,qs_exit

	; Trampolines: QS_TRAMP: JP compar; QS_SWJ: JP qs_sw2 or qs_swg
	LD	A,0C3H
	LD	(QS_TRAMP),A
	LD	(QS_SWJ),A
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	(QS_TRAMP+1),HL
	LD	HL,(QS_SIZE)
	LD	DE,qs_swg
	DEC	H
	INC	H
	JR	NZ,qs_e1
	LD	A,L
	CP	2
	JR	NZ,qs_e1
	LD	DE,qs_sw2
qs_e1:
	LD	(QS_SWJ+1),DE

	; QS_MASK = size AND -size (lowest set bit of size)
	LD	HL,(QS_SIZE)
	XOR	A
	SUB	L
	LD	E,A
	LD	A,0
	SBC	A,H
	LD	D,A			; DE = -size
	LD	A,E
	AND	L
	LD	E,A
	LD	A,D
	AND	H
	LD	D,A
	LD	(QS_MASK),DE

	; QS_THB = QS_THR*size, 0FFFFH if that overflows
	LD	DE,(QS_SIZE)
	LD	HL,0
	LD	B,QS_THR
qs_e2:
	ADD	HL,DE
	JR	C,qs_e3
	DJNZ	qs_e2
	JR	qs_e4
qs_e3:
	LD	HL,0FFFFH
qs_e4:
	LD	(QS_THB),HL

	; lo = base, hi = base + (nmemb-1)*size
	LD	L,(IX+6)
	LD	H,(IX+7)
	DEC	HL
	CALL	qs_mul
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(QS_LO),DE
	LD	(QS_BASE),DE
	ADD	HL,DE
	LD	(QS_HI),HL
	LD	(QS_LAST),HL
	LD	HL,0
	ADD	HL,SP
	LD	(QS_SP0),HL		; SP with an empty partition stack

	; Small array: straight to insertion sort.
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	DE,QS_THR+1
	OR	A
	SBC	HL,DE
	JP	C,qs_ins

; ---- run check: already sorted, or reverse sorted? ----
	LD	HL,(QS_LO)
	CALL	qs_cnext		; compar(p, p+size), p = lo
	BIT	7,H
	JR	NZ,qs_asc1		; < 0: ascending so far
	LD	A,H
	OR	L
	JR	NZ,qs_desc		; > 0: try descending
qs_asc1:
	; ascending: check compar(p, p+size) <= 0 for all p < hi
	LD	HL,(QS_LO)
qs_asc:
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JP	Z,qs_exit		; p == hi: all in order
	EX	DE,HL			; HL = p
	PUSH	HL
	CALL	qs_cnext
	POP	DE			; DE = p
	BIT	7,H
	EX	DE,HL
	JR	NZ,qs_asc		; < 0
	LD	A,D
	OR	E
	JR	Z,qs_asc		; == 0
	JR	qs_part			; > 0: not sorted
qs_desc:
	; descending: check compar(p, p+size) >= 0 for all p < hi
	LD	HL,(QS_LO)
qs_dsc:
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JR	Z,qs_rev		; p == hi: all in reverse order
	EX	DE,HL			; HL = p
	PUSH	HL
	CALL	qs_cnext
	POP	DE			; DE = p
	BIT	7,H
	EX	DE,HL
	JR	Z,qs_dsc		; >= 0
	JR	qs_part			; < 0: not in reverse order
qs_rev:
	; reverse the array: swap lo and hi, step inward
	LD	HL,(QS_LO)
	LD	DE,(QS_HI)
qs_rev1:
	PUSH	HL
	PUSH	DE
	CALL	QS_SWJ
	POP	HL
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE			; hi -= size
	EX	(SP),HL			; HL = lo
	ADD	HL,DE			; lo += size
	POP	DE			; DE = hi
	PUSH	HL
	OR	A
	SBC	HL,DE
	POP	HL
	JR	C,qs_rev1		; while lo < hi
	JP	qs_exit

; ---- partition [QS_LO..QS_HI], more than QS_THR elements ----
qs_part:
	; mid = lo + (d - (k odd ? size : 0)) / 2, d = hi - lo = k*size
	LD	HL,(QS_HI)
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	LD	A,(QS_MASK)
	AND	L
	LD	B,A
	LD	A,(QS_MASK+1)
	AND	H
	OR	B
	JR	Z,qs_p1
	LD	BC,(QS_SIZE)
	SBC	HL,BC			; CY is clear after OR B
qs_p1:
	SRL	H
	RR	L
	ADD	HL,DE
	LD	(QS_MID),HL

	; Median of three: order *lo <= *mid <= *hi.
	CALL	qs_ord			; mid < lo: swap
	LD	HL,(QS_HI)
	LD	DE,(QS_MID)
	CALL	qs_ord			; hi < mid: swap
	JR	Z,qs_m3
	LD	HL,(QS_MID)
	LD	DE,(QS_LO)
	CALL	qs_ord			; mid < lo: swap
qs_m3:
	; l = lo + size, r = hi - size
	LD	DE,(QS_SIZE)
	LD	HL,(QS_LO)
	ADD	HL,DE
	LD	(QS_L),HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	LD	(QS_R),HL

qs_scan:
	; while (compar(l, mid) < 0) l += size;
	LD	HL,(QS_L)
qs_sl:
	PUSH	HL			; keep l
	LD	DE,(QS_MID)
	PUSH	DE			; b = mid
	PUSH	HL			; a = l
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	DE			; DE = l
	JR	Z,qs_sl9
	LD	HL,(QS_SIZE)
	ADD	HL,DE
	JP	qs_sl
qs_sl9:
	LD	(QS_L),DE

	; while (compar(mid, r) < 0) r -= size;
	LD	HL,(QS_R)
qs_sr:
	PUSH	HL			; keep r
	PUSH	HL			; b = r
	LD	HL,(QS_MID)
	PUSH	HL			; a = mid
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	HL			; HL = r
	JR	Z,qs_sr9
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE
	JP	qs_sr
qs_sr9:
	LD	(QS_R),HL
	EX	DE,HL			; DE = r
	LD	HL,(QS_L)
	OR	A
	SBC	HL,DE
	JR	Z,qs_eq			; l == r: step both and stop
	JR	NC,qs_split		; l > r: done
	; l < r: swap, keep QS_MID on the pivot
	ADD	HL,DE			; HL = l, DE = r
	CALL	QS_SWJ
	LD	HL,(QS_MID)
	LD	DE,(QS_L)
	OR	A
	SBC	HL,DE
	JR	NZ,qs_pv1
	LD	HL,(QS_R)
	LD	(QS_MID),HL
	JR	qs_adv
qs_pv1:
	LD	HL,(QS_MID)
	LD	DE,(QS_R)
	OR	A
	SBC	HL,DE
	JR	NZ,qs_adv
	LD	HL,(QS_L)
	LD	(QS_MID),HL
qs_adv:
	CALL	qs_step
	; loop while l <= r  (qs_step leaves DE = l, HL = r)
	OR	A
	SBC	HL,DE
	JP	NC,qs_scan
	JR	qs_split

qs_eq:
	CALL	qs_step

qs_split:
	; Parts: [lo..r] and [l..hi]; byte lengths ld = r-lo, rd = hi-l
	; (a part has QS_THR elements or fewer when its length < QS_THB).
	LD	HL,(QS_R)
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	LD	(QS_LD),HL
	LD	HL,(QS_HI)
	LD	DE,(QS_L)
	OR	A
	SBC	HL,DE
	LD	(QS_RD),HL
	LD	DE,(QS_THB)
	OR	A
	SBC	HL,DE
	JR	NC,qs_rbig
	; right part small: if the left part is small too, pop
	LD	HL,(QS_LD)
	OR	A
	SBC	HL,DE
	JR	C,qs_pop
qs_goleft:
	LD	HL,(QS_R)
	LD	(QS_HI),HL
	JP	qs_part
qs_rbig:
	; right part big.  Left part small: continue with the right part.
	LD	HL,(QS_LD)
	OR	A
	SBC	HL,DE
	JR	C,qs_goright
	; both big: push the larger, continue with the smaller
	LD	HL,(QS_LD)
	LD	DE,(QS_RD)
	OR	A
	SBC	HL,DE
	JR	C,qs_pushr		; ld < rd: push right
	; push left (lo, r), continue with the right part
	LD	HL,(QS_R)
	PUSH	HL
	LD	HL,(QS_LO)
	PUSH	HL
qs_goright:
	LD	HL,(QS_L)
	LD	(QS_LO),HL
	JP	qs_part
qs_pushr:
	; push right (l, hi), continue with the left part
	LD	HL,(QS_HI)
	PUSH	HL
	LD	HL,(QS_L)
	PUSH	HL
	JR	qs_goleft

qs_pop:
	LD	HL,(QS_SP0)
	OR	A
	SBC	HL,SP
	JR	Z,qs_ins0
	POP	HL
	LD	(QS_LO),HL
	POP	HL
	LD	(QS_HI),HL
	JP	qs_part

; ---- final insertion sort over the whole array ----
qs_ins0:
	; lo = base, hi = last element
	LD	HL,(QS_BASE)
	LD	(QS_LO),HL
	LD	HL,(QS_LAST)
	LD	(QS_HI),HL
qs_ins:
	LD	HL,(QS_LO)
	LD	(QS_L),HL		; p = lo
qs_iouter:
	LD	HL,(QS_L)
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	LD	(QS_L),HL
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JR	C,qs_exit		; p > hi: done
	EX	DE,HL			; HL = q = p
qs_iinner:
	; while (q > lo && compar(q - size, q) > 0) { swap; q -= size; }
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	JR	Z,qs_iouter		; q == lo
	ADD	HL,DE
	PUSH	HL			; keep q
	PUSH	HL			; b = q
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE
	PUSH	HL			; a = q - size
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	JR	NZ,qs_ino		; < 0: in place
	LD	A,H
	OR	L
	JR	Z,qs_ino		; == 0: in place
	POP	DE			; DE = q
	LD	HL,(QS_SIZE)
	EX	DE,HL			; HL = q, DE = size
	OR	A
	SBC	HL,DE			; HL = q - size
	PUSH	HL			; new q
	ADD	HL,DE
	EX	DE,HL			; DE = q
	POP	HL			; HL = q - size
	PUSH	HL
	CALL	QS_SWJ
	POP	HL			; HL = new q
	JR	qs_iinner
qs_ino:
	POP	DE
	JP	qs_iouter

qs_exit:
	; Restore the static working area and return.
	PUSH	IX
	POP	HL
	LD	DE,-(QS_NV+2)
	ADD	HL,DE
	LD	SP,HL			; SP = save area
	LD	DE,QS_VARS
	LD	BC,QS_NV
	LDIR
	LD	HL,QS_NV
	ADD	HL,SP
	LD	SP,HL
	POP	BC
	POP	IX
	RET

; If compar(HL, DE) < 0, swap the elements at HL and DE.
; Returns NZ if it swapped, Z if not.  Clobbers A, BC, DE, HL.
qs_ord:
	PUSH	HL
	PUSH	DE
	PUSH	DE			; b
	PUSH	HL			; a
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	DE
	POP	HL
	RET	Z
	CALL	QS_SWJ
	OR	1			; NZ: swapped
	RET

; HL = compar(HL, HL + size)
qs_cnext:
	EX	DE,HL
	LD	HL,(QS_SIZE)
	ADD	HL,DE
	PUSH	HL			; b = p + size
	PUSH	DE			; a = p
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	RET

; l += size; r -= size.  Returns DE = l, HL = r.
qs_step:
	LD	DE,(QS_SIZE)
	LD	HL,(QS_L)
	ADD	HL,DE
	LD	(QS_L),HL
	LD	HL,(QS_R)
	OR	A
	SBC	HL,DE
	LD	(QS_R),HL
	LD	DE,(QS_L)
	RET

; HL = HL * QS_SIZE  (clobbers A, BC, DE)
qs_mul:
	EX	DE,HL
	LD	BC,(QS_SIZE)
	LD	HL,0
qs_mul1:
	SRL	B
	RR	C
	JR	NC,qs_mul2
	ADD	HL,DE
qs_mul2:
	LD	A,B
	OR	C
	RET	Z
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL
	JR	qs_mul1

; Swap the elements at HL and DE (reached through QS_SWJ).
; Clobbers A, BC, DE, HL.
qs_sw2:
	; size 2
	LD	C,(HL)
	LD	A,(DE)
	LD	(HL),A
	LD	A,C
	LD	(DE),A
	INC	HL
	INC	DE
	LD	C,(HL)
	LD	A,(DE)
	LD	(HL),A
	LD	A,C
	LD	(DE),A
	RET
qs_swg:
	; any size
	LD	BC,(QS_SIZE)
qs_swg1:
	LD	A,(DE)
	LDI				; (DE) <- (HL), DE++, HL++, BC--
	DEC	HL
	LD	(HL),A
	INC	HL
	JP	PE,qs_swg1		; P/V set while BC != 0
	RET

; ============================================================
; void *bsearch(const void *key, const void *base, size_t nmemb,
;               size_t size, int (*compar)(const void *, const void *))
; Binary search in a sorted array.  Calls compar(key, element).
; Stack: key(IX+4), base(IX+6), nmemb(IX+8), size(IX+10), compar(IX+12)
; Locals: low(IX-4), high(IX-6), mid(IX-8) -- on the stack, so bsearch
; is reentrant (a comparator can call bsearch or qsort).
; Returns: pointer to a matching element, or NULL.  Preserves BC and IX.
; ============================================================
	PUBLIC	_bsearch
_bsearch:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	LD	HL,0
	PUSH	HL			; low = 0      (IX-4)
	LD	L,(IX+8)
	LD	H,(IX+9)
	PUSH	HL			; high = nmemb (IX-6)
	PUSH	HL			; mid          (IX-8)

bs_loop:
	; if (low >= high) not found
	LD	L,(IX-4)
	LD	H,(IX-3)
	LD	E,(IX-6)
	LD	D,(IX-5)
	OR	A
	SBC	HL,DE
	JR	NC,bs_nf
	; mid = (low + high) / 2, with the 17th bit kept
	ADD	HL,DE			; HL = low again
	ADD	HL,DE			; CY:HL = low + high
	RR	H
	RR	L
	LD	(IX-8),L
	LD	(IX-7),H
	; HL = base + mid*size
	EX	DE,HL			; DE = mid
	LD	C,(IX+10)
	LD	B,(IX+11)		; BC = size
	LD	HL,0
bs_mul:
	SRL	B
	RR	C
	JR	NC,bs_mul2
	ADD	HL,DE
bs_mul2:
	LD	A,B
	OR	C
	JR	Z,bs_mul3
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL
	JR	bs_mul
bs_mul3:
	LD	E,(IX+6)
	LD	D,(IX+7)
	ADD	HL,DE			; HL = &base[mid]
	PUSH	HL			; keep element address
	PUSH	HL			; b = element
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL			; a = key
	LD	L,(IX+12)
	LD	H,(IX+13)
	CALL	bs_jphl
	POP	DE
	POP	DE
	POP	DE			; DE = element address
	LD	A,H
	OR	L
	JR	Z,bs_found
	BIT	7,H
	JR	NZ,bs_left
	; key > element: low = mid + 1
	LD	L,(IX-8)
	LD	H,(IX-7)
	INC	HL
	LD	(IX-4),L
	LD	(IX-3),H
	JR	bs_loop
bs_left:
	; key < element: high = mid
	LD	L,(IX-8)
	LD	H,(IX-7)
	LD	(IX-6),L
	LD	(IX-5),H
	JR	bs_loop

bs_found:
	EX	DE,HL
	JR	bs_ret
bs_nf:
	LD	HL,0
bs_ret:
	LD	SP,IX
	DEC	SP
	DEC	SP
	POP	BC
	POP	IX
	RET

bs_jphl:
	JP	(HL)

	DSEG
; qsort working storage.  qsort saves these QS_NV bytes on its stack on
; entry and restores them on exit (see "Reentrancy" above).
QS_VARS:
QS_TRAMP:	DS	3	; JP compar
QS_SWJ:		DS	3	; JP qs_sw2 or qs_swg
QS_SIZE:	DS	2	; element size
QS_MASK:	DS	2	; lowest set bit of the element size
QS_THB:		DS	2	; QS_THR * size (bytes), 0FFFFH on overflow
QS_LO:		DS	2	; current part: first element
QS_HI:		DS	2	; current part: last element
QS_MID:		DS	2	; pivot element
QS_L:		DS	2	; left scan pointer (insertion sort: p)
QS_R:		DS	2	; right scan pointer
QS_LD:		DS	2	; left part length - size, in bytes
QS_RD:		DS	2	; right part length - size, in bytes
QS_SP0:		DS	2	; SP with an empty partition stack
QS_BASE:	DS	2	; first element of the array
QS_LAST:	DS	2	; last element of the array
QS_END:
QS_NV	EQU	QS_END-QS_VARS

	END
