; lc_printf_lo.mac - printf %lo handler (unsigned long octal)
	.Z80


	EXTRN	_printf_loop
	EXTRN	_printf_alt
	EXTRN	_printf_prec
	EXTRN	_printf_decbuf
	EXTRN	_printf_dstart
	EXTRN	_printf_dcnt
	EXTRN	_printf_numout

	CSEG

	PUBLIC	__printf_handle_lo
__printf_handle_lo:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = value
	; Store DEHL to work area
	LD	(_plo_val),HL
	LD	(_plo_val+2),DE
	PUSH	IX
	LD	IX,_printf_decbuf+24
	LD	B,0		; digit counter
_plo_cvt:
	LD	A,(_plo_val)
	AND	07h		; remainder = value & 7
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	; Shift 32-bit _plo_val right by 3 (divide by 8)
	; Byte order: _plo_val+0 (low) .. _plo_val+3 (high)
	; Do 3 single-bit right shifts
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Second shift
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Third shift
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Check if quotient is zero
	LD	HL,(_plo_val)
	LD	A,H
	OR	L
	JR	NZ,_plo_cvt
	LD	HL,(_plo_val+2)
	LD	A,H
	OR	L
	JR	NZ,_plo_cvt
	; '#' flag: force the first digit to be '0'
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_plo_set
	LD	A,(IX+0)
	CP	'0'
	JR	Z,_plo_set_z
	DEC	IX
	LD	(IX+0),'0'
	INC	B
	JR	_plo_set
_plo_set_z:
	; value 0 with '#': "%#.0o" still prints "0"
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_plo_set
	INC	A
	LD	(_printf_prec),A
_plo_set:
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	IX
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop

	COMMON	/lc_printf_lo/
_plo_val:	DS	4

	END
