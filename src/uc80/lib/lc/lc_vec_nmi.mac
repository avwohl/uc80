; lc_vec_nmi.mac - default handler of the NMI vector (66h): return
; The label __nmi_handler is the target of a vector in crt0_rom_vec.mac.  A module
; of the program that binds the vector defines the label itself; the linker
; takes this module of the library only when no module does.  See
; docs/rom_hardware.md.

	.Z80

	CSEG
	PUBLIC	__nmi_handler
__nmi_handler:
	RETN

	END
