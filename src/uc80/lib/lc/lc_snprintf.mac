; lc_snprintf.mac - snprintf(): the shared printf engine, bounded buffer.
;
; The sink, the NUL and the count are in lc_snprintf_run.mac, which
; vsnprintf shares.
	.Z80

	EXTRN	_snprintf_run
	EXTRN	_snprintf_out
	EXTRN	_snprintf_max

	CSEG

	PUBLIC	_snprintf

; int snprintf(char *str, size_t size, const char *fmt, ...)
_snprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; str at IX+4, size at IX+6, fmt at IX+8, first vararg at IX+10
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(_snprintf_out),DE
	LD	E,(IX+6)
	LD	D,(IX+7)
	LD	(_snprintf_max),DE

	LD	L,(IX+8)
	LD	H,(IX+9)		; HL = format string
	LD	C,10			; first vararg at IX+10
	CALL	_snprintf_run

	POP	DE
	POP	BC
	POP	IX
	RET

	END
