; lc_sprintf.mac - sprintf(): the shared printf engine, writing to a buffer.
;
; This file used to carry a second, independent formatter: its own
; CP/JR-Z chain over the conversion characters, its own width and
; precision handling, its own integer and float printers.  It knew %d %u
; %x %s %c %f and little else, so %e, %g and %F reached printf and no
; other member of the family -- they emitted an empty field and, because
; the miss path was `INC HL / JP _sprintf_loop`, did not advance the
; vararg offset either, so every later conversion in the same call read
; the wrong argument.  That is the bug uc80 set out to fix in printf, and
; four of the five entry points still had it.
;
; There is one formatter now.  lc_printf_core's _printf_engine takes the
; frame, the format string, the offset of the first vararg and a sink
; routine; the entry points below are those four things and nothing else,
; so a conversion added to the table is available to all of them at once.
	.Z80

	EXTRN	_printf_engine
	EXTRN	_printf_sink
	EXTRN	_printf_count

	CSEG

	PUBLIC	_sprintf
	PUBLIC	_sprintf_sink
	PUBLIC	_sprintf_out

; int sprintf(char *str, const char *fmt, ...)
_sprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; str at IX+4, fmt at IX+6, first vararg at IX+8
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(_sprintf_out),DE

	LD	HL,(_printf_sink)
	PUSH	HL			; the caller's sink, restored below
	LD	HL,_sprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	C,8			; first vararg at IX+8
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL	; restore before anything can print

	LD	HL,(_sprintf_out)
	LD	(HL),0			; NUL terminate

	LD	HL,(_printf_count)	; C 7.21.6.6: bytes written, sans NUL
	POP	DE
	POP	BC
	POP	IX
	RET

; Sink: the character is in E.  _printf_putc has already saved every
; register and counts the byte itself once we return.
_sprintf_sink:
	PUSH	HL
	LD	HL,(_sprintf_out)
	LD	(HL),E
	INC	HL
	LD	(_sprintf_out),HL
	POP	HL
	RET

	DSEG

_sprintf_out:	DS	2	; next byte of the caller's buffer

	END
