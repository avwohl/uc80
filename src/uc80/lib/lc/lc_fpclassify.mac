; lc_fpclassify.mac - _fpclassify
; Split from lc_fpclassify.mac

	.Z80

	CSEG
; ============================================================
; fpclassify(x) - classify floating-point value
; ============================================================
	PUBLIC	_fpclassify
_fpclassify:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	; Extract exponent
	LD	A,(IX+7)	; D byte (SEEEEEEE)
	AND	7FH		; Strip sign (0EEEEEEE)
	ADD	A,A		; Shift left (EEEEEEE0)
	LD	B,A
	LD	A,(IX+6)	; E byte (EMMMMMMM)
	RLCA			; Rotate - exp low bit into bit 0
	AND	1		; Isolate exp low bit
	OR	B		; A = 8-bit biased exponent

	; exp == 0?
	OR	A
	JR	Z,_fpc_expz

	; exp == 255?
	CP	255
	JR	Z,_fpc_exp255

	; Normal (exp 1..254)
	LD	HL,4		; FP_NORMAL
	POP	IX
	RET

_fpc_expz:
	; Check mantissa
	LD	A,(IX+6)
	AND	7FH
	OR	(IX+5)
	OR	(IX+4)
	JR	NZ,_fpc_sub
	; Zero
	LD	HL,2		; FP_ZERO
	POP	IX
	RET

_fpc_sub:
	LD	HL,3		; FP_SUBNORMAL
	POP	IX
	RET

_fpc_exp255:
	; Check mantissa for NaN vs Inf
	LD	A,(IX+6)
	AND	7FH
	OR	(IX+5)
	OR	(IX+4)
	JR	NZ,_fpc_nan
	; Infinity
	LD	HL,1		; FP_INFINITE
	POP	IX
	RET

_fpc_nan:
	LD	HL,0		; FP_NAN
	POP	IX
	RET

	END
