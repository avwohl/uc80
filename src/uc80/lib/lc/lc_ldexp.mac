; lc_ldexp.mac - _ldexp, _ldexpf
; Split from lc_frexp.mac

	.Z80

	CSEG
; ============================================================
; ldexp(x, n) - multiply x by 2^n
; ============================================================
	PUBLIC	_ldexp
_ldexp:
	PUBLIC	_ldexpf
_ldexpf:
	PUSH	IX
	PUSH	BC
	LD	IX,0
	ADD	IX,SP

	; Read float arg: IX+6..IX+9
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	E,(IX+8)
	LD	D,(IX+9)

	; Get int exponent n (at IX+10)
	LD	B,(IX+10)

	; Extract 8-bit biased exponent
	LD	A,D		; D = SEEEEEEE
	AND	7FH		; Strip sign
	ADD	A,A		; EEEEEEE0
	LD	C,A
	LD	A,E		; EMMMMMMM
	RLCA			; MMMMMMME
	AND	1
	OR	C		; Full 8-bit exponent

	; Add n
	ADD	A,B		; New biased exponent

	; Reconstruct: D = S | exp[7:1], E = exp[0] | mantissa[6:0]
	LD	C,A		; Save new exponent
	SRL	A		; A = exp >> 1 = 0_exp[7:1]
	LD	B,A
	LD	A,D
	AND	80H		; Keep sign
	OR	B
	LD	D,A
	LD	A,C		; New exponent
	AND	1		; exp[0]
	RRCA			; Rotate to bit 7
	LD	B,A
	LD	A,E
	AND	7FH		; Keep mantissa bits
	OR	B		; Set exp[0]
	LD	E,A

	POP	BC
	POP	IX
	RET

	END
