; lc_fwrite.mac - split from lc_file.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	EXTRN	__div16
	EXTRN	__mul16
	EXTRN	_fputc

	CSEG

; ============================================================
; size_t fwrite(const void *ptr, size_t size, size_t nmemb, FILE *stream)
; Write data to stream
; ============================================================
	PUBLIC	_fwrite
_fwrite:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Simple implementation - write byte by byte
	LD	L,(IX+6)
	LD	H,(IX+7)	; size
	LD	E,(IX+8)
	LD	D,(IX+9)	; nmemb
	CALL	__mul16		; HL = total bytes
	LD	B,H
	LD	C,L		; BC = bytes to write

	LD	A,B
	OR	C
	JR	Z,_fwrite_done

	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = ptr (source)
	LD	(_fwrite_ptr),HL
	LD	HL,0
	LD	(_fwrite_cnt),HL

_fwrite_loop:
	LD	A,B
	OR	C
	JR	Z,_fwrite_done

	; Get byte from source
	LD	HL,(_fwrite_ptr)
	LD	A,(HL)
	INC	HL
	LD	(_fwrite_ptr),HL

	; Write to stream
	PUSH	BC
	LD	L,(IX+10)
	LD	H,(IX+11)	; stream
	PUSH	HL
	LD	L,A
	LD	H,0
	PUSH	HL
	CALL	_fputc
	POP	HL
	POP	HL
	POP	BC

	; Check error
	LD	A,H
	INC	A
	JR	Z,_fwrite_done	; Error

	LD	HL,(_fwrite_cnt)
	INC	HL
	LD	(_fwrite_cnt),HL
	DEC	BC
	JR	_fwrite_loop

_fwrite_done:
	; Return items written (cnt / size)
	; __div16 does HL = DE / HL, so DE = cnt, HL = size
	LD	E,(IX+6)
	LD	D,(IX+7)	; DE = size (temporarily)
	LD	A,D
	OR	E
	JR	Z,_fwrite_ret
	LD	HL,(_fwrite_cnt)	; HL = cnt
	EX	DE,HL		; Now DE = cnt, HL = size
	CALL	__div16		; HL = cnt / size
_fwrite_ret:
	POP	DE
	POP	BC
	POP	IX
	RET


	COMMON	/lc_fwrite/

_fwrite_ptr:	DS	2	; fwrite source pointer temp
_fwrite_cnt:	DS	2	; fwrite byte counter temp

	END
