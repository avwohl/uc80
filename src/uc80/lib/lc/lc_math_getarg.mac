; lc_math_getarg.mac - _math_getarg
; Split from lc_math_helper.mac

	.Z80

	CSEG
; ============================================================
; Helper: Load float argument from stack into DEHL
; Call with IX pointing to stack frame
; ============================================================
	PUBLIC	_math_getarg
_math_getarg:
	; Stack: +0,+1=BC, +2,+3=IX, +4,+5=retaddr, +6..+9=arg
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	E,(IX+8)
	LD	D,(IX+9)
	RET

	END
