; lc_scan_fdefault.mac - CONCAT-SKIP: lc_scan_float defines _sc_float too
;
; The default floating-point conversion of the scanf engine: every %f, %e,
; %g and %a is a matching failure.  A program that needs them links
; lc_scan_float instead (see scan_hook.py in uc80).  The name sorts before the name of the real
; module: the linker reads the library in the order of the names, so it takes
; this module only if the real module is not in the program already.
	.Z80

	CSEG

	PUBLIC	__sc_float
__sc_float:
	LD	HL,0
	RET

	END
