; lc_floor.mac - _floor, _floorf, _floorl
; Split from lc_floor.mac

	.Z80

	EXTRN	__fsub
	EXTRN	__ftoi
	EXTRN	__itof
	EXTRN	__tmp32
	EXTRN	_math_getarg

	CSEG
; ============================================================
; floor(x) - round toward negative infinity
; ============================================================
	PUBLIC	_floor
_floor:
	PUBLIC	_floorf
_floorf:
	PUBLIC	_floorl
_floorl:
	PUSH	IX
	PUSH	BC
	LD	IX,0
	ADD	IX,SP

	CALL	_math_getarg
	LD	(_floor_x),HL
	LD	(_floor_x+2),DE

	; Save sign
	LD	A,D
	AND	80H
	LD	(_floor_sign),A

	; trunc(x)
	CALL	__ftoi
	CALL	__itof
	LD	(_floor_t),HL
	LD	(_floor_t+2),DE

	; If positive, done
	LD	A,(_floor_sign)
	OR	A
	JR	Z,_floor_ret

	; Negative: check if x == trunc(x)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_floor_x)
	LD	DE,(_floor_x+2)
	CALL	__fsub		; x - trunc(x)

	; If fractional part is 0, done
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	Z,_floor_ret

	; Subtract 1.0 from trunc(x)
	LD	HL,0
	LD	DE,3F80H	; 1.0
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_floor_t)
	LD	DE,(_floor_t+2)
	CALL	__fsub		; trunc(x) - 1.0

	JR	_floor_done

_floor_ret:
	LD	HL,(_floor_t)
	LD	DE,(_floor_t+2)

_floor_done:
	POP	BC
	POP	IX
	RET

	COMMON	/lc_floor/
_floor_x:	DS	4
_floor_t:	DS	4
_floor_sign:	DS	1
_ceil_x:	DS	4

	END
