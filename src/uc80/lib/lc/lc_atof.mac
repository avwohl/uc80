; lc_atof.mac - _atof
; Split from lc_atof.mac

	.Z80

	EXTRN	_strtod

	CSEG
; ============================================================
; double atof(const char *nptr)
; Convert string to double (IEEE 754 single precision)
; ============================================================
	PUBLIC	_atof
_atof:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	; Call strtod with NULL endptr
	LD	HL,0
	PUSH	HL		; endptr = NULL (pushed first: last argument)
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = nptr
	PUSH	HL
	CALL	_strtod
	POP	BC
	POP	BC

	POP	BC
	POP	IX
	RET

	END
