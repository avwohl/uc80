; lc_vm_frexp.mac - __vm_frexp1, a routine of the float interpreter
;
; DEHL = x, a finite number that is not zero.  The routine returns
; DEHL = m, with 1 <= m < 2 (the sign of x is lost), and (__tmp32) = n as a
; float, where |x| = m * 2^n.  It keeps BC and IX.  A subnormal x gives the
; normalized m and an n below -126.
	.Z80

	CSEG

	EXTRN	__itof
	EXTRN	__tmp32

	PUBLIC	__vm_frexp1
__vm_frexp1:
	PUSH	BC
	LD	A,E
	RLA
	LD	A,D
	RLA			; A = the exponent field
	LD	C,A
	LD	B,0
	OR	A
	JR	NZ,_vfx_n
	INC	C		; the exponent field of the subnormal numbers is 1
	LD	A,E
	OR	H
	OR	L
	JR	Z,_vfx_n	; a zero (not allowed): do not loop
_vfx_s:
	BIT	7,E
	JR	NZ,_vfx_n
	ADD	HL,HL
	RL	E
	DEC	BC
	JR	_vfx_s
_vfx_n:
	LD	D,3FH
	SET	7,E
	PUSH	HL
	PUSH	DE
	LD	HL,-127
	ADD	HL,BC
	LD	A,H
	ADD	A,A
	SBC	A,A
	LD	E,A
	LD	D,A
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	POP	DE
	POP	HL
	POP	BC
	RET

	END
