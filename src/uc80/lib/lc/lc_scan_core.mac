; lc_scan_core.mac - the scanf engine, used by scanf, fscanf, sscanf and the
; v versions
;
; int _scan_run(struct sc *in, const char *fmt, char *ap)
;
; The engine takes the characters from a struct sc (see csrc/scan.h):
;   +0 get function, +2 unget function, +4 string, +6 FILE, +8 count n
; Integers go into a byte array of the size of the target, so %d, %ld,
; %lld and %hhd share one reader and no 32-bit or 64-bit runtime routine is
; linked.  This module does the integer conversions, the literal
; characters, white space, %%, %n and the size modifiers.  The other
; conversions are in two modules that the compiler links when a program
; needs them (scan_hook.py):
;   _sc_float  (lc_scan_float)  %f %e %g %a, a C function
;   _sc_text   (lc_scan_text)   %c %s %[ ]
; Each has a default module that fails the conversion.
;
; Return value: the number of items assigned; EOF when the input ends
; before the first item was assigned.  A conversion "0x" with no digit
; after it is the number 0 and the x stays in the input, but a FILE can
; push back only one character.
	.Z80

	CSEG

	EXTRN	__sc_float
	EXTRN	__sc_text
	EXTRN	__sc_muladd
	EXTRN	__sc_negate
	EXTRN	__sc_dv

	PUBLIC	__scan_run
	PUBLIC	__scn_gc
	PUBLIC	__scn_ugc
	PUBLIC	__scn_sp
	PUBLIC	__scn_skipws
	PUBLIC	__scn_arg
	PUBLIC	__sc_getc
	PUBLIC	__sc_ungetc

; ------------------------------------------------------------
; int _sc_getc(struct sc *in): the next character, or -1.  The argument
; is the source of the running call and is not used.
; ------------------------------------------------------------
__sc_getc:
	JR	__scn_gc

; void _sc_ungetc(struct sc *in, int c)
__sc_ungetc:
	LD	HL,5
	ADD	HL,SP
	LD	A,(HL)
	DEC	HL
	LD	L,(HL)
	LD	H,A
	JR	__scn_ugc

; ------------------------------------------------------------
; __scn_gc: HL = the next character, or -1 at the end.  A character
; adds 1 to in->n.  Changes everything but IX.
; ------------------------------------------------------------
__scn_gc:
	LD	HL,(_scn_in)
	PUSH	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	CALL	_scn_jphl
	POP	DE
	BIT	7,H
	RET	NZ
	PUSH	HL
	LD	HL,(_scn_in)
	LD	DE,8
	ADD	HL,DE
	INC	(HL)
	JR	NZ,_scn_g1
	INC	HL
	INC	(HL)
_scn_g1:
	POP	HL
	RET
_scn_jphl:
	JP	(HL)

; ------------------------------------------------------------
; __scn_ugc: push back the character HL.  Nothing happens for a negative
; HL.  The count in->n goes down by 1.
; ------------------------------------------------------------
__scn_ugc:
	BIT	7,H
	RET	NZ
	PUSH	HL
	LD	HL,(_scn_in)
	PUSH	HL
	INC	HL
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	CALL	_scn_jphl
	POP	HL
	POP	HL
	LD	HL,(_scn_in)
	LD	DE,8
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	DEC	DE
	LD	(HL),D
	DEC	HL
	LD	(HL),E
	RET

; ------------------------------------------------------------
; __scn_sp: carry is set when A is white space (space, 9 to 13).
; Keeps A.
; ------------------------------------------------------------
__scn_sp:
	CP	' '
	JR	Z,_scn_spy
	CP	14
	RET	NC
	CP	9
	CCF
	RET
_scn_spy:
	SCF
	RET

; ------------------------------------------------------------
; __scn_skipws: skip white space.  Carry is set at the end of the input.
; ------------------------------------------------------------
__scn_skipws:
	CALL	__scn_gc
	BIT	7,H
	JR	NZ,_scn_swe
	LD	A,L
	CALL	__scn_sp
	JR	C,__scn_skipws
	CALL	__scn_ugc
	OR	A
	RET
_scn_swe:
	SCF
	RET

; ------------------------------------------------------------
; __scn_arg: HL = the next argument, which is a pointer
; ------------------------------------------------------------
__scn_arg:
	LD	HL,(__scn_ap)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(__scn_ap),HL
	EX	DE,HL
	RET

; ------------------------------------------------------------
; _scn_nx: the next character inside the width, HL = -2 when the width is
; used up
; ------------------------------------------------------------
_scn_nx:
	LD	HL,(_scn_iw)
	BIT	7,H
	JR	NZ,_scn_nxe
	LD	A,H
	OR	L
	JR	Z,_scn_nxe
	DEC	HL
	LD	(_scn_iw),HL
	JR	__scn_gc
_scn_nxe:
	LD	HL,-2
	RET

; ------------------------------------------------------------
; _scn_int: read an integer.  A = the base (0: read the prefix).  The
; number goes into _scn_num (nb bytes).  Returns A = 1 for a number, 0 for
; a matching failure and 255 at the end of the input.
; ------------------------------------------------------------
_scn_int:
	LD	(_scn_base),A
	XOR	A
	LD	(_scn_neg),A
	LD	(_scn_any),A
	LD	HL,_scn_num
	LD	A,(_scn_nb)
	LD	B,A
_scn_i0:
	LD	(HL),0
	INC	HL
	DJNZ	_scn_i0
	LD	HL,(__scn_w)
	LD	A,H
	OR	L
	JR	NZ,_scn_i1
	LD	HL,32767
_scn_i1:
	LD	(_scn_iw),HL
	CALL	_scn_nx
	BIT	7,H
	JR	NZ,_scn_ieof
	LD	A,L
	CP	'-'
	JR	Z,_scn_sm
	CP	'+'
	JR	NZ,_scn_nsg
	JR	_scn_sg
_scn_sm:
	LD	A,1
	LD	(_scn_neg),A
_scn_sg:
	CALL	_scn_nx
_scn_nsg:
	; HL = the first character after the sign
	LD	A,H
	OR	A
	JR	NZ,_scn_nz
	LD	A,L
	CP	'0'
	JR	NZ,_scn_nz
	LD	A,(_scn_base)
	OR	A
	JR	Z,_scn_z
	CP	16
	JR	Z,_scn_z
	CP	2
	JR	NZ,_scn_nz
_scn_z:
	; a zero: a number already, and maybe a prefix 0x or 0b
	LD	A,1
	LD	(_scn_any),A
	CALL	_scn_nx
	BIT	7,H
	JR	NZ,_scn_oct
	LD	A,L
	OR	20H
	CP	'x'
	JR	NZ,_scn_tb
	LD	A,(_scn_base)
	CP	2
	JR	Z,_scn_oct
	LD	E,16
	JR	_scn_pre
_scn_tb:
	CP	'b'
	JR	NZ,_scn_oct
	LD	A,(_scn_base)
	CP	16
	JR	Z,_scn_oct
	LD	E,2
_scn_pre:
	LD	A,E
	LD	(_scn_nb2),A
	LD	(_scn_xc),HL
	CALL	_scn_nx
	BIT	7,H
	JR	NZ,_scn_pf
	LD	A,L
	PUSH	HL
	CALL	__sc_dv
	LD	HL,_scn_nb2
	CP	(HL)
	POP	HL
	JR	NC,_scn_pf
	LD	A,(_scn_nb2)
	LD	(_scn_base),A
	XOR	A
	LD	(_scn_any),A
	JR	_scn_digits
_scn_pf:
	; no digit after the prefix: the number is 0 and the letter stays
	CALL	__scn_ugc
	LD	HL,(_scn_xc)
	CALL	__scn_ugc
	LD	HL,-2
	JR	_scn_digits
_scn_oct:
	LD	A,(_scn_base)
	OR	A
	JR	NZ,_scn_digits
	LD	A,8
	LD	(_scn_base),A
	JR	_scn_digits
_scn_nz:
	LD	A,(_scn_base)
	OR	A
	JR	NZ,_scn_digits
	LD	A,10
	LD	(_scn_base),A
_scn_digits:
	BIT	7,H
	JR	NZ,_scn_dend
	LD	A,L
	CALL	__sc_dv
	LD	D,A
	LD	A,(_scn_base)
	LD	C,A
	LD	A,D
	CP	C
	JR	NC,_scn_dend
	LD	A,1
	LD	(_scn_any),A
	LD	A,(_scn_nb)
	LD	B,A
	LD	HL,_scn_num
	LD	A,D
	CALL	__sc_muladd
	CALL	_scn_nx
	JR	_scn_digits
_scn_dend:
	CALL	__scn_ugc
	LD	A,(_scn_any)
	OR	A
	RET	Z
	LD	A,(_scn_neg)
	OR	A
	JR	Z,_scn_iok
	LD	A,(_scn_nb)
	LD	B,A
	LD	HL,_scn_num
	CALL	__sc_negate
_scn_iok:
	LD	A,1
	RET
_scn_ieof:
	LD	A,0FFH
	RET

; ------------------------------------------------------------
; int _scan_run(struct sc *in, const char *fmt, char *ap)
; ------------------------------------------------------------
__scan_run:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_scn_in),HL
	LD	DE,8
	ADD	HL,DE
	XOR	A
	LD	(HL),A
	INC	HL
	LD	(HL),A
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	(__scn_f),HL
	LD	L,(IX+8)
	LD	H,(IX+9)
	LD	(__scn_ap),HL
	LD	HL,0
	LD	(_scn_done),HL
_scn_next:
	LD	HL,(__scn_f)
	LD	A,(HL)
	INC	HL
	LD	(__scn_f),HL
	OR	A
	JP	Z,_scn_end
	CALL	__scn_sp
	JR	NC,_scn_nws
	CALL	__scn_skipws
	JR	_scn_next
_scn_nws:
	CP	'%'
	JR	Z,_scn_pct
	; a character of the format must match the input
	LD	(_scn_lit),A
	CALL	__scn_gc
	BIT	7,H
	JP	NZ,_scn_fail
	LD	A,(_scn_lit)
	CP	L
	JR	Z,_scn_next
	CALL	__scn_ugc
	JP	_scn_end
_scn_pct:
	; %[*][width][length]conversion
	XOR	A
	LD	(__scn_skip),A
	LD	(_scn_mod),A
	LD	HL,(__scn_f)
	LD	A,(HL)
	CP	'*'
	JR	NZ,_scn_nstar
	LD	(__scn_skip),A
	INC	HL
_scn_nstar:
	LD	DE,0
_scn_wd:
	LD	A,(HL)
	SUB	'0'
	CP	10
	JR	NC,_scn_wend
	LD	C,A
	PUSH	HL
	EX	DE,HL
	LD	D,H
	LD	E,L
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,DE
	ADD	HL,HL
	LD	E,C
	LD	D,0
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	INC	HL
	JR	_scn_wd
_scn_wend:
	LD	(__scn_w),DE
_scn_ml:
	LD	A,(HL)
	LD	DE,_scn_mod
	CP	'h'
	JR	NZ,_scn_ml1
	LD	A,(DE)
	CP	2
	LD	A,1
	JR	Z,_scn_mset
	LD	A,2
	JR	_scn_mset
_scn_ml1:
	CP	'l'
	JR	NZ,_scn_ml2
	LD	A,(DE)
	CP	3
	LD	A,4
	JR	Z,_scn_mset
	LD	A,3
	JR	_scn_mset
_scn_ml2:
	LD	B,5
	CP	'j'
	JR	Z,_scn_mb
	INC	B
	CP	'z'
	JR	Z,_scn_mb
	INC	B
	CP	't'
	JR	Z,_scn_mb
	INC	B
	CP	'L'
	JR	Z,_scn_mb
	CP	'q'
	JR	NZ,_scn_mend
_scn_mb:
	LD	A,B
_scn_mset:
	LD	(DE),A
	INC	HL
	JR	_scn_ml
_scn_mend:
	; A = the conversion character
	OR	A
	JP	Z,_scn_end
	INC	HL
	LD	(__scn_f),HL
	LD	(_scn_conv),A
	LD	A,(_scn_mod)
	LD	E,A
	LD	D,0
	LD	HL,_scn_size
	ADD	HL,DE
	LD	A,(HL)
	LD	(_scn_nb),A
	LD	A,(_scn_conv)
	CP	'%'
	JR	NZ,_scn_c1
	CALL	__scn_skipws
	JP	C,_scn_fail
	CALL	__scn_gc
	LD	A,L
	CP	'%'
	JR	NZ,_scn_pbad
	BIT	7,H
	JP	Z,_scn_next
_scn_pbad:
	CALL	__scn_ugc
	JP	_scn_end
_scn_c1:
	CP	'n'
	JR	NZ,_scn_c2
	LD	A,(__scn_skip)
	OR	A
	JP	NZ,_scn_next
	CALL	__scn_arg
	EX	DE,HL
	LD	HL,(_scn_in)
	LD	BC,8
	ADD	HL,BC
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	EX	DE,HL
	LD	A,(_scn_nb)
	LD	D,A
	LD	(HL),C
	INC	HL
	DEC	D
	JP	Z,_scn_next
	LD	(HL),B
	INC	HL
	DEC	D
	JP	Z,_scn_next
_scn_nz1:
	LD	(HL),0
	INC	HL
	DEC	D
	JR	NZ,_scn_nz1
	JP	_scn_next
_scn_c2:
	CP	'c'
	JR	Z,_scn_txt
	CP	's'
	JR	Z,_scn_txt
	CP	'['
	JR	NZ,_scn_c3
_scn_txt:
	CALL	__sc_text
	; 0: stop, 1: go on, 2: end of the input, 3: assigned
	OR	A
	JP	Z,_scn_end
	DEC	A
	JP	Z,_scn_next
	DEC	A
	JP	Z,_scn_fail
	JR	_scn_inc
_scn_c3:
	; the other conversions skip white space first
	CALL	__scn_skipws
	JP	C,_scn_fail
	LD	A,(_scn_conv)
	LD	HL,_scn_ic
	LD	BC,8
	CPIR
	JR	NZ,_scn_c4
	LD	DE,7
	ADD	HL,DE
	LD	A,(HL)		; the base
	LD	B,A
	LD	A,(_scn_conv)
	CP	'p'
	JR	NZ,_scn_c3a
	LD	A,2
	LD	(_scn_nb),A
_scn_c3a:
	LD	A,B
	CALL	_scn_int
	OR	A
	JP	Z,_scn_end
	INC	A
	JP	Z,_scn_fail
	LD	A,(__scn_skip)
	OR	A
	JP	NZ,_scn_next
	CALL	__scn_arg
	EX	DE,HL
	LD	HL,_scn_num
	LD	A,(_scn_nb)
	LD	C,A
	LD	B,0
	LDIR
	JR	_scn_inc
_scn_c4:
	LD	A,(_scn_conv)
	LD	HL,_scn_fc
	LD	BC,8
	CPIR
	JP	NZ,_scn_end
	LD	HL,0
	LD	A,(__scn_skip)
	OR	A
	CALL	Z,__scn_arg
	PUSH	HL
	LD	HL,(__scn_w)
	PUSH	HL
	LD	HL,(_scn_in)
	PUSH	HL
	CALL	__sc_float
	POP	DE
	POP	DE
	POP	DE
	BIT	7,H
	JR	NZ,_scn_fail
	LD	A,H
	OR	L
	JR	Z,_scn_end
	LD	A,(__scn_skip)
	OR	A
	JP	NZ,_scn_next
_scn_inc:
	LD	HL,(_scn_done)
	INC	HL
	LD	(_scn_done),HL
	JP	_scn_next
_scn_fail:
	LD	HL,(_scn_done)
	LD	A,H
	OR	L
	JR	NZ,_scn_ret
	LD	HL,-1
	JR	_scn_ret
_scn_end:
	LD	HL,(_scn_done)
_scn_ret:
	POP	IX
	RET

; the size of the target for the length modifiers: none, hh, h, l, ll, j,
; z, t, L
_scn_size:
	DB	2,1,2,4,8,8,2,2,8
; the integer conversions, and the base of each (0: read the prefix)
_scn_ic:
	DB	'duoxXpib'
	DB	10,10,8,16,16,16,0,2
_scn_fc:
	DB	'feEgGaAF'

	COMMON	/lc_scan_core/
_scn_in:
	DS	2
	PUBLIC	__scn_ap
__scn_ap:
	DS	2
	PUBLIC	__scn_f
__scn_f:
	DS	2
	PUBLIC	__scn_w
__scn_w:
	DS	2
	PUBLIC	__scn_skip
__scn_skip:
	DS	1
_scn_done:
	DS	2
_scn_iw:
	DS	2
_scn_xc:
	DS	2
_scn_num:
	DS	8
_scn_mod:
	DS	1
_scn_conv:
	DS	1
_scn_nb:
	DS	1
_scn_nb2:
	DS	1
_scn_base:
	DS	1
_scn_neg:
	DS	1
_scn_any:
	DS	1
_scn_lit:
	DS	1

; ---- BEGIN work-area save helpers (gen_wa_helpers.py) ----
	CSEG
	PUBLIC	__wasv_lc_scan_core
	PUBLIC	__wars_lc_scan_core
__wasv_lc_scan_core:
	POP	IY
	LD	HL,-31
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL
	LD	HL,_scn_in
	LD	BC,31
	LDIR
	JP	(IY)
__wars_lc_scan_core:
	POP	IY
	LD	HL,0
	ADD	HL,SP
	LD	DE,_scn_in
	LD	BC,31
	LDIR
	LD	SP,HL
	JP	(IY)
; ---- END work-area save helpers ----

	END
