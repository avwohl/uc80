; lc_logb.mac - _logb, _logbf
; Split from lc_logb.mac

	.Z80

	EXTRN	__itof

	CSEG
; ============================================================
; logb(x) - return exponent as float
; ============================================================
	PUBLIC	_logb
_logb:
	PUBLIC	_logbf
_logbf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	; Extract exponent
	LD	A,(IX+7)	; D byte (SEEEEEEE)
	AND	7FH		; Strip sign (0EEEEEEE)
	ADD	A,A		; Shift left (EEEEEEE0)
	LD	B,A
	LD	A,(IX+6)	; E byte (EMMMMMMM)
	RLCA			; Rotate - exp low bit into bit 0
	AND	1		; Isolate exp low bit
	OR	B		; A = biased exponent

	; Check zero
	OR	A
	JR	Z,_logb_zero

	; Check inf/nan
	CP	255
	JR	Z,_logb_inf

	; Normal: convert (exp - 127) to float
	SUB	127
	LD	L,A
	RLA
	SBC	A,A		; Sign extend
	LD	H,A
	LD	D,A
	LD	E,A		; DEHL = 32-bit signed
	CALL	__itof
	POP	IX
	RET

_logb_zero:
	; Check subnormal
	LD	A,(IX+6)
	AND	7FH
	OR	(IX+5)
	OR	(IX+4)
	JR	NZ,_logb_sub
	; True zero: return -inf
	LD	HL,0
	LD	DE,0FF80H
	POP	IX
	RET

_logb_sub:
	; Subnormal: return -126 as float
	LD	HL,0FF82H	; -126 as 16-bit
	LD	DE,0FFFFH	; Sign extend to 32-bit
	CALL	__itof
	POP	IX
	RET

_logb_inf:
	; Return +inf
	LD	HL,0
	LD	DE,7F80H
	POP	IX
	RET

	END
