; lc_islower.mac - split from lc_ctype.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	CSEG

; int islower(int c)
	PUBLIC	_islower
_islower:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	A,(IX+4)
	CP	'a'
	JR	C,_islower_no
	CP	'z'+1
	JR	NC,_islower_no
	LD	HL,1
	POP	IX
	RET
_islower_no:
	LD	HL,0
	POP	IX
	RET

	END
