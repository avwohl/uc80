; lc_isnan.mac - _isnan
; Split from lc_fpclassify.mac

	.Z80

	CSEG
; ============================================================
; isnan(x) - return nonzero if NaN
; ============================================================
	PUBLIC	_isnan
_isnan:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	LD	A,(IX+7)	; D byte (SEEEEEEE)
	AND	7FH		; Strip sign (0EEEEEEE)
	ADD	A,A		; Shift left (EEEEEEE0)
	LD	B,A
	LD	A,(IX+6)	; E byte (EMMMMMMM)
	RLCA			; Rotate - exp low bit into bit 0
	AND	1		; Isolate exp low bit
	OR	B		; A = 8-bit biased exponent
	CP	255
	JR	NZ,_isnan_z	; exp != 255, not nan
	; Check mantissa != 0
	LD	A,(IX+6)
	AND	7FH
	OR	(IX+5)
	OR	(IX+4)
	JR	Z,_isnan_z	; mantissa 0 = inf, not nan
	LD	HL,1
	POP	IX
	RET
_isnan_z:
	LD	HL,0
	POP	IX
	RET

	END
