; lc_scalbn.mac - scalbn and ldexp: x * 2^n
;
; double scalbn(double x, int n)
; The entry limits n to -600 to 600 and calls __sbn_core (lc_vm_ldexp).
	.Z80

	CSEG

	EXTRN	__sbn_core

	PUBLIC	_scalbn
	PUBLIC	_scalbnf
	PUBLIC	_scalbnl
	PUBLIC	_ldexp
	PUBLIC	_ldexpf
	PUBLIC	_ldexpl

_scalbn:
_scalbnf:
_scalbnl:
_ldexp:
_ldexpf:
_ldexpl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	C,(IX+8)
	LD	B,(IX+9)
	LD	A,B
	LD	HL,600
	ADD	HL,BC
	LD	DE,1201
	OR	A
	SBC	HL,DE
	JR	C,_sbn_ok	; -600 <= n <= 600
	LD	BC,600
	OR	A
	JP	P,_sbn_ok
	LD	BC,-600
_sbn_ok:
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	E,(IX+6)
	LD	D,(IX+7)
	CALL	__sbn_core
	POP	IX
	RET

	END
