; lc_scalbn.mac - scalbn and ldexp: x * 2^n
;
; double scalbn(double x, int n)
; An infinity, a NaN and a zero are the result.  When the exponent of x and
; the new exponent are both from 1 to 254, the routine only changes the
; exponent field.  Else (a subnormal x, an overflow or an underflow) it
; unpacks x, adds n (from -600 to 600) to the exponent and packs the
; result, which rounds a subnormal result to nearest even.
;
; __vm_ldexp is the routine of the float interpreter (see lc_vm.mac):
; DEHL = x, (__tmp32) = n as a float.  It keeps BC and IX.
	.Z80

	CSEG

	EXTRN	__m_unpack
	EXTRN	__m_pack
	EXTRN	__ftoi
	EXTRN	__tmp32

	PUBLIC	_scalbn
	PUBLIC	_scalbnf
	PUBLIC	_scalbnl
	PUBLIC	_ldexp
	PUBLIC	_ldexpf
	PUBLIC	_ldexpl
	PUBLIC	__vm_ldexp

_scalbn:
_scalbnf:
_scalbnl:
_ldexp:
_ldexpf:
_ldexpl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	E,(IX+6)
	LD	D,(IX+7)
	LD	C,(IX+8)
	LD	B,(IX+9)
	CALL	_sbn_core
	POP	IX
	RET

__vm_ldexp:
	PUSH	BC
	PUSH	HL
	PUSH	DE
	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__ftoi
	LD	B,H
	LD	C,L
	POP	DE
	POP	HL
	CALL	_sbn_core
	POP	BC
	RET

; DEHL = x, BC = n.  Result in DEHL.  Changes AF and BC.
_sbn_core:
	LD	A,E
	RLA
	LD	A,D
	RLA			; A = the biased exponent
	CP	255
	RET	Z		; an infinity or a NaN
	OR	A
	JR	NZ,_sbn_norm
	LD	A,E		; exponent 0: a zero, or a subnormal x
	AND	7FH
	OR	H
	OR	L
	RET	Z
	JR	_sbn_slow
_sbn_norm:
	PUSH	HL
	LD	L,A
	LD	H,0
	ADD	HL,BC		; HL = the new exponent
	LD	A,H
	OR	A
	JR	NZ,_sbn_bad
	LD	A,L
	DEC	A
	CP	254
	JR	NC,_sbn_bad	; not from 1 to 254
	LD	B,L		; B = the new exponent
	POP	HL
	LD	A,B
	SRL	A
	LD	C,A
	LD	A,D
	AND	80H
	OR	C
	LD	D,A
	RES	7,E
	BIT	0,B
	RET	Z
	SET	7,E
	RET
_sbn_bad:
	POP	HL
_sbn_slow:
	; clamp n to -600..600
	PUSH	HL
	PUSH	DE
	LD	A,B
	LD	HL,600
	ADD	HL,BC
	LD	DE,1201
	OR	A
	SBC	HL,DE
	JR	C,_sbn_ok
	LD	BC,600
	OR	A
	JP	P,_sbn_ok
	LD	BC,-600
_sbn_ok:
	POP	DE
	POP	HL
	LD	(_sbn_n),BC
	LD	(_sbn_x),HL
	LD	(_sbn_x+2),DE
	LD	HL,_sbn_e
	PUSH	HL
	PUSH	DE
	LD	HL,(_sbn_x)
	PUSH	HL
	CALL	__m_unpack	; DEHL = the mantissa
	POP	BC
	POP	BC
	POP	BC
	LD	BC,(_sbn_e)
	PUSH	HL
	LD	HL,(_sbn_n)
	ADD	HL,BC
	LD	B,H
	LD	C,L
	POP	HL
	PUSH	BC		; e + n
	PUSH	DE
	PUSH	HL		; the mantissa
	LD	A,(_sbn_x+3)
	RLCA
	AND	1
	LD	L,A
	LD	H,0
	PUSH	HL		; the sign
	CALL	__m_pack
	POP	BC
	POP	BC
	POP	BC
	POP	BC
	RET

	COMMON	/lc_scalbn/
_sbn_n:
	DS	2
_sbn_x:
	DS	4
_sbn_e:
	DS	2

	END
