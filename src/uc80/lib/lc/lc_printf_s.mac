; lc_printf_s.mac - printf %s handler
	.Z80

	EXTRN	_printf_putc
	EXTRN	_printf_loop
	EXTRN	_printf_hasprec
	EXTRN	_printf_prec
	EXTRN	_printf_width
	EXTRN	_printf_left
	EXTRN	_printf_padw

	CSEG

	PUBLIC	__printf_handle_s
__printf_handle_s:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = string pointer

	LD	HL,0
	LD	(_phs_pad),HL
	LD	HL,(_printf_width)
	LD	A,H
	OR	L
	JR	Z,_phs_print	; no field width: nothing to count

	; Count the characters that will be printed, but never more than
	; the width: BC = min(width, precision if any).
	LD	B,H
	LD	C,L
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_cnt
	LD	HL,(_printf_prec)
	OR	A
	SBC	HL,BC
	JR	NC,_phs_cnt	; precision >= width: the limit is the width
	LD	BC,(_printf_prec)
_phs_cnt:
	LD	H,D
	LD	L,E
	PUSH	BC		; the limit
_phs_c1:
	LD	A,B
	OR	C
	JR	Z,_phs_cd
	LD	A,(HL)
	OR	A
	JR	Z,_phs_cd
	INC	HL
	DEC	BC
	JR	_phs_c1
_phs_cd:
	POP	HL
	OR	A
	SBC	HL,BC		; HL = the characters that will be printed
	LD	B,H
	LD	C,L
	LD	HL,(_printf_width)
	OR	A
	SBC	HL,BC		; padding = width - printed characters
	LD	(_phs_pad),HL
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_phs_print
	PUSH	DE
	LD	E,' '
	CALL	_printf_padw
	POP	DE

_phs_print:
	; Load precision limit into BC
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_nop
	LD	BC,(_printf_prec)
	JR	_phs_loop
_phs_nop:
	LD	BC,0

_phs_loop:
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_nolim
	LD	A,B
	OR	C
	JR	Z,_phs_done
	DEC	BC
_phs_nolim:
	LD	A,(DE)
	OR	A
	JR	Z,_phs_done
	PUSH	DE
	PUSH	BC
	LD	E,A
	CALL	_printf_putc
	POP	BC
	POP	DE
	INC	DE
	JR	_phs_loop

_phs_done:
	LD	A,(_printf_left)
	OR	A
	JR	Z,_phs_ret
	LD	HL,(_phs_pad)
	LD	E,' '
	CALL	_printf_padw
_phs_ret:
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

	COMMON	/lc_printf_s/
	PUBLIC	__wa_lc_printf_s	;!
__wa_lc_printf_s:	;!
_phs_pad:	DS	2

	END
