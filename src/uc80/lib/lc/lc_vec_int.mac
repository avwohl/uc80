; lc_vec_int.mac - default handler of the INT vector (38h): enable interrupts and return
; The label __int_handler is the target of a vector in crt0_rom_vec.mac.  A module
; of the program that binds the vector defines the label itself; the linker
; takes this module of the library only when no module does.  See
; docs/rom_hardware.md.

	.Z80

	CSEG
	PUBLIC	__int_handler
__int_handler:
	EI
	RETI

	END
