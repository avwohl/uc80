; lc_clearerr.mac - split from lc_file.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9
FLAG_EOF	EQU	02H
FLAG_ERROR	EQU	04H

	CSEG

; ============================================================
; void clearerr(FILE *stream)
; Clear error and EOF flags
; ============================================================
	PUBLIC	_clearerr
_clearerr:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	A,H
	OR	L
	JR	Z,_clearerr_ret
	INC	HL		; flags
	LD	A,(HL)
	AND	0FFH - FLAG_EOF - FLAG_ERROR
	LD	(HL),A
_clearerr_ret:
	POP	IX
	RET

	END
