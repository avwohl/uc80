; lc_fputc.mac - split from lc_file.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9
FILE_BUFPOS	EQU	3	; Current position in buffer
FILE_FCB	EQU	6	; FCB starts here (36 bytes)
FILE_RECNO	EQU	39	; r0 r1 of the FCB: the number of the record in the buffer
FILE_BUFFER	EQU	42	; Buffer starts here (128 bytes)

	EXTRN	__conout

	EXTRN	_fflush_internal
	EXTRN	_file_towrite
	EXTRN	_file_loadrec

	CSEG

; ============================================================
; int fputc(int c, FILE *stream)
; Put character to stream
; ============================================================
	PUBLIC	_fputc
_fputc:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = stream

	; Check for NULL
	LD	A,H
	OR	L
	JP	Z,_fputc_err

	; Check if stdout/stderr
	LD	A,(HL)
	CP	3
	JR	NC,_fputc_file

	; Console output.  Only this branch translates LF -> CR LF; the
	; _fputc_file branch below writes raw bytes, so "w" and "wb"
	; streams both stay byte-for-byte what the program handed us.
	LD	E,(IX+4)
	CALL	__conout
	LD	L,(IX+4)
	LD	H,0
	JP	_fputc_ret

_fputc_file:
	; A stream in the reading state (r+, or a+ after a read) goes to the
	; writing state first; a stream that cannot write fails here.
	INC	HL
	BIT	3,(HL)
	DEC	HL
	JR	NZ,_fputc_ready
	PUSH	HL
	CALL	_file_towrite
	POP	HL
	JR	NZ,_fputc_err
_fputc_ready:
	PUSH	HL		; the FILE* stays on the stack
	LD	DE,FILE_BUFPOS
	ADD	HL,DE
	LD	A,(HL)		; A = bufpos
	CP	128
	JR	C,_fputc_store

	; Buffer full - write the record and start the next one
	POP	HL
	PUSH	HL
	CALL	_fflush_internal
	LD	A,H
	OR	L
	JR	NZ,_fputc_flerr
	POP	HL
	PUSH	HL
	CALL	_file_nextrec
	XOR	A		; bufpos = 0

_fputc_store:
	; A = bufpos.  Store the byte in the buffer.
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	LD	E,A
	LD	D,0
	ADD	HL,DE		; HL = buffer[bufpos]
	LD	A,(IX+4)
	LD	(HL),A		; Store the byte

	; The buffer now differs from the file (flag bit 7).  Increment
	; bufpos.  bufcnt is the number of bytes of the record that are
	; valid (the high water mark), so a flush pads only after them.
	POP	HL
	PUSH	HL
	INC	HL
	SET	7,(HL)
	INC	HL
	INC	HL		; bufpos
	INC	(HL)		; bufpos++
	LD	A,(HL)
	INC	HL
	CP	(HL)
	JR	C,_fputc_hw
	LD	(HL),A		; bufcnt = bufpos
_fputc_hw:

	POP	HL
	LD	L,(IX+4)
	LD	H,0
	JP	_fputc_ret

_fputc_flerr:
	POP	HL
_fputc_err:
	LD	HL,-1
_fputc_ret:
	POP	DE
	POP	BC
	POP	IX
	RET

; ============================================================
; Internal: start the next record.  HL = FILE*
; ============================================================
	PUBLIC	_file_nextrec
_file_nextrec:
	PUSH	HL
	LD	DE,FILE_BUFPOS
	ADD	HL,DE
	XOR	A
	LD	(HL),A		; bufpos = 0
	INC	HL
	LD	(HL),A		; bufcnt = 0
	POP	HL
	PUSH	HL
	LD	DE,FILE_RECNO
	ADD	HL,DE
	INC	(HL)
	JR	NZ,_nextrec_ld
	INC	HL
	INC	(HL)
_nextrec_ld:
	; A stream that can also read, or that fseek moved (byte 5 is not 0),
	; keeps the bytes that the next record already has, so a write into
	; it changes only the bytes written.
	POP	HL
	PUSH	HL
	INC	HL
	BIT	4,(HL)
	POP	HL
	JP	NZ,_file_loadrec
	PUSH	HL
	LD	DE,5
	ADD	HL,DE
	LD	A,(HL)
	POP	HL
	OR	A
	RET	Z
	JP	_file_loadrec

	END
