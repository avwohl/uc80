; lc_printf_o.mac - printf %o handler (unsigned int octal)
	.Z80

	EXTRN	_printf_loop
	EXTRN	_printf_alt
	EXTRN	_printf_decbuf
	EXTRN	_printf_dstart
	EXTRN	_printf_dcnt
	EXTRN	_printf_numout

	CSEG

	PUBLIC	__printf_handle_o
__printf_handle_o:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL		; HL = value
	PUSH	IX
	PUSH	BC
	LD	B,0
	LD	IX,_printf_decbuf+24
_pho_cvt:
	LD	A,L
	AND	07h		; remainder = value & 7
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	; Shift HL right by 3 (divide by 8)
	SRL	H
	RR	L
	SRL	H
	RR	L
	SRL	H
	RR	L
	LD	A,H
	OR	L
	JR	NZ,_pho_cvt
	; Alternative form (# flag): C 7.21.6.1 para 6 says force the first
	; digit to be '0'.  Value 0 already gives "0".
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_pho_set
	LD	A,(IX+0)
	CP	'0'
	JR	Z,_pho_set
	DEC	IX
	LD	(IX+0),'0'
	INC	B
_pho_set:
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	BC
	POP	IX
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

	END
