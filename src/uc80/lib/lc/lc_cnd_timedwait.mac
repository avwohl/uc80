; lc_cnd_timedwait.mac - _cnd_timedwait
; Split from lc_thread.mac

	.Z80

	EXTRN	_mtx_lock
	EXTRN	_mtx_unlock
	EXTRN	_thrd_yield

	CSEG
; int cnd_timedwait(cnd_t *cond, mtx_t *mtx, const struct timespec *ts)
	PUBLIC	_cnd_timedwait
_cnd_timedwait:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	; Unlock mutex
	LD	L,(IX+6)
	LD	H,(IX+7)
	PUSH	HL
	CALL	_mtx_unlock
	POP	BC

	; Try a few times
	LD	B,100
	LD	L,(IX+4)
	LD	H,(IX+5)
	INC	HL

_cnd_timed_loop:
	DI
	LD	A,(HL)
	OR	A
	JR	NZ,_cnd_timed_done
	EI
	PUSH	HL
	PUSH	BC
	CALL	_thrd_yield
	POP	BC
	POP	HL
	DJNZ	_cnd_timed_loop

	; Timeout
	LD	L,(IX+6)
	LD	H,(IX+7)
	PUSH	HL
	CALL	_mtx_lock
	POP	BC
	LD	HL,2		; thrd_timedout
	JR	_cnd_timed_ret

_cnd_timed_done:
	XOR	A
	LD	(HL),A
	EI
	LD	L,(IX+6)
	LD	H,(IX+7)
	PUSH	HL
	CALL	_mtx_lock
	POP	BC
	LD	HL,0

_cnd_timed_ret:
	POP	BC
	POP	IX
	RET

	END
