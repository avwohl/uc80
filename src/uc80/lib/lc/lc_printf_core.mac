; lc_printf_core.mac - printf core dispatcher
; Table-driven printf: searches __printf_format_table for format handlers
;
; Handler calling convention:
;   Entry: HL = format string ptr (past the specifier char)
;          C  = arg offset byte (relative to IX frame)
;          IX = caller's frame pointer
;   State: _printf_width, _printf_zero, _printf_prec, _printf_hasprec,
;          _printf_upper available via EXTRN
;   Exit:  JP _printf_loop with HL = next format position, C = updated arg offset
;
; The format table is an array of (DB char, DW handler_addr) entries
; terminated by DB 0. It is defined by the codegen (in the user's .mac file)
; when compiling main(), or defaults to a full table.

	.Z80

; CP/M BDOS function numbers
BDOS	EQU	5
CONOUT	EQU	2

	EXTRN	__printf_format_table
	EXTRN	__conout

	CSEG

	PUBLIC	_printf
	PUBLIC	_printf_loop
	PUBLIC	_printf_done
	PUBLIC	_printf_format
	PUBLIC	_printf_unk_echo
	PUBLIC	_printf_prt_hex
	PUBLIC	_printf_nib2a
	PUBLIC	_printf_width
	PUBLIC	_printf_zero
	PUBLIC	_printf_upper
	PUBLIC	_printf_prec
	PUBLIC	_printf_hasprec
	PUBLIC	_printf_alt
	PUBLIC	_printf_neg
	PUBLIC	_printf_hexbuf
	PUBLIC	_printf_decbuf
	PUBLIC	_printf_dptr
	PUBLIC	_printf_dstart
	PUBLIC	_printf_dcnt
	PUBLIC	_printf_ll_w0
	PUBLIC	_printf_ll_w1
	PUBLIC	_printf_ll_w2
	PUBLIC	_printf_ll_w3
	PUBLIC	_prt_float_prec
	PUBLIC	_prt_float
	PUBLIC	_printf_putc
	PUBLIC	_printf_count
	PUBLIC	__ftmp

; ============================================================
; _printf_putc: output the char in E to CONOUT and bump
; ``_printf_count`` so the printf-family functions can return the
; number of bytes written. All format handlers (lc_printf_*.mac)
; route their output through this helper. Preserves every
; register the caller might depend on.
; ============================================================
_printf_putc:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	__conout	; the only console write in printf land
	LD	HL,(_printf_count)
	INC	HL
	LD	(_printf_count),HL
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

_printf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Reset byte counter for return value (C 7.21.6.3).
	LD	HL,0
	LD	(_printf_count),HL

	; fmt is at IX+4, first vararg at IX+6
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = format string pointer
	LD	C,6		; C = offset to next argument

_printf_loop:
	LD	A,(HL)
	OR	A
	JR	Z,_printf_done

	CP	'%'
	JR	Z,_printf_format

	; Regular character - output it
	LD	E,A
	PUSH	HL
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	JR	_printf_loop

_printf_format:
	INC	HL
	; Remember where the conversion specification starts (the first byte
	; after the '%') so _printf_unknown can echo it verbatim.
	LD	(_printf_fmtstart),HL
	; Initialize format state
	XOR	A
	LD	(_printf_width),A
	LD	(_printf_zero),A
	LD	(_printf_upper),A
	LD	(_printf_prec),A
	LD	(_printf_hasprec),A
	LD	(_printf_alt),A
	LD	A,(HL)
	OR	A
	JP	Z,_printf_done

	CP	'%'
	JR	Z,_printf_pct

_printf_fmt2:
	; Check for '0' flag (only when not in precision and width is 0)
	CP	'0'
	JR	NZ,_printf_not0
	PUSH	AF
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_printf_0dig
	LD	A,(_printf_width)
	OR	A
	JR	NZ,_printf_0dig
	; Set zero-padding flag
	LD	A,1
	LD	(_printf_zero),A
	POP	AF
	JR	_printf_skip
_printf_0dig:
	POP	AF
	JR	_printf_isdig

_printf_not0:
	; Check for precision start
	CP	'.'
	JR	NZ,_printf_notdot
	PUSH	AF
	LD	A,1
	LD	(_printf_hasprec),A
	POP	AF
	JR	_printf_skip

_printf_notdot:
	; Skip other flags: -, +, space, #
	CP	'-'
	JR	Z,_printf_skip
	CP	'+'
	JR	Z,_printf_skip
	CP	' '
	JR	Z,_printf_skip
	CP	'#'
	JR	NZ,_printf_not_alt
	PUSH	AF
	LD	A,1
	LD	(_printf_alt),A
	POP	AF
	JR	_printf_skip
_printf_not_alt:
	; Check for digits (1-9)
	CP	'1'
	JR	C,_printf_nodig
	CP	'9'+1
	JR	C,_printf_isdig
_printf_nodig:
	; Skip length modifiers: h, z, L
	CP	'h'
	JR	Z,_printf_skip
	CP	'z'
	JR	Z,_printf_skip
	CP	'L'
	JR	Z,_printf_skip

	; === DISPATCH: search __printf_format_table ===
	PUSH	HL		; Save format string position
	PUSH	BC		; Save arg offset
	LD	B,A		; B = format char to find
	LD	HL,__printf_format_table
_printf_search:
	LD	A,(HL)
	OR	A
	JR	Z,_printf_unknown	; End of table, char not found
	CP	B
	JR	Z,_printf_found
	INC	HL		; Skip handler address
	INC	HL
	INC	HL		; Next entry
	JR	_printf_search

_printf_found:
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = handler address
	POP	BC		; Restore arg offset
	POP	HL		; Restore format string ptr
	INC	HL		; Past the specifier char
	PUSH	DE
	RET			; Tail-call handler (JP DE)

_printf_unknown:
	POP	BC		; arg offset - deliberately NOT advanced
	POP	HL		; HL -> the offending conversion char
	INC	HL
	; fall into _printf_unk_echo

; ============================================================
; _printf_unk_echo: echo the conversion specification verbatim.
;
; C23 7.23.6.1p9 makes an invalid conversion specification undefined
; behaviour, so we may choose what to do.  Printing nothing is the worst
; option available: it is invisible AND it silently truncates the output.
; Echo the whole specification instead ("%q", "%.3q", "%ls", ...) so the
; failure is VISIBLE.
;
; LIMITATION, on purpose: this does NOT resync the varargs.  Only a
; handler advances C, and no handler ran, so every later conversion in
; this same printf call still reads the wrong argument.  There is no
; portable way to know an unknown conversion's argument size.  The
; compiler warns about this at compile time whenever the format string is
; a literal; the echo is the safety net for the non-literal case, which
; the compiler cannot see.
;
; Entry: HL -> one byte PAST the offending conversion character
;        _printf_fmtstart -> first byte after the '%'
; Exit:  jumps to _printf_loop with HL unchanged.
; ============================================================
_printf_unk_echo:
	LD	E,'%'
	CALL	_printf_putc	; preserves AF, BC, DE, HL
	LD	DE,(_printf_fmtstart)
_printf_unk_lp:
	LD	A,D		; done once DE has walked up to HL
	CP	H
	JR	NZ,_printf_unk_go
	LD	A,E
	CP	L
	JP	Z,_printf_loop
_printf_unk_go:
	LD	A,(DE)
	PUSH	DE
	LD	E,A
	CALL	_printf_putc
	POP	DE
	INC	DE
	JR	_printf_unk_lp

_printf_isdig:
	; Parse digit into width or precision
	SUB	'0'
	PUSH	BC
	LD	B,A		; B = new digit
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_printf_precdig
	; Width digit
	LD	A,(_printf_width)
	LD	C,A
	ADD	A,A		; *2
	ADD	A,A		; *4
	ADD	A,C		; *5
	ADD	A,A		; *10
	ADD	A,B		; + digit
	LD	(_printf_width),A
	POP	BC
	JR	_printf_skip
_printf_precdig:
	; Precision digit
	LD	A,(_printf_prec)
	LD	C,A
	ADD	A,A
	ADD	A,A
	ADD	A,C
	ADD	A,A
	ADD	A,B
	LD	(_printf_prec),A
	POP	BC
	; Fall through to _printf_skip

_printf_skip:
	INC	HL
	LD	A,(HL)
	OR	A
	JP	Z,_printf_done
	JR	_printf_fmt2

_printf_pct:
	; Output literal %
	LD	E,'%'
	PUSH	HL
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	JR	_printf_loop

_printf_done:
	LD	HL,(_printf_count)	; Return count of bytes written
	POP	DE
	POP	BC
	POP	IX
	RET

; ============================================================
; Printf hex with width/zero-padding/uppercase support
; Input: HL = value to print
; ============================================================
_printf_prt_hex:
	PUSH	BC
	; Convert 4 hex nibbles to ASCII in buffer
	LD	DE,_printf_hexbuf
	LD	A,H
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_printf_nib2a
	LD	A,H
	AND	0FH
	CALL	_printf_nib2a
	LD	A,L
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_printf_nib2a
	LD	A,L
	AND	0FH
	CALL	_printf_nib2a
	; Buffer has 4 ASCII hex chars
	; Find first significant digit (skip leading '0' but keep last)
	LD	HL,_printf_hexbuf
	LD	B,4
_printf_hx_lz:
	LD	A,B
	CP	1
	JR	Z,_printf_hx_pad
	LD	A,(HL)
	CP	'0'
	JR	NZ,_printf_hx_pad
	INC	HL
	DEC	B
	JR	_printf_hx_lz
_printf_hx_pad:
	; B = significant digits, HL = pointer to first
	LD	A,(_printf_width)
	OR	A
	JR	Z,_printf_hx_out
	SUB	B
	JR	Z,_printf_hx_out
	JR	C,_printf_hx_out
	PUSH	HL
	PUSH	BC
	LD	B,A
	LD	A,(_printf_zero)
	OR	A
	LD	A,' '
	JR	Z,_printf_hx_plp
	LD	A,'0'
_printf_hx_plp:
	LD	E,A
	PUSH	AF
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	AF
	DJNZ	_printf_hx_plp
	POP	BC
	POP	HL
_printf_hx_out:
	LD	A,(HL)
	LD	E,A
	PUSH	BC
	PUSH	HL
	CALL	_printf_putc
	POP	HL
	POP	BC
	INC	HL
	DJNZ	_printf_hx_out
	POP	BC
	RET

; Convert nibble (0-15) in A to ASCII hex char, store at (DE), advance DE
_printf_nib2a:
	ADD	A,'0'
	CP	'9'+1
	JR	C,_printf_nib_ok
	PUSH	BC
	LD	B,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,B
	POP	BC
	JR	Z,_printf_nib_lo
	ADD	A,7
	JR	_printf_nib_ok
_printf_nib_lo:
	ADD	A,39
_printf_nib_ok:
	LD	(DE),A
	INC	DE
	RET

; ============================================================
; Internal: print float from __ftmp (IEEE 754 single precision)
; This is included in core since it's complex and shares state
; ============================================================
	EXTRN	__fmul
	EXTRN	__fsub
	EXTRN	__ftoi
	EXTRN	__itof
	EXTRN	__fadd
	EXTRN	__tmp32
	EXTRN	_prt_dec32

_prt_float:
	PUSH	BC
	PUSH	DE
	PUSH	IX

	; Load float from __ftmp into HLDE
	LD	DE,(__ftmp)
	LD	HL,(__ftmp+2)

	; Check for zero
	LD	A,H
	AND	7FH
	OR	L
	OR	D
	OR	E
	JP	Z,_prt_float_zero

	; Check sign bit
	BIT	7,H
	JR	Z,_prt_float_pos

	; Print minus sign
	PUSH	HL
	PUSH	DE
	LD	E,'-'
	CALL	_printf_putc
	POP	DE
	POP	HL
	RES	7,H

_prt_float_pos:
	EX	DE,HL
	LD	(__fwork),HL
	LD	(__fwork+2),DE

	; Pre-round
	PUSH	DE
	PUSH	HL
	LD	DE,3F00H
	LD	HL,0
	LD	A,(_prt_float_prec)
	OR	A
	JR	Z,_prt_round_add
	LD	B,A
_prt_round_lp:
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,3DCCH
	LD	HL,0CCCDH
	CALL	__fmul
	DJNZ	_prt_round_lp
_prt_round_add:
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__fadd
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	POP	HL
	POP	DE

	; Reload rounded value
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	EX	DE,HL

	; Extract exponent
	LD	A,H
	ADD	A,A
	LD	B,A
	LD	A,L
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A

	CP	255
	JP	Z,_prt_float_inf

	OR	A
	JP	Z,_prt_float_zero

	; Above 2^31 the integer no longer fits the int32 that __ftoi
	; returns -- it saturates at 2147483647 and the fraction loop then
	; emits bytes that are not even digits.  Such a value is an exact
	; integer (a float has 24 mantissa bits), so print it exactly.
	; Compare the BIASED exponent: 127+31 = 158.  Subtracting the bias
	; first and comparing against 31 would be a signed test written
	; with an unsigned CP, and every |value| < 1 (negative unbiased
	; exponent, so 0xFF..0x80 as a byte) would take the big path.
	LD	A,B
	CP	158			; unbiased exponent >= 31, i.e. >= 2^31
	JP	NC,_prt_float_big

	; ---- Integer part ----
	; __ftoi truncates the pre-rounded value to a 32-bit integer and
	; _prt_dec32 prints all 32 bits of it, which is what the %ld
	; handler already does.
	;
	; This replaces a hand-rolled mantissa walk that assembled the
	; integer part in H:L:E and then printed it with the 16-bit
	; _prt_dec, dropping E: every |value| >= 65536 came out wrong,
	; and often not even as digits, because the leftover low byte
	; was emitted as a character.  1000000.0 printed as "3906.00///".
	; The >= 2^24 path shifted a 16-bit HL left and yielded 0.
	; sprintf in this same libc has always done it the way below.
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__ftoi
	LD	(__fint),HL
	LD	(__fint+2),DE
	CALL	_prt_dec32

	LD	E,'.'
	CALL	_printf_putc

	; frac = value - (float)int
	LD	HL,(__fint)
	LD	DE,(__fint+2)
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__fsub
	LD	(__fwork),HL
	LD	(__fwork+2),DE

	LD	A,(_prt_float_prec)
	LD	B,A
	OR	A
	JP	Z,_prt_float_done
	JP	_prt_float_frac

_prt_float_frac:
	PUSH	BC
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,4120H
	LD	HL,0
	CALL	__fmul
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	CALL	__ftoi
	LD	A,L
	PUSH	AF
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	POP	AF
	LD	L,A
	LD	H,0
	LD	DE,0
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__fsub
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	POP	BC
	DJNZ	_prt_float_frac
	JP	_prt_float_done

; ============================================================
; %f for |value| >= 2^31.
;
; value = mantissa * 2^(e-23) with a 24-bit mantissa, so it is a whole
; number and its decimal form is exact.  Feed the mantissa's bits into
; a decimal accumulator most significant first, then double (e-23) more
; times.  Doubling a decimal digit string is exact at every step, so the
; digits printed are the value's own -- unlike scaling by powers of ten
; in float, which runs out of precision after about seven digits.
;
; Entry: HL = high half of |value| (L holds the top mantissa bits),
;        DE = low half, A = biased exponent.
; ============================================================
_prt_float_big:
	PUSH	AF
	LD	A,E
	LD	(_pbig_m),A
	LD	A,D
	LD	(_pbig_m+1),A
	LD	A,L
	AND	7FH
	OR	80H			; restore the implicit leading 1
	LD	(_pbig_m+2),A

	XOR	A
	LD	HL,_prt_big
	LD	B,40
_pbig_clr:
	LD	(HL),A
	INC	HL
	DJNZ	_pbig_clr
	LD	A,1
	LD	(_prt_biglen),A

	LD	B,24
_pbig_bits:
	PUSH	BC
	LD	A,(_pbig_m)
	ADD	A,A
	LD	(_pbig_m),A
	LD	A,(_pbig_m+1)
	ADC	A,A
	LD	(_pbig_m+1),A
	LD	A,(_pbig_m+2)
	ADC	A,A
	LD	(_pbig_m+2),A
	LD	A,0
	ADC	A,0			; A = the bit shifted out of the top
	CALL	_pbig_dbl
	POP	BC
	DJNZ	_pbig_bits

	POP	AF
	SUB	150			; (e - 127) - 23, straight off the biased form
	JR	Z,_pbig_print
	LD	B,A
_pbig_more:
	PUSH	BC
	XOR	A
	CALL	_pbig_dbl
	POP	BC
	DJNZ	_pbig_more

_pbig_print:
	LD	A,(_prt_biglen)
	LD	B,A
	LD	HL,_prt_big
	LD	D,0
	LD	E,A
	ADD	HL,DE
	DEC	HL			; most significant digit
_pbig_po:
	PUSH	BC
	PUSH	HL
	LD	A,(HL)
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	POP	HL
	DEC	HL
	POP	BC
	DJNZ	_pbig_po
	JP	_prt_float_dot_zeros

; Double the decimal accumulator, adding the carry-in in A.
_pbig_dbl:
	LD	C,A
	LD	HL,_prt_big
	LD	A,(_prt_biglen)
	LD	B,A
_pbig_dl:
	LD	A,(HL)
	ADD	A,A
	ADD	A,C
	LD	C,0
	CP	10
	JR	C,_pbig_nc
	SUB	10
	LD	C,1
_pbig_nc:
	LD	(HL),A
	INC	HL
	DJNZ	_pbig_dl
	LD	A,C
	OR	A
	RET	Z
	LD	(HL),1
	LD	A,(_prt_biglen)
	INC	A
	LD	(_prt_biglen),A
	RET

_prt_float_zero:
	LD	E,'0'
	CALL	_printf_putc
_prt_float_dot_zeros:
	LD	E,'.'
	CALL	_printf_putc
	LD	A,(_prt_float_prec)
	LD	B,A
	OR	A
	JR	Z,_prt_float_done
_prt_float_z2:
	PUSH	BC
	LD	E,'0'
	CALL	_printf_putc
	POP	BC
	DJNZ	_prt_float_z2
	JR	_prt_float_done

_prt_float_inf:
	LD	E,'i'
	CALL	_printf_putc
	LD	E,'n'
	CALL	_printf_putc
	LD	E,'f'
	CALL	_printf_putc

_prt_float_done:
	POP	IX
	POP	DE
	POP	BC
	RET

; ============================================================
; Internal: print HL as decimal (no padding, simple)
; ============================================================
	PUBLIC	_prt_dec
_prt_dec:
	PUSH	BC
	PUSH	DE
	LD	DE,10
	LD	B,0
_prt_dec_loop:
	CALL	_prt_div16
	PUSH	DE
	INC	B
	LD	A,H
	OR	L
	JR	NZ,_prt_dec_loop
_prt_dec_out:
	POP	DE
	LD	A,E
	ADD	A,'0'
	LD	E,A
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	DJNZ	_prt_dec_out
	POP	DE
	POP	BC
	RET

; ============================================================
; Internal: HL = HL / 10, DE = HL % 10
; ============================================================
	PUBLIC	_prt_div16
_prt_div16:
	PUSH	BC
	LD	BC,0
	LD	DE,0
_prt_div16_lp:
	LD	A,H
	OR	A
	JR	NZ,_prt_div16_sub
	LD	A,L
	CP	10
	JR	C,_prt_div16_dn
_prt_div16_sub:
	LD	A,L
	SUB	10
	LD	L,A
	LD	A,H
	SBC	A,0
	LD	H,A
	INC	BC
	JR	_prt_div16_lp
_prt_div16_dn:
	LD	E,L
	LD	D,0
	LD	H,B
	LD	L,C
	POP	BC
	RET

	DSEG

_printf_count:	DS	2	; running byte count, returned by printf-family
_printf_fmtstart:	DS	2	; first byte after '%', for _printf_unknown
_printf_hexbuf:	DS	8	; 8 chars for %lx, lower 4 reused by 16-bit %x
_printf_decbuf:	DS	6
_printf_neg:	DB	0
_printf_dptr:	DS	2
_printf_dstart:	DS	2
_printf_dcnt:	DB	0
_printf_width:	DB	0
_printf_zero:	DB	0
_printf_upper:	DB	0
_printf_prec:	DB	0
_printf_hasprec:	DB	0
_printf_alt:	DB	0	; '#' flag — alt form for o/x/X
_printf_ll_w0:	DS	2
_printf_ll_w1:	DS	2
_printf_ll_w2:	DS	2
_printf_ll_w3:	DS	2
_prt_float_prec:	DB	6
__ftmp:		DS	4
__fwork:	DS	4
__fint:		DS	4	; %f integer part, as a 32-bit integer
_pbig_m:	DS	3	; %f >= 2^31: the 24-bit mantissa, shifted out MSB first
_prt_big:	DS	40	; %f >= 2^31: decimal digits, least significant first
_prt_biglen:	DB	1

	END
