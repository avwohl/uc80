; lc_printf_d.mac - printf %d/%i handler
	.Z80

	EXTRN	_printf_loop
	EXTRN	_printf_neg
	EXTRN	_printf_numout
	EXTRN	_printf_dec16

	CSEG

	PUBLIC	__printf_handle_d
__printf_handle_d:
	; Entry: HL = format ptr (past 'd'), C = arg offset, IX = frame
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = value
	EX	DE,HL		; HL = value
	LD	A,2		; signed, not negative
	BIT	7,H
	JR	Z,_phd_pos
	DEC	A		; negative: 1, and HL = -HL
	LD	(_printf_neg),A
	LD	A,L
	CPL
	LD	L,A
	LD	A,H
	CPL
	LD	H,A
	INC	HL
	JR	_phd_go
_phd_pos:
	LD	(_printf_neg),A
_phd_go:
	CALL	_printf_dec16
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

	END
