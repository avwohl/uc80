; lc_printf_x.mac - printf %x, %X, %p handlers
	.Z80

BDOS	EQU	5
CONOUT	EQU	2

	EXTRN	_printf_loop
	EXTRN	_printf_upper
	EXTRN	_printf_alt
	EXTRN	_printf_putc
	EXTRN	_printf_prt_hex

	CSEG

	PUBLIC	__printf_handle_x
	PUBLIC	__printf_handle_xu
	PUBLIC	__printf_handle_p

__printf_handle_xu:
	; %X handler - set uppercase flag and fall through
	PUSH	AF
	LD	A,1
	LD	(_printf_upper),A
	POP	AF
	JR	__printf_handle_x

__printf_handle_p:
	; Pointer - same as %x

__printf_handle_x:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	; If # flag set and value != 0, emit "0x" / "0X" prefix per
	; C 7.21.6.1 ¶6 (alternative form for x/X conversion).
	LD	A,(_printf_alt)
	OR	A
	JR	Z,__printf_x_noalt
	LD	A,H
	OR	L
	JR	Z,__printf_x_noalt	; zero value → no prefix
	PUSH	HL
	PUSH	BC
	LD	E,'0'
	CALL	_printf_putc
	LD	A,(_printf_upper)
	OR	A
	LD	E,'x'
	JR	Z,__printf_x_lc
	LD	E,'X'
__printf_x_lc:
	CALL	_printf_putc
	POP	BC
	POP	HL
__printf_x_noalt:
	CALL	_printf_prt_hex
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

	END
