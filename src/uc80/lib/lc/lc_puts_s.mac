; lc_puts_s.mac - __puts_s: puts without a stack frame
	.Z80

	EXTRN	__conout

	CSEG

; ============================================================
; int _puts_s(const char *s)
; Output a string followed by a newline, as puts does.  Family K, step 2
; (docs/k2_code_size.md).  The compiler calls this routine in place of
; puts.  It does not use IX, and it does not save BC, because __conout
; keeps BC, DE and HL.  The routine is 31 bytes.  puts (lc_puts.mac) is
; 40 bytes.
; Argument: pointer to string on the stack at SP+2
; Returns: 0
; ============================================================
	PUBLIC	__puts_s
__puts_s:
	LD	HL,2
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,E
__puts_s_loop:
	LD	A,(HL)
	OR	A
	JR	Z,__puts_s_nl	; end of string
	LD	E,A
	CALL	__conout	; preserves HL
	INC	HL
	JR	__puts_s_loop
__puts_s_nl:
	LD	E,0AH
	CALL	__conout
	LD	HL,0
	RET

	END
