; lc_sqrt.mac - sqrt, sqrtf, sqrtl
;
; Correctly rounded square root with integer arithmetic.  The mantissa M
; (24 bits) becomes the 56-bit number N = M * 2^32 or M * 2^31, whichever
; makes the exponent of the root a whole number.  The digit-by-digit method
; takes 28 bits of the root of N, two bits of N in each of 28 steps:
;   R = R * 4 + the next two bits of N
;   if R >= 4 * Q + 1 then R = R - (4 * Q + 1), Q = 2 * Q + 1, else Q = 2 * Q
; The loop keeps X = 4 * Q in memory.  The mantissa of the result is Q
; rounded at 4 bits: (Q + 8) >> 4.  A tie cannot happen, so the 4 low bits
; of Q are enough.
;
; __vm_sqrt is the routine of the float interpreter (see lc_vm.mac): DEHL = x,
; the result is in DEHL.  It keeps BC and IX.
	.Z80

	CSEG

	PUBLIC	__vm_sqrt
	PUBLIC	_sqrt
	PUBLIC	_sqrtf
	PUBLIC	_sqrtl

__vm_sqrt:
	PUSH	BC
	CALL	_sq_core
	POP	BC
	RET

; double sqrt(double x)
_sqrt:
_sqrtf:
_sqrtl:
	LD	HL,2
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = x

; DEHL = x.  Result in DEHL.  Changes AF and BC.
_sq_core:
	LD	A,E
	RLA
	LD	A,D
	RLA			; A = the exponent field, carry = the sign
	JR	C,_sq_neg
	CP	255
	RET	Z		; +inf or a NaN
	OR	A
	JR	NZ,_sq_n
	LD	A,E		; exponent 0: +0 or a subnormal number
	OR	H
	OR	L
	RET	Z
	LD	B,0		; B = the number of shifts
_sq_nl:
	ADD	HL,HL
	RL	E
	INC	B
	BIT	7,E
	JR	Z,_sq_nl
	LD	A,128
	SUB	B
	SRL	A		; the exponent of the root; the carry is 1 when
	JR	_sq_go		; the exponent of x is even
_sq_n:
	SET	7,E		; the implicit bit
	ADD	A,127
	RRA			; (e + 127) / 2; the carry is 1 when e is even
_sq_go:
	PUSH	AF
	PUSH	IX
	LD	D,E		; D:E:H:L = M * 2^8
	LD	E,H
	LD	H,L
	LD	L,0
	JR	C,_sq_c
	SRL	D		; M * 2^7
	RR	E
	RR	H
	RR	L
_sq_c:
	XOR	A
	PUSH	AF		; the bytes of N, the last first
	PUSH	AF
	PUSH	AF
	LD	A,L
	PUSH	AF
	LD	A,H
	PUSH	AF
	LD	A,E
	PUSH	AF
	LD	A,D
	PUSH	AF
	LD	IX,_sq_x
	LD	HL,0
	LD	(_sq_x),HL
	LD	(_sq_x+2),HL
	LD	D,H
	LD	E,L		; R = 0
	LD	(IX+4),7
_sq_outer:
	POP	AF		; A = the next byte of N
	LD	(IX+5),4
_sq_inner:
	RLCA			; R = R * 4 + the next two bits
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	RLCA
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	PUSH	HL
	PUSH	DE
	LD	BC,(_sq_x)
	SCF
	SBC	HL,BC		; R - X - 1
	EX	DE,HL
	LD	BC,(_sq_x+2)
	SBC	HL,BC
	EX	DE,HL
	JR	C,_sq_no
	POP	BC		; R >= X + 1: keep the difference
	POP	BC
	CALL	_sq_shx
	SET	2,(IX+0)	; X = X * 2 + 4
	JR	_sq_next
_sq_no:
	POP	DE
	POP	HL
	CALL	_sq_shx
_sq_next:
	DEC	(IX+5)
	JR	NZ,_sq_inner
	DEC	(IX+4)
	JR	NZ,_sq_outer
	; the mantissa is (X + 32) >> 6
	LD	HL,(_sq_x)
	LD	DE,(_sq_x+2)
	LD	BC,32
	ADD	HL,BC
	JR	NC,_sq_f1
	INC	DE
_sq_f1:
	LD	B,6
_sq_f2:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	_sq_f2
	POP	IX
	POP	AF		; A = the exponent of the root
	LD	B,A
	LD	A,D
	OR	A
	LD	A,B
	JR	Z,_sq_p
	INC	A		; the mantissa carried to 2^24
	LD	E,80H
_sq_p:
	SRL	A
	LD	D,A
	RET	C
	RES	7,E
	RET

; X = X * 2
_sq_shx:
	SLA	(IX+0)
	RL	(IX+1)
	RL	(IX+2)
	RL	(IX+3)
	RET

; the sign bit is set: -0 is the result for -0, a NaN for a NaN, else a NaN
_sq_neg:
	CP	255
	JR	NZ,_sq_n2
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	RET	NZ		; a NaN
	JR	_sq_nan		; -inf
_sq_n2:
	OR	A
	JR	NZ,_sq_nan
	LD	A,E
	OR	H
	OR	L
	RET	Z		; -0
_sq_nan:
	LD	DE,7FC0H
	LD	HL,0
	RET

	COMMON	/lc_sqrt/
_sq_x:
	DS	6

	END
