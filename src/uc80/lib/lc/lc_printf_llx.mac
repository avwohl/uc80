; lc_printf_llx.mac - printf %llx handler (long long hex)
	.Z80

BDOS	EQU	5
CONOUT	EQU	2

	EXTRN	_printf_loop
	EXTRN	_printf_ll_w0
	EXTRN	_printf_ll_w1
	EXTRN	_printf_ll_w2
	EXTRN	_printf_ll_w3
	EXTRN	_printf_hexbuf
	EXTRN	_printf_hexword
	EXTRN	_printf_hexfin

	CSEG

	PUBLIC	__printf_handle_llx
__printf_handle_llx:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	; Read 8 bytes (64 bits)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w0),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w1),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_printf_ll_w3),DE
	; 16 nibbles, high word first, into _printf_hexbuf
	LD	DE,_printf_hexbuf
	LD	HL,(_printf_ll_w3)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w2)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w1)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w0)
	CALL	_printf_hexword
	LD	B,16
	CALL	_printf_hexfin
	POP	BC
	LD	A,C
	ADD	A,8
	LD	C,A
	POP	HL
	JP	_printf_loop

	END
