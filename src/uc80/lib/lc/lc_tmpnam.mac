; lc_tmpnam.mac - split from lc_file.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	PUBLIC	_gen_tmpnam

	CSEG

; ============================================================
; char *tmpnam(char *s)
; Generate a unique temporary file name
; If s is NULL, returns pointer to internal static buffer
; ============================================================
	PUBLIC	_tmpnam
_tmpnam:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Get buffer pointer
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	A,H
	OR	L
	JR	NZ,_tmpnam_usebuf
	; Use internal buffer
	LD	HL,_tmpnam_buf
_tmpnam_usebuf:
	PUSH	HL		; Save destination
	CALL	_gen_tmpnam
	POP	HL		; Return destination

	POP	DE
	POP	BC
	POP	IX
	RET

; Internal: Generate temp name into HL
_gen_tmpnam:
	PUSH	BC
	PUSH	DE
	PUSH	HL

	; Format: TMP00000.$$$
	LD	(HL),'T'
	INC	HL
	LD	(HL),'M'
	INC	HL
	LD	(HL),'P'
	INC	HL

	; Get counter and convert to 5 digits
	LD	DE,(_tmpnam_cnt)
	INC	DE
	LD	(_tmpnam_cnt),DE

	; Convert DE to 5 decimal digits
	LD	BC,10000
	CALL	_div16
	ADD	A,'0'
	LD	(HL),A
	INC	HL
	; Remainder in DE
	LD	BC,1000
	CALL	_div16
	ADD	A,'0'
	LD	(HL),A
	INC	HL
	LD	BC,100
	CALL	_div16
	ADD	A,'0'
	LD	(HL),A
	INC	HL
	LD	BC,10
	CALL	_div16
	ADD	A,'0'
	LD	(HL),A
	INC	HL
	LD	A,E
	ADD	A,'0'
	LD	(HL),A
	INC	HL

	; Add .$$$ extension
	LD	(HL),'.'
	INC	HL
	LD	(HL),'$'
	INC	HL
	LD	(HL),'$'
	INC	HL
	LD	(HL),'$'
	INC	HL
	LD	(HL),0

	POP	HL
	POP	DE
	POP	BC
	RET

; Internal: Divide DE by BC, quotient in A, remainder in DE.  Keeps HL (the
; place in the name): the loop below uses HL as a work register.
_div16:
	PUSH	HL
	XOR	A
_div16_loop:
	LD	H,D
	LD	L,E
	OR	A
	SBC	HL,BC
	JR	C,_div16_done
	EX	DE,HL
	INC	A
	JR	_div16_loop
_div16_done:
	POP	HL
	RET



_tmpnam_cnt:
	DW	0

_tmpnam_buf:
	DS	13		; TMP00000.$$$ + null

	END
