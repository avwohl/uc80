; lc_printf_u.mac - printf %u handler
	.Z80

	EXTRN	_printf_loop
	EXTRN	_printf_numout
	EXTRN	_printf_dec16

	CSEG

	PUBLIC	__printf_handle_u
__printf_handle_u:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL		; HL = value
	CALL	_printf_dec16
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

	END
