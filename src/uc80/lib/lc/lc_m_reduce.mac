	ld	A,D
	xor	80H
	ld	D,A
	jr @TERN_END51_m_reduce
@TERN_E50_m_reduce:
	ld	HL,(??AUTO_m_reduce+24)
	ld	DE,(??AUTO_m_reduce+26)
@TERN_END51_m_reduce:
	push	DE
	push	HL
	ld	L,(IX+8)
	ld	H,(IX+9)
	ex	DE,HL
	pop	HL
	ex	DE,HL
	ld	(HL),E
	inc	HL
	ld	(HL),D
	inc	HL
	pop	DE
	ld	(HL),E
	inc	HL
	ld	(HL),D
	ld	HL,(??AUTO_m_reduce+6)
@_m_reduce_ret:
	pop	IX
	ret


