; lc_memcpy.mac - split from lc_mem.mac
	.Z80

BDOS	EQU	5
CONOUT	EQU	2
CONIN	EQU	1
PRTSTR	EQU	9

	CSEG

; ============================================================
; void *memcpy(void *dest, const void *src, size_t n)
; Copy n bytes from src to dest
; Returns: dest
; ============================================================
	PUBLIC	_memcpy
_memcpy:
	POP	AF		; return address
	POP	DE		; DE = dest
	POP	HL		; HL = src
	POP	BC		; BC = n
	PUSH	BC
	PUSH	HL
	PUSH	DE
	PUSH	AF
	PUSH	DE		; return value
	LD	A,B
	OR	C
	JR	Z,_memcpy_done
	LDIR
_memcpy_done:
	POP	HL
	RET

	END
