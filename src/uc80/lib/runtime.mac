	RR	L
	LD	(__acc64+4),HL
	LD	HL,(__acc64+2)
	RR	H
	RR	L
	LD	(__acc64+2),HL
	LD	HL,(__acc64)
	RR	H
	RR	L
	LD	(__acc64),HL
	DJNZ	__sar64_loop
	POP	BC
