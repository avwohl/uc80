	OR	B
	LD	B,A
	LD	A,(__acc64+3)
	OR	B
	LD	B,A
	LD	A,(__acc64+4)
	OR	B
	LD	B,A
	LD	A,(__acc64+5)
	OR	B
	LD	B,A
	LD	A,(__acc64+6)
	OR	B
