; ============================================================
; rt_longjmp.mac
; ============================================================
; rt_longjmp.mac - _longjmp
; Split from rt_setjmp.mac


	CSEG
; ============================================================
; longjmp - Non-local goto
; void longjmp(jmp_buf env, int val)
; env at SP+4, val at SP+2 (after return address)
; If val==0, returns 1, else returns val
; ============================================================
	PUBLIC	_longjmp
_longjmp:
	; Get parameters - we'll discard our return address
	; Stack at entry: [ret_addr, env, val, ...]
	; (C calling convention: args pushed right-to-left)
	POP	DE		; Discard longjmp's return address
	POP	HL		; HL = env pointer
	POP	BC		; BC = val

	; If val == 0, set val = 1
	LD	A,B
	OR	C
	JR	NZ,_longjmp_valok
	LD	BC,1
_longjmp_valok:
	; BC = return value, HL = env

	; Get return address from env[0..1] into DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	; DE = return address, HL = env+2

	; Get saved SP from env[2..3]
	LD	A,(HL)
	INC	HL
	PUSH	HL		; Save env+3
	LD	H,(HL)
	LD	L,A		; HL = saved SP
	EX	(SP),HL		; Stack: [saved SP], HL = env+3
	INC	HL		; HL = env+4

	; Get saved IX from env[4..5]
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A		; HL = saved IX
	PUSH	HL
	POP	IX		; IX restored

	; Now: DE = return addr, BC = return val, (SP) = saved SP
	POP	HL		; HL = saved SP
	LD	SP,HL		; Switch stack!

	; Stack now points to original env location in caller's frame
	; Push return address so RET will go there
	PUSH	DE

	; Return value in HL
	LD	H,B
	LD	L,C
	RET


	CSEG
; ============================================================
; rt_ltof.mac
; ============================================================
; rt_ltof.mac - __ltof, __itof
; Split from rt_float.mac



	CSEG
; ============================================================
; Integer to Float: DEHL = float(DEHL) (signed 32-bit)
; Also known as __ltof for long to float conversion
; ============================================================
	PUBLIC	__ltof
__ltof:
	PUBLIC	__itof
__itof:
	PUSH	BC

	; Check for zero
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__itof_nz
	LD	DE,0
	LD	HL,0
	JR	__itof_done

__itof_nz:
	; Get sign
	LD	A,D
	AND	80H
	LD	(__fsgn1),A

	; Make positive if negative
	BIT	7,D
	JR	Z,__itof_pos
	CALL	__neg32
	; Check for LONG_MIN overflow: __neg32(0x80000000) = 0x80000000
	BIT	7,D
	JR	Z,__itof_pos
	; Special case: value is 2^31, mantissa = 1<<23, exp = 127+31
	LD	HL,0
	LD	(__fman1),HL
	LD	DE,0080H	; E=0x80 = bit 23 set
	LD	(__fman1+2),DE
	LD	HL,127+31
	LD	(__fexp1),HL
	JR	__itof_pack

__itof_pos:
	; Initial exponent = 127 + 23 (normalizing to bit 23)
	PUSH	HL
	LD	HL,127+23
	LD	(__fexp1),HL
	POP	HL

	; If high byte D has bits set, shift right to bring mantissa
	; into 24-bit range (bits 0-23) before __fnorm
	LD	BC,0		; B = the last bit shifted out, C = the bits before it
__itof_rshift:
	LD	A,D
	OR	A
	JR	Z,__itof_round
	LD	A,B
	OR	C
	LD	C,A
	; Shift DEHL right by 1
	SRL	D
	RR	E
	RR	H
	RR	L
	LD	A,0
	RLA
	LD	B,A
	; Increment exponent
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	JR	__itof_rshift

__itof_round:
	; Round to nearest, ties to even (the shift lost the bits in B and C)
	LD	A,B
	OR	A
	JR	Z,__itof_store
	LD	A,C
	OR	A
	JR	NZ,__itof_up
	BIT	0,L
	JR	Z,__itof_store
__itof_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,__itof_store
	INC	DE
__itof_store:
	; Store mantissa (now D=0, bits in EHL)
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Normalize (shift mantissa left until bit 23 is set)
	CALL	__fnorm
__itof_pack:

	; Pack result
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

__itof_done:
	POP	BC
	RET


	CSEG
