; ============================================================
; rt_mul16.mac
; ============================================================
; rt_mul16.mac - __mul16
; Split from rt_arith16.mac



	CSEG
; ============================================================
; 16-bit multiplication: HL = DE * HL (low 16 bits; signed and
; unsigned give the same bits)
; Preserves BC, IX, IY.  Clobbers A, DE, flags.
; When either operand fits in 8 bits it is the multiplier of one
; __mul8x16.  An operand in -255..-1 is negated to 1..255 and the
; product negated back.  Otherwise
;   DE*HL mod 2^16 = DE*L + ((E*H) mod 256)<<8.
; ============================================================
	PUBLIC	__mul16
__mul16:
	LD	A,H
	OR	A
	JR	NZ,__mul16_h
	OR	L		; A = L
	JP	__mul8x16	; HL = DE * L
__mul16_h:
	LD	A,D
	OR	A
	JR	NZ,__mul16_n
	LD	A,E
	EX	DE,HL
	JP	__mul8x16	; HL = HL * E
__mul16_n:
	LD	A,H
	INC	A
	JR	NZ,__mul16_n2	; H <> 0FFH
	SUB	L		; A = -L (A was 0)
	JP	NZ,__mul16ng	; HL = -(DE * -HL)
__mul16_n2:
	LD	A,D
	INC	A
	JP	NZ,__mul16w	; D <> 0FFH
	SUB	E		; A = -E
	JP	Z,__mul16w	; DE = -256
	EX	DE,HL
	JP	__mul16ng	; HL = -(HL * -DE)


	CSEG
; ============================================================
; rt_mul16_32.mac
; ============================================================
; rt_mul16_32.mac - __mul16_32
; Split from rt_mul.mac



	CSEG
; ============================================================
; __mul16_32 - 16 x 16 -> 32-bit unsigned multiply: DEHL = BC * DE
; Preserves BC, IX, IY.  Clobbers A, flags.
; One or two __mul8x16 passes: an operand whose high byte is 0 is
; the multiplier of a single pass.
; ============================================================
	PUBLIC	__mul16_32
__mul16_32:
	LD	A,B
	OR	A
	JR	Z,__m1632_c	; BC < 256: one pass, multiplier C
	LD	A,D
	OR	A
	JR	NZ,__m1632_2
	LD	A,E		; DE < 256: one pass, multiplier E,
	LD	D,B		; multiplicand BC
	LD	E,C
	JR	__m1632_1
__m1632_c:
	LD	A,C
__m1632_1:
	CALL	__mul8x16	; AHL = A * DE
	LD	E,A
	LD	D,0
	RET
__m1632_2:
	PUSH	BC
	LD	A,C
	CALL	__mul8x16	; P0 = AHL = C * DE
	PUSH	HL
	LD	C,A		; C = P0 bits 16..23
	LD	A,B
	CALL	__mul8x16	; P1 = AHL = B * DE
	POP	DE		; DE = P0 bits 0..15
	LD	B,A		; B = P1 bits 16..23
	LD	A,D		; result = P0 + (P1 << 8)
	ADD	A,L
	LD	D,A		; D = byte 1
	LD	A,C
	ADC	A,H
	LD	C,A		; C = byte 2
	LD	A,B
	ADC	A,0		; A = byte 3
	LD	L,E
	LD	H,D
	LD	E,C
	LD	D,A
	POP	BC
	RET


	CSEG
; ============================================================
; rt_mul16ng.mac
; ============================================================
; rt_mul16ng.mac - __mul16ng
; Split from rt_arith16.mac



	CSEG
; ============================================================
; __mul16ng - HL = -(DE * A), A = 1..255.  Part of __mul16.
; __mul16w  - HL = DE * HL when neither operand fits in 8 bits:
;   DE*L + ((E*H) mod 256)<<8.  Part of __mul16.
; Kept apart from __mul16 so that the common 8-bit cases are one
; short routine.  Same registers as __mul16.
; ============================================================
	PUBLIC	__mul16ng
__mul16ng:
	CALL	__mul8x16
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
	RET


	CSEG
; ============================================================
; rt_mul16w.mac
; ============================================================
; rt_mul16w.mac - __mul16w
; Split from rt_arith16.mac



	CSEG
	PUBLIC	__mul16w
__mul16w:
	PUSH	HL
	LD	A,L
	CALL	__mul8x16	; HL = DE * L
	EX	(SP),HL		; HL = right operand, stack = partial
	LD	A,H
	LD	D,0		; DE = E
	CALL	__mul8x16	; L = (H * E) & 0FFH
	LD	A,L
	POP	HL
	ADD	A,H
	LD	H,A
	RET


	CSEG
; ============================================================
; rt_mul32.mac
; ============================================================
; rt_mul32.mac - __mul32
; Split from rt_arith32.mac



	CSEG
; ============================================================
; 32-bit multiplication: DEHL = DEHL * (__tmp32)  (low 32 bits)
; When both operands are sign-extended 16-bit values the product is
; +-(|AL| * |BL|): one __mul16_32 with its 8-bit fast paths.
; Otherwise, with A = AH:AL (DEHL) and B = BH:BL (__tmp32):
;   A*B mod 2^32 = AL*BL + ((AH*BL + AL*BH) mod 2^16) << 16
; Each product is a __mul16_32 (only the low word of the cross
; products is used); a cross product is skipped when AH or BH is 0.  __tmp32 is not changed.
; Preserves BC, IX, IY.
; ============================================================
	PUBLIC	__mul32
__mul32:
	PUSH	BC
	LD	A,H		; DEHL = sign extension of HL?
	RLA
	SBC	A,A
	CP	D
	JR	NZ,__mul32_g
	CP	E
	JR	NZ,__mul32_g
	LD	C,A
	LD	A,(__tmp32+1)	; and __tmp32 of its low word?
	RLA
	SBC	A,A
	LD	B,A
	LD	A,(__tmp32+2)
	CP	B
	JR	NZ,__mul32_g
	LD	A,(__tmp32+3)
	CP	B
	JR	NZ,__mul32_g
	XOR	C
	PUSH	AF		; S flag = sign of the product
	BIT	7,H
	JR	Z,__mul32_s1
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__mul32_s1:
	LD	B,H
	LD	C,L		; BC = |AL|
	LD	HL,(__tmp32)
	BIT	7,H
	JR	Z,__mul32_s2
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__mul32_s2:
	EX	DE,HL		; DE = |BL|
	CALL	__mul16_32	; DEHL = |AL| * |BL|
	POP	AF
	POP	BC
	RET	P
	JP	__neg32
__mul32_g:
	LD	B,H
	LD	C,L		; BC = AL
	LD	A,D
	OR	E
	JR	Z,__mul32_1	; AH = 0: DE = 0 = cross sum so far
	PUSH	BC
	LD	BC,(__tmp32)
	CALL	__mul16_32	; HL = (AH * BL) mod 2^16
	POP	BC
	EX	DE,HL		; DE = cross sum
__mul32_1:
	LD	HL,(__tmp32+2)
	LD	A,H
	OR	L
	JR	Z,__mul32_2	; BH = 0
	PUSH	DE
	EX	DE,HL
	CALL	__mul16_32	; HL = (AL * BH) mod 2^16
	POP	DE
	ADD	HL,DE
	EX	DE,HL		; DE = cross sum
__mul32_2:
	PUSH	DE
	LD	DE,(__tmp32)
	CALL	__mul16_32	; DEHL = AL * BL
	EX	DE,HL
	POP	BC
	ADD	HL,BC		; high word += cross sum
	EX	DE,HL
	POP	BC
	RET


	CSEG
; ============================================================
; rt_mul64.mac
; ============================================================
; rt_mul64.mac - __mul64
; Split from rt_arith64.mac



	COMMON	/rt_mul64/
__mul64_mcd:	DS	8	; Multiplicand
__mul64_mpr:	DS	8	; Multiplier
	CSEG
	PUBLIC	__mul64
__mul64:
	PUSH	BC
	PUSH	DE
	; Save multiplicand (__acc64) to __mul64_mcd
	LD	HL,(__acc64)
	LD	(__mul64_mcd),HL
	LD	HL,(__acc64+2)
	LD	(__mul64_mcd+2),HL
	LD	HL,(__acc64+4)
	LD	(__mul64_mcd+4),HL
	LD	HL,(__acc64+6)
	LD	(__mul64_mcd+6),HL
	; Copy multiplier (__tmp64) to __mul64_mpr
	LD	HL,(__tmp64)
	LD	(__mul64_mpr),HL
	LD	HL,(__tmp64+2)
	LD	(__mul64_mpr+2),HL
	LD	HL,(__tmp64+4)
	LD	(__mul64_mpr+4),HL
	LD	HL,(__tmp64+6)
	LD	(__mul64_mpr+6),HL
	; Initialize result (__acc64) to 0
	LD	HL,0
	LD	(__acc64),HL
	LD	(__acc64+2),HL
	LD	(__acc64+4),HL
	LD	(__acc64+6),HL
	; Loop through 64 bits
	LD	B,64
__mul64_loop:
	; Shift multiplier right, get LSB
	LD	HL,(__mul64_mpr+6)
	SRL	H
	RR	L
	LD	(__mul64_mpr+6),HL
	LD	HL,(__mul64_mpr+4)
	RR	H
	RR	L
	LD	(__mul64_mpr+4),HL
	LD	HL,(__mul64_mpr+2)
	RR	H
	RR	L
	LD	(__mul64_mpr+2),HL
	LD	HL,(__mul64_mpr)
	RR	H
	RR	L
	LD	(__mul64_mpr),HL
	JR	NC,__mul64_noadd
	; Add multiplicand to result. NB: load through DE rather than BC —
	; ``LD BC,(nn)`` would clobber B, which is our DJNZ loop counter.
	; That was the long-standing miscompile in this routine: any
	; iteration where the add path ran (multiplier bit set) overwrote
	; B with a byte of the multiplicand, terminating the loop early
	; once mcd's high byte happened to be 1.
	LD	HL,(__acc64)
	LD	DE,(__mul64_mcd)
	ADD	HL,DE
	LD	(__acc64),HL
	LD	HL,(__acc64+2)
	LD	DE,(__mul64_mcd+2)
	ADC	HL,DE
	LD	(__acc64+2),HL
	LD	HL,(__acc64+4)
	LD	DE,(__mul64_mcd+4)
	ADC	HL,DE
	LD	(__acc64+4),HL
	LD	HL,(__acc64+6)
	LD	DE,(__mul64_mcd+6)
	ADC	HL,DE
	LD	(__acc64+6),HL
__mul64_noadd:
	; Shift multiplicand left
	LD	HL,(__mul64_mcd)
	ADD	HL,HL
	LD	(__mul64_mcd),HL
	LD	HL,(__mul64_mcd+2)
	ADC	HL,HL
	LD	(__mul64_mcd+2),HL
	LD	HL,(__mul64_mcd+4)
	ADC	HL,HL
	LD	(__mul64_mcd+4),HL
	LD	HL,(__mul64_mcd+6)
	ADC	HL,HL
	LD	(__mul64_mcd+6),HL
	DJNZ	__mul64_loop
	POP	DE
	POP	BC
	RET


	CSEG
; ============================================================
; rt_mul8x16.mac
; ============================================================
; rt_mul8x16.mac - __mul8x16
; Split from rt_mul.mac


	CSEG
; ============================================================
; __mul8x16 - 8 x 16 -> 24-bit unsigned multiply: AHL = A * DE
; In:  A = multiplier, DE = multiplicand
; Out: HL = product bits 0..15, A = product bits 16..23
; Preserves BC, DE, IX, IY.  Clobbers flags.
;
; MSB first and unrolled.  The ADD A,A chain finds the top set bit of
; the multiplier (11 T for each leading zero bit) and jumps into the
; unrolled steps at that bit, so a small multiplier costs only a few
; steps.  Each later step is "ADD HL,HL / RLA": the carry out of HL
; moves into the low end of A while the next multiplier bit leaves
; the top of A, so A ends holding the high byte of the product.
; ============================================================
	PUBLIC	__mul8x16
__mul8x16:
	LD	HL,0
	ADD	A,A
	JR	C,__m816_7
	ADD	A,A
	JR	C,__m816_6
	ADD	A,A
	JR	C,__m816_5
	ADD	A,A
	JR	C,__m816_4
	ADD	A,A
	JR	C,__m816_3
	ADD	A,A
	JR	C,__m816_2
	ADD	A,A
	JR	C,__m816_1
	ADD	A,A
	JR	C,__m816_0
	RET			; multiplier 0: A = 0, HL = 0
__m816_7:
	ADD	HL,DE		; HL was 0: HL = DE, A low bits are 0
	ADD	HL,HL
	RLA
	JR	NC,__m816_6n
__m816_6:
	ADD	HL,DE
	ADC	A,0
__m816_6n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_5n
__m816_5:
	ADD	HL,DE
	ADC	A,0
__m816_5n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_4n
__m816_4:
	ADD	HL,DE
	ADC	A,0
__m816_4n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_3n
__m816_3:
	ADD	HL,DE
	ADC	A,0
__m816_3n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_2n
__m816_2:
	ADD	HL,DE
	ADC	A,0
__m816_2n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_1n
__m816_1:
	ADD	HL,DE
	ADC	A,0
__m816_1n:
	ADD	HL,HL
	RLA
	RET	NC
__m816_0:
	ADD	HL,DE
	ADC	A,0
	RET


	CSEG
; ============================================================
; rt_neg32.mac
; ============================================================
; rt_neg32.mac - 32-bit negate
; A module of its own: rt_float (linked from the library for printf)
; needs it, and it should not bring in the rest of rt_arith32.


	CSEG

; ============================================================
; 32-bit negate: DEHL = -DEHL
; ============================================================
	PUBLIC	__neg32
__neg32:
	XOR	A
	SUB	L
	LD	L,A
	LD	A,0
	SBC	A,H
	LD	H,A
	LD	A,0
	SBC	A,E
