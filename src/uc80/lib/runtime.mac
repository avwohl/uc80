	SBC	A,A
	SUB	D
	LD	D,A
__sdiv16_1:
	BIT	7,H
	JR	Z,__sdiv16_2
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__sdiv16_2:
	CALL	__div16
	POP	AF
	RET	P
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
	RET


