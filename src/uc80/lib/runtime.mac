	EX	DE,HL
	CP	8
	JR	NC,__sar16_8
	OR	A
	RET	Z
__sar16_lp:
	SRA	H
	RR	L
	DEC	A
	JR	NZ,__sar16_lp
	RET
__sar16_8:
	CP	16
	JR	NC,__sar16_f
