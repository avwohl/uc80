	XOR	0FFH
	LD	H,A
	LD	A,L
	XOR	0FFH
	LD	L,A
__clrsb16_pos:
	; Now HL has leading 0 bits we count, MSB is 0.
	LD	A,H
	OR	L
	JR	Z,__clrsb16_all_same	; all bits matched sign → 15
	CALL	__clz16
	DEC	HL
	RET
__clrsb16_all_same:
	LD	HL,15
	RET


