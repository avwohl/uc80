	; Divide by denominator for imag part
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__cplx_work)
	LD	DE,(__cplx_work+2)
	LD	BC,(__tmp32)
	LD	(__cplx_work+4),BC
	LD	BC,(__tmp32+2)
	LD	(__cplx_work+6),BC
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__cplx_work+4)
	LD	DE,(__cplx_work+6)
	CALL	__fdiv			; DEHL = (bc-ad)/(c²+d²)
