	CP	8
	JR	C,__shl32_2
	LD	D,E		; shift by 8: byte move
	LD	E,H
	LD	H,L
	LD	L,0
	SUB	8
__shl32_2:
	CP	5
	JR	C,__shl32_s
	PUSH	BC
	LD	B,A
	LD	A,8
	SUB	B
	LD	B,A
	XOR	A
__shl32_rl:
	SRL	D
	RR	E
	RR	H
	RR	L
	RRA
	DJNZ	__shl32_rl
	LD	D,E
	LD	E,H
	LD	H,L
	LD	L,A
	POP	BC
	RET
__shl32_z:
	LD	HL,0
	LD	D,H
	LD	E,L
	RET


	CSEG
; ============================================================
; rt_shl64.mac
; ============================================================
; rt_shl64.mac - __shl64
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __shl64: 64-bit left shift __acc64 = __acc64 << A
; Input: A = shift count (0-63)
; ============================================================
	PUBLIC	__shl64
__shl64:
	AND	63			; Limit to 0-63
	RET	Z			; No shift needed
	PUSH	BC
	LD	B,A			; B = shift count
__shl64_loop:
	; Shift left by 1: shift each word and propagate carry
	LD	HL,(__acc64)
	ADD	HL,HL			; Shift word 0, carry out
	LD	(__acc64),HL
	LD	HL,(__acc64+2)
	ADC	HL,HL			; Shift word 1 with carry in
	LD	(__acc64+2),HL
	LD	HL,(__acc64+4)
	ADC	HL,HL			; Shift word 2 with carry in
	LD	(__acc64+4),HL
	LD	HL,(__acc64+6)
	ADC	HL,HL			; Shift word 3 with carry in
	LD	(__acc64+6),HL
	DJNZ	__shl64_loop
	POP	BC
	RET


	CSEG
; ============================================================
; rt_shr16.mac
; ============================================================
; rt_shr16.mac - __shr16
; Split from rt_arith16.mac


	CSEG
; ============================================================
; 16-bit logical right shift: HL = DE >> L (unsigned)
; ============================================================
	PUBLIC	__shr16
__shr16:
	LD	A,L
	EX	DE,HL
	CP	8
	JR	NC,__shr16_8
	OR	A
	RET	Z
__shr16_lp:
	SRL	H
	RR	L
	DEC	A
	JR	NZ,__shr16_lp
	RET
__shr16_8:
	CP	16
	JR	NC,__shr16_z
	LD	L,H		; shift by 8 is a byte move
	LD	H,0
	SUB	8
	RET	Z
__shr16_b:
	SRL	L
	DEC	A
	JR	NZ,__shr16_b
	RET
__shr16_z:
	LD	HL,0
	RET


	CSEG
; ============================================================
; rt_shr32.mac
; ============================================================
; rt_shr32.mac - __shr32
; Split from rt_arith32.mac


	CSEG
; ============================================================
; 32-bit logical right shift: DEHL = DEHL >> A (unsigned)
; ============================================================
	PUBLIC	__shr32
__shr32:
	CP	5
	JR	NC,__shr32_b
__shr32_s:
	OR	A
	RET	Z
__shr32_lp:
	SRL	D
	RR	E
	RR	H
	RR	L
	DEC	A
	JR	NZ,__shr32_lp
	RET
__shr32_b:
	CP	32
	JR	NC,__shr32_z
	CP	16
	JR	C,__shr32_1
	EX	DE,HL		; shift by 16: word move
	LD	DE,0
	SUB	16
__shr32_1:
	CP	8
	JR	C,__shr32_2
	LD	L,H		; shift by 8: byte move
	LD	H,E
	LD	E,D
	LD	D,0
	SUB	8
__shr32_2:
	CP	5
	JR	C,__shr32_s
	PUSH	BC		; 5..7: left by 8-n into a fifth byte
	LD	B,A
	LD	A,8
	SUB	B
	LD	B,A
	XOR	A
__shr32_ll:
	ADD	HL,HL
	RL	E
	RL	D
	RLA
	DJNZ	__shr32_ll
	LD	L,H
	LD	H,E
	LD	E,D
	LD	D,A
	POP	BC
	RET
__shr32_z:
	LD	HL,0
	LD	D,H
	LD	E,L
	RET


	CSEG
; ============================================================
; rt_shr64.mac
; ============================================================
; rt_shr64.mac - __shr64
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __shr64: 64-bit logical right shift __acc64 = __acc64 >> A
; Input: A = shift count (0-63)
; ============================================================
	PUBLIC	__shr64
__shr64:
	AND	63
	RET	Z
	PUSH	BC
	LD	B,A
__shr64_loop:
	; Shift right by 1 from MSB
	LD	HL,(__acc64+6)
	SRL	H
	RR	L
	LD	(__acc64+6),HL
	LD	HL,(__acc64+4)
	RR	H
	RR	L
	LD	(__acc64+4),HL
	LD	HL,(__acc64+2)
	RR	H
	RR	L
	LD	(__acc64+2),HL
	LD	HL,(__acc64)
	RR	H
	RR	L
	LD	(__acc64),HL
	DJNZ	__shr64_loop
	POP	BC
	RET


	CSEG
; ============================================================
; rt_smod16.mac
; ============================================================
; rt_smod16.mac - __smod16
; Split from rt_arith16.mac



	CSEG
; ============================================================
; 16-bit signed modulo: HL = DE % HL (signed)
; Result has same sign as dividend (DE)
; ============================================================
	PUBLIC	__smod16
__smod16:
	LD	A,D
	OR	A
	PUSH	AF		; S flag = sign of the dividend
	JP	P,__smod16_1
	XOR	A		; DE = -DE
	SUB	E
	LD	E,A
	SBC	A,A
	SUB	D
	LD	D,A
__smod16_1:
	BIT	7,H
	JR	Z,__smod16_2
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__smod16_2:
	CALL	__div16
	EX	DE,HL		; HL = remainder
	POP	AF
	RET	P
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
	RET


	CSEG
; ============================================================
; rt_smod32.mac
; ============================================================
; rt_smod32.mac - __smod32
; Split from rt_arith32.mac



	CSEG
; ============================================================
; 32-bit signed modulo: DEHL = DEHL % (__tmp32) (signed)
; Result has same sign as dividend.  Leaves |divisor| in __tmp32.
; ============================================================
	PUBLIC	__smod32
__smod32:
	LD	A,D
	OR	A
	PUSH	AF		; S flag = sign of the dividend
	CALL	M,__neg32
	LD	A,(__tmp32+3)
	OR	A
	JP	P,__smod32_p
	PUSH	HL		; __tmp32 = -__tmp32
	LD	HL,__tmp32
	XOR	A
	SUB	(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	POP	HL
__smod32_p:
	CALL	__div32
	LD	HL,(__rem32)
	LD	DE,(__rem32+2)
	POP	AF
	RET	P
	JP	__neg32


	CSEG
; ============================================================
; rt_smod64.mac
; ============================================================
; rt_smod64.mac - __smod64
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __smod64: 64-bit signed modulo __acc64 = __acc64 % __tmp64
; Remainder has same sign as dividend
; ============================================================
	PUBLIC	__smod64
__smod64:
	; Save dividend sign
	LD	A,(__acc64+7)
	PUSH	AF

	; Check signs
	LD	B,A
	LD	A,(__tmp64+7)
	XOR	B
	PUSH	AF

	; Make dividend positive
	LD	A,(__acc64+7)
	BIT	7,A
	JR	Z,__smod64_dvdpos
	CALL	__neg64
__smod64_dvdpos:
	; Make divisor positive
	LD	A,(__tmp64+7)
	BIT	7,A
	JR	Z,__smod64_dvspos
	PUSH	HL
	LD	HL,0
	LD	BC,(__tmp64)
	OR	A
	SBC	HL,BC
	LD	(__tmp64),HL
	LD	HL,0
	LD	BC,(__tmp64+2)
	SBC	HL,BC
	LD	(__tmp64+2),HL
	LD	HL,0
	LD	BC,(__tmp64+4)
	SBC	HL,BC
	LD	(__tmp64+4),HL
	LD	HL,0
	LD	BC,(__tmp64+6)
	SBC	HL,BC
	LD	(__tmp64+6),HL
	POP	HL
__smod64_dvspos:
	; Do unsigned division (remainder in __rem64)
	CALL	__div64

	; Load remainder into __acc64
	LD	HL,(__rem64)
	LD	(__acc64),HL
	LD	HL,(__rem64+2)
	LD	(__acc64+2),HL
	LD	HL,(__rem64+4)
	LD	(__acc64+4),HL
	LD	HL,(__rem64+6)
	LD	(__acc64+6),HL

	; Negate remainder if dividend was negative
	POP	AF		; discard result sign
	POP	AF		; dividend sign
	BIT	7,A
	RET	Z
	JP	__neg64		; tail call


	CSEG
; ============================================================
; rt_smul32.mac
; ============================================================
; rt_smul32.mac - __smul32
; Split from rt_arith32.mac



	CSEG
; ============================================================
; 32-bit signed multiplication: DEHL = DEHL * (__tmp32)
; The low 32 bits of a product do not depend on the signs, so this
; is __mul32.  Not a bare "JP __mul32": the peephole pass runs on
; the code between inline-asm regions one piece at a time, and a
; label whose only code is a jump, with no reference in the same
; piece, is removed as a jump to a jump.
; ============================================================
	PUBLIC	__smul32
__smul32:
	PUSH	BC
	CALL	__mul32
	POP	BC
	RET


	CSEG
; ============================================================
; rt_sret.mac
; ============================================================
; rt_sret.mac - struct return buffer
; Split out of rt_arith32.mac: __sret_buf is where a function returning a
; struct by value leaves its result, so every translation unit that returns
; a struct references it, and it has nothing to do with 32-bit arithmetic.
; Sharing a module with the arith32 code gave it two homes -- the runtime
; the compiler embeds and rt_arith32 in runtime.lib -- and a program that
; embedded it and then pulled rt_arith32 for a 32-bit helper defined it
; twice.  Alone in its own module it is pulled only when it is unresolved.


	COMMON	/rt_sret/
	PUBLIC	__sret_buf
__sret_buf:	DS	256		; Struct return buffer

	CSEG
; ============================================================
; rt_store64.mac
; ============================================================
; rt_store64.mac - __store64
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __store64: Store __acc64 to address
; Input: HL = destination address
; Output: __acc64 stored at address
; ============================================================
	PUBLIC	__store64
__store64:
	PUSH	DE
	LD	DE,(__acc64)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL
	LD	DE,(__acc64+2)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL
	LD	DE,(__acc64+4)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL
	LD	DE,(__acc64+6)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	POP	DE
	RET


	CSEG
; ============================================================
; rt_sub32.mac
; ============================================================
; rt_sub32.mac - __sub32
; Split from rt_arith32.mac



	CSEG
; ============================================================
; 32-bit subtraction: DEHL = DEHL - (__tmp32)
; ============================================================
	PUBLIC	__sub32
__sub32:
	PUSH	BC
	LD	BC,(__tmp32)
	OR	A		; Clear carry
	SBC	HL,BC		; HL = left.low - right.low
	EX	DE,HL
	LD	BC,(__tmp32+2)
	SBC	HL,BC		; HL = left.high - right.high - borrow
	EX	DE,HL
	POP	BC
	RET


	CSEG
; ============================================================
; rt_sub64.mac
; ============================================================
; rt_sub64.mac - __sub64
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __sub64: 64-bit subtraction __acc64 = __acc64 - __tmp64
; ============================================================
	PUBLIC	__sub64
__sub64:
	PUSH	BC
	PUSH	DE
	; Subtract word 0
	LD	HL,(__acc64)
	LD	BC,(__tmp64)
	OR	A			; Clear carry
	SBC	HL,BC
	LD	(__acc64),HL
	; Subtract word 1 with borrow
	LD	HL,(__acc64+2)
	LD	BC,(__tmp64+2)
	SBC	HL,BC
	LD	(__acc64+2),HL
	; Subtract word 2 with borrow
	LD	HL,(__acc64+4)
	LD	BC,(__tmp64+4)
	SBC	HL,BC
	LD	(__acc64+4),HL
	; Subtract word 3 with borrow
	LD	HL,(__acc64+6)
	LD	BC,(__tmp64+6)
	SBC	HL,BC
	LD	(__acc64+6),HL
	POP	DE
	POP	BC
	RET


	CSEG
; ============================================================
; rt_tmp32.mac
; ============================================================
; rt_tmp32.mac - __tmp32, the right operand of the 32-bit helpers
; A data module of its own: many libc modules use __tmp32, and
; linking one of them should not bring in rt_arith32.


	COMMON	/rt_tmp32/
	PUBLIC	__tmp32
__tmp32:
	DS	4


	CSEG
; ============================================================
; rt_ucmp64.mac
; ============================================================
; rt_ucmp64.mac - __ucmp64
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __ucmp64: Compare __acc64 with __tmp64 (unsigned)
; Returns: HL = -1 if <, 0 if ==, 1 if >
; ============================================================
	PUBLIC	__ucmp64
__ucmp64:
	PUSH	BC
	; Compare from MSB to LSB
	LD	HL,(__acc64+6)
	LD	BC,(__tmp64+6)
	OR	A
	SBC	HL,BC
	JR	NZ,__ucmp64_neq
	LD	HL,(__acc64+4)
	LD	BC,(__tmp64+4)
	SBC	HL,BC
	JR	NZ,__ucmp64_neq
	LD	HL,(__acc64+2)
	LD	BC,(__tmp64+2)
	SBC	HL,BC
	JR	NZ,__ucmp64_neq
	LD	HL,(__acc64)
	LD	BC,(__tmp64)
	SBC	HL,BC
	JR	NZ,__ucmp64_neq
	; Equal
	LD	HL,0
	POP	BC
	RET
__ucmp64_neq:
	JR	C,__ucmp64_lt
	LD	HL,1
	POP	BC
	RET
__ucmp64_lt:
	LD	HL,-1
	POP	BC
	RET


	CSEG
; ============================================================
; rt_uitof.mac
; ============================================================
; rt_uitof.mac - __uitof
; Split from rt_float.mac



	CSEG
; ============================================================
; Unsigned Integer to Float: DEHL = float(DEHL) (unsigned 32-bit)
; ============================================================
	PUBLIC	__uitof
__uitof:
	PUSH	BC

	; Check for zero
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__uitof_nz
	LD	DE,0
	LD	HL,0
	JR	__uitof_done

__uitof_nz:
	; Sign is always positive
	XOR	A
	LD	(__fsgn1),A

	; Initial exponent = 127 + 23 (normalizing to bit 23)
	PUSH	HL
	LD	HL,127+23
	LD	(__fexp1),HL
	POP	HL

	; If high byte D has bits set, shift right to bring mantissa
	; into 24-bit range (bits 0-23) before __fnorm
	LD	BC,0		; B = the last bit shifted out, C = the bits before it
__uitof_rshift:
	LD	A,D
	OR	A
	JR	Z,__uitof_round
	LD	A,B
	OR	C
	LD	C,A
	; Shift DEHL right by 1
	SRL	D
	RR	E
	RR	H
	RR	L
	LD	A,0
	RLA
	LD	B,A
	; Increment exponent
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	JR	__uitof_rshift

__uitof_round:
	; Round to nearest, ties to even (the shift lost the bits in B and C)
	LD	A,B
	OR	A
	JR	Z,__uitof_store
	LD	A,C
	OR	A
	JR	NZ,__uitof_up
	BIT	0,L
	JR	Z,__uitof_store
__uitof_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,__uitof_store
	INC	DE
__uitof_store:
	; Store mantissa
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Normalize
	CALL	__fnorm

	; Pack
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

__uitof_done:
	POP	BC
	RET


	CSEG
; ============================================================
; rt_xor32.mac
; ============================================================
; rt_xor32.mac - __xor32
; Split from rt_arith32.mac



	CSEG
; ============================================================
; 32-bit bitwise XOR: DEHL = DEHL ^ (__tmp32)
; ============================================================
	PUBLIC	__xor32
__xor32:
	LD	A,(__tmp32)
	XOR	L
	LD	L,A
	LD	A,(__tmp32+1)
	XOR	H
	LD	H,A
	LD	A,(__tmp32+2)
	XOR	E
	LD	E,A
	LD	A,(__tmp32+3)
	XOR	D
	LD	D,A
	RET


	CSEG
; ============================================================
; rt_xor64.mac
; ============================================================
; rt_xor64.mac - __xor64
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __xor64: 64-bit bitwise XOR __acc64 = __acc64 ^ __tmp64
; ============================================================
	PUBLIC	__xor64
__xor64:
	PUSH	BC
	LD	HL,(__acc64)
	LD	BC,(__tmp64)
	LD	A,L
	XOR	C
	LD	L,A
	LD	A,H
	XOR	B
	LD	H,A
	LD	(__acc64),HL
	LD	HL,(__acc64+2)
	LD	BC,(__tmp64+2)
	LD	A,L
	XOR	C
	LD	L,A
	LD	A,H
	XOR	B
	LD	H,A
	LD	(__acc64+2),HL
	LD	HL,(__acc64+4)
	LD	BC,(__tmp64+4)
	LD	A,L
	XOR	C
	LD	L,A
	LD	A,H
	XOR	B
	LD	H,A
	LD	(__acc64+4),HL
	LD	HL,(__acc64+6)
	LD	BC,(__tmp64+6)
	LD	A,L
	XOR	C
	LD	L,A
	LD	A,H
	XOR	B
	LD	H,A
	LD	(__acc64+6),HL
	POP	BC
	RET


	CSEG
; ============================================================
; rt_zext32.mac
; ============================================================
; rt_zext32.mac - __zext32
; Split from rt_arith32.mac


	CSEG
; ============================================================
; Zero-extend 16-bit HL to 32-bit DEHL
; ============================================================
	PUBLIC	__zext32
__zext32:
	LD	DE,0
	RET


	CSEG
; ============================================================
; rt_zext64.mac
; ============================================================
; rt_zext64.mac - __zext64
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __zext64: Zero-extend 32-bit DEHL to 64-bit in __acc64
; Input: DEHL = 32-bit value
; Output: __acc64 = zero-extended 64-bit value
; ============================================================
	PUBLIC	__zext64
__zext64:
	LD	(__acc64),HL		; Store low word
	LD	(__acc64+2),DE		; Store second word
	LD	HL,0
	LD	(__acc64+4),HL		; Upper 32 bits = 0
	LD	(__acc64+6),HL
	RET


	CSEG
; ============================================================
; rt_zext64_hl.mac
; ============================================================
; rt_zext64_hl.mac - __zext64_hl
; Split from rt_arith64.mac



	CSEG
; ============================================================
; __zext64_hl: Zero-extend 16-bit HL to 64-bit in __acc64
; ============================================================
	PUBLIC	__zext64_hl
__zext64_hl:
	LD	DE,0
	JP	__zext64		; tail call


	END
