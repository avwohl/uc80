; ============================================================
; Complex Multiplication: __cplx_result = __cplx_l * __cplx_r
; (a+bi) * (c+di) = (ac-bd) + (ad+bc)i
; Let: a=l.real, b=l.imag, c=r.real, d=r.imag
; ============================================================
	PUBLIC	__cmul
__cmul:
	; Calculate ac (a*c)
	LD	HL,(__cplx_r)		; c low
	LD	DE,(__cplx_r+2)		; c high
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__cplx_l)		; a low
	LD	DE,(__cplx_l+2)		; a high
	CALL	__fmul			; DEHL = a*c
	LD	(__cplx_work),HL	; store ac
	LD	(__cplx_work+2),DE

	; Calculate bd (b*d)
	LD	HL,(__cplx_r+4)		; d low
	LD	DE,(__cplx_r+6)		; d high
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__cplx_l+4)		; b low
	LD	DE,(__cplx_l+6)		; b high
	CALL	__fmul			; DEHL = b*d
	; Store bd in __tmp32 for subtraction
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	; result.real = ac - bd
	LD	HL,(__cplx_work)
	LD	DE,(__cplx_work+2)
	CALL	__fsub
	LD	(__cplx_result),HL
	LD	(__cplx_result+2),DE

	; Calculate ad (a*d)
	LD	HL,(__cplx_r+4)		; d low
	LD	DE,(__cplx_r+6)		; d high
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__cplx_l)		; a low
	LD	DE,(__cplx_l+2)		; a high
	CALL	__fmul			; DEHL = a*d
	LD	(__cplx_work),HL	; store ad
	LD	(__cplx_work+2),DE

	; Calculate bc (b*c)
	LD	HL,(__cplx_r)		; c low
	LD	DE,(__cplx_r+2)		; c high
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__cplx_l+4)		; b low
	LD	DE,(__cplx_l+6)		; b high
	CALL	__fmul			; DEHL = b*c
	; Store bc in __tmp32 for addition
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	; result.imag = ad + bc
	LD	HL,(__cplx_work)
	LD	DE,(__cplx_work+2)
	CALL	__fadd
	LD	(__cplx_result+4),HL
	LD	(__cplx_result+6),DE
	RET


	CSEG
; ============================================================
; rt_cplx_data.mac
; ============================================================
; rt_cplx_data.mac - __cplx_l, __cplx_r, __cplx_result, __cplx_tmp
; Split from rt_complex.mac


	COMMON	/rt_cplx_data/
	PUBLIC	__cplx_l
__cplx_l:
	DS	8
	PUBLIC	__cplx_r
__cplx_r:
	DS	8
	PUBLIC	__cplx_result
__cplx_result:
	DS	8
	PUBLIC	__cplx_tmp
__cplx_tmp:
	DS	8
	PUBLIC	__cplx_work
__cplx_work:
	DS	8


	CSEG
; ============================================================
; rt_csub.mac
; ============================================================
; rt_csub.mac - __csub
; Split from rt_complex.mac



	CSEG
; ============================================================
; Complex Subtraction: __cplx_result = __cplx_l - __cplx_r
; (a+bi) - (c+di) = (a-c) + (b-d)i
; ============================================================
	PUBLIC	__csub
__csub:
	; Sub real parts: result.real = l.real - r.real
	LD	HL,(__cplx_r)		; r.real low
	LD	DE,(__cplx_r+2)		; r.real high
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__cplx_l)		; l.real low
	LD	DE,(__cplx_l+2)		; l.real high
	CALL	__fsub
	LD	(__cplx_result),HL
	LD	(__cplx_result+2),DE

	; Sub imag parts: result.imag = l.imag - r.imag
	LD	HL,(__cplx_r+4)		; r.imag low
	LD	DE,(__cplx_r+6)		; r.imag high
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__cplx_l+4)		; l.imag low
	LD	DE,(__cplx_l+6)		; l.imag high
	CALL	__fsub
	LD	(__cplx_result+4),HL
	LD	(__cplx_result+6),DE
	RET


	CSEG
; ============================================================
; rt_ctz16.mac
; ============================================================
; rt_ctz16.mac - __ctz16
; Split from rt_arith16.mac


	CSEG
; ============================================================
; __ctz16 — count trailing zeros of 16-bit HL.
; Undefined for x=0 per GCC. Returns 16 if HL == 0 (defensive).
; ============================================================
	PUBLIC	__ctz16
__ctz16:
	LD	A,H
	OR	L
	JR	Z,__ctz16_zero
	PUSH	BC
	LD	B,0
__ctz16_lp:
	BIT	0,L
	JR	NZ,__ctz16_done
	INC	B
	SRL	H
	RR	L
	JR	__ctz16_lp
__ctz16_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ctz16_zero:
	LD	HL,16
	RET


	CSEG
; ============================================================
; rt_ctz32.mac
; ============================================================
; rt_ctz32.mac - __ctz32
; Split from rt_arith32.mac


	CSEG
; ============================================================
; __ctz32 — count trailing zeros of 32-bit DEHL.
; ============================================================
	PUBLIC	__ctz32
__ctz32:
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,__ctz32_zero
	PUSH	BC
	LD	B,0
__ctz32_lp:
	BIT	0,L
	JR	NZ,__ctz32_done
	INC	B
	; Shift DEHL right by 1
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	__ctz32_lp
__ctz32_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ctz32_zero:
	LD	HL,32
	RET


	CSEG
; ============================================================
; rt_ctz64.mac
; ============================================================
; rt_ctz64.mac - __ctz64
; Split from rt_arith64.mac



	CSEG
	PUBLIC	__ctz64
__ctz64:
	LD	A,(__acc64)
	LD	B,A
	LD	A,(__acc64+1)
	OR	B
	LD	B,A
	LD	A,(__acc64+2)
	OR	B
	LD	B,A
	LD	A,(__acc64+3)
	OR	B
	LD	B,A
	LD	A,(__acc64+4)
	OR	B
	LD	B,A
	LD	A,(__acc64+5)
	OR	B
	LD	B,A
	LD	A,(__acc64+6)
	OR	B
	LD	B,A
	LD	A,(__acc64+7)
	OR	B
	JR	NZ,__ctz64_nz
	LD	HL,64
	RET
__ctz64_nz:
	PUSH	BC
	LD	BC,0
__ctz64_lp:
	LD	A,(__acc64)
	AND	1
	JR	NZ,__ctz64_done
	INC	BC
	; Shift __acc64 right by 1
	LD	HL,(__acc64+6)
	SRL	H
	RR	L
	LD	(__acc64+6),HL
	LD	HL,(__acc64+4)
	RR	H
	RR	L
	LD	(__acc64+4),HL
	LD	HL,(__acc64+2)
	RR	H
	RR	L
	LD	(__acc64+2),HL
	LD	HL,(__acc64)
	RR	H
	RR	L
	LD	(__acc64),HL
	JR	__ctz64_lp
__ctz64_done:
	LD	L,C
	LD	H,B
	POP	BC
	RET


	CSEG
; ============================================================
; rt_div16.mac
; ============================================================
; rt_div16.mac - __div16
; Split from rt_arith16.mac



	CSEG
; ============================================================
; 16-bit unsigned division: HL = DE / HL
; Also sets __divrem to remainder (DE % HL), and returns the
; remainder in DE.  Division by zero: HL = 0, remainder 0.
; Preserves BC, IX, IY.  Clobbers A, flags.
; ============================================================
	PUBLIC	__div16
__div16:
	EX	DE,HL		; HL = dividend, DE = divisor
	LD	A,D
	OR	E
	JR	Z,__div16_zero
	PUSH	BC
	LD	A,D
	OR	A
	JR	NZ,__div16_w
	LD	C,E		; divisor < 256
	LD	A,H
	CP	C
	JR	C,__div16_lo	; H < divisor: quotient < 256
	LD	E,H
	XOR	A
	CALL	__dv8n		; E = quotient high byte, A = remainder
	LD	H,E
	LD	E,L
	CALL	__dv8n		; E = quotient low byte
	LD	L,E
	JR	__div16_n
__div16_lo:
	LD	E,L		; A = H is the remainder so far
	CALL	__dv8n
	LD	L,E
	LD	H,0
__div16_n:
	LD	E,A
	LD	D,0
	JR	__div16_done
__div16_w:
	LD	A,L		; divisor >= 256: quotient < 256
	LD	L,H
	LD	H,0
	CALL	__dv8w		; A = quotient, HL = remainder
	EX	DE,HL
	LD	L,A
	LD	H,0
__div16_done:
	LD	(__divrem),DE
	POP	BC
	RET
__div16_zero:
	LD	HL,0
	LD	(__divrem),HL
	LD	D,H
	LD	E,L
	RET


	CSEG
; ============================================================
; rt_div32.mac
; ============================================================
; rt_div32.mac - __div32
; Split from rt_arith32.mac



	CSEG
; ============================================================
; 32-bit unsigned division: DEHL = DEHL / (__tmp32)
; Also stores remainder in __rem32.
; Division by zero: quotient 0FFFFFFFFH, remainder = dividend.
; Preserves BC, IX, IY.  __tmp32 is not changed.
;
; Divisor < 65536: long division one dividend byte at a time
; (__dv8n for an 8-bit divisor, __dv8w for a 16-bit one), with a
; 16-bit running remainder; leading bytes below the divisor cost
; almost nothing.  Divisor >= 65536: the quotient has at most 16
; bits (8 when the divisor is >= 2^24), so only that many steps of
; 32-bit restoring division run.
; ============================================================
	PUBLIC	__div32
__div32:
	PUSH	BC
	LD	(__div32_dvd),HL
	LD	(__div32_dvd+2),DE
	LD	HL,(__tmp32+2)
	LD	A,H
	OR	L
	JP	NZ,__div32_big
	LD	DE,(__tmp32)
	LD	A,D
	OR	A
	JR	NZ,__div32_w
	OR	E
	JR	Z,__div32_zero
	LD	C,E		; divisor 1..255
	LD	HL,__div32_dvd+3
	XOR	A
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	LD	L,A
	LD	H,0
	JR	__div32_r16
__div32_w:
	LD	HL,0		; divisor 256..65535
	LD	A,(__div32_dvd+3)
	CALL	__dv8w
	LD	(__div32_dvd+3),A
	LD	A,(__div32_dvd+2)
	CALL	__dv8w
	LD	(__div32_dvd+2),A
	LD	A,(__div32_dvd+1)
	CALL	__dv8w
	LD	(__div32_dvd+1),A
	LD	A,(__div32_dvd)
	CALL	__dv8w
	LD	(__div32_dvd),A
__div32_r16:
	LD	(__rem32),HL
	LD	HL,0
	LD	(__rem32+2),HL
__div32_q:
	LD	HL,(__div32_dvd)
	LD	DE,(__div32_dvd+2)
	POP	BC
	RET
__div32_zero:
	LD	HL,(__div32_dvd)
	LD	(__rem32),HL
	LD	HL,(__div32_dvd+2)
	LD	(__rem32+2),HL
	LD	HL,0FFFFH
	LD	D,H
	LD	E,L
	POP	BC
	RET
__div32_big:
	PUSH	IY
	LD	IY,__tmp32
	LD	A,H
	OR	A
	JR	NZ,__div32_b3
	LD	DE,0		; divisor < 2^24: remainder starts as the
	LD	HL,(__div32_dvd+2) ; high word, two quotient bytes
	LD	A,(__div32_dvd+1)
	LD	C,A
	CALL	__div32_g
	LD	A,C
	LD	(__div32_dvd+1),A
	JR	__div32_b0
__div32_b3:
	LD	A,(__div32_dvd+3) ; divisor >= 2^24: remainder starts as
	LD	E,A		; the top three bytes, one quotient byte
	LD	D,0
	LD	HL,(__div32_dvd+1)
	XOR	A
	LD	(__div32_dvd+1),A
__div32_b0:
	LD	A,(__div32_dvd)
	LD	C,A
	CALL	__div32_g
	LD	A,C
	LD	(__div32_dvd),A
	LD	(__rem32),HL
	LD	(__rem32+2),DE
	LD	HL,0
	LD	(__div32_dvd+2),HL
	POP	IY
	JR	__div32_q

; One quotient byte of 32-bit restoring division.
; In:  DEHL = remainder (< divisor), C = dividend byte, IY = __tmp32
; Out: C = quotient byte, DEHL = new remainder.  Clobbers A, B.
__div32_g:
	LD	B,8
__div32_gl:
	SLA	C		; next dividend bit out, quotient bit 0 in
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	JR	C,__div32_gs	; remainder passed 2^32: above the divisor
	LD	A,D		; compare DEHL with the divisor, top first
	CP	(IY+3)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,E
	CP	(IY+2)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,H
	CP	(IY+1)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,L
	CP	(IY+0)
	JR	C,__div32_gn
__div32_gs:
	LD	A,L		; DEHL -= divisor
	SUB	(IY+0)
	LD	L,A
	LD	A,H
	SBC	A,(IY+1)
	LD	H,A
	LD	A,E
	SBC	A,(IY+2)
	LD	E,A
	LD	A,D
	SBC	A,(IY+3)
	LD	D,A
	INC	C
__div32_gn:
	DJNZ	__div32_gl
	RET


	CSEG
; ============================================================
; rt_div64.mac
; ============================================================
; rt_div64.mac - __div64
; Split from rt_arith64.mac



	CSEG
	PUBLIC	__div64
__div64:
	PUSH	BC
	PUSH	DE

	; Save dividend (__acc64) to __div64_dvd
	LD	HL,(__acc64)
	LD	(__div64_dvd),HL
	LD	HL,(__acc64+2)
	LD	(__div64_dvd+2),HL
	LD	HL,(__acc64+4)
	LD	(__div64_dvd+4),HL
	LD	HL,(__acc64+6)
	LD	(__div64_dvd+6),HL

	; Quotient in __acc64 (start at 0)
	LD	HL,0
	LD	(__acc64),HL
	LD	(__acc64+2),HL
	LD	(__acc64+4),HL
	LD	(__acc64+6),HL

	; Remainder starts at 0
	LD	(__rem64),HL
	LD	(__rem64+2),HL
	LD	(__rem64+4),HL
	LD	(__rem64+6),HL

	LD	B,64		; 64 bits

__div64_loop:
	; Shift dividend left, MSB into carry
	LD	HL,(__div64_dvd)
	ADD	HL,HL
	LD	(__div64_dvd),HL
	LD	HL,(__div64_dvd+2)
	ADC	HL,HL
	LD	(__div64_dvd+2),HL
	LD	HL,(__div64_dvd+4)
	ADC	HL,HL
	LD	(__div64_dvd+4),HL
	LD	HL,(__div64_dvd+6)
	ADC	HL,HL
	LD	(__div64_dvd+6),HL

	; Rotate carry into remainder (shift remainder left, carry in LSB)
	LD	HL,(__rem64)
	ADC	HL,HL
	LD	(__rem64),HL
	LD	HL,(__rem64+2)
	ADC	HL,HL
	LD	(__rem64+2),HL
	LD	HL,(__rem64+4)
	ADC	HL,HL
	LD	(__rem64+4),HL
	LD	HL,(__rem64+6)
	ADC	HL,HL
	LD	(__rem64+6),HL

	; Shift quotient (__acc64) left
	LD	HL,(__acc64)
	ADD	HL,HL
	LD	(__acc64),HL
	LD	HL,(__acc64+2)
	ADC	HL,HL
	LD	(__acc64+2),HL
	LD	HL,(__acc64+4)
	ADC	HL,HL
	LD	(__acc64+4),HL
	LD	HL,(__acc64+6)
	ADC	HL,HL
	LD	(__acc64+6),HL

	; Check if remainder >= divisor (__tmp64)
	; Compare from MSW to LSW
	LD	HL,(__rem64+6)
	LD	DE,(__tmp64+6)
	OR	A
	SBC	HL,DE
	JR	NZ,__div64_chk	; Not equal at word 3
	LD	HL,(__rem64+4)
	LD	DE,(__tmp64+4)
	SBC	HL,DE
	JR	NZ,__div64_chk
	LD	HL,(__rem64+2)
	LD	DE,(__tmp64+2)
	SBC	HL,DE
	JR	NZ,__div64_chk
	LD	HL,(__rem64)
	LD	DE,(__tmp64)
	SBC	HL,DE
__div64_chk:
	JR	C,__div64_nosub	; remainder < divisor, skip

	; remainder >= divisor: subtract divisor from remainder
	LD	HL,(__rem64)
	LD	DE,(__tmp64)
	OR	A
	SBC	HL,DE
	LD	(__rem64),HL
	LD	HL,(__rem64+2)
	LD	DE,(__tmp64+2)
	SBC	HL,DE
	LD	(__rem64+2),HL
	LD	HL,(__rem64+4)
	LD	DE,(__tmp64+4)
	SBC	HL,DE
	LD	(__rem64+4),HL
	LD	HL,(__rem64+6)
	LD	DE,(__tmp64+6)
	SBC	HL,DE
	LD	(__rem64+6),HL

	; Set LSB of quotient
	LD	HL,(__acc64)
	SET	0,L
	LD	(__acc64),HL

__div64_nosub:
	DJNZ	__div64_loop
	; B wrapped from 0 to 255 for first 255, then need to handle remaining
	; Actually DJNZ with B=64 will loop 64 times correctly
	; (B goes 64->63->...->1->0, DJNZ stops when B reaches 0)

	POP	DE
	POP	BC
	RET


	CSEG
; ============================================================
; rt_divrem.mac
; ============================================================
; rt_divrem.mac - __divrem
; Split from rt_arith16.mac


	COMMON	/rt_divrem/
	PUBLIC	__divrem
__divrem:
	DS	2


	CSEG
; ============================================================
; rt_dv8n.mac
; ============================================================
; rt_dv8n.mac - __dv8n
; Split from rt_div8.mac


	CSEG
; ============================================================
; __dv8n - one byte of long division by an 8-bit divisor
; In:  A = running remainder (< C), E = next dividend byte,
;      C = divisor (1..255)
; Out: E = quotient byte, A = new remainder
; Preserves C, D, HL, IX, IY.  Clobbers B, flags.
; ============================================================
	PUBLIC	__dv8n
__dv8n:
	OR	A
	JR	NZ,__dv8n_go
	LD	A,E		; remainder 0: if the byte is below the
	CP	C		; divisor the quotient byte is 0
	JR	NC,__dv8n_g0
	LD	E,0
	RET
__dv8n_g0:
	XOR	A
__dv8n_go:
	LD	B,8
	BIT	7,C
	JR	NZ,__dv8n_hi
	; Divisor < 128: 2*remainder+1 fits in a byte.  The carry after
	; CP/SUB is the complement of the quotient bit; RL E shifts it in
	; as the next dividend bit leaves.
__dv8n_lp:
	RL	E
	RLA
	CP	C
	JR	C,__dv8n_nx
	SUB	C
__dv8n_nx:
	DJNZ	__dv8n_lp
	RL	E
	LD	B,A
	LD	A,E
	CPL
	LD	E,A
	LD	A,B
	RET
__dv8n_hi:
	SLA	E		; next dividend bit out, quotient bit 0 in
	RLA
	JR	C,__dv8n_sub	; remainder passed 255: above the divisor
	CP	C
	JR	C,__dv8n_hn
__dv8n_sub:
	SUB	C
	INC	E
__dv8n_hn:
	DJNZ	__dv8n_hi
	RET


	CSEG
; ============================================================
; rt_dv8w.mac
; ============================================================
; rt_dv8w.mac - __dv8w
; Split from rt_div8.mac


	CSEG
; ============================================================
; __dv8w - one byte of long division by a 16-bit divisor
; In:  HL = running remainder (< DE), A = next dividend byte,
;      DE = divisor (1..65535)
; Out: A = quotient byte, HL = new remainder
; Preserves C, DE, IX, IY.  Clobbers B, flags.
; ============================================================
	PUBLIC	__dv8w
__dv8w:
	LD	B,A
	LD	A,H
	OR	A
	JR	NZ,__dv8w_go
	LD	A,L		; remainder < 256: if L:byte < DE the
	CP	D		; quotient byte is 0
	JR	C,__dv8w_z
	JR	NZ,__dv8w_go
	LD	A,B
	CP	E
	JR	NC,__dv8w_go
__dv8w_z:
	LD	H,L
	LD	L,B
	XOR	A
	RET
__dv8w_go:
	LD	A,B
	LD	B,8
	BIT	7,D
	JR	NZ,__dv8w_hl
	; Divisor < 32768: 2*remainder+1 fits in 16 bits.  The carry
	; after SBC (or the restoring ADD) is the complement of the
	; quotient bit; RLA shifts it in as the next dividend bit leaves.
__dv8w_lp:
	RLA
	ADC	HL,HL
	SBC	HL,DE		; carry is 0 here
	JR	NC,__dv8w_ok
	ADD	HL,DE		; restore; this sets carry
__dv8w_ok:
	DJNZ	__dv8w_lp
	RLA
	CPL
	RET
__dv8w_hl:
	RLA
	ADC	HL,HL
	JR	C,__dv8w_ov	; remainder passed 65535: above the divisor
	SBC	HL,DE
	JR	NC,__dv8w_hk
	ADD	HL,DE
__dv8w_hk:
	DJNZ	__dv8w_hl
	RLA
	CPL
	RET
__dv8w_ov:
	OR	A
	SBC	HL,DE		; borrows
	CCF			; carry 0: quotient bit 1
	DJNZ	__dv8w_hl
	RLA
	CPL
	RET


	CSEG
; ============================================================
; rt_fadd.mac
; ============================================================
; rt_fadd.mac - __fadd
; Split from rt_float.mac



	CSEG
; ============================================================
; IEEE 754 Single-Precision Floating Point Library
; ============================================================
; Format: DEHL where D=high byte (sign+exp), E,H,L=mantissa
; Sign: bit 7 of D
; Exponent: bits 6-0 of D and bit 7 of E (8 bits total, bias 127)
; Mantissa: bits 6-0 of E and all of H,L (23 bits, implied 1.)
; ============================================================

; ============================================================
; Float Addition: DEHL = DEHL + (__tmp32)
;
; The result is rounded to nearest, ties to even.  Each mantissa has five
; extra low bits, and the bits that the alignment shifts out are OR-ed into
; the lowest of them.  A subnormal operand counts as zero, and a result
; below the smallest normal number is zero.  An infinity or a NaN in an
; operand gives the IEEE result.
;
; The data labels start with two underscores, because the compiler embeds
; only the data with such names (runtime.py).
;
; Each operand is unpacked into a block of 6 bytes:
;   +0 sign (0 or 80H), +1 exponent, +2 to +5 mantissa (32 bits, little endian)
; ============================================================
	PUBLIC	__fadd
__fadd:
	PUSH	BC
	PUSH	IX
	LD	(__fa_o1),HL
	LD	(__fa_o1+2),DE
	LD	IX,__fa1
	CALL	_fa_unp
	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	LD	IX,__fa2
	CALL	_fa_unp

	LD	A,(__fa1+1)
	LD	B,A		; B = exponent of operand 1
	LD	A,(__fa2+1)
	LD	C,A		; C = exponent of operand 2
	LD	A,B
	OR	A
	JR	Z,_fa_z1
	LD	A,C
	OR	A
	JR	Z,_fa_ret1
	LD	A,B
	CP	255
	JR	Z,_fa_sp
	LD	A,C
	CP	255
	JR	Z,_fa_sp

	; align: the operand with the smaller exponent shifts right
	LD	A,B
	SUB	C
	LD	L,B		; L = exponent of the result
	JR	Z,_fa_aligned
	JR	NC,_fa_sh2
	NEG
	LD	L,C
	LD	IX,__fa1
	JR	_fa_shift
_fa_sh2:
	LD	IX,__fa2
_fa_shift:
	LD	H,0
	LD	(__fa_e),HL
	CP	32
	JR	C,_fa_cnt
	LD	A,31
_fa_cnt:
	LD	B,A
	LD	L,(IX+2)
	LD	H,(IX+3)
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	C,0		; C = sticky
_fa_s1:
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	NC,_fa_s2
	LD	C,1
_fa_s2:
	DJNZ	_fa_s1
	LD	A,C
	OR	A
	JR	Z,_fa_s3
	SET	0,L
_fa_s3:
	LD	(IX+2),L
	LD	(IX+3),H
	LD	(IX+4),E
	LD	(IX+5),D
	JR	_fa_as2
_fa_aligned:
	LD	H,0
	LD	(__fa_e),HL
_fa_as2:
	; add or subtract the mantissas
	LD	A,(__fa1)
	LD	B,A
	LD	A,(__fa2)
	XOR	B
	JR	NZ,_fa_sub
	LD	HL,(__fa1+2)
	LD	BC,(__fa2+2)
	ADD	HL,BC
	PUSH	HL
	LD	HL,(__fa1+4)
	LD	BC,(__fa2+4)
	ADC	HL,BC
	EX	DE,HL
	POP	HL
	LD	A,(__fa1)
	JR	_fa_norm
_fa_sub:
	LD	HL,(__fa1+2)
	LD	BC,(__fa2+2)
	OR	A
	SBC	HL,BC
	PUSH	HL
	LD	HL,(__fa1+4)
	LD	BC,(__fa2+4)
	SBC	HL,BC
	EX	DE,HL
	POP	HL
	LD	A,(__fa1)
	JR	NC,_fa_norm
	; operand 2 is larger: the result is m2 - m1 with the sign of operand 2
	LD	HL,(__fa2+2)
	LD	BC,(__fa1+2)
	OR	A
	SBC	HL,BC
	PUSH	HL
	LD	HL,(__fa2+4)
	LD	BC,(__fa1+4)
	SBC	HL,BC
	EX	DE,HL
	POP	HL
	LD	A,(__fa2)
_fa_norm:
	LD	(__fa_s),A
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,_fa_nz
	LD	DE,0		; exact zero: +0
	LD	HL,0
	JR	_fa_done
_fa_nz:
	; normalise: the leading bit goes to bit 28 (bit 4 of D)
	LD	BC,(__fa_e)
	BIT	5,D
	JR	Z,_fa_nocarry
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	NC,_fa_c1
	SET	0,L
_fa_c1:
	INC	BC
	JR	_fa_round
_fa_nocarry:
	BIT	4,D
	JR	NZ,_fa_round
_fa_left:
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	DEC	BC
	BIT	4,D
	JR	Z,_fa_left
_fa_round:
	LD	A,L
	AND	1FH
	LD	(__fa_e),A	; the five low bits
	LD	A,B
	LD	B,5
_fa_shr5:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	_fa_shr5
	LD	B,A		; B = high byte of the exponent again
	LD	A,(__fa_e)
	CP	17
	JR	NC,_fa_up
	CP	16
	JR	NZ,_fa_rounded
	BIT	0,L
	JR	Z,_fa_rounded
_fa_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,_fa_rounded
	INC	DE
_fa_rounded:
	LD	A,D
	OR	A
	JR	Z,_fa_range
	LD	DE,0080H	; the mantissa carried to 2^24
	LD	HL,0
	INC	BC
_fa_range:
	LD	A,(__fa_s)
	LD	D,A		; D = sign (the high byte of the mantissa is zero)
	BIT	7,B
	JR	NZ,_fa_under
	LD	A,B
	OR	A
	JR	NZ,_fa_over
	LD	A,C
	OR	A
	JR	Z,_fa_under
	CP	255
	JR	NC,_fa_over
	LD	A,D
	LD	D,0
	CALL	__fpack
_fa_done:
	POP	IX
	POP	BC
	RET

_fa_under:
	LD	E,0
	LD	HL,0
	JR	_fa_done
_fa_over:
	LD	A,D
	OR	7FH
	LD	D,A
	LD	E,80H
	LD	HL,0
	JR	_fa_done

; operand 1 is zero (exponent 0): the result is operand 2, or a zero
_fa_z1:
	LD	A,C
	OR	A
	JR	NZ,_fa_ret2
	LD	A,(__fa1)
	LD	HL,__fa2
	AND	(HL)
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	_fa_done
_fa_ret2:
	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	JR	_fa_done
_fa_ret1:
	LD	HL,(__fa_o1)
	LD	DE,(__fa_o1+2)
	JR	_fa_done

; an exponent of 255: infinity or NaN
_fa_sp:
	LD	A,B
	CP	255
	JR	NZ,_fa_sp2
	LD	A,(__fa_o1+2)
	AND	7FH
	LD	HL,(__fa_o1)
	OR	H
	OR	L
	JR	NZ,_fa_ret1	; operand 1 is a NaN
_fa_sp2:
	LD	A,C
	CP	255
	JR	NZ,_fa_ret1	; operand 1 is the infinity
	LD	A,(__tmp32+2)
	AND	7FH
	LD	HL,(__tmp32)
	OR	H
	OR	L
	JR	NZ,_fa_ret2	; operand 2 is a NaN
	LD	A,B
	CP	255
	JR	NZ,_fa_ret2	; only operand 2 is infinite
	LD	A,(__fa1)
	LD	HL,__fa2
	XOR	(HL)
	JR	Z,_fa_ret1	; the same infinity twice
	LD	DE,07FC0H	; inf - inf: a quiet NaN
	LD	HL,0
	JR	_fa_done

; unpack the float in DEHL into the block at IX; the mantissa gets 5 more bits
_fa_unp:
	CALL	__funpack
	LD	(IX+0),A
	LD	(IX+1),C
	LD	B,5
_fa_u5:
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	DJNZ	_fa_u5
	LD	(IX+2),L
	LD	(IX+3),H
	LD	(IX+4),E
	LD	(IX+5),D
	RET

	COMMON	/rt_fadd/
__fa1:
	DS	6
__fa2:
	DS	6
__fa_o1:
	DS	4
__fa_e:
	DS	2
__fa_s:
	DS	1


	CSEG
; ============================================================
; rt_fcmp.mac
; ============================================================
; rt_fcmp.mac - __fcmp
; Split from rt_float.mac



	CSEG
; ============================================================
; Float Comparison: Compare DEHL with (__tmp32)
; Returns: Z if equal, C if DEHL < __tmp32.
; Unordered (either operand is a NaN): Z and C both set.  That pair
; never comes from an ordered compare, so the code generator tests it
; where an unordered result must give false (or true for !=).
; ============================================================
	PUBLIC	__fcmp
__fcmp:
	PUSH	BC

	; NaN check.  An exponent of FFH is D = 7FH|xx and E bit 7 set;
	; only then look at the mantissa.  Fast path: two compares.
	LD	A,D
	AND	7FH
	CP	7FH
	JR	Z,__fcmp_lchk
__fcmp_lok:
	LD	A,(__tmp32+3)
	AND	7FH
	CP	7FH
	JR	Z,__fcmp_rchk
__fcmp_rok:

	; IEEE 754: -0.0 == +0.0. Special-case zero before the bit-pattern
	; compare so a signed-zero pair doesn't end up "left < right" just
	; because the sign bit differs.
	LD	A,D
	AND	7FH		; mask off left's sign bit
	OR	E
	OR	H
	OR	L
	JR	NZ,__fcmp_lnz
	; left magnitude == 0; check right
	LD	A,(__tmp32+3)
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+2)
	OR	B
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,__fcmp_lnz
	; both zero (any sign) — return Z, NC
	XOR	A		; clears Z=1 actually? XOR A sets Z; CP A is cleaner
	POP	BC
	RET
__fcmp_lnz:

	; Compare: left (DEHL) vs right (__tmp32)
	; Sets Z if equal, C if left < right
	LD	A,(__tmp32+3)
	XOR	D
	JP	P,__fcmp_same	; same sign

	; Signs differ: the negative one is smaller.  Flip the sign
	; bits so an unsigned compare of the high bytes says so.
	LD	A,(__tmp32+3)
	XOR	80H
	LD	B,A		; B = right high byte (sign-flipped)
	LD	A,D
	XOR	80H		; A = left high byte (sign-flipped)
	CP	B		; C if left < right
	JR	__fcmp_diff

__fcmp_same:
	BIT	7,D
	JR	NZ,__fcmp_neg

	; Both positive: compare the magnitudes, left against right.
	LD	A,(__tmp32+3)
	LD	B,A
	LD	A,D
	CP	B		; C if left < right
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32+2)
	LD	B,A
	LD	A,E
	CP	B
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32+1)
	LD	B,A
	LD	A,H
	CP	B
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32)
	LD	B,A
	LD	A,L
	CP	B
	JR	__fcmp_diff

__fcmp_neg:
	; Both negative: the larger magnitude is the smaller value, so
	; compare right against left.
	LD	A,(__tmp32+3)
	CP	D		; C if |right| < |left|, left < right
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32+2)
	CP	E
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32+1)
	CP	H
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32)
	CP	L

__fcmp_diff:
	POP	BC
	RET

__fcmp_lchk:
	BIT	7,E
	JR	Z,__fcmp_lok		; exponent FEH: finite
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	JR	Z,__fcmp_lok		; infinity
	JR	__fcmp_unord
__fcmp_rchk:
	LD	A,(__tmp32+2)
	BIT	7,A
	JR	Z,__fcmp_rok		; exponent FEH: finite
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	Z,__fcmp_rok		; infinity
__fcmp_unord:
	XOR	A			; Z
	SCF				; and C
	POP	BC
	RET


	CSEG
; ============================================================
; rt_fdata.mac
; ============================================================
; rt_fdata.mac - __fop1, __fop2, __fsgn1, __fsgn2, __fexp1, __fexp2, __fman1, __fman2
; Split from rt_float.mac


	COMMON	/rt_fdata/
	PUBLIC	__fop1
__fop1:
	DS	4
	PUBLIC	__fop2
__fop2:
	DS	4
	PUBLIC	__fsgn1
__fsgn1:
	DS	1
	PUBLIC	__fsgn2
__fsgn2:
	DS	1
	PUBLIC	__fexp1
__fexp1:
	DS	2
	PUBLIC	__fexp2
__fexp2:
	DS	2
	PUBLIC	__fman1
__fman1:
	DS	4
	PUBLIC	__fman2
__fman2:
	DS	4


	CSEG
; ============================================================
; rt_fdiv.mac
; ============================================================
; rt_fdiv.mac - __fdiv
; Split from rt_float.mac



	CSEG
; ============================================================
; Float Division: DEHL = DEHL / (__tmp32)
; Native implementation using long division.  The quotient has 26 bits;
; the two extra bits and the remainder round the result to nearest, ties
; to even.  A result below the smallest normal number is zero.
; ============================================================
	PUBLIC	__fdiv
__fdiv:
	PUSH	BC
	PUSH	IX

	; dividend infinity or NaN?
	LD	A,D
	AND	7FH
	CP	7FH
	JR	NZ,@fdiv_n1
	BIT	7,E
	JR	Z,@fdiv_n1
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	JR	NZ,@fdiv_nan		; NaN / x
	LD	A,(__tmp32+3)		; inf / x
	AND	7FH
	CP	7FH
	JR	NZ,__fdiv_divzero	; inf / finite: infinity
	LD	A,(__tmp32+2)
	BIT	7,A
	JR	Z,__fdiv_divzero
@fdiv_nan:				; inf / inf, inf / NaN, x / NaN
	LD	DE,07FC0H
	LD	HL,0
	JR	@fdiv_exit
@fdiv_n1:
	; divisor infinity or NaN?
	LD	A,(__tmp32+3)
	AND	7FH
	CP	7FH
	JR	NZ,@fdiv_n2
	LD	A,(__tmp32+2)
	BIT	7,A
	JR	Z,@fdiv_n2
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,@fdiv_nan
	JR	@fdiv_szero		; finite / infinity: a signed zero
@fdiv_n2:

	; Check for zero divisor -> infinity (or a NaN for 0/0)
	LD	A,(__tmp32+3)
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+2)
	OR	B
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,__fdiv_check_dividend
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fdiv_divzero
	LD	DE,07FC0H		; 0/0: a quiet NaN
	LD	HL,0
	JR	@fdiv_exit
__fdiv_divzero:
	LD	A,D
	LD	B,A
	LD	A,(__tmp32+3)
	XOR	B
	AND	80H
	OR	7FH
	LD	D,A
	LD	E,80H			; +-infinity
	LD	HL,0
	JR	@fdiv_exit

__fdiv_check_dividend:
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fdiv_do_div
@fdiv_szero:				; zero or finite / infinity: the sign is the xor
	LD	A,D
	LD	B,A
	LD	A,(__tmp32+3)
	XOR	B
	AND	80H
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_do_div:
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	LD	(__fsgn1),A

	; biased exponent of the quotient: e1 - e2 + 127 (it may be out of
	; range; the range is checked after the rounding)
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	OR	A
	SBC	HL,DE
	LD	DE,127
	ADD	HL,DE
	LD	(__fexp1),HL

	CALL	__fdiv_man

	; mantissa in __fman1 (24 bits), exponent in __fexp1
	LD	HL,(__fexp1)
	BIT	7,H
	JR	NZ,__fdiv_underflow
	LD	A,H
	OR	A
	JR	NZ,__fdiv_inf
	LD	A,L
	OR	A
	JR	Z,__fdiv_underflow
	CP	255
	JR	NC,__fdiv_inf
	LD	B,H
	LD	C,L
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	A,(__fsgn1)
	CALL	__fpack

@fdiv_exit:
	POP	IX
	POP	BC
	RET

__fdiv_underflow:
	LD	A,(__fsgn1)
	AND	80H
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_inf:
	LD	A,(__fsgn1)
	AND	80H
	OR	7FH
	LD	D,A
	LD	E,80H
	LD	HL,0
	JR	@fdiv_exit

; ------------------------------------------------------------
; __fdiv_man: divide the 24-bit mantissa in __fman1 by the one in __fman2.
; Out: __fman1 = the rounded 24-bit quotient (bit 23 set), __fexp1 adjusted.
;
; Restoring division, 26 steps.  The remainder is in DE:HL, the divisor in
; BC (low 16 bits) and (IX+2) (high 8 bits), and the quotient in the second
; register set (DE':HL') with the step counter in B'.
; ------------------------------------------------------------
__fdiv_man:
	LD	IX,__fman2
	LD	BC,(__fman2)
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	EXX
	LD	HL,0
	LD	DE,0
	LD	B,26
	EXX
@fdiv_lp:
	PUSH	DE
	PUSH	HL
	OR	A
	SBC	HL,BC
	LD	A,E
	SBC	A,(IX+2)
	LD	E,A
	LD	A,D
	SBC	A,0
	LD	D,A		; DE:HL = remainder - divisor, carry if it is negative
	JR	C,@fdiv_no
	POP	AF
	POP	AF
	SCF
	JR	@fdiv_q
@fdiv_no:
	POP	HL
	POP	DE
	OR	A
@fdiv_q:
	EXX			; quotient = quotient * 2 + the carry
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	EXX
	ADD	HL,HL		; remainder = remainder * 2
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	EXX
	DEC	B
	EXX
	JP	NZ,@fdiv_lp

	; sticky: a non-zero remainder
	LD	A,D
	OR	E
	OR	H
	OR	L
	ADD	A,255
	SBC	A,A
	AND	1
	LD	B,A
	EXX			; DEHL = the quotient, in [2^24, 2^26)
	BIT	1,D
	JR	NZ,@fdiv_lead
	ADD	HL,HL		; put the leading bit at bit 25
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	PUSH	HL
	LD	HL,(__fexp1)
	DEC	HL
	LD	(__fexp1),HL
	POP	HL
@fdiv_lead:
	EXX
	LD	A,B
	EXX
	OR	A
	JR	Z,@fdiv_exact
	SET	0,L
@fdiv_exact:
	; round bit = bit 1, sticky = bit 0
	LD	A,L
	AND	3
	LD	C,A
	SRL	D
	RR	E
	RR	H
	RR	L
	SRL	D
	RR	E
	RR	H
	RR	L
	; C: 0,1 = round down; 2 = tie; 3 = round up
	LD	A,C
	CP	3
	JR	Z,@fdiv_up
	CP	2
	JR	NZ,@fdiv_store
	BIT	0,L
	JR	Z,@fdiv_store
@fdiv_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,@fdiv_store
	INC	DE
@fdiv_store:
	LD	A,D
	OR	A
	JR	Z,@fdiv_fit
	LD	DE,0080H		; the mantissa reached 2^24
	LD	HL,0
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
@fdiv_fit:
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	RET

	COMMON	/rt_fdiv/
__fdiv_rem:
	DS	4


	CSEG
; ============================================================
; rt_ffs16.mac
; ============================================================
; rt_ffs16.mac - __ffs16
; Split from rt_arith16.mac


	CSEG
; ============================================================
; __ffs16 — find lowest set bit (1-indexed), 0 if none.
; Models __builtin_ffs / POSIX ffs for 16-bit operands. uc80 calls
; this from gen_call when the user invokes ``__builtin_ffs(int)``.
; In:  HL = value
; Out: HL = 1..16 (position of lowest set bit) or 0 if HL==0
; ============================================================
	PUBLIC	__ffs16
__ffs16:
	LD	A,H
	OR	L
	JR	Z,__ffs16_zero
	PUSH	BC
	LD	B,1		; current bit position
	LD	A,L
__ffs16_lo:
	RRCA
	JR	C,__ffs16_found
	INC	B
	LD	C,A
	LD	A,B
	CP	9
	LD	A,C
	JR	NZ,__ffs16_lo
	; First 8 bits all zero; move to high byte
	LD	A,H
__ffs16_hi:
	RRCA
	JR	C,__ffs16_found
	INC	B
	JR	__ffs16_hi
__ffs16_found:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ffs16_zero:
	LD	HL,0
	RET


	CSEG
; ============================================================
; rt_ffs32.mac
; ============================================================
; rt_ffs32.mac - __ffs32
; Split from rt_arith32.mac


	CSEG
; ============================================================
; __ffs32 — 1-indexed lowest set bit of DEHL, 0 if none.
; ============================================================
	PUBLIC	__ffs32
__ffs32:
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,__ffs32_zero
	PUSH	BC
	LD	B,1
__ffs32_lp:
	BIT	0,L
	JR	NZ,__ffs32_done
	INC	B
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	__ffs32_lp
__ffs32_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ffs32_zero:
	LD	HL,0
	RET


	CSEG
; ============================================================
; rt_ffs64.mac
; ============================================================
; rt_ffs64.mac - __ffs64
; Split from rt_arith64.mac



	CSEG
	PUBLIC	__ffs64
__ffs64:
	; If zero return 0; else return 1+CTZ
	LD	A,(__acc64)
	LD	B,A
	LD	A,(__acc64+1)
	OR	B
	LD	B,A
	LD	A,(__acc64+2)
	OR	B
	LD	B,A
	LD	A,(__acc64+3)
	OR	B
	LD	B,A
	LD	A,(__acc64+4)
	OR	B
	LD	B,A
	LD	A,(__acc64+5)
	OR	B
	LD	B,A
	LD	A,(__acc64+6)
	OR	B
	LD	B,A
	LD	A,(__acc64+7)
	OR	B
	JR	NZ,__ffs64_nz
	LD	HL,0
	RET
__ffs64_nz:
	CALL	__ctz64
	INC	HL
	RET


	CSEG
; ============================================================
; rt_fmul.mac
; ============================================================
; rt_fmul.mac - __fmul
; Split from rt_float.mac



	CSEG
; ============================================================
; Float Multiplication: DEHL = DEHL * (__tmp32)
; ============================================================
	PUBLIC	__fmul
__fmul:
	PUSH	BC
	PUSH	IX

	; Result sign = xor of the operand signs; every special result
	; (zero, infinity) carries it.
	LD	A,(__tmp32+3)
	XOR	D
	AND	80H
	LD	(__fsgn1),A
	; C = exponent of operand 1, B = exponent of operand 2
	LD	A,D
	ADD	A,A
	LD	B,A
	LD	A,E
	RLCA
	LD	A,B
	ADC	A,0
	LD	C,A
	LD	A,(__tmp32+3)
	ADD	A,A
	LD	B,A
	LD	A,(__tmp32+2)
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A
	LD	A,C
	INC	A
	JR	Z,__fmul_sp1
	LD	A,B
	INC	A
	JR	Z,__fmul_sp2
	; A zero or subnormal operand (exponent 0): a signed zero.
	LD	A,C
	OR	A
	JR	Z,__fmul_zero
	LD	A,B
	OR	A
	JR	Z,__fmul_zero
	JR	__fmul_unpack

__fmul_sp1:
	; operand 1 is an infinity or a NaN
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	JR	NZ,__fmul_nan
	LD	A,B
	INC	A
	JR	NZ,__fmul_sp3
__fmul_sp2:
	; operand 2 is an infinity or a NaN
	LD	A,(__tmp32+2)
	AND	7FH
	PUSH	HL
	LD	HL,(__tmp32)
	OR	H
	OR	L
	POP	HL
	JR	NZ,__fmul_nan
__fmul_sp3:
	; no NaN, at least one infinity: inf * 0 is a NaN, else a signed inf
	LD	A,C
	OR	A
	JR	Z,__fmul_nan
	LD	A,B
	OR	A
	JR	Z,__fmul_nan
	JR	__fmul_inf

__fmul_nan:
	LD	HL,0
	LD	DE,7FC0H
	JR	__fmul_done

__fmul_unpack:
	; Unpack operands
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	; Result sign = xor of signs
	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	LD	(__fsgn1),A

	; Result exponent = exp1 + exp2 - 127
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	ADD	HL,DE
	LD	DE,127
	OR	A
	SBC	HL,DE
	; Underflow check: if subtraction borrowed (HL is "negative", i.e. >= 0x8000),
	; the true exponent is below the smallest normal — flush to zero.  Without
	; this, the wrapped 16-bit value becomes a huge bogus exponent and __fpack
	; emits a giant garbage float instead of 0.
	JR	C,__fmul_zero
	; Pre-check for unambiguous overflow before mantissa multiply.
	; (__fmul_man may bump exp by +1 below.)
	LD	A,H
	OR	A
	JR	NZ,__fmul_inf	; HL > 0xFF → certainly inf
	LD	A,L
	CP	255
	JR	NC,__fmul_inf	; HL >= 255 → inf
	LD	(__fexp1),HL

	; Multiply mantissas (24-bit x 24-bit -> 48-bit, take high 24)
	; Simplified: use 16x16 multiplications
	CALL	__fmul_man

	; Post-check: __fmul_man may have bumped exp by 1 for product
	; overflow into [2.0, 4.0). If the new exp is >= 255 the result
	; is inf — short-circuit before __fpack would encode a NaN.
	LD	HL,(__fexp1)
	LD	A,H
	OR	A
	JR	NZ,__fmul_inf
	LD	A,L
	OR	A
	JR	Z,__fmul_zero	; exponent 0: a subnormal result, flushed to zero
	CP	255
	JR	NC,__fmul_inf

	; Pack result (normalization handled in __fmul_man)
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack
	JR	__fmul_done

__fmul_zero:
	LD	A,(__fsgn1)
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	__fmul_done

__fmul_inf:
	; Build +/- inf: exp=255, mantissa=0. Sign = xor of operand signs,
	; already stored in (__fsgn1).
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__fmul_inf_pos
	; Negative inf: 0xFF800000
	LD	HL,0
	LD	DE,0FF80H
	JR	__fmul_done
__fmul_inf_pos:
	; Positive inf: 0x7F800000
	LD	HL,0
	LD	DE,07F80H

__fmul_done:
	POP	IX
	POP	BC
	RET

; Mantissa multiplication helper
__fmul_man:
	; Multiply __fman1 by __fman2 (24-bit × 24-bit = 48-bit)
	; Need high 32 bits of the 48-bit product
	;
	; Split each 24-bit value: m1 = m1h*2^16 + m1l
	; Product = m1h*m2h*2^32 + (m1h*m2l + m1l*m2h)*2^16 + m1l*m2l
	; Result is 48 bits, we want bits 47-16

	; Load operands
	LD	BC,(__fman1)		; BC = m1l (low 16 bits)
	LD	A,(__fman1+2)
	LD	H,A
	LD	L,0			; HL = m1h * 256 (treat as 16-bit)
	PUSH	BC			; Save m1l
	PUSH	HL			; Save m1h*256

	LD	BC,(__fman2)		; BC = m2l
	LD	A,(__fman2+2)
	LD	H,A
	LD	L,0			; HL = m2h * 256
	PUSH	BC			; Save m2l
	PUSH	HL			; Save m2h*256

	; Compute m1l × m2l
	POP	DE			; Discard m2h for now
	POP	DE			; DE = m2l
	POP	BC			; Discard m1h
	POP	BC			; BC = m1l
	PUSH	BC			; Save m1l again
	PUSH	DE			; Save m2l again
	CALL	__mul16_32		; DEHL = m1l × m2l (32-bit)
	LD	(__fmul_ll),HL		; Save low 16 bits
	LD	(__fmul_ll+2),DE	; Save high 16 bits

	; Compute m1h × m2h (but as 16-bit values)
	LD	BC,(__fman1+2)		; BC = m1h (8-bit in C)
	LD	B,0
	LD	DE,(__fman2+2)		; DE = m2h (8-bit in E)
	LD	D,0
	CALL	__mul16_32			; DEHL = m1h × m2h
	LD	(__fmul_hh),HL		; Save (only 16 bits needed)
	LD	(__fmul_hh+2),DE

	; Compute m1h × m2l
	LD	BC,(__fman1+2)		; BC = m1h
	LD	B,0
	POP	DE			; DE = m2l
	PUSH	DE
	CALL	__mul16_32			; DEHL = m1h × m2l (32-bit)
	LD	(__fmul_hl),HL
	LD	(__fmul_hl+2),DE

	; Compute m1l × m2h
	POP	DE			; Discard m2l
	POP	BC			; BC = m1l
	LD	DE,(__fman2+2)		; DE = m2h
	LD	D,0
	CALL	__mul16_32			; DEHL = m1l × m2h (32-bit)
	LD	(__fmul_lh),HL
	LD	(__fmul_lh+2),DE

	; Accumulate the 48-bit result from partial products
	; result[47:0] = LL + (HL << 16) + (LH << 16) + (HH << 32)
	; Extract bits [47:16] for the mantissa
	;
	; In 16-bit words:
	; word0 [15:0]   = LL.lo
	; word1 [31:16]  = LL.hi + HL.lo + LH.lo
	; word2 [47:32]  = HL.hi + LH.hi + HH.lo + carry_from_word1

	; Compute word1 = LL.hi + HL.lo + LH.lo.  The sum of three 16-bit
	; words carries 0, 1 or 2 into word2, so count the carries in B (the
	; old code chained them through ADC, which lost the second one and
	; made the product wrong by hundreds of units in the last place).
	LD	B,0
	LD	HL,(__fmul_ll+2)	; LL.hi
	LD	DE,(__fmul_hl)		; HL.lo
	ADD	HL,DE
	JR	NC,__fmul_nc1
	INC	B
__fmul_nc1:
	LD	DE,(__fmul_lh)		; LH.lo
	ADD	HL,DE
	JR	NC,__fmul_nc2
	INC	B
__fmul_nc2:
	PUSH	HL			; Save word1

	; Compute word2 = HL.hi + LH.hi + HH.lo + carries (the 48-bit
	; product fits, so no carry out of word2)
	LD	HL,(__fmul_hl+2)	; HL.hi
	LD	DE,(__fmul_lh+2)	; LH.hi
	ADD	HL,DE
	LD	DE,(__fmul_hh)		; HH.lo
	ADD	HL,DE
	LD	E,B
	LD	D,0
	ADD	HL,DE
	; HL = word2 (bits 47-32)
	EX	DE,HL			; Move to DE

	POP	HL			; HL = word1 (bits 31-16)

	; DEHL now contains bits [47:16] of the 48-bit product
	; Current: D=bits[47:40], E=bits[39:32], H=bits[31:24], L=bits[23:16]
	;
	; For mantissa multiply: product of two [1.0,2.0) values is in [1.0,4.0)
	; If bit 47 is set (product >= 2.0), we need bits [47:24] and must increment exp
	; If bit 47 is clear (product < 2.0), we need bits [46:23] (shift left by 1)
	; Check bit 47 (D bit 7)
	BIT	7,D
	JR	Z,__fmul_man_no_overflow

	; Product >= 2.0: the mantissa is bits [47:24] = D:E:H and the
	; rounding byte is bits [23:16] = L.  Exponent + 1.
	LD	B,L		; B = rounding byte
	LD	L,H
	LD	H,E
	LD	E,D
	LD	D,0		; E:H:L = mantissa
	CALL	__fmul_expinc
	JR	__fmul_man_round

__fmul_man_no_overflow:
	; Product < 2.0: shift DEHL left by 1; the mantissa is then
	; D:E:H and the rounding byte is L (bit 7 = product bit 22).
	SLA	L
	RL	H
	RL	E
	RL	D
	LD	B,L		; B = rounding byte
	LD	L,H
	LD	H,E
	LD	E,D
	LD	D,0		; E:H:L = mantissa

__fmul_man_round:
	; Round to nearest, ties to even.  B = the 8 product bits just below
	; the mantissa (bit 7 is the guard bit); the 16 bits below those are
	; the low word of the 48-bit product, saved in __fmul_ll.
	LD	A,(__fmul_ll)
	LD	C,A
	LD	A,(__fmul_ll+1)
	OR	C
	LD	C,A		; C = nonzero if any of the lowest 16 bits is set
	LD	A,B
	ADD	A,A		; carry = guard bit, A = the bits below it
	JR	NC,__fmul_man_store	; guard clear: truncate
	OR	C
	JR	NZ,__fmul_rup	; guard set and something below: round up
	LD	A,L
	AND	1
	JR	Z,__fmul_man_store	; exact tie and the mantissa is even
__fmul_rup:
	INC	L
	JR	NZ,__fmul_man_store
	INC	H
	JR	NZ,__fmul_man_store
	INC	E
	JR	NZ,__fmul_man_store
	LD	E,80H		; mantissa wrapped to 2.0 = 1.0 * 2^(e+1)
	CALL	__fmul_expinc
__fmul_man_store:
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	RET

; __fexp1 = __fexp1 + 1, no register changed
__fmul_expinc:
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	RET

; __mul16_32 (DEHL = BC * DE) lives in rt_mul.mac.

	COMMON	/rt_fmul/
; Temporary storage for partial products in float multiplication
; (private to __fmul)
__fmul_hh:
	DS	4
__fmul_hl:
	DS	4
__fmul_lh:
	DS	4
__fmul_ll:
	DS	4


	CSEG
; ============================================================
; rt_fneg.mac
; ============================================================
; rt_fneg.mac - __fneg
; Split from rt_float.mac


	CSEG
; ============================================================
; Float Negation: DEHL = -DEHL
; ============================================================
	PUBLIC	__fneg
__fneg:
	LD	A,D
	XOR	80H
	LD	D,A
	RET


	CSEG
; ============================================================
; rt_fnorm.mac
; ============================================================
; rt_fnorm.mac - __fnorm
; Split from rt_float.mac



	CSEG
; ============================================================
; Float Normalize: Normalize mantissa in __fman1 and adjust __fexp1
; ============================================================
	PUBLIC	__fnorm
__fnorm:
	; Check for zero
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	A,D
	OR	E
	OR	H
	OR	L
	RET	Z		; Zero stays zero

	; Check if bits above bit 23 are set (D != 0)
	; If so, shift right until D == 0 and bit 7 of E is the leading 1
	LD	A,D
	OR	A
	JR	Z,__fnorm_loop	; D is zero, go to left-shift path

	; Right-shift path: mantissa is too large (bits above bit 23 set)
__fnorm_rloop:
	LD	A,D
	OR	A
	JR	Z,__fnorm_rchk	; D is zero, check if normalized
	; Shift mantissa right
	SRL	D
	RR	E
	RR	H
	RR	L
	; Increment exponent
	PUSH	DE
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	POP	DE
	JR	__fnorm_rloop

__fnorm_rchk:
	; D is zero. Check if bit 7 of E is set (normalized)
	BIT	7,E
	JR	NZ,__fnorm_done	; Done
	; Still need left shifts
	; Fall through to left-shift loop

	; Shift left until bit 23 is set (bit 7 of E)
__fnorm_loop:
	BIT	7,E
	JR	NZ,__fnorm_done	; Normalized when bit 23 set

	; Shift mantissa left
	SLA	L
	RL	H
	RL	E
	RL	D

	; Decrement exponent
	PUSH	DE
	PUSH	HL
	LD	HL,(__fexp1)
	DEC	HL
	LD	(__fexp1),HL
	POP	HL
	POP	DE

	; Check for underflow
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__fnorm_loop

	; Underflow to zero
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	LD	HL,0
	LD	(__fexp1),HL
	RET

__fnorm_done:
	; Save normalized mantissa back to memory
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	RET


	CSEG
; ============================================================
; rt_fpack.mac
; ============================================================
; rt_fpack.mac - __fpack
; Split from rt_float.mac


	CSEG
; ============================================================
; Float Pack: Combine sign, exponent, mantissa into IEEE 754
; Input: A = sign (0 or 80H), BC = exponent, DEHL = mantissa
; Output: DEHL = IEEE 754 float
; ============================================================
	PUBLIC	__fpack
__fpack:
	PUSH	AF		; Save sign

	; Check for zero mantissa
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__fpack_nz
	; Return zero
	LD	DE,0
	LD	HL,0
	POP	AF
	RET

__fpack_nz:
	; Combine exponent and mantissa
	; Exponent in C, mantissa in E.H.L (bit 23 is implied 1)
	LD	A,E
	AND	7FH		; Clear implied 1 bit
	LD	E,A

	; Insert exponent into result
	; D will hold exp[7:1], E will hold exp[0]|mantissa[22:16]
	LD	A,C		; Get exponent
	SRL	A		; Shift right, bit 0 → carry, bits 7-1 → bits 6-0
	LD	D,A		; D = exp[7:1] in bits 6-0

	; Insert exponent bit 0 into E bit 7
	LD	A,E		; A = mantissa bits 22-16 (cleared of implied 1)
	JR	NC,__fpack_exp0_clear
	SET	7,A		; Set bit 7 if exponent bit 0 was 1
__fpack_exp0_clear:
	LD	E,A		; E = exp[0]|mantissa[22:16]

	; Add sign
	POP	AF
	OR	D
	LD	D,A
	RET


	CSEG
; ============================================================
; rt_fsub.mac
; ============================================================
; rt_fsub.mac - __fsub
; Split from rt_float.mac



	CSEG
; ============================================================
; Float Subtraction: DEHL = DEHL - (__tmp32)
; ============================================================
	PUBLIC	__fsub
__fsub:
	; Negate op2 sign and call fadd
	LD	A,(__tmp32+3)
	XOR	80H
	LD	(__tmp32+3),A
	CALL	__fadd
	; Restore op2 sign
	LD	A,(__tmp32+3)
	XOR	80H
	LD	(__tmp32+3),A
	RET


	CSEG
; ============================================================
; rt_ftoi.mac
; ============================================================
; rt_ftoi.mac - __ftoi
; Split from rt_float.mac



	CSEG
; ============================================================
; Float to Integer: DEHL = int(DEHL) (truncate towards zero)
; ============================================================
	PUBLIC	__ftoi
__ftoi:
	PUSH	BC

	; Check for zero
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__ftoi_nz
	LD	DE,0
	LD	HL,0
	JR	__ftoi_done

__ftoi_nz:
	; Unpack
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Check exponent range
	LD	HL,(__fexp1)
	LD	DE,127
	OR	A
	SBC	HL,DE		; HL = exp - 127 (actual exponent)
	JR	C,__ftoi_zero	; exp < 0, result is 0

	LD	A,L
	CP	31
	JR	NC,__ftoi_ovf	; exp >= 31, overflow

	; Shift mantissa right by (23 - exp) positions
	LD	B,A		; B = actual exponent
	LD	A,23
	SUB	B		; A = 23 - exp = shift count
	JR	C,__ftoi_shleft
	JR	Z,__ftoi_noshift

	LD	B,A
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
__ftoi_shrloop:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	__ftoi_shrloop
	JR	__ftoi_sign

__ftoi_shleft:
	; exp > 23, shift left
	NEG
	LD	B,A
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
__ftoi_shlloop:
	SLA	L
	RL	H
	RL	E
	RL	D
	DJNZ	__ftoi_shlloop
	JR	__ftoi_sign

__ftoi_noshift:
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)

__ftoi_sign:
	; Apply sign
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__ftoi_done
	CALL	__neg32
	JR	__ftoi_done

__ftoi_zero:
	LD	HL,0
	LD	DE,0
	JR	__ftoi_done

__ftoi_ovf:
	; Return max int
	LD	HL,0FFFFH
	LD	DE,7FFFH
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__ftoi_done
	LD	DE,8000H
	LD	HL,0

__ftoi_done:
	POP	BC
	RET


	CSEG
; ============================================================
; rt_funpack.mac
; ============================================================
; rt_funpack.mac - __funpack
; Split from rt_float.mac


	CSEG
; ============================================================
; Float Unpack: Extract sign, exponent, mantissa from DEHL
; Input: DEHL = IEEE 754 float
; Output: A = sign (0 or 80H), BC = exponent, DEHL = mantissa (with implied 1)
; ============================================================
	PUBLIC	__funpack
__funpack:
	; Extract sign
	LD	A,D
	AND	80H
	PUSH	AF		; Save sign

	; Extract exponent (8 bits)
	; exp = (D & 0x7F) << 1 | (E >> 7)
	; D = sign|exp[7:1], E = exp[0]|mant[22:16]
	LD	A,D
	ADD	A,A		; A = exp[7:1] << 1 (sign shifted out)
	LD	B,A		; B = exp[7:1] << 1
	LD	A,E
	RLCA			; Rotate left, carry = bit 7 = exp[0]
	LD	A,B		; A = exp[7:1] << 1
	ADC	A,0		; A = exp[7:1] << 1 + exp[0] = full exponent
	LD	C,A
	LD	B,0		; BC = exponent

	; Extract mantissa and add implied 1
	LD	A,E
	AND	7FH		; Clear exponent bit
	OR	80H		; Add implied 1
	LD	E,A
	; DEHL now has mantissa with bit 23 = 1 (the implied 1)
	; But we need it shifted properly - E has bits 23-16, H has 15-8, L has 7-0
	; Actually mantissa is in bits 22-0, so we need to arrange
	; Let's shift everything to put implied 1 at bit 23
	; E.H.L has mantissa bits 22-0 with E bit 7 = 1 (implied)
	; This is already in the right position

	; Put mantissa in DEHL as 24-bit value in low 24 bits
	LD	D,0

	POP	AF		; Restore sign
