	LD	L,H		; sign fill
	LD	H,0
	BIT	7,L
	JR	Z,__sar16_p
	DEC	H
__sar16_p:
	OR	A
	RET	Z
__sar16_b:
	SRA	L
	DEC	A
	JR	NZ,__sar16_b
	RET
__sar16_f:
	LD	A,H		; shift >= 16: 0 or -1 by the sign
	RLA
	SBC	A,A
	LD	H,A
	LD	L,A
	RET


