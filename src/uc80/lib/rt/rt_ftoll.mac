; rt_ftoll.mac - __ftoll, __ftoull
; Float to 64-bit integer, truncated towards zero.

	.Z80

	EXTRN	__acc64
	EXTRN	__funpack
	EXTRN	__neg64

	CSEG
; ============================================================
; __ftoll:  __acc64 = (long long) DEHL;  DEHL = its low 32 bits
; __ftoull: __acc64 = (unsigned long long) DEHL;  DEHL = its low 32 bits
;
; Values that do not fit give the nearest limit: 7FFF...F or 8000...0 for
; the signed form, FFFF...F (or 0 for a negative value) for the unsigned
; form.  A negative value in the unsigned form wraps (-1.0 gives FFFF...F),
; as it does on a host.  A NaN gives the limit its sign bit chooses.  A
; value under 1 in size, and a subnormal number, give 0.  The unsigned form
; also converts a float to a 32-bit unsigned long: the low 32 bits.
; ============================================================
	PUBLIC	__ftoll
__ftoll:
	XOR	A
	LD	(__f2ll_u),A
	JP	__f2ll_go

	PUBLIC	__ftoull
__ftoull:
	LD	A,1
	LD	(__f2ll_u),A
	JP	__f2ll_go

	PUBLIC	__f2ll_go
__f2ll_go:
	PUSH	BC
	CALL	__funpack	; A = sign, C = exponent, EHL = mantissa
	LD	(__f2ll_sgn),A
	LD	A,C
	OR	A
	JR	Z,__f2ll_zero	; 0 or a subnormal number
	SUB	127
	JR	C,__f2ll_zero	; magnitude under 1
	LD	B,A		; B = the power of two of the leading bit
	LD	A,(__f2ll_u)
	OR	A
	LD	A,B
	JR	NZ,__f2ll_uchk
	CP	63
	JR	NC,__f2ll_ovf
	JR	__f2ll_ok
__f2ll_uchk:
	CP	64
	JR	NC,__f2ll_ovf
__f2ll_ok:
	LD	(__acc64),HL	; __acc64 = the 24-bit mantissa
	LD	A,E
	LD	(__acc64+2),A
	XOR	A
	LD	(__acc64+3),A
	LD	HL,0
	LD	(__acc64+4),HL
	LD	(__acc64+6),HL
	LD	A,B
	SUB	23		; the mantissa has its leading bit at 23
	JR	Z,__f2ll_sign
	JR	C,__f2ll_right
	LD	B,A		; shift left by B
__f2ll_lbyte:
	LD	A,B
	CP	8
	JR	C,__f2ll_lbits
	LD	HL,__acc64+6	; a whole byte
	LD	DE,__acc64+7
	PUSH	BC
	LD	BC,7
	LDDR
	POP	BC
	XOR	A
	LD	(__acc64),A
	LD	A,B
	SUB	8
	LD	B,A
	JR	__f2ll_lbyte
__f2ll_lbits:
	LD	A,B
	OR	A
	JR	Z,__f2ll_sign
__f2ll_lb1:
	LD	HL,__acc64
	SLA	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	DJNZ	__f2ll_lb1
	JR	__f2ll_sign
__f2ll_right:
	NEG			; A = 23 - the power: 1 to 23 places
	LD	B,A
__f2ll_rb:
	LD	HL,__acc64+2
	SRL	(HL)
	DEC	HL
	RR	(HL)
	DEC	HL
	RR	(HL)
	DJNZ	__f2ll_rb
__f2ll_sign:
	LD	A,(__f2ll_sgn)
	OR	A
	JR	Z,__f2ll_done
	CALL	__neg64
__f2ll_done:
	LD	HL,(__acc64)
	LD	DE,(__acc64+2)
	POP	BC
	RET

__f2ll_zero:
	LD	HL,0
	LD	(__acc64),HL
	LD	(__acc64+2),HL
	LD	(__acc64+4),HL
	LD	(__acc64+6),HL
	JR	__f2ll_done

__f2ll_ovf:
	LD	A,(__f2ll_sgn)
	OR	A
	JR	NZ,__f2ll_ovfn
	LD	HL,0FFFFH	; positive: 7FFF...F signed, FFFF...F unsigned
	LD	(__acc64),HL
	LD	(__acc64+2),HL
	LD	(__acc64+4),HL
	LD	A,(__f2ll_u)
	OR	A
	JR	NZ,__f2ll_ovfs
	LD	HL,7FFFH
__f2ll_ovfs:
	LD	(__acc64+6),HL
	JR	__f2ll_done
__f2ll_ovfn:
	LD	HL,0		; negative: 8000...0 signed, 0 unsigned
	LD	(__acc64),HL
	LD	(__acc64+2),HL
	LD	(__acc64+4),HL
	LD	A,(__f2ll_u)
	OR	A
	JR	NZ,__f2ll_ovfs
	LD	HL,8000H
	JR	__f2ll_ovfs

	COMMON	/rt_ftoll/
	PUBLIC	__wa_rt_ftoll	;!
__wa_rt_ftoll:	;!
__f2ll_u:	DS	1
__f2ll_sgn:	DS	1

	END
