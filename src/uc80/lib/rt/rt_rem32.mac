; rt_rem32.mac - __rem32
; Split from rt_arith32.mac

	.Z80

	COMMON	/rt_rem32/
	PUBLIC	__div32_dvd
__div32_dvd:
	DS	4
	PUBLIC	__rem32
__rem32:
	DS	4

; ---- BEGIN work-area save helpers (gen_wa_helpers.py) ----
	CSEG
	PUBLIC	__wasv_rt_rem32
	PUBLIC	__wars_rt_rem32
__wasv_rt_rem32:
	POP	IY
	LD	HL,-8
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL
	LD	HL,__div32_dvd
	LD	BC,8
	LDIR
	JP	(IY)
__wars_rt_rem32:
	POP	IY
	LD	HL,0
	ADD	HL,SP
	LD	DE,__div32_dvd
	LD	BC,8
	LDIR
	LD	SP,HL
	JP	(IY)
; ---- END work-area save helpers ----

	END
