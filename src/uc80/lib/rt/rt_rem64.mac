; rt_rem64.mac - __rem64
; Split from rt_arith64.mac

	.Z80

	COMMON	/rt_rem64/
	PUBLIC	__div64_dvd
__div64_dvd:	DS	8	; dividend
	PUBLIC	__rem64
__rem64:	DS	8	; remainder

; ---- BEGIN work-area save helpers (gen_wa_helpers.py) ----
	CSEG
	PUBLIC	__wasv_rt_rem64
	PUBLIC	__wars_rt_rem64
__wasv_rt_rem64:
	POP	IY
	LD	HL,-16
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL
	LD	HL,__div64_dvd
	LD	BC,16
	LDIR
	JP	(IY)
__wars_rt_rem64:
	POP	IY
	LD	HL,0
	ADD	HL,SP
	LD	DE,__div64_dvd
	LD	BC,16
	LDIR
	LD	SP,HL
	JP	(IY)
; ---- END work-area save helpers ----

	END
