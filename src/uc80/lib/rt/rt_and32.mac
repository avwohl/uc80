; rt_and32.mac - __and32
; Split from rt_arith32.mac

	.Z80

	EXTRN	__tmp32

	CSEG
; ============================================================
; 32-bit bitwise AND: DEHL = DEHL & (__tmp32)
; ============================================================
	PUBLIC	__and32
__and32:
	LD	A,(__tmp32)
	AND	L
	LD	L,A
	LD	A,(__tmp32+1)
	AND	H
	LD	H,A
	LD	A,(__tmp32+2)
	AND	E
	LD	E,A
	LD	A,(__tmp32+3)
	AND	D
	LD	D,A
	RET

	END
