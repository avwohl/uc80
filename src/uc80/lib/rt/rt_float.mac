; rt_float.mac - IEEE 754 single-precision floating point
; Split from runtime.mac

	.Z80

	EXTRN	__tmp32
	EXTRN	__neg32
	EXTRN	__mul16_32

	CSEG

; ============================================================
; IEEE 754 Single-Precision Floating Point Library
; ============================================================
; Format: DEHL where D=high byte (sign+exp), E,H,L=mantissa
; Sign: bit 7 of D
; Exponent: bits 6-0 of D and bit 7 of E (8 bits total, bias 127)
; Mantissa: bits 6-0 of E and all of H,L (23 bits, implied 1.)
; ============================================================

; ============================================================
; Float Addition: DEHL = DEHL + (__tmp32)
; ============================================================
	PUBLIC	__fadd
__fadd:
	PUSH	BC
	PUSH	IX

	; Save operands to work area
	LD	(__fop1),HL
	LD	(__fop1+2),DE
	LD	HL,(__tmp32)
	LD	(__fop2),HL
	LD	HL,(__tmp32+2)
	LD	(__fop2+2),HL

	; Check for zero operands
	LD	A,D
	AND	7FH		; Mask off sign
	OR	E
	OR	H
	OR	L
	JR	NZ,__fadd_op1nz
	; Op1 is zero, return op2
	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	JR	__fadd_done

__fadd_op1nz:
	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fadd_bothnonzero
	; Op2 is zero, return op1
	LD	HL,(__fop1)
	LD	DE,(__fop1+2)
	JR	__fadd_done

__fadd_bothnonzero:
	; Unpack both operands
	LD	HL,(__fop1)
	LD	DE,(__fop1+2)
	CALL	__funpack
	LD	(__fsgn1),A	; Sign
	LD	(__fexp1),BC	; Exponent
	LD	(__fman1),HL	; Mantissa low
	LD	(__fman1+2),DE	; Mantissa high

	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	; Align exponents (shift smaller mantissa right)
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	OR	A
	SBC	HL,DE		; HL = exp1 - exp2
	JR	Z,__fadd_aligned
	JR	C,__fadd_shift1	; exp1 < exp2

	; exp1 > exp2: shift mantissa2 right by (exp1-exp2)
	LD	B,L		; Shift count
	LD	A,B
	CP	24		; If shift >= 24, result is op1
	JR	C,__fadd_doshift2
	LD	HL,(__fop1)
	LD	DE,(__fop1+2)
	JR	__fadd_done

__fadd_doshift2:
	LD	HL,(__fman2)
	LD	DE,(__fman2+2)
__fadd_shloop2:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	__fadd_shloop2
	LD	(__fman2),HL
	LD	(__fman2+2),DE
	LD	HL,(__fexp1)
	LD	(__fexp2),HL	; Set exp2 = exp1
	JR	__fadd_aligned

__fadd_shift1:
	; exp1 < exp2: shift mantissa1 right by (exp2-exp1)
	LD	HL,(__fexp2)
	LD	DE,(__fexp1)
	OR	A
	SBC	HL,DE
	LD	B,L
	LD	A,B
	CP	24
	JR	C,__fadd_doshift1
	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	JR	__fadd_done

__fadd_doshift1:
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
__fadd_shloop1:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	__fadd_shloop1
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	LD	HL,(__fexp2)
	LD	(__fexp1),HL

__fadd_aligned:
	; Add or subtract mantissas based on signs
	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	JR	NZ,__fadd_subtract

	; Same signs: add mantissas
	LD	HL,(__fman1)
	LD	DE,(__fman2)
	ADD	HL,DE
	LD	(__fman1),HL
	LD	HL,(__fman1+2)
	LD	DE,(__fman2+2)
	ADC	HL,DE
	LD	(__fman1+2),HL

	; Check for mantissa overflow (carry into bit 24+)
	; After ADC, HL contains high word. H=byte3 (bits 31-24), L=byte2 (bits 23-16)
	; Check if H (bits 31-24) has any bits set
	LD	A,H
	OR	A
	JR	Z,__fadd_normalize	; No overflow

	; Overflow: need to shift mantissa right and increment exponent
	; Most common case: single bit overflow (H=1)
	LD	HL,(__fman1)		; Load low word
	LD	DE,(__fman1+2)		; Load high word (D has overflow bits)

	; Shift right by 1
	SRL	D			; Shift D (bits 31-24) right
	RR	E			; Rotate E (bits 23-16) right with carry
	RR	H			; Rotate H (bits 15-8) right with carry
	RR	L			; Rotate L (bits 7-0) right with carry

	LD	(__fman1),HL		; Store back low word
	LD	(__fman1+2),DE		; Store back high word

	; Increment exponent
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL

	; Result sign is same as operands
	JR	__fadd_normalize

__fadd_subtract:
	; Different signs: subtract mantissas
	; Compare magnitudes first
	LD	HL,(__fman1+2)
	LD	DE,(__fman2+2)
	OR	A
	SBC	HL,DE
	JR	NZ,__fadd_cmphi
	LD	HL,(__fman1)
	LD	DE,(__fman2)
	OR	A
	SBC	HL,DE
__fadd_cmphi:
	JR	NC,__fadd_sub_m1_m2

	; man2 > man1: result = man2 - man1, sign = sgn2
	LD	HL,(__fman2)
	LD	DE,(__fman1)
	OR	A
	SBC	HL,DE
	LD	(__fman1),HL
	LD	HL,(__fman2+2)
	LD	DE,(__fman1+2)
	SBC	HL,DE
	LD	(__fman1+2),HL
	LD	A,(__fsgn2)
	LD	(__fsgn1),A
	JR	__fadd_normalize

__fadd_sub_m1_m2:
	; man1 >= man2: result = man1 - man2, sign = sgn1
	LD	HL,(__fman1)
	LD	DE,(__fman2)
	OR	A
	SBC	HL,DE
	LD	(__fman1),HL
	LD	HL,(__fman1+2)
	LD	DE,(__fman2+2)
	SBC	HL,DE
	LD	(__fman1+2),HL

__fadd_normalize:
	; Normalize result in __fman1, __fexp1, __fsgn1
	CALL	__fnorm
	; Overflow check: __fnorm may have bumped __fexp1 (right-shift
	; renormalisation when the sum carried into bit 24). If the
	; biased exponent now hits 255 the result is inf; otherwise
	; __fpack would encode it as a NaN-shaped value (exp=255 with
	; non-zero mantissa).
	LD	HL,(__fexp1)
	LD	A,H
	OR	A
	JR	NZ,__fadd_inf
	LD	A,L
	CP	255
	JR	NC,__fadd_inf
	; Pack result
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

__fadd_done:
	POP	IX
	POP	BC
	RET

__fadd_inf:
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__fadd_inf_pos
	LD	DE,0FF80H
	LD	HL,0
	JR	__fadd_done
__fadd_inf_pos:
	LD	DE,07F80H
	LD	HL,0
	JR	__fadd_done

; ============================================================
; Float Subtraction: DEHL = DEHL - (__tmp32)
; ============================================================
	PUBLIC	__fsub
__fsub:
	; Negate op2 sign and call fadd
	LD	A,(__tmp32+3)
	XOR	80H
	LD	(__tmp32+3),A
	CALL	__fadd
	; Restore op2 sign
	LD	A,(__tmp32+3)
	XOR	80H
	LD	(__tmp32+3),A
	RET

; ============================================================
; Float Multiplication: DEHL = DEHL * (__tmp32)
; ============================================================
	PUBLIC	__fmul
__fmul:
	PUSH	BC
	PUSH	IX

	; Result sign = xor of the operand signs; every special result
	; (zero, infinity) carries it.
	LD	A,(__tmp32+3)
	XOR	D
	AND	80H
	LD	(__fsgn1),A
	; C = exponent of operand 1, B = exponent of operand 2
	LD	A,D
	ADD	A,A
	LD	B,A
	LD	A,E
	RLCA
	LD	A,B
	ADC	A,0
	LD	C,A
	LD	A,(__tmp32+3)
	ADD	A,A
	LD	B,A
	LD	A,(__tmp32+2)
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A
	LD	A,C
	INC	A
	JR	Z,__fmul_sp1
	LD	A,B
	INC	A
	JR	Z,__fmul_sp2
	; A zero or subnormal operand (exponent 0): a signed zero.
	LD	A,C
	OR	A
	JR	Z,__fmul_zero
	LD	A,B
	OR	A
	JR	Z,__fmul_zero
	JR	__fmul_unpack

__fmul_sp1:
	; operand 1 is an infinity or a NaN
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	JR	NZ,__fmul_nan
	LD	A,B
	INC	A
	JR	NZ,__fmul_sp3
__fmul_sp2:
	; operand 2 is an infinity or a NaN
	LD	A,(__tmp32+2)
	AND	7FH
	PUSH	HL
	LD	HL,(__tmp32)
	OR	H
	OR	L
	POP	HL
	JR	NZ,__fmul_nan
__fmul_sp3:
	; no NaN, at least one infinity: inf * 0 is a NaN, else a signed inf
	LD	A,C
	OR	A
	JR	Z,__fmul_nan
	LD	A,B
	OR	A
	JR	Z,__fmul_nan
	JR	__fmul_inf

__fmul_nan:
	LD	HL,0
	LD	DE,7FC0H
	JR	__fmul_done

__fmul_unpack:
	; Unpack operands
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	; Result sign = xor of signs
	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	LD	(__fsgn1),A

	; Result exponent = exp1 + exp2 - 127
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	ADD	HL,DE
	LD	DE,127
	OR	A
	SBC	HL,DE
	; Underflow check: if subtraction borrowed (HL is "negative", i.e. >= 0x8000),
	; the true exponent is below the smallest normal — flush to zero.  Without
	; this, the wrapped 16-bit value becomes a huge bogus exponent and __fpack
	; emits a giant garbage float instead of 0.
	JR	C,__fmul_zero
	; Pre-check for unambiguous overflow before mantissa multiply.
	; (__fmul_man may bump exp by +1 below.)
	LD	A,H
	OR	A
	JR	NZ,__fmul_inf	; HL > 0xFF → certainly inf
	LD	A,L
	CP	255
	JR	NC,__fmul_inf	; HL >= 255 → inf
	LD	(__fexp1),HL

	; Multiply mantissas (24-bit x 24-bit -> 48-bit, take high 24)
	; Simplified: use 16x16 multiplications
	CALL	__fmul_man

	; Post-check: __fmul_man may have bumped exp by 1 for product
	; overflow into [2.0, 4.0). If the new exp is >= 255 the result
	; is inf — short-circuit before __fpack would encode a NaN.
	LD	HL,(__fexp1)
	LD	A,H
	OR	A
	JR	NZ,__fmul_inf
	LD	A,L
	OR	A
	JR	Z,__fmul_zero	; exponent 0: a subnormal result, flushed to zero
	CP	255
	JR	NC,__fmul_inf

	; Pack result (normalization handled in __fmul_man)
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack
	JR	__fmul_done

__fmul_zero:
	LD	A,(__fsgn1)
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	__fmul_done

__fmul_inf:
	; Build +/- inf: exp=255, mantissa=0. Sign = xor of operand signs,
	; already stored in (__fsgn1).
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__fmul_inf_pos
	; Negative inf: 0xFF800000
	LD	HL,0
	LD	DE,0FF80H
	JR	__fmul_done
__fmul_inf_pos:
	; Positive inf: 0x7F800000
	LD	HL,0
	LD	DE,07F80H

__fmul_done:
	POP	IX
	POP	BC
	RET

; Mantissa multiplication helper
__fmul_man:
	; Multiply __fman1 by __fman2 (24-bit × 24-bit = 48-bit)
	; Need high 32 bits of the 48-bit product
	;
	; Split each 24-bit value: m1 = m1h*2^16 + m1l
	; Product = m1h*m2h*2^32 + (m1h*m2l + m1l*m2h)*2^16 + m1l*m2l
	; Result is 48 bits, we want bits 47-16

	; Load operands
	LD	BC,(__fman1)		; BC = m1l (low 16 bits)
	LD	A,(__fman1+2)
	LD	H,A
	LD	L,0			; HL = m1h * 256 (treat as 16-bit)
	PUSH	BC			; Save m1l
	PUSH	HL			; Save m1h*256

	LD	BC,(__fman2)		; BC = m2l
	LD	A,(__fman2+2)
	LD	H,A
	LD	L,0			; HL = m2h * 256
	PUSH	BC			; Save m2l
	PUSH	HL			; Save m2h*256

	; Compute m1l × m2l
	POP	DE			; Discard m2h for now
	POP	DE			; DE = m2l
	POP	BC			; Discard m1h
	POP	BC			; BC = m1l
	PUSH	BC			; Save m1l again
	PUSH	DE			; Save m2l again
	CALL	__mul16_32		; DEHL = m1l × m2l (32-bit)
	LD	(__fmul_ll),HL		; Save low 16 bits
	LD	(__fmul_ll+2),DE	; Save high 16 bits

	; Compute m1h × m2h (but as 16-bit values)
	LD	BC,(__fman1+2)		; BC = m1h (8-bit in C)
	LD	B,0
	LD	DE,(__fman2+2)		; DE = m2h (8-bit in E)
	LD	D,0
	CALL	__mul16_32			; DEHL = m1h × m2h
	LD	(__fmul_hh),HL		; Save (only 16 bits needed)
	LD	(__fmul_hh+2),DE

	; Compute m1h × m2l
	LD	BC,(__fman1+2)		; BC = m1h
	LD	B,0
	POP	DE			; DE = m2l
	PUSH	DE
	CALL	__mul16_32			; DEHL = m1h × m2l (32-bit)
	LD	(__fmul_hl),HL
	LD	(__fmul_hl+2),DE

	; Compute m1l × m2h
	POP	DE			; Discard m2l
	POP	BC			; BC = m1l
	LD	DE,(__fman2+2)		; DE = m2h
	LD	D,0
	CALL	__mul16_32			; DEHL = m1l × m2h (32-bit)
	LD	(__fmul_lh),HL
	LD	(__fmul_lh+2),DE

	; Accumulate the 48-bit result from partial products
	; result[47:0] = LL + (HL << 16) + (LH << 16) + (HH << 32)
	; Extract bits [47:16] for the mantissa
	;
	; In 16-bit words:
	; word0 [15:0]   = LL.lo
	; word1 [31:16]  = LL.hi + HL.lo + LH.lo
	; word2 [47:32]  = HL.hi + LH.hi + HH.lo + carry_from_word1

	; Compute word1 = LL.hi + HL.lo + LH.lo.  The sum of three 16-bit
	; words carries 0, 1 or 2 into word2, so count the carries in B (the
	; old code chained them through ADC, which lost the second one and
	; made the product wrong by hundreds of units in the last place).
	LD	B,0
	LD	HL,(__fmul_ll+2)	; LL.hi
	LD	DE,(__fmul_hl)		; HL.lo
	ADD	HL,DE
	JR	NC,__fmul_nc1
	INC	B
__fmul_nc1:
	LD	DE,(__fmul_lh)		; LH.lo
	ADD	HL,DE
	JR	NC,__fmul_nc2
	INC	B
__fmul_nc2:
	PUSH	HL			; Save word1

	; Compute word2 = HL.hi + LH.hi + HH.lo + carries (the 48-bit
	; product fits, so no carry out of word2)
	LD	HL,(__fmul_hl+2)	; HL.hi
	LD	DE,(__fmul_lh+2)	; LH.hi
	ADD	HL,DE
	LD	DE,(__fmul_hh)		; HH.lo
	ADD	HL,DE
	LD	E,B
	LD	D,0
	ADD	HL,DE
	; HL = word2 (bits 47-32)
	EX	DE,HL			; Move to DE

	POP	HL			; HL = word1 (bits 31-16)

	; DEHL now contains bits [47:16] of the 48-bit product
	; Current: D=bits[47:40], E=bits[39:32], H=bits[31:24], L=bits[23:16]
	;
	; For mantissa multiply: product of two [1.0,2.0) values is in [1.0,4.0)
	; If bit 47 is set (product >= 2.0), we need bits [47:24] and must increment exp
	; If bit 47 is clear (product < 2.0), we need bits [46:23] (shift left by 1)
	; Check bit 47 (D bit 7)
	BIT	7,D
	JR	Z,__fmul_man_no_overflow

	; Product >= 2.0: the mantissa is bits [47:24] = D:E:H and the
	; rounding byte is bits [23:16] = L.  Exponent + 1.
	LD	B,L		; B = rounding byte
	LD	L,H
	LD	H,E
	LD	E,D
	LD	D,0		; E:H:L = mantissa
	CALL	__fmul_expinc
	JR	__fmul_man_round

__fmul_man_no_overflow:
	; Product < 2.0: shift DEHL left by 1; the mantissa is then
	; D:E:H and the rounding byte is L (bit 7 = product bit 22).
	SLA	L
	RL	H
	RL	E
	RL	D
	LD	B,L		; B = rounding byte
	LD	L,H
	LD	H,E
	LD	E,D
	LD	D,0		; E:H:L = mantissa

__fmul_man_round:
	; Round to nearest, ties to even.  B = the 8 product bits just below
	; the mantissa (bit 7 is the guard bit); the 16 bits below those are
	; the low word of the 48-bit product, saved in __fmul_ll.
	LD	A,(__fmul_ll)
	LD	C,A
	LD	A,(__fmul_ll+1)
	OR	C
	LD	C,A		; C = nonzero if any of the lowest 16 bits is set
	LD	A,B
	ADD	A,A		; carry = guard bit, A = the bits below it
	JR	NC,__fmul_man_store	; guard clear: truncate
	OR	C
	JR	NZ,__fmul_rup	; guard set and something below: round up
	LD	A,L
	AND	1
	JR	Z,__fmul_man_store	; exact tie and the mantissa is even
__fmul_rup:
	INC	L
	JR	NZ,__fmul_man_store
	INC	H
	JR	NZ,__fmul_man_store
	INC	E
	JR	NZ,__fmul_man_store
	LD	E,80H		; mantissa wrapped to 2.0 = 1.0 * 2^(e+1)
	CALL	__fmul_expinc
__fmul_man_store:
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	RET

; __fexp1 = __fexp1 + 1, no register changed
__fmul_expinc:
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	RET

; __mul16_32 (DEHL = BC * DE) lives in rt_mul.mac.

; ============================================================
; Float Division: DEHL = DEHL / (__tmp32)
; Native implementation using long division
; ============================================================
	PUBLIC	__fdiv
__fdiv:
	PUSH	BC
	PUSH	IX

	; Check for zero divisor -> infinity
	LD	A,(__tmp32+3)
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+2)
	OR	B
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,__fdiv_check_dividend
	; Divisor is zero - return infinity
	LD	DE,07F80H		; +infinity
	LD	HL,0
	JR	@fdiv_exit

__fdiv_check_dividend:
	; Check for zero dividend -> zero
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fdiv_do_div
	; Dividend is zero
	LD	DE,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_do_div:
	; Unpack dividend
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Unpack divisor
	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	; Result sign = xor of signs
	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	LD	(__fsgn1),A

	; Result exponent = exp1 - exp2 + 127
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	OR	A
	SBC	HL,DE
	LD	DE,127
	ADD	HL,DE
	; Underflow: exp went negative — flush to zero rather than wrapping
	; into a bogus near-one float via the truncated low byte.
	BIT	7,H
	JR	NZ,__fdiv_underflow
	; Overflow: if HL >= 255 the result is inf. (HL > 0xFF is also
	; overflow; check that first.)
	LD	A,H
	OR	A
	JR	NZ,__fdiv_inf
	LD	A,L
	CP	255
	JR	NC,__fdiv_inf
	LD	(__fexp1),HL

	; Divide mantissas using long division
	CALL	__fdiv_man

	; Pack result
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

@fdiv_exit:
	POP	IX
	POP	BC
	RET

__fdiv_underflow:
	LD	DE,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_inf:
	; +/- inf based on result sign (xor'd into __fsgn1 above).
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__fdiv_inf_pos
	LD	DE,0FF80H		; -inf
	LD	HL,0
	JR	@fdiv_exit
__fdiv_inf_pos:
	LD	DE,07F80H		; +inf
	LD	HL,0
	JR	@fdiv_exit

; Mantissa division helper
; Divides __fman1 by __fman2 (24-bit / 24-bit)
; Both have implied 1 at bit 23 (E bit 7, D=0)
; Result stored in __fman1
;
; Algorithm: Non-restoring division
; We compute quo = dividend / divisor
; where both have implied 1, so both are in [1, 2)
; Result is in range (0.5, 2)
;
; Use __fdiv_rem[0..3] for temporary storage of dividend copy
;
__fdiv_man:
	; Copy dividend to __fdiv_rem (we'll shift this and use as working copy)
	LD	A,(__fman1)
	LD	(__fdiv_rem),A
	LD	A,(__fman1+1)
	LD	(__fdiv_rem+1),A
	LD	A,(__fman1+2)
	LD	(__fdiv_rem+2),A
	XOR	A
	LD	(__fdiv_rem+3),A	; Clear high byte (for 32-bit shifts)

	; Clear quotient (will be stored in __fman1)
	LD	(__fman1),A
	LD	(__fman1+1),A
	LD	(__fman1+2),A

	; Loop 24 times for 24 quotient bits
	LD	B,24

@fdiv_lp:
	PUSH	BC

	; Compare dividend (in __fdiv_rem, 32-bit) with divisor (in __fman2, 24-bit)
	; __fdiv_rem can overflow to 32 bits during shifts

	; Check high byte (byte 3) of dividend - divisor is only 24-bit
	LD	A,(__fdiv_rem+3)
	OR	A
	JR	NZ,@fdiv_sub		; dividend has bit 24+, definitely >= divisor

	; High byte is 0, compare 24-bit portion
	; Compare byte 2 (high of 24-bit portion)
	LD	A,(__fdiv_rem+2)
	LD	C,A
	LD	A,(__fman2+2)
	CP	C
	JR	C,@fdiv_sub		; divisor < dividend, subtract
	JR	NZ,@fdiv_nosub		; divisor > dividend, no subtract

	; Byte 2 equal, compare byte 1
	LD	A,(__fdiv_rem+1)
	LD	C,A
	LD	A,(__fman2+1)
	CP	C
	JR	C,@fdiv_sub
	JR	NZ,@fdiv_nosub

	; Byte 1 equal, compare byte 0
	LD	A,(__fdiv_rem)
	LD	C,A
	LD	A,(__fman2)
	CP	C
	JR	C,@fdiv_sub
	JR	NZ,@fdiv_nosub

	; All equal: dividend == divisor, subtract
@fdiv_sub:
	; dividend (32-bit) -= divisor (24-bit)
	LD	A,(__fdiv_rem)
	LD	C,A
	LD	A,(__fman2)
	LD	E,A
	LD	A,C
	SUB	E
	LD	(__fdiv_rem),A

	LD	A,(__fdiv_rem+1)
	LD	C,A
	LD	A,(__fman2+1)
	LD	E,A
	LD	A,C
	SBC	A,E
	LD	(__fdiv_rem+1),A

	LD	A,(__fdiv_rem+2)
	LD	C,A
	LD	A,(__fman2+2)
	LD	E,A
	LD	A,C
	SBC	A,E
	LD	(__fdiv_rem+2),A

	; Handle borrow into byte 3 (subtract 0 with carry)
	LD	A,(__fdiv_rem+3)
	SBC	A,0
	LD	(__fdiv_rem+3),A

	; Set quotient bit (shift left first to preserve carry chain, then set bit 0)
	LD	A,(__fman1)
	ADD	A,A
	LD	(__fman1),A
	LD	A,(__fman1+1)
	ADC	A,A
	LD	(__fman1+1),A
	LD	A,(__fman1+2)
	ADC	A,A
	LD	(__fman1+2),A
	; Now set bit 0 of quotient
	LD	A,(__fman1)
	OR	1
	LD	(__fman1),A
	JR	@fdiv_next

@fdiv_nosub:
	; Don't subtract, just shift quotient left (bit 0 stays 0)
	LD	A,(__fman1)
	ADD	A,A
	LD	(__fman1),A
	LD	A,(__fman1+1)
	ADC	A,A
	LD	(__fman1+1),A
	LD	A,(__fman1+2)
	ADC	A,A
	LD	(__fman1+2),A

@fdiv_next:
	; Shift dividend (32-bit) left by 1 for next iteration
	LD	A,(__fdiv_rem)
	ADD	A,A
	LD	(__fdiv_rem),A
	LD	A,(__fdiv_rem+1)
	ADC	A,A
	LD	(__fdiv_rem+1),A
	LD	A,(__fdiv_rem+2)
	ADC	A,A
	LD	(__fdiv_rem+2),A
	LD	A,(__fdiv_rem+3)
	ADC	A,A
	LD	(__fdiv_rem+3),A

	POP	BC
	DEC	B
	JP	NZ,@fdiv_lp

	; Quotient is now in __fman1 (24 bits)
	; Check if normalization needed (bit 23 should be 1)
	; May need to shift multiple times if quotient is small
@fdiv_norm:
	LD	A,(__fman1+2)
	BIT	7,A
	JR	NZ,@fdiv_dn

	; Bit 23 is 0, shift left and decrement exponent
	LD	A,(__fman1)
	ADD	A,A
	LD	(__fman1),A
	LD	A,(__fman1+1)
	ADC	A,A
	LD	(__fman1+1),A
	LD	A,(__fman1+2)
	ADC	A,A
	LD	(__fman1+2),A

	LD	HL,(__fexp1)
	DEC	HL
	LD	(__fexp1),HL
	JP	@fdiv_norm		; Loop until normalized

@fdiv_dn:
	RET

; ============================================================
; Float Comparison: Compare DEHL with (__tmp32)
; Returns: Z if equal, C if DEHL < __tmp32
; ============================================================
	PUBLIC	__fcmp
__fcmp:
	PUSH	BC

	; IEEE 754: -0.0 == +0.0. Special-case zero before the bit-pattern
	; compare so a signed-zero pair doesn't end up "left < right" just
	; because the sign bit differs.
	LD	A,D
	AND	7FH		; mask off left's sign bit
	OR	E
	OR	H
	OR	L
	JR	NZ,__fcmp_lnz
	; left magnitude == 0; check right
	LD	A,(__tmp32+3)
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+2)
	OR	B
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,__fcmp_lnz
	; both zero (any sign) — return Z, NC
	XOR	A		; clears Z=1 actually? XOR A sets Z; CP A is cleaner
	POP	BC
	RET
__fcmp_lnz:

	; Compare: left (DEHL) vs right (__tmp32)
	; Sets Z if equal, C if left < right
	LD	A,(__tmp32+3)
	XOR	D
	JP	P,__fcmp_same	; same sign

	; Signs differ: the negative one is smaller.  Flip the sign
	; bits so an unsigned compare of the high bytes says so.
	LD	A,(__tmp32+3)
	XOR	80H
	LD	B,A		; B = right high byte (sign-flipped)
	LD	A,D
	XOR	80H		; A = left high byte (sign-flipped)
	CP	B		; C if left < right
	JR	__fcmp_diff

__fcmp_same:
	BIT	7,D
	JR	NZ,__fcmp_neg

	; Both positive: compare the magnitudes, left against right.
	LD	A,(__tmp32+3)
	LD	B,A
	LD	A,D
	CP	B		; C if left < right
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32+2)
	LD	B,A
	LD	A,E
	CP	B
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32+1)
	LD	B,A
	LD	A,H
	CP	B
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32)
	LD	B,A
	LD	A,L
	CP	B
	JR	__fcmp_diff

__fcmp_neg:
	; Both negative: the larger magnitude is the smaller value, so
	; compare right against left.
	LD	A,(__tmp32+3)
	CP	D		; C if |right| < |left|, left < right
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32+2)
	CP	E
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32+1)
	CP	H
	JR	NZ,__fcmp_diff
	LD	A,(__tmp32)
	CP	L

__fcmp_diff:
	POP	BC
	RET

; ============================================================
; Integer to Float: DEHL = float(DEHL) (signed 32-bit)
; Also known as __ltof for long to float conversion
; ============================================================
	PUBLIC	__itof
	PUBLIC	__ltof
__ltof:
__itof:
	PUSH	BC

	; Check for zero
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__itof_nz
	LD	DE,0
	LD	HL,0
	JR	__itof_done

__itof_nz:
	; Get sign
	LD	A,D
	AND	80H
	LD	(__fsgn1),A

	; Make positive if negative
	BIT	7,D
	JR	Z,__itof_pos
	CALL	__neg32
	; Check for LONG_MIN overflow: __neg32(0x80000000) = 0x80000000
	BIT	7,D
	JR	Z,__itof_pos
	; Special case: value is 2^31, mantissa = 1<<23, exp = 127+31
	LD	HL,0
	LD	(__fman1),HL
	LD	DE,0080H	; E=0x80 = bit 23 set
	LD	(__fman1+2),DE
	LD	HL,127+31
	LD	(__fexp1),HL
	JR	__itof_pack

__itof_pos:
	; Initial exponent = 127 + 23 (normalizing to bit 23)
	PUSH	HL
	LD	HL,127+23
	LD	(__fexp1),HL
	POP	HL

	; If high byte D has bits set, shift right to bring mantissa
	; into 24-bit range (bits 0-23) before __fnorm
__itof_rshift:
	LD	A,D
	OR	A
	JR	Z,__itof_store
	; Shift DEHL right by 1
	SRL	D
	RR	E
	RR	H
	RR	L
	; Increment exponent
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	JR	__itof_rshift

__itof_store:
	; Store mantissa (now D=0, bits in EHL)
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Normalize (shift mantissa left until bit 23 is set)
	CALL	__fnorm
__itof_pack:

	; Pack result
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

__itof_done:
	POP	BC
	RET

; ============================================================
; Unsigned Integer to Float: DEHL = float(DEHL) (unsigned 32-bit)
; ============================================================
	PUBLIC	__uitof
__uitof:
	PUSH	BC

	; Check for zero
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__uitof_nz
	LD	DE,0
	LD	HL,0
	JR	__uitof_done

__uitof_nz:
	; Sign is always positive
	XOR	A
	LD	(__fsgn1),A

	; Initial exponent = 127 + 23 (normalizing to bit 23)
	PUSH	HL
	LD	HL,127+23
	LD	(__fexp1),HL
	POP	HL

	; If high byte D has bits set, shift right to bring mantissa
	; into 24-bit range (bits 0-23) before __fnorm
__uitof_rshift:
	LD	A,D
	OR	A
	JR	Z,__uitof_store
	; Shift DEHL right by 1
	SRL	D
	RR	E
	RR	H
	RR	L
	; Increment exponent
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	JR	__uitof_rshift

__uitof_store:
	; Store mantissa
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Normalize
	CALL	__fnorm

	; Pack
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

__uitof_done:
	POP	BC
	RET

; ============================================================
; Float to Integer: DEHL = int(DEHL) (truncate towards zero)
; ============================================================
	PUBLIC	__ftoi
__ftoi:
	PUSH	BC

	; Check for zero
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__ftoi_nz
	LD	DE,0
	LD	HL,0
	JR	__ftoi_done

__ftoi_nz:
	; Unpack
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Check exponent range
	LD	HL,(__fexp1)
	LD	DE,127
	OR	A
	SBC	HL,DE		; HL = exp - 127 (actual exponent)
	JR	C,__ftoi_zero	; exp < 0, result is 0

	LD	A,L
	CP	31
	JR	NC,__ftoi_ovf	; exp >= 31, overflow

	; Shift mantissa right by (23 - exp) positions
	LD	B,A		; B = actual exponent
	LD	A,23
	SUB	B		; A = 23 - exp = shift count
	JR	C,__ftoi_shleft
	JR	Z,__ftoi_noshift

	LD	B,A
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
__ftoi_shrloop:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	__ftoi_shrloop
	JR	__ftoi_sign

__ftoi_shleft:
	; exp > 23, shift left
	NEG
	LD	B,A
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
__ftoi_shlloop:
	SLA	L
	RL	H
	RL	E
	RL	D
	DJNZ	__ftoi_shlloop
	JR	__ftoi_sign

__ftoi_noshift:
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)

__ftoi_sign:
	; Apply sign
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__ftoi_done
	CALL	__neg32
	JR	__ftoi_done

__ftoi_zero:
	LD	HL,0
	LD	DE,0
	JR	__ftoi_done

__ftoi_ovf:
	; Return max int
	LD	HL,0FFFFH
	LD	DE,7FFFH
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__ftoi_done
	LD	DE,8000H
	LD	HL,0

__ftoi_done:
	POP	BC
	RET

; ============================================================
; Float Unpack: Extract sign, exponent, mantissa from DEHL
; Input: DEHL = IEEE 754 float
; Output: A = sign (0 or 80H), BC = exponent, DEHL = mantissa (with implied 1)
; ============================================================
	PUBLIC	__funpack
__funpack:
	; Extract sign
	LD	A,D
	AND	80H
	PUSH	AF		; Save sign

	; Extract exponent (8 bits)
	; exp = (D & 0x7F) << 1 | (E >> 7)
	; D = sign|exp[7:1], E = exp[0]|mant[22:16]
	LD	A,D
	ADD	A,A		; A = exp[7:1] << 1 (sign shifted out)
	LD	B,A		; B = exp[7:1] << 1
	LD	A,E
	RLCA			; Rotate left, carry = bit 7 = exp[0]
	LD	A,B		; A = exp[7:1] << 1
	ADC	A,0		; A = exp[7:1] << 1 + exp[0] = full exponent
	LD	C,A
	LD	B,0		; BC = exponent

	; Extract mantissa and add implied 1
	LD	A,E
	AND	7FH		; Clear exponent bit
	OR	80H		; Add implied 1
	LD	E,A
	; DEHL now has mantissa with bit 23 = 1 (the implied 1)
	; But we need it shifted properly - E has bits 23-16, H has 15-8, L has 7-0
	; Actually mantissa is in bits 22-0, so we need to arrange
	; Let's shift everything to put implied 1 at bit 23
	; E.H.L has mantissa bits 22-0 with E bit 7 = 1 (implied)
	; This is already in the right position

	; Put mantissa in DEHL as 24-bit value in low 24 bits
	LD	D,0

	POP	AF		; Restore sign
	RET

; ============================================================
; Float Pack: Combine sign, exponent, mantissa into IEEE 754
; Input: A = sign (0 or 80H), BC = exponent, DEHL = mantissa
; Output: DEHL = IEEE 754 float
; ============================================================
	PUBLIC	__fpack
__fpack:
	PUSH	AF		; Save sign

	; Check for zero mantissa
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__fpack_nz
	; Return zero
	LD	DE,0
	LD	HL,0
	POP	AF
	RET

__fpack_nz:
	; Combine exponent and mantissa
	; Exponent in C, mantissa in E.H.L (bit 23 is implied 1)
	LD	A,E
	AND	7FH		; Clear implied 1 bit
	LD	E,A

	; Insert exponent into result
	; D will hold exp[7:1], E will hold exp[0]|mantissa[22:16]
	LD	A,C		; Get exponent
	SRL	A		; Shift right, bit 0 → carry, bits 7-1 → bits 6-0
	LD	D,A		; D = exp[7:1] in bits 6-0

	; Insert exponent bit 0 into E bit 7
	LD	A,E		; A = mantissa bits 22-16 (cleared of implied 1)
	JR	NC,__fpack_exp0_clear
	SET	7,A		; Set bit 7 if exponent bit 0 was 1
__fpack_exp0_clear:
	LD	E,A		; E = exp[0]|mantissa[22:16]

	; Add sign
	POP	AF
	OR	D
	LD	D,A
	RET

; ============================================================
; Float Normalize: Normalize mantissa in __fman1 and adjust __fexp1
; ============================================================
	PUBLIC	__fnorm
__fnorm:
	; Check for zero
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	A,D
	OR	E
	OR	H
	OR	L
	RET	Z		; Zero stays zero

	; Check if bits above bit 23 are set (D != 0)
	; If so, shift right until D == 0 and bit 7 of E is the leading 1
	LD	A,D
	OR	A
	JR	Z,__fnorm_loop	; D is zero, go to left-shift path

	; Right-shift path: mantissa is too large (bits above bit 23 set)
__fnorm_rloop:
	LD	A,D
	OR	A
	JR	Z,__fnorm_rchk	; D is zero, check if normalized
	; Shift mantissa right
	SRL	D
	RR	E
	RR	H
	RR	L
	; Increment exponent
	PUSH	DE
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	POP	DE
	JR	__fnorm_rloop

__fnorm_rchk:
	; D is zero. Check if bit 7 of E is set (normalized)
	BIT	7,E
	JR	NZ,__fnorm_done	; Done
	; Still need left shifts
	; Fall through to left-shift loop

	; Shift left until bit 23 is set (bit 7 of E)
__fnorm_loop:
	BIT	7,E
	JR	NZ,__fnorm_done	; Normalized when bit 23 set

	; Shift mantissa left
	SLA	L
	RL	H
	RL	E
	RL	D

	; Decrement exponent
	PUSH	DE
	PUSH	HL
	LD	HL,(__fexp1)
	DEC	HL
	LD	(__fexp1),HL
	POP	HL
	POP	DE

	; Check for underflow
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__fnorm_loop

	; Underflow to zero
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	LD	HL,0
	LD	(__fexp1),HL
	RET

__fnorm_done:
	; Save normalized mantissa back to memory
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	RET

; ============================================================
; Float Negation: DEHL = -DEHL
; ============================================================
	PUBLIC	__fneg
__fneg:
	LD	A,D
	XOR	80H
	LD	D,A
	RET

	DSEG
	PUBLIC	__fop1,__fop2,__fsgn1,__fsgn2,__fexp1,__fexp2,__fman1,__fman2
__fop1:
	DW	0,0
__fop2:
	DW	0,0
__fsgn1:
	DB	0
__fsgn2:
	DB	0
__fexp1:
	DW	0
__fexp2:
	DW	0
__fman1:
	DW	0,0
__fman2:
	DW	0,0
__fdiv_rem:
	DW	0,0


; Temporary storage for partial products in float multiplication
__fmul_hh:
	DW	0,0
__fmul_hl:
	DW	0,0
__fmul_lh:
	DW	0,0
__fmul_ll:
	DW	0,0
	END
