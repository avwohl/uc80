; rt_div16.mac - __div16
; Split from rt_arith16.mac

	.Z80

	EXTRN	__dv8n
	EXTRN	__divrem

	CSEG
; ============================================================
; 16-bit unsigned division: HL = DE / HL
; Also sets __divrem to remainder (DE % HL), and returns the
; remainder in DE.  Division by zero: HL = 0, remainder 0.
; Preserves BC, IX, IY.  Clobbers A, flags.
; A divisor of 256 or more uses a loop of 8 steps (family K, step 2);
; lib/rt_alt/rt_div16.mac has the older version with __dv8w.
; ============================================================
	PUBLIC	__div16
__div16:
	EX	DE,HL		; HL = dividend, DE = divisor
	LD	A,D
	OR	E
	JR	Z,__div16_zero
	PUSH	BC
	LD	A,D
	OR	A
	JR	NZ,__div16_w
	LD	C,E		; divisor < 256
	LD	A,H
	CP	C
	JR	C,__div16_lo	; H < divisor: quotient < 256
	LD	E,H
	XOR	A
	CALL	__dv8n		; E = quotient high byte, A = remainder
	LD	H,E
	LD	E,L
	CALL	__dv8n		; E = quotient low byte
	LD	L,E
	JR	__div16_n
__div16_lo:
	LD	E,L		; A = H is the remainder so far
	CALL	__dv8n
	LD	L,E
	LD	H,0
__div16_n:
	LD	E,A
	LD	D,0
	JR	__div16_done
__div16_w:
	LD	A,L		; divisor >= 256: quotient < 256, and the
	LD	L,H		; remainder so far is the high byte
	LD	H,0
	LD	B,8
__div16_wl:
	RLA			; dividend bit out, quotient bit in (as
	ADC	HL,HL		; the complement of the carry)
	JR	C,__div16_wo	; remainder passed 65535: above the divisor
	SBC	HL,DE
	JR	NC,__div16_wk
	ADD	HL,DE		; restore; this sets carry
__div16_wk:
	DJNZ	__div16_wl
	JR	__div16_wd
__div16_wo:
	OR	A
	SBC	HL,DE		; borrows
	CCF			; carry 0: quotient bit 1
	DJNZ	__div16_wl
__div16_wd:
	RLA
	CPL			; A = quotient, HL = remainder
	EX	DE,HL
	LD	L,A
	LD	H,0
__div16_done:
	LD	(__divrem),DE
	POP	BC
	RET
__div16_zero:
	LD	HL,0
	LD	(__divrem),HL
	LD	D,H
	LD	E,L
	RET

	END
