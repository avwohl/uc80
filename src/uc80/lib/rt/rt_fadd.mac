; rt_fadd.mac - __fadd
; Split from rt_float.mac

	.Z80

	EXTRN	__tmp32
	EXTRN	__fexp1
	EXTRN	__fexp2
	EXTRN	__fman1
	EXTRN	__fman2
	EXTRN	__fnorm
	EXTRN	__fop1
	EXTRN	__fop2
	EXTRN	__fpack
	EXTRN	__fsgn1
	EXTRN	__fsgn2
	EXTRN	__funpack

	CSEG
; ============================================================
; IEEE 754 Single-Precision Floating Point Library
; ============================================================
; Format: DEHL where D=high byte (sign+exp), E,H,L=mantissa
; Sign: bit 7 of D
; Exponent: bits 6-0 of D and bit 7 of E (8 bits total, bias 127)
; Mantissa: bits 6-0 of E and all of H,L (23 bits, implied 1.)
; ============================================================

; ============================================================
; Float Addition: DEHL = DEHL + (__tmp32)
; ============================================================
	PUBLIC	__fadd
__fadd:
	PUSH	BC
	PUSH	IX

	; Save operands to work area
	LD	(__fop1),HL
	LD	(__fop1+2),DE
	LD	HL,(__tmp32)
	LD	(__fop2),HL
	LD	HL,(__tmp32+2)
	LD	(__fop2+2),HL

	; Check for zero operands
	LD	A,D
	AND	7FH		; Mask off sign
	OR	E
	OR	H
	OR	L
	JR	NZ,__fadd_op1nz
	; Op1 is zero, return op2
	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	JR	__fadd_done

__fadd_op1nz:
	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fadd_bothnonzero
	; Op2 is zero, return op1
	LD	HL,(__fop1)
	LD	DE,(__fop1+2)
	JR	__fadd_done

__fadd_bothnonzero:
	; Unpack both operands
	LD	HL,(__fop1)
	LD	DE,(__fop1+2)
	CALL	__funpack
	LD	(__fsgn1),A	; Sign
	LD	(__fexp1),BC	; Exponent
	LD	(__fman1),HL	; Mantissa low
	LD	(__fman1+2),DE	; Mantissa high

	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	; Align exponents (shift smaller mantissa right)
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	OR	A
	SBC	HL,DE		; HL = exp1 - exp2
	JR	Z,__fadd_aligned
	JR	C,__fadd_shift1	; exp1 < exp2

	; exp1 > exp2: shift mantissa2 right by (exp1-exp2)
	LD	B,L		; Shift count
	LD	A,B
	CP	24		; If shift >= 24, result is op1
	JR	C,__fadd_doshift2
	LD	HL,(__fop1)
	LD	DE,(__fop1+2)
	JR	__fadd_done

__fadd_doshift2:
	LD	HL,(__fman2)
	LD	DE,(__fman2+2)
__fadd_shloop2:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	__fadd_shloop2
	LD	(__fman2),HL
	LD	(__fman2+2),DE
	LD	HL,(__fexp1)
	LD	(__fexp2),HL	; Set exp2 = exp1
	JR	__fadd_aligned

__fadd_shift1:
	; exp1 < exp2: shift mantissa1 right by (exp2-exp1)
	LD	HL,(__fexp2)
	LD	DE,(__fexp1)
	OR	A
	SBC	HL,DE
	LD	B,L
	LD	A,B
	CP	24
	JR	C,__fadd_doshift1
	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	JR	__fadd_done

__fadd_doshift1:
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
__fadd_shloop1:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	__fadd_shloop1
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	LD	HL,(__fexp2)
	LD	(__fexp1),HL

__fadd_aligned:
	; Add or subtract mantissas based on signs
	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	JR	NZ,__fadd_subtract

	; Same signs: add mantissas
	LD	HL,(__fman1)
	LD	DE,(__fman2)
	ADD	HL,DE
	LD	(__fman1),HL
	LD	HL,(__fman1+2)
	LD	DE,(__fman2+2)
	ADC	HL,DE
	LD	(__fman1+2),HL

	; Check for mantissa overflow (carry into bit 24+)
	; After ADC, HL contains high word. H=byte3 (bits 31-24), L=byte2 (bits 23-16)
	; Check if H (bits 31-24) has any bits set
	LD	A,H
	OR	A
	JR	Z,__fadd_normalize	; No overflow

	; Overflow: need to shift mantissa right and increment exponent
	; Most common case: single bit overflow (H=1)
	LD	HL,(__fman1)		; Load low word
	LD	DE,(__fman1+2)		; Load high word (D has overflow bits)

	; Shift right by 1
	SRL	D			; Shift D (bits 31-24) right
	RR	E			; Rotate E (bits 23-16) right with carry
	RR	H			; Rotate H (bits 15-8) right with carry
	RR	L			; Rotate L (bits 7-0) right with carry

	LD	(__fman1),HL		; Store back low word
	LD	(__fman1+2),DE		; Store back high word

	; Increment exponent
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL

	; Result sign is same as operands
	JR	__fadd_normalize

__fadd_subtract:
	; Different signs: subtract mantissas
	; Compare magnitudes first
	LD	HL,(__fman1+2)
	LD	DE,(__fman2+2)
	OR	A
	SBC	HL,DE
	JR	NZ,__fadd_cmphi
	LD	HL,(__fman1)
	LD	DE,(__fman2)
	OR	A
	SBC	HL,DE
__fadd_cmphi:
	JR	NC,__fadd_sub_m1_m2

	; man2 > man1: result = man2 - man1, sign = sgn2
	LD	HL,(__fman2)
	LD	DE,(__fman1)
	OR	A
	SBC	HL,DE
	LD	(__fman1),HL
	LD	HL,(__fman2+2)
	LD	DE,(__fman1+2)
	SBC	HL,DE
	LD	(__fman1+2),HL
	LD	A,(__fsgn2)
	LD	(__fsgn1),A
	JR	__fadd_normalize

__fadd_sub_m1_m2:
	; man1 >= man2: result = man1 - man2, sign = sgn1
	LD	HL,(__fman1)
	LD	DE,(__fman2)
	OR	A
	SBC	HL,DE
	LD	(__fman1),HL
	LD	HL,(__fman1+2)
	LD	DE,(__fman2+2)
	SBC	HL,DE
	LD	(__fman1+2),HL

__fadd_normalize:
	; Normalize result in __fman1, __fexp1, __fsgn1
	CALL	__fnorm
	; Overflow check: __fnorm may have bumped __fexp1 (right-shift
	; renormalisation when the sum carried into bit 24). If the
	; biased exponent now hits 255 the result is inf; otherwise
	; __fpack would encode it as a NaN-shaped value (exp=255 with
	; non-zero mantissa).
	LD	HL,(__fexp1)
	LD	A,H
	OR	A
	JR	NZ,__fadd_inf
	LD	A,L
	CP	255
	JR	NC,__fadd_inf
	; Pack result
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

__fadd_done:
	POP	IX
	POP	BC
	RET

__fadd_inf:
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__fadd_inf_pos
	LD	DE,0FF80H
	LD	HL,0
	JR	__fadd_done
__fadd_inf_pos:
	LD	DE,07F80H
	LD	HL,0
	JR	__fadd_done

	END
