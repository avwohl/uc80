; rt_fadd.mac - __fadd
; Split from rt_float.mac

	.Z80

	EXTRN	__tmp32
	EXTRN	__fpack
	EXTRN	__funpack

	CSEG
; ============================================================
; IEEE 754 Single-Precision Floating Point Library
; ============================================================
; Format: DEHL where D=high byte (sign+exp), E,H,L=mantissa
; Sign: bit 7 of D
; Exponent: bits 6-0 of D and bit 7 of E (8 bits total, bias 127)
; Mantissa: bits 6-0 of E and all of H,L (23 bits, implied 1.)
; ============================================================

; ============================================================
; Float Addition: DEHL = DEHL + (__tmp32)
;
; The result is rounded to nearest, ties to even.  Each mantissa has five
; extra low bits, and the bits that the alignment shifts out are OR-ed into
; the lowest of them.  A subnormal operand counts as zero, and a result
; below the smallest normal number is zero.  An infinity or a NaN in an
; operand gives the IEEE result.
;
; The data labels start with two underscores, because the compiler embeds
; only the data with such names (runtime.py).
;
; Each operand is unpacked into a block of 6 bytes:
;   +0 sign (0 or 80H), +1 exponent, +2 to +5 mantissa (32 bits, little endian)
; ============================================================
	PUBLIC	__fadd
__fadd:
	PUSH	BC
	PUSH	IX
	LD	(__fa_o1),HL
	LD	(__fa_o1+2),DE
	LD	IX,__fa1
	CALL	_fa_unp
	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	LD	IX,__fa2
	CALL	_fa_unp

	LD	A,(__fa1+1)
	LD	B,A		; B = exponent of operand 1
	LD	A,(__fa2+1)
	LD	C,A		; C = exponent of operand 2
	LD	A,B
	OR	A
	JR	Z,_fa_z1
	LD	A,C
	OR	A
	JR	Z,_fa_ret1
	LD	A,B
	CP	255
	JR	Z,_fa_sp
	LD	A,C
	CP	255
	JR	Z,_fa_sp

	; align: the operand with the smaller exponent shifts right
	LD	A,B
	SUB	C
	LD	L,B		; L = exponent of the result
	JR	Z,_fa_aligned
	JR	NC,_fa_sh2
	NEG
	LD	L,C
	LD	IX,__fa1
	JR	_fa_shift
_fa_sh2:
	LD	IX,__fa2
_fa_shift:
	LD	H,0
	LD	(__fa_e),HL
	CP	32
	JR	C,_fa_cnt
	LD	A,31
_fa_cnt:
	LD	B,A
	LD	L,(IX+2)
	LD	H,(IX+3)
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	C,0		; C = sticky
_fa_s1:
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	NC,_fa_s2
	LD	C,1
_fa_s2:
	DJNZ	_fa_s1
	LD	A,C
	OR	A
	JR	Z,_fa_s3
	SET	0,L
_fa_s3:
	LD	(IX+2),L
	LD	(IX+3),H
	LD	(IX+4),E
	LD	(IX+5),D
	JR	_fa_as2
_fa_aligned:
	LD	H,0
	LD	(__fa_e),HL
_fa_as2:
	; add or subtract the mantissas
	LD	A,(__fa1)
	LD	B,A
	LD	A,(__fa2)
	XOR	B
	JR	NZ,_fa_sub
	LD	HL,(__fa1+2)
	LD	BC,(__fa2+2)
	ADD	HL,BC
	PUSH	HL
	LD	HL,(__fa1+4)
	LD	BC,(__fa2+4)
	ADC	HL,BC
	EX	DE,HL
	POP	HL
	LD	A,(__fa1)
	JR	_fa_norm
_fa_sub:
	LD	HL,(__fa1+2)
	LD	BC,(__fa2+2)
	OR	A
	SBC	HL,BC
	PUSH	HL
	LD	HL,(__fa1+4)
	LD	BC,(__fa2+4)
	SBC	HL,BC
	EX	DE,HL
	POP	HL
	LD	A,(__fa1)
	JR	NC,_fa_norm
	; operand 2 is larger: the result is m2 - m1 with the sign of operand 2
	LD	HL,(__fa2+2)
	LD	BC,(__fa1+2)
	OR	A
	SBC	HL,BC
	PUSH	HL
	LD	HL,(__fa2+4)
	LD	BC,(__fa1+4)
	SBC	HL,BC
	EX	DE,HL
	POP	HL
	LD	A,(__fa2)
_fa_norm:
	LD	(__fa_s),A
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,_fa_nz
	LD	DE,0		; exact zero: +0
	LD	HL,0
	JR	_fa_done
_fa_nz:
	; normalise: the leading bit goes to bit 28 (bit 4 of D)
	LD	BC,(__fa_e)
	BIT	5,D
	JR	Z,_fa_nocarry
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	NC,_fa_c1
	SET	0,L
_fa_c1:
	INC	BC
	JR	_fa_round
_fa_nocarry:
	BIT	4,D
	JR	NZ,_fa_round
_fa_left:
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	DEC	BC
	BIT	4,D
	JR	Z,_fa_left
_fa_round:
	LD	A,L
	AND	1FH
	LD	(__fa_e),A	; the five low bits
	LD	A,B
	LD	B,5
_fa_shr5:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	_fa_shr5
	LD	B,A		; B = high byte of the exponent again
	LD	A,(__fa_e)
	CP	17
	JR	NC,_fa_up
	CP	16
	JR	NZ,_fa_rounded
	BIT	0,L
	JR	Z,_fa_rounded
_fa_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,_fa_rounded
	INC	DE
_fa_rounded:
	LD	A,D
	OR	A
	JR	Z,_fa_range
	LD	DE,0080H	; the mantissa carried to 2^24
	LD	HL,0
	INC	BC
_fa_range:
	LD	A,(__fa_s)
	LD	D,A		; D = sign (the high byte of the mantissa is zero)
	BIT	7,B
	JR	NZ,_fa_under
	LD	A,B
	OR	A
	JR	NZ,_fa_over
	LD	A,C
	OR	A
	JR	Z,_fa_under
	CP	255
	JR	NC,_fa_over
	LD	A,D
	LD	D,0
	CALL	__fpack
_fa_done:
	POP	IX
	POP	BC
	RET

_fa_under:
	LD	E,0
	LD	HL,0
	JR	_fa_done
_fa_over:
	LD	A,D
	OR	7FH
	LD	D,A
	LD	E,80H
	LD	HL,0
	JR	_fa_done

; operand 1 is zero (exponent 0): the result is operand 2, or a zero
_fa_z1:
	LD	A,C
	OR	A
	JR	NZ,_fa_ret2
	LD	A,(__fa1)
	LD	HL,__fa2
	AND	(HL)
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	_fa_done
_fa_ret2:
	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	JR	_fa_done
_fa_ret1:
	LD	HL,(__fa_o1)
	LD	DE,(__fa_o1+2)
	JR	_fa_done

; an exponent of 255: infinity or NaN
_fa_sp:
	LD	A,B
	CP	255
	JR	NZ,_fa_sp2
	LD	A,(__fa_o1+2)
	AND	7FH
	LD	HL,(__fa_o1)
	OR	H
	OR	L
	JR	NZ,_fa_ret1	; operand 1 is a NaN
_fa_sp2:
	LD	A,C
	CP	255
	JR	NZ,_fa_ret1	; operand 1 is the infinity
	LD	A,(__tmp32+2)
	AND	7FH
	LD	HL,(__tmp32)
	OR	H
	OR	L
	JR	NZ,_fa_ret2	; operand 2 is a NaN
	LD	A,B
	CP	255
	JR	NZ,_fa_ret2	; only operand 2 is infinite
	LD	A,(__fa1)
	LD	HL,__fa2
	XOR	(HL)
	JR	Z,_fa_ret1	; the same infinity twice
	LD	DE,07FC0H	; inf - inf: a quiet NaN
	LD	HL,0
	JR	_fa_done

; unpack the float in DEHL into the block at IX; the mantissa gets 5 more bits
_fa_unp:
	CALL	__funpack
	LD	(IX+0),A
	LD	(IX+1),C
	LD	B,5
_fa_u5:
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	DJNZ	_fa_u5
	LD	(IX+2),L
	LD	(IX+3),H
	LD	(IX+4),E
	LD	(IX+5),D
	RET

	COMMON	/rt_fadd/
__fa1:
	DS	6
__fa2:
	DS	6
__fa_o1:
	DS	4
__fa_e:
	DS	2
__fa_s:
	DS	1

; ---- BEGIN work-area save helpers (gen_wa_helpers.py) ----
	CSEG
	PUBLIC	__wasv_rt_fadd
	PUBLIC	__wars_rt_fadd
__wasv_rt_fadd:
	POP	IY
	LD	HL,-19
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL
	LD	HL,__fa1
	LD	BC,19
	LDIR
	JP	(IY)
__wars_rt_fadd:
	POP	IY
	LD	HL,0
	ADD	HL,SP
	LD	DE,__fa1
	LD	BC,19
	LDIR
	LD	SP,HL
	JP	(IY)
; ---- END work-area save helpers ----

	END
