; rt_fadd.mac - __fadd
; Split from rt_float.mac

	.Z80

	EXTRN	__tmp32
	EXTRN	__fexp1
	EXTRN	__fman1
	EXTRN	__fman2
	EXTRN	__fop1
	EXTRN	__fop2
	EXTRN	__fpack

	CSEG
; ============================================================
; IEEE 754 Single-Precision Floating Point Library
; ============================================================
; Format: DEHL where D=high byte (sign+exp), E,H,L=mantissa
; Sign: bit 7 of D
; Exponent: bits 6-0 of D and bit 7 of E (8 bits total, bias 127)
; Mantissa: bits 6-0 of E and all of H,L (23 bits, implied 1.)
; ============================================================

; ============================================================
; Float Addition: DEHL = DEHL + (__tmp32)
;
; The result is rounded to nearest, ties to even.  The mantissas have five
; extra low bits; the bits that the alignment shifts out are OR-ed into the
; lowest of them.  A subnormal operand counts as zero, and a result below
; the smallest normal number is zero.  An infinity or a NaN in an operand
; gives the IEEE result.
; ============================================================
	PUBLIC	__fadd
__fadd:
	PUSH	BC
	PUSH	IX

	LD	(__fop1),HL
	LD	(__fop1+2),DE
	LD	HL,(__tmp32)
	LD	(__fop2),HL
	LD	HL,(__tmp32+2)
	LD	(__fop2+2),HL

	; B = exponent of operand 1, C = exponent of operand 2
	LD	A,D
	ADD	A,A
	LD	B,A
	LD	A,E
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A
	LD	A,(__fop2+3)
	ADD	A,A
	LD	C,A
	LD	A,(__fop2+2)
	RLCA
	LD	A,C
	ADC	A,0
	LD	C,A

	LD	A,B
	CP	255
	JP	Z,__fadd_special
	LD	A,C
	CP	255
	JP	Z,__fadd_special
	LD	A,B
	OR	A
	JR	Z,__fadd_azero
	LD	A,C
	OR	A
	JP	Z,__fadd_retx

	; Order the operands: operand 1 gets the larger magnitude.
	LD	A,B
	CP	C
	JR	C,__fadd_swap
	JR	NZ,__fadd_ordered
	LD	A,(__fop1+2)
	AND	7FH
	LD	D,A
	LD	A,(__fop2+2)
	AND	7FH
	CP	D
	JR	C,__fadd_ordered
	JR	NZ,__fadd_swap
	LD	A,(__fop1+1)
	LD	D,A
	LD	A,(__fop2+1)
	CP	D
	JR	C,__fadd_ordered
	JR	NZ,__fadd_swap
	LD	A,(__fop1)
	LD	D,A
	LD	A,(__fop2)
	CP	D
	JR	C,__fadd_ordered
	JR	Z,__fadd_ordered
__fadd_swap:
	LD	HL,(__fop1)
	LD	DE,(__fop2)
	LD	(__fop1),DE
	LD	(__fop2),HL
	LD	HL,(__fop1+2)
	LD	DE,(__fop2+2)
	LD	(__fop1+2),DE
	LD	(__fop2+2),HL
	LD	A,B
	LD	B,C
	LD	C,A
__fadd_ordered:
	; B = exponent of the larger number, C = exponent of the smaller
	LD	A,B
	LD	E,0
	LD	D,0
	LD	H,0
	LD	L,A
	LD	(__fexp1),HL
	SUB	C		; A = shift count for the smaller number
	CP	30
	JP	NC,__fadd_retx	; the smaller number is below the last bit
	PUSH	AF

	; larger mantissa <<5 into __fman1
	LD	A,(__fop1+2)
	OR	80H
	LD	E,A
	LD	HL,(__fop1)
	LD	D,0
	LD	B,5
__fadd_shl1:
	SLA	L
	RL	H
	RL	E
	RL	D
	DJNZ	__fadd_shl1
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; smaller mantissa <<5, then >> count with a sticky bit
	LD	A,(__fop2+2)
	OR	80H
	LD	E,A
	LD	HL,(__fop2)
	LD	D,0
	LD	B,5
__fadd_shl2:
	SLA	L
	RL	H
	RL	E
	RL	D
	DJNZ	__fadd_shl2
	POP	AF
	LD	B,A
	LD	C,0		; C = sticky
	OR	A
	JR	Z,__fadd_aligned
__fadd_shr:
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	NC,__fadd_shr_nc
	LD	C,1
__fadd_shr_nc:
	DJNZ	__fadd_shr
	LD	A,C
	OR	A
	JR	Z,__fadd_aligned
	SET	0,L
__fadd_aligned:
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	; add or subtract
	LD	A,(__fop1+3)
	LD	B,A
	LD	A,(__fop2+3)
	XOR	B
	AND	80H
	JR	NZ,__fadd_sub
	LD	HL,(__fman1)
	LD	BC,(__fman2)
	ADD	HL,BC
	LD	(__fman1),HL
	LD	HL,(__fman1+2)
	LD	BC,(__fman2+2)
	ADC	HL,BC
	LD	(__fman1+2),HL
	JR	__fadd_sum
__fadd_sub:
	LD	HL,(__fman1)
	LD	BC,(__fman2)
	OR	A
	SBC	HL,BC
	LD	(__fman1),HL
	LD	HL,(__fman1+2)
	LD	BC,(__fman2+2)
	SBC	HL,BC
	LD	(__fman1+2),HL
__fadd_sum:
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__fadd_nz
	LD	DE,0		; exact zero: +0
	LD	HL,0
	JP	__fadd_done
__fadd_nz:
	; normalise: the leading bit goes to bit 28 (bit 4 of D)
	BIT	5,D
	JR	Z,__fadd_nocarry
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	NC,__fadd_c1
	SET	0,L
__fadd_c1:
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	JR	__fadd_round
__fadd_nocarry:
	BIT	4,D
	JR	NZ,__fadd_round
	PUSH	BC
	LD	BC,(__fexp1)
__fadd_left:
	SLA	L
	RL	H
	RL	E
	RL	D
	DEC	BC
	BIT	4,D
	JR	Z,__fadd_left
	LD	(__fexp1),BC
	POP	BC
__fadd_round:
	LD	A,L
	AND	1FH
	LD	C,A		; C = the five low bits
	LD	B,5
__fadd_shr5:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	__fadd_shr5
	LD	A,C
	CP	17
	JR	NC,__fadd_up
	CP	16
	JR	NZ,__fadd_rounded
	BIT	0,L
	JR	Z,__fadd_rounded
__fadd_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,__fadd_rounded
	INC	DE
__fadd_rounded:
	LD	A,D
	OR	A
	JR	Z,__fadd_range
	LD	DE,0080H	; the mantissa carried to 2^24
	LD	HL,0
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
__fadd_range:
	PUSH	HL
	LD	HL,(__fexp1)
	BIT	7,H
	JR	NZ,__fadd_under
	LD	A,H
	OR	A
	JR	NZ,__fadd_over
	LD	A,L
	OR	A
	JR	Z,__fadd_under
	CP	255
	JR	NC,__fadd_over
	LD	B,H
	LD	C,L
	POP	HL
	LD	D,0
	LD	A,(__fop1+3)
	AND	80H
	CALL	__fpack
__fadd_done:
	POP	IX
	POP	BC
	RET

__fadd_under:
	POP	HL
	LD	A,(__fop1+3)
	AND	80H
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	__fadd_done
__fadd_over:
	POP	HL
	LD	A,(__fop1+3)
	AND	80H
	OR	7FH
	LD	D,A
	LD	E,80H
	LD	HL,0
	JR	__fadd_done

; operand 1 is zero (exponent 0): the result is operand 2, or a zero
__fadd_azero:
	LD	A,C
	OR	A
	JR	NZ,__fadd_rety
	LD	A,(__fop1+3)
	LD	B,A
	LD	A,(__fop2+3)
	AND	B
	AND	80H
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	__fadd_done
__fadd_rety:
	LD	HL,(__fop2)
	LD	DE,(__fop2+2)
	JR	__fadd_done
__fadd_retx:
	LD	HL,(__fop1)
	LD	DE,(__fop1+2)
	JR	__fadd_done

; an exponent of 255: infinity or NaN
__fadd_special:
	LD	A,B
	CP	255
	JR	NZ,__fadd_sp2
	; operand 1 is inf or NaN
	LD	A,(__fop1+2)
	AND	7FH
	LD	HL,(__fop1)
	OR	H
	OR	L
	JR	NZ,__fadd_retx	; NaN
__fadd_sp2:
	LD	A,C
	CP	255
	JR	NZ,__fadd_retx	; operand 1 is the infinity
	LD	A,(__fop2+2)
	AND	7FH
	LD	HL,(__fop2)
	OR	H
	OR	L
	JR	NZ,__fadd_rety	; operand 2 is NaN
	LD	A,B
	CP	255
	JR	NZ,__fadd_rety	; only operand 2 is infinite
	LD	A,(__fop1+3)
	LD	B,A
	LD	A,(__fop2+3)
	XOR	B
	AND	80H
	JR	Z,__fadd_retx	; the same infinity twice
	LD	DE,07FC0H	; inf - inf: a quiet NaN
	LD	HL,0
	JR	__fadd_done

	END
