; rt_div32.mac - __div32
; Split from rt_arith32.mac

	.Z80

	EXTRN	__tmp32
	EXTRN	__dv8n
	EXTRN	__dv8w
	EXTRN	__div32_dvd
	EXTRN	__rem32

	CSEG
; ============================================================
; 32-bit unsigned division: DEHL = DEHL / (__tmp32)
; Also stores remainder in __rem32.
; Division by zero: quotient 0FFFFFFFFH, remainder = dividend.
; Preserves BC, IX, IY.  __tmp32 is not changed.
;
; A dividend below 65536 with a divisor of 65536 or more returns at once
; (lines tagged rt-shortcut; uc80 --no-rt-shortcuts drops them from the
; embedded copy).
;
; Divisor < 65536: long division one dividend byte at a time
; (__dv8n for an 8-bit divisor, __dv8w for a 16-bit one), with a
; 16-bit running remainder; leading bytes below the divisor cost
; almost nothing.  Divisor >= 65536: the quotient has at most 16
; bits (8 when the divisor is >= 2^24), so only that many steps of
; 32-bit restoring division run.
; ============================================================
	PUBLIC	__div32
__div32:
	PUSH	BC
	LD	(__div32_dvd),HL
	LD	(__div32_dvd+2),DE
	LD	HL,(__tmp32+2)
	LD	A,H
	OR	L
	JP	NZ,__div32_big
	LD	DE,(__tmp32)
	LD	A,D
	OR	A
	JR	NZ,__div32_w
	OR	E
	JR	Z,__div32_zero
	LD	C,E		; divisor 1..255
	LD	HL,__div32_dvd+3
	XOR	A
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	LD	L,A
	LD	H,0
	JR	__div32_r16
__div32_w:
	LD	HL,0		; divisor 256..65535
	LD	A,(__div32_dvd+3)
	CALL	__dv8w
	LD	(__div32_dvd+3),A
	LD	A,(__div32_dvd+2)
	CALL	__dv8w
	LD	(__div32_dvd+2),A
	LD	A,(__div32_dvd+1)
	CALL	__dv8w
	LD	(__div32_dvd+1),A
	LD	A,(__div32_dvd)
	CALL	__dv8w
	LD	(__div32_dvd),A
__div32_r16:
	LD	(__rem32),HL
	LD	HL,0
	LD	(__rem32+2),HL
__div32_q:
	LD	HL,(__div32_dvd)
	LD	DE,(__div32_dvd+2)
	POP	BC
	RET
__div32_zero:
	LD	DE,0FFFFH	; quotient 0FFFFFFFFH
__div32_cp:			; DE = both words of the quotient
	LD	HL,(__div32_dvd)
	LD	(__rem32),HL
	LD	HL,(__div32_dvd+2)
	LD	(__rem32+2),HL
	LD	H,D
	LD	L,E
	POP	BC
	RET
__div32_big:
	LD	DE,(__div32_dvd+2)	;@rt-shortcut dividend < 65536 and
	LD	A,D			;@rt-shortcut divisor >= 65536:
	OR	E			;@rt-shortcut quotient 0,
	JR	Z,__div32_cp		;@rt-shortcut remainder = dividend
	PUSH	IY
	LD	IY,__tmp32
	LD	A,H
	OR	A
	JR	NZ,__div32_b3
	LD	DE,0		; divisor < 2^24: remainder starts as the
	LD	HL,(__div32_dvd+2) ; high word, two quotient bytes
	LD	A,(__div32_dvd+1)
	LD	C,A
	CALL	__div32_g
	LD	A,C
	LD	(__div32_dvd+1),A
	JR	__div32_b0
__div32_b3:
	LD	A,(__div32_dvd+3) ; divisor >= 2^24: remainder starts as
	LD	E,A		; the top three bytes, one quotient byte
	LD	D,0
	LD	HL,(__div32_dvd+1)
	XOR	A
	LD	(__div32_dvd+1),A
__div32_b0:
	LD	A,(__div32_dvd)
	LD	C,A
	CALL	__div32_g
	LD	A,C
	LD	(__div32_dvd),A
	LD	(__rem32),HL
	LD	(__rem32+2),DE
	LD	HL,0
	LD	(__div32_dvd+2),HL
	POP	IY
	JR	__div32_q

; One quotient byte of 32-bit restoring division.
; In:  DEHL = remainder (< divisor), C = dividend byte, IY = __tmp32
; Out: C = quotient byte, DEHL = new remainder.  Clobbers A, B.
__div32_g:
	LD	B,8
__div32_gl:
	SLA	C		; next dividend bit out, quotient bit 0 in
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	JR	C,__div32_gs	; remainder passed 2^32: above the divisor
	LD	A,D		; compare DEHL with the divisor, top first
	CP	(IY+3)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,E
	CP	(IY+2)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,H
	CP	(IY+1)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,L
	CP	(IY+0)
	JR	C,__div32_gn
__div32_gs:
	LD	A,L		; DEHL -= divisor
	SUB	(IY+0)
	LD	L,A
	LD	A,H
	SBC	A,(IY+1)
	LD	H,A
	LD	A,E
	SBC	A,(IY+2)
	LD	E,A
	LD	A,D
	SBC	A,(IY+3)
	LD	D,A
	INC	C
__div32_gn:
	DJNZ	__div32_gl
	RET

	END
