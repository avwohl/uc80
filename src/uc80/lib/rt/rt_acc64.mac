; rt_acc64.mac - __acc64, __tmp64
; Split from rt_arith64.mac

	.Z80

	CSEG
; ============================================================
; 64-bit Integer Support
; Convention: 64-bit values stored in __acc64 (accumulator) and __tmp64
; ============================================================

; 64-bit accumulator and temporary storage
	COMMON	/rt_acc64/
	PUBLIC	__acc64
__acc64:	DS	8	; 64-bit accumulator
	PUBLIC	__tmp64
__tmp64:	DS	8	; 64-bit temporary

; ---- BEGIN work-area save helpers (gen_wa_helpers.py) ----
	CSEG
	PUBLIC	__wasv_rt_acc64
	PUBLIC	__wars_rt_acc64
__wasv_rt_acc64:
	POP	IY
	LD	HL,-16
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL
	LD	HL,__acc64
	LD	BC,16
	LDIR
	JP	(IY)
__wars_rt_acc64:
	POP	IY
	LD	HL,0
	ADD	HL,SP
	LD	DE,__acc64
	LD	BC,16
	LDIR
	LD	SP,HL
	JP	(IY)
; ---- END work-area save helpers ----

	END
