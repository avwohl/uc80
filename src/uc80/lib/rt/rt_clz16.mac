; rt_clz16.mac - __clz16
; Split from rt_arith16.mac

	.Z80

	CSEG
; ============================================================
; __clz16 — count leading zeros of 16-bit HL.
; Undefined for x=0 per GCC. Returns 16 if HL == 0 (defensive).
; ============================================================
	PUBLIC	__clz16
__clz16:
	LD	A,H
	OR	L
	JR	Z,__clz16_zero
	PUSH	BC
	LD	B,0		; counter
	; Probe bits from high (15) down to 0
__clz16_lp:
	BIT	7,H
	JR	NZ,__clz16_done
	INC	B
	ADD	HL,HL
	JR	__clz16_lp
__clz16_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__clz16_zero:
	LD	HL,16
	RET

	END
