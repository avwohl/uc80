; rt_ftoi.mac - __ftoi
; Split from rt_float.mac

	.Z80

	EXTRN	__neg32
	EXTRN	__fexp1
	EXTRN	__fman1
	EXTRN	__fsgn1
	EXTRN	__funpack

	CSEG
; ============================================================
; Float to Integer: DEHL = int(DEHL) (truncate towards zero)
; ============================================================
	PUBLIC	__ftoi
__ftoi:
	PUSH	BC

	; Check for zero
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__ftoi_nz
	LD	DE,0
	LD	HL,0
	JR	__ftoi_done

__ftoi_nz:
	; Unpack
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Check exponent range
	LD	HL,(__fexp1)
	LD	DE,127
	OR	A
	SBC	HL,DE		; HL = exp - 127 (actual exponent)
	JR	C,__ftoi_zero	; exp < 0, result is 0

	LD	A,L
	CP	31
	JR	NC,__ftoi_ovf	; exp >= 31, overflow

	; Shift mantissa right by (23 - exp) positions
	LD	B,A		; B = actual exponent
	LD	A,23
	SUB	B		; A = 23 - exp = shift count
	JR	C,__ftoi_shleft
	JR	Z,__ftoi_noshift

	LD	B,A
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
__ftoi_shrloop:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	__ftoi_shrloop
	JR	__ftoi_sign

__ftoi_shleft:
	; exp > 23, shift left
	NEG
	LD	B,A
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
__ftoi_shlloop:
	SLA	L
	RL	H
	RL	E
	RL	D
	DJNZ	__ftoi_shlloop
	JR	__ftoi_sign

__ftoi_noshift:
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)

__ftoi_sign:
	; Apply sign
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__ftoi_done
	CALL	__neg32
	JR	__ftoi_done

__ftoi_zero:
	LD	HL,0
	LD	DE,0
	JR	__ftoi_done

__ftoi_ovf:
	; Return max int
	LD	HL,0FFFFH
	LD	DE,7FFFH
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__ftoi_done
	LD	DE,8000H
	LD	HL,0

__ftoi_done:
	POP	BC
	RET

	END
