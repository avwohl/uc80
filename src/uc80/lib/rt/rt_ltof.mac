; rt_ltof.mac - __ltof, __itof
; Split from rt_float.mac

	.Z80

	EXTRN	__neg32
	EXTRN	__fexp1
	EXTRN	__fman1
	EXTRN	__fnorm
	EXTRN	__fpack
	EXTRN	__fsgn1

	CSEG
; ============================================================
; Integer to Float: DEHL = float(DEHL) (signed 32-bit)
; Also known as __ltof for long to float conversion
; ============================================================
	PUBLIC	__ltof
__ltof:
	PUBLIC	__itof
__itof:
	PUSH	BC

	; Check for zero
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__itof_nz
	LD	DE,0
	LD	HL,0
	JR	__itof_done

__itof_nz:
	; Get sign
	LD	A,D
	AND	80H
	LD	(__fsgn1),A

	; Make positive if negative
	BIT	7,D
	JR	Z,__itof_pos
	CALL	__neg32
	; Check for LONG_MIN overflow: __neg32(0x80000000) = 0x80000000
	BIT	7,D
	JR	Z,__itof_pos
	; Special case: value is 2^31, mantissa = 1<<23, exp = 127+31
	LD	HL,0
	LD	(__fman1),HL
	LD	DE,0080H	; E=0x80 = bit 23 set
	LD	(__fman1+2),DE
	LD	HL,127+31
	LD	(__fexp1),HL
	JR	__itof_pack

__itof_pos:
	; Initial exponent = 127 + 23 (normalizing to bit 23)
	PUSH	HL
	LD	HL,127+23
	LD	(__fexp1),HL
	POP	HL

	; If high byte D has bits set, shift right to bring mantissa
	; into 24-bit range (bits 0-23) before __fnorm
__itof_rshift:
	LD	A,D
	OR	A
	JR	Z,__itof_store
	; Shift DEHL right by 1
	SRL	D
	RR	E
	RR	H
	RR	L
	; Increment exponent
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	JR	__itof_rshift

__itof_store:
	; Store mantissa (now D=0, bits in EHL)
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Normalize (shift mantissa left until bit 23 is set)
	CALL	__fnorm
__itof_pack:

	; Pack result
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

__itof_done:
	POP	BC
	RET

	END
