; rt_uitof.mac - __uitof
; Split from rt_float.mac

	.Z80

	EXTRN	__fexp1
	EXTRN	__fman1
	EXTRN	__fnorm
	EXTRN	__fpack
	EXTRN	__fsgn1

	CSEG
; ============================================================
; Unsigned Integer to Float: DEHL = float(DEHL) (unsigned 32-bit)
; ============================================================
	PUBLIC	__uitof
__uitof:
	PUSH	BC

	; Check for zero
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	NZ,__uitof_nz
	LD	DE,0
	LD	HL,0
	JR	__uitof_done

__uitof_nz:
	; Sign is always positive
	XOR	A
	LD	(__fsgn1),A

	; Initial exponent = 127 + 23 (normalizing to bit 23)
	PUSH	HL
	LD	HL,127+23
	LD	(__fexp1),HL
	POP	HL

	; If high byte D has bits set, shift right to bring mantissa
	; into 24-bit range (bits 0-23) before __fnorm
	LD	BC,0		; B = the last bit shifted out, C = the bits before it
__uitof_rshift:
	LD	A,D
	OR	A
	JR	Z,__uitof_round
	LD	A,B
	OR	C
	LD	C,A
	; Shift DEHL right by 1
	SRL	D
	RR	E
	RR	H
	RR	L
	LD	A,0
	RLA
	LD	B,A
	; Increment exponent
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
	JR	__uitof_rshift

__uitof_round:
	; Round to nearest, ties to even (the shift lost the bits in B and C)
	LD	A,B
	OR	A
	JR	Z,__uitof_store
	LD	A,C
	OR	A
	JR	NZ,__uitof_up
	BIT	0,L
	JR	Z,__uitof_store
__uitof_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,__uitof_store
	INC	DE
__uitof_store:
	; Store mantissa
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Normalize
	CALL	__fnorm

	; Pack
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

__uitof_done:
	POP	BC
	RET

	END
