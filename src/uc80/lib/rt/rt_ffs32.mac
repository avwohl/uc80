; rt_ffs32.mac - __ffs32
; Split from rt_arith32.mac

	.Z80

	CSEG
; ============================================================
; __ffs32 — 1-indexed lowest set bit of DEHL, 0 if none.
; ============================================================
	PUBLIC	__ffs32
__ffs32:
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,__ffs32_zero
	PUSH	BC
	LD	B,1
__ffs32_lp:
	BIT	0,L
	JR	NZ,__ffs32_done
	INC	B
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	__ffs32_lp
__ffs32_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ffs32_zero:
	LD	HL,0
	RET

	END
