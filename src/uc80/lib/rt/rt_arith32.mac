; rt_arith32.mac - 32-bit arithmetic routines
; Split from runtime.mac

	.Z80

	EXTRN	__mul16_32
	EXTRN	__neg32
	EXTRN	__tmp32
	EXTRN	__dv8n
	EXTRN	__dv8w

	CSEG

; ============================================================
; 32-bit routines
; Convention: DEHL = 32-bit value (DE=high word, HL=low word)
; For binary ops: left in DEHL, right in __tmp32
; Result returned in DEHL
; ============================================================

; ============================================================
; 32-bit addition: DEHL = DEHL + (__tmp32)
; ============================================================
	PUBLIC	__add32
__add32:
	; DEHL = DEHL + (__tmp32)
	PUSH	BC
	LD	BC,(__tmp32)	; BC = right low word
	ADD	HL,BC		; HL = left.low + right.low
	EX	DE,HL		; HL = left.high, DE = result.low
	LD	BC,(__tmp32+2)	; BC = right high word
	ADC	HL,BC		; HL = left.high + right.high + carry
	EX	DE,HL		; DEHL = result
	POP	BC
	RET

; ============================================================
; 32-bit subtraction: DEHL = DEHL - (__tmp32)
; ============================================================
	PUBLIC	__sub32
__sub32:
	PUSH	BC
	LD	BC,(__tmp32)
	OR	A		; Clear carry
	SBC	HL,BC		; HL = left.low - right.low
	EX	DE,HL
	LD	BC,(__tmp32+2)
	SBC	HL,BC		; HL = left.high - right.high - borrow
	EX	DE,HL
	POP	BC
	RET

; ============================================================
; 32-bit multiplication: DEHL = DEHL * (__tmp32)  (low 32 bits)
; When both operands are sign-extended 16-bit values the product is
; +-(|AL| * |BL|): one __mul16_32 with its 8-bit fast paths.
; Otherwise, with A = AH:AL (DEHL) and B = BH:BL (__tmp32):
;   A*B mod 2^32 = AL*BL + ((AH*BL + AL*BH) mod 2^16) << 16
; Each product is a __mul16_32 (only the low word of the cross
; products is used); a cross product is skipped when AH or BH is 0.  __tmp32 is not changed.
; Preserves BC, IX, IY.
; ============================================================
	PUBLIC	__mul32
__mul32:
	PUSH	BC
	LD	A,H		; DEHL = sign extension of HL?
	RLA
	SBC	A,A
	CP	D
	JR	NZ,__mul32_g
	CP	E
	JR	NZ,__mul32_g
	LD	C,A
	LD	A,(__tmp32+1)	; and __tmp32 of its low word?
	RLA
	SBC	A,A
	LD	B,A
	LD	A,(__tmp32+2)
	CP	B
	JR	NZ,__mul32_g
	LD	A,(__tmp32+3)
	CP	B
	JR	NZ,__mul32_g
	XOR	C
	PUSH	AF		; S flag = sign of the product
	BIT	7,H
	JR	Z,__mul32_s1
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__mul32_s1:
	LD	B,H
	LD	C,L		; BC = |AL|
	LD	HL,(__tmp32)
	BIT	7,H
	JR	Z,__mul32_s2
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__mul32_s2:
	EX	DE,HL		; DE = |BL|
	CALL	__mul16_32	; DEHL = |AL| * |BL|
	POP	AF
	POP	BC
	RET	P
	JP	__neg32
__mul32_g:
	LD	B,H
	LD	C,L		; BC = AL
	LD	A,D
	OR	E
	JR	Z,__mul32_1	; AH = 0: DE = 0 = cross sum so far
	PUSH	BC
	LD	BC,(__tmp32)
	CALL	__mul16_32	; HL = (AH * BL) mod 2^16
	POP	BC
	EX	DE,HL		; DE = cross sum
__mul32_1:
	LD	HL,(__tmp32+2)
	LD	A,H
	OR	L
	JR	Z,__mul32_2	; BH = 0
	PUSH	DE
	EX	DE,HL
	CALL	__mul16_32	; HL = (AL * BH) mod 2^16
	POP	DE
	ADD	HL,DE
	EX	DE,HL		; DE = cross sum
__mul32_2:
	PUSH	DE
	LD	DE,(__tmp32)
	CALL	__mul16_32	; DEHL = AL * BL
	EX	DE,HL
	POP	BC
	ADD	HL,BC		; high word += cross sum
	EX	DE,HL
	POP	BC
	RET

; ============================================================
; 32-bit signed multiplication: DEHL = DEHL * (__tmp32)
; The low 32 bits of a product do not depend on the signs, so this
; is __mul32.  Not a bare "JP __mul32": the peephole pass runs on
; the code between inline-asm regions one piece at a time, and a
; label whose only code is a jump, with no reference in the same
; piece, is removed as a jump to a jump.
; ============================================================
	PUBLIC	__smul32
__smul32:
	PUSH	BC
	CALL	__mul32
	POP	BC
	RET

; ============================================================
; 32-bit unsigned division: DEHL = DEHL / (__tmp32)
; Also stores remainder in __rem32.
; Division by zero: quotient 0FFFFFFFFH, remainder = dividend.
; Preserves BC, IX, IY.  __tmp32 is not changed.
;
; Divisor < 65536: long division one dividend byte at a time
; (__dv8n for an 8-bit divisor, __dv8w for a 16-bit one), with a
; 16-bit running remainder; leading bytes below the divisor cost
; almost nothing.  Divisor >= 65536: the quotient has at most 16
; bits (8 when the divisor is >= 2^24), so only that many steps of
; 32-bit restoring division run.
; ============================================================
	PUBLIC	__div32
	PUBLIC	__rem32
__div32:
	PUSH	BC
	LD	(__div32_dvd),HL
	LD	(__div32_dvd+2),DE
	LD	HL,(__tmp32+2)
	LD	A,H
	OR	L
	JP	NZ,__div32_big
	LD	DE,(__tmp32)
	LD	A,D
	OR	A
	JR	NZ,__div32_w
	OR	E
	JR	Z,__div32_zero
	LD	C,E		; divisor 1..255
	LD	HL,__div32_dvd+3
	XOR	A
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	DEC	HL
	LD	E,(HL)
	CALL	__dv8n
	LD	(HL),E
	LD	L,A
	LD	H,0
	JR	__div32_r16
__div32_w:
	LD	HL,0		; divisor 256..65535
	LD	A,(__div32_dvd+3)
	CALL	__dv8w
	LD	(__div32_dvd+3),A
	LD	A,(__div32_dvd+2)
	CALL	__dv8w
	LD	(__div32_dvd+2),A
	LD	A,(__div32_dvd+1)
	CALL	__dv8w
	LD	(__div32_dvd+1),A
	LD	A,(__div32_dvd)
	CALL	__dv8w
	LD	(__div32_dvd),A
__div32_r16:
	LD	(__rem32),HL
	LD	HL,0
	LD	(__rem32+2),HL
__div32_q:
	LD	HL,(__div32_dvd)
	LD	DE,(__div32_dvd+2)
	POP	BC
	RET
__div32_zero:
	LD	HL,(__div32_dvd)
	LD	(__rem32),HL
	LD	HL,(__div32_dvd+2)
	LD	(__rem32+2),HL
	LD	HL,0FFFFH
	LD	D,H
	LD	E,L
	POP	BC
	RET
__div32_big:
	PUSH	IY
	LD	IY,__tmp32
	LD	A,H
	OR	A
	JR	NZ,__div32_b3
	LD	DE,0		; divisor < 2^24: remainder starts as the
	LD	HL,(__div32_dvd+2) ; high word, two quotient bytes
	LD	A,(__div32_dvd+1)
	LD	C,A
	CALL	__div32_g
	LD	A,C
	LD	(__div32_dvd+1),A
	JR	__div32_b0
__div32_b3:
	LD	A,(__div32_dvd+3) ; divisor >= 2^24: remainder starts as
	LD	E,A		; the top three bytes, one quotient byte
	LD	D,0
	LD	HL,(__div32_dvd+1)
	XOR	A
	LD	(__div32_dvd+1),A
__div32_b0:
	LD	A,(__div32_dvd)
	LD	C,A
	CALL	__div32_g
	LD	A,C
	LD	(__div32_dvd),A
	LD	(__rem32),HL
	LD	(__rem32+2),DE
	LD	HL,0
	LD	(__div32_dvd+2),HL
	POP	IY
	JR	__div32_q

; One quotient byte of 32-bit restoring division.
; In:  DEHL = remainder (< divisor), C = dividend byte, IY = __tmp32
; Out: C = quotient byte, DEHL = new remainder.  Clobbers A, B.
__div32_g:
	LD	B,8
__div32_gl:
	SLA	C		; next dividend bit out, quotient bit 0 in
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	JR	C,__div32_gs	; remainder passed 2^32: above the divisor
	LD	A,D		; compare DEHL with the divisor, top first
	CP	(IY+3)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,E
	CP	(IY+2)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,H
	CP	(IY+1)
	JR	C,__div32_gn
	JR	NZ,__div32_gs
	LD	A,L
	CP	(IY+0)
	JR	C,__div32_gn
__div32_gs:
	LD	A,L		; DEHL -= divisor
	SUB	(IY+0)
	LD	L,A
	LD	A,H
	SBC	A,(IY+1)
	LD	H,A
	LD	A,E
	SBC	A,(IY+2)
	LD	E,A
	LD	A,D
	SBC	A,(IY+3)
	LD	D,A
	INC	C
__div32_gn:
	DJNZ	__div32_gl
	RET

; ============================================================
; 32-bit unsigned modulo: DEHL = DEHL % (__tmp32)
; ============================================================
	PUBLIC	__mod32
__mod32:
	CALL	__div32
	LD	HL,(__rem32)
	LD	DE,(__rem32+2)
	RET

; ============================================================
; 32-bit signed division: DEHL = DEHL / (__tmp32) (signed)
; Truncates toward zero.  Leaves |divisor| in __tmp32.
; ============================================================
	PUBLIC	__sdiv32
__sdiv32:
	LD	A,(__tmp32+3)
	XOR	D
	PUSH	AF		; S flag = sign of the quotient
	BIT	7,D
	CALL	NZ,__neg32
	LD	A,(__tmp32+3)
	OR	A
	JP	P,__sdiv32_p
	PUSH	HL		; __tmp32 = -__tmp32
	LD	HL,__tmp32
	XOR	A
	SUB	(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	POP	HL
__sdiv32_p:
	CALL	__div32
	POP	AF
	RET	P
	JP	__neg32

; ============================================================
; 32-bit signed modulo: DEHL = DEHL % (__tmp32) (signed)
; Result has same sign as dividend.  Leaves |divisor| in __tmp32.
; ============================================================
	PUBLIC	__smod32
__smod32:
	LD	A,D
	OR	A
	PUSH	AF		; S flag = sign of the dividend
	CALL	M,__neg32
	LD	A,(__tmp32+3)
	OR	A
	JP	P,__smod32_p
	PUSH	HL		; __tmp32 = -__tmp32
	LD	HL,__tmp32
	XOR	A
	SUB	(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	INC	HL
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	POP	HL
__smod32_p:
	CALL	__div32
	LD	HL,(__rem32)
	LD	DE,(__rem32+2)
	POP	AF
	RET	P
	JP	__neg32

; ============================================================
; 32-bit compare: sets flags based on DEHL - (__tmp32)
; Returns: Z if equal, C if DEHL < __tmp32 (unsigned)
; ============================================================
	PUBLIC	__cmp32
__cmp32:
	PUSH	BC
	; Compare high words first
	LD	BC,(__tmp32+2)
	LD	A,D
	CP	B
	JR	NZ,__cmp32_done
	LD	A,E
	CP	C
	JR	NZ,__cmp32_done
	; High words equal, compare low
	LD	BC,(__tmp32)
	LD	A,H
	CP	B
	JR	NZ,__cmp32_done
	LD	A,L
	CP	C
__cmp32_done:
	POP	BC
	RET

; ============================================================
; 32-bit left shift: DEHL = DEHL << A  (A >= 32 gives 0)
; Counts below 5 shift bit by bit.  Larger counts move whole bytes
; first; 5..7 leftover bits go the other way: right by 8-n into a
; fifth byte, then a byte move.
; ============================================================
	PUBLIC	__shl32
__shl32:
	CP	5
	JR	NC,__shl32_b
__shl32_s:
	OR	A
	RET	Z
__shl32_lp:
	ADD	HL,HL
	RL	E
	RL	D
	DEC	A
	JR	NZ,__shl32_lp
	RET
__shl32_b:
	CP	32
	JR	NC,__shl32_z
	CP	16
	JR	C,__shl32_1
	EX	DE,HL		; shift by 16: word move
	LD	HL,0
	SUB	16
__shl32_1:
	CP	8
	JR	C,__shl32_2
	LD	D,E		; shift by 8: byte move
	LD	E,H
	LD	H,L
	LD	L,0
	SUB	8
__shl32_2:
	CP	5
	JR	C,__shl32_s
	PUSH	BC
	LD	B,A
	LD	A,8
	SUB	B
	LD	B,A
	XOR	A
__shl32_rl:
	SRL	D
	RR	E
	RR	H
	RR	L
	RRA
	DJNZ	__shl32_rl
	LD	D,E
	LD	E,H
	LD	H,L
	LD	L,A
	POP	BC
	RET
__shl32_z:
	LD	HL,0
	LD	D,H
	LD	E,L
	RET

; ============================================================
; 32-bit logical right shift: DEHL = DEHL >> A (unsigned)
; ============================================================
	PUBLIC	__shr32
__shr32:
	CP	5
	JR	NC,__shr32_b
__shr32_s:
	OR	A
	RET	Z
__shr32_lp:
	SRL	D
	RR	E
	RR	H
	RR	L
	DEC	A
	JR	NZ,__shr32_lp
	RET
__shr32_b:
	CP	32
	JR	NC,__shr32_z
	CP	16
	JR	C,__shr32_1
	EX	DE,HL		; shift by 16: word move
	LD	DE,0
	SUB	16
__shr32_1:
	CP	8
	JR	C,__shr32_2
	LD	L,H		; shift by 8: byte move
	LD	H,E
	LD	E,D
	LD	D,0
	SUB	8
__shr32_2:
	CP	5
	JR	C,__shr32_s
	PUSH	BC		; 5..7: left by 8-n into a fifth byte
	LD	B,A
	LD	A,8
	SUB	B
	LD	B,A
	XOR	A
__shr32_ll:
	ADD	HL,HL
	RL	E
	RL	D
	RLA
	DJNZ	__shr32_ll
	LD	L,H
	LD	H,E
	LD	E,D
	LD	D,A
	POP	BC
	RET
__shr32_z:
	LD	HL,0
	LD	D,H
	LD	E,L
	RET

; ============================================================
; 32-bit arithmetic right shift: DEHL = DEHL >> A (signed)
; A >= 32 acts as 31: 0 or -1 by the sign.
; ============================================================
	PUBLIC	__sar32
__sar32:
	CP	5
	JR	NC,__sar32_b
__sar32_s:
	OR	A
	RET	Z
__sar32_lp:
	SRA	D
	RR	E
	RR	H
	RR	L
	DEC	A
	JR	NZ,__sar32_lp
	RET
__sar32_b:
	CP	32
	JR	C,__sar32_0
	LD	A,31
__sar32_0:
	CP	16
	JR	C,__sar32_1
	SUB	16		; shift by 16: word move, sign fill
	EX	DE,HL
	LD	DE,0
	BIT	7,H
	JR	Z,__sar32_1
	DEC	DE
__sar32_1:
	CP	8
	JR	C,__sar32_2
	LD	L,H		; shift by 8: byte move, sign fill
	LD	H,E
	LD	E,D
	LD	D,0
	BIT	7,E
	JR	Z,__sar32_1p
	DEC	D
__sar32_1p:
	SUB	8
__sar32_2:
	CP	5
	JR	C,__sar32_s
	PUSH	BC		; 5..7: left by 8-n into a fifth byte
	LD	B,A		; that starts as the sign fill
	LD	A,8
	SUB	B
	LD	B,A
	LD	A,D
	RLA
	SBC	A,A
__sar32_ll:
	ADD	HL,HL
	RL	E
	RL	D
	RLA
	DJNZ	__sar32_ll
	LD	L,H
	LD	H,E
	LD	E,D
	LD	D,A
	POP	BC
	RET

; ============================================================
; 32-bit bitwise AND: DEHL = DEHL & (__tmp32)
; ============================================================
	PUBLIC	__and32
__and32:
	LD	A,(__tmp32)
	AND	L
	LD	L,A
	LD	A,(__tmp32+1)
	AND	H
	LD	H,A
	LD	A,(__tmp32+2)
	AND	E
	LD	E,A
	LD	A,(__tmp32+3)
	AND	D
	LD	D,A
	RET

; ============================================================
; 32-bit bitwise OR: DEHL = DEHL | (__tmp32)
; ============================================================
	PUBLIC	__or32
__or32:
	LD	A,(__tmp32)
	OR	L
	LD	L,A
	LD	A,(__tmp32+1)
	OR	H
	LD	H,A
	LD	A,(__tmp32+2)
	OR	E
	LD	E,A
	LD	A,(__tmp32+3)
	OR	D
	LD	D,A
	RET

; ============================================================
; 32-bit bitwise XOR: DEHL = DEHL ^ (__tmp32)
; ============================================================
	PUBLIC	__xor32
__xor32:
	LD	A,(__tmp32)
	XOR	L
	LD	L,A
	LD	A,(__tmp32+1)
	XOR	H
	LD	H,A
	LD	A,(__tmp32+2)
	XOR	E
	LD	E,A
	LD	A,(__tmp32+3)
	XOR	D
	LD	D,A
	RET

; ============================================================
; 32-bit bitwise NOT: DEHL = ~DEHL
; ============================================================
	PUBLIC	__not32
__not32:
	LD	A,L
	CPL
	LD	L,A
	LD	A,H
	CPL
	LD	H,A
	LD	A,E
	CPL
	LD	E,A
	LD	A,D
	CPL
	LD	D,A
	RET

; ============================================================
; Sign-extend 16-bit HL to 32-bit DEHL
; ============================================================
	PUBLIC	__sext32
__sext32:
	LD	D,H
	LD	A,D
	RLA			; Get sign bit into carry
	SBC	A,A		; A = 0xFF if negative, 0 if positive
	LD	D,A
	LD	E,A
	RET

; ============================================================
; Zero-extend 16-bit HL to 32-bit DEHL
; ============================================================
	PUBLIC	__zext32
__zext32:
	LD	DE,0
	RET

; ============================================================
; __clz32 — count leading zeros of 32-bit DEHL.
; Returns count in HL (0..32). 32 if input zero (defensive).
; ============================================================
	PUBLIC	__clz32
__clz32:
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,__clz32_zero
	PUSH	BC
	LD	B,0		; counter
__clz32_lp:
	BIT	7,D
	JR	NZ,__clz32_done
	INC	B
	; Shift DEHL left by 1
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	JR	__clz32_lp
__clz32_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__clz32_zero:
	LD	HL,32
	RET

; ============================================================
; __clrsb32 — count leading sign bits minus 1 (32-bit signed DEHL).
; clrsb(x) = clz(x ^ (x >> 31)) - 1, with clrsb(0) / clrsb(-1) = 31.
; ============================================================
	PUBLIC	__clrsb32
__clrsb32:
	; If MSB (bit 31, D bit 7) is set, XOR DEHL with 0xFFFFFFFF.
	BIT	7,D
	JR	Z,__clrsb32_pos
	LD	A,D
	XOR	0FFH
	LD	D,A
	LD	A,E
	XOR	0FFH
	LD	E,A
	LD	A,H
	XOR	0FFH
	LD	H,A
	LD	A,L
	XOR	0FFH
	LD	L,A
__clrsb32_pos:
	; All bits 0 → all sign bits → 31.
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,__clrsb32_all_same
	CALL	__clz32
	DEC	HL
	RET
__clrsb32_all_same:
	LD	HL,31
	RET

; ============================================================
; __ctz32 — count trailing zeros of 32-bit DEHL.
; ============================================================
	PUBLIC	__ctz32
__ctz32:
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,__ctz32_zero
	PUSH	BC
	LD	B,0
__ctz32_lp:
	BIT	0,L
	JR	NZ,__ctz32_done
	INC	B
	; Shift DEHL right by 1
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	__ctz32_lp
__ctz32_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ctz32_zero:
	LD	HL,32
	RET

; ============================================================
; __popcount32 — count set bits in 32-bit DEHL.
; ============================================================
	PUBLIC	__popcount32
__popcount32:
	PUSH	BC
	LD	B,0
	LD	C,32
__popcount32_lp:
	; Shift DEHL right by 1; check carry
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	NC,__popcount32_skip
	INC	B
__popcount32_skip:
	DEC	C
	JR	NZ,__popcount32_lp
	LD	L,B
	LD	H,0
	POP	BC
	RET

; ============================================================
; __ffs32 — 1-indexed lowest set bit of DEHL, 0 if none.
; ============================================================
	PUBLIC	__ffs32
__ffs32:
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,__ffs32_zero
	PUSH	BC
	LD	B,1
__ffs32_lp:
	BIT	0,L
	JR	NZ,__ffs32_done
	INC	B
	SRL	D
	RR	E
	RR	H
	RR	L
	JR	__ffs32_lp
__ffs32_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ffs32_zero:
	LD	HL,0
	RET

	COMMON	/rt_arith32/
__div32_dvd:
	DS	4
__rem32:
	DS	4
	END
