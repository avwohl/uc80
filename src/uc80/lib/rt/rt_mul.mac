; rt_mul.mac - 8x16 and 16x16 unsigned multiply cores
; Used by rt_arith16 (__mul16), rt_arith32 (__mul32) and rt_float
; (__fmul).  A module of its own, so a library link of one of
; them does not bring in the others.

	.Z80

	CSEG

; ============================================================
; __mul8x16 - 8 x 16 -> 24-bit unsigned multiply: AHL = A * DE
; In:  A = multiplier, DE = multiplicand
; Out: HL = product bits 0..15, A = product bits 16..23
; Preserves BC, DE, IX, IY.  Clobbers flags.
;
; MSB first and unrolled.  The ADD A,A chain finds the top set bit of
; the multiplier (11 T for each leading zero bit) and jumps into the
; unrolled steps at that bit, so a small multiplier costs only a few
; steps.  Each later step is "ADD HL,HL / RLA": the carry out of HL
; moves into the low end of A while the next multiplier bit leaves
; the top of A, so A ends holding the high byte of the product.
; ============================================================
	PUBLIC	__mul8x16
__mul8x16:
	LD	HL,0
	ADD	A,A
	JR	C,__m816_7
	ADD	A,A
	JR	C,__m816_6
	ADD	A,A
	JR	C,__m816_5
	ADD	A,A
	JR	C,__m816_4
	ADD	A,A
	JR	C,__m816_3
	ADD	A,A
	JR	C,__m816_2
	ADD	A,A
	JR	C,__m816_1
	ADD	A,A
	JR	C,__m816_0
	RET			; multiplier 0: A = 0, HL = 0
__m816_7:
	ADD	HL,DE		; HL was 0: HL = DE, A low bits are 0
	ADD	HL,HL
	RLA
	JR	NC,__m816_6n
__m816_6:
	ADD	HL,DE
	ADC	A,0
__m816_6n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_5n
__m816_5:
	ADD	HL,DE
	ADC	A,0
__m816_5n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_4n
__m816_4:
	ADD	HL,DE
	ADC	A,0
__m816_4n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_3n
__m816_3:
	ADD	HL,DE
	ADC	A,0
__m816_3n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_2n
__m816_2:
	ADD	HL,DE
	ADC	A,0
__m816_2n:
	ADD	HL,HL
	RLA
	JR	NC,__m816_1n
__m816_1:
	ADD	HL,DE
	ADC	A,0
__m816_1n:
	ADD	HL,HL
	RLA
	RET	NC
__m816_0:
	ADD	HL,DE
	ADC	A,0
	RET

; ============================================================
; __mul16_32 - 16 x 16 -> 32-bit unsigned multiply: DEHL = BC * DE
; Preserves BC, IX, IY.  Clobbers A, flags.
; One or two __mul8x16 passes: an operand whose high byte is 0 is
; the multiplier of a single pass.
; ============================================================
	PUBLIC	__mul16_32
__mul16_32:
	LD	A,B
	OR	A
	JR	Z,__m1632_c	; BC < 256: one pass, multiplier C
	LD	A,D
	OR	A
	JR	NZ,__m1632_2
	LD	A,E		; DE < 256: one pass, multiplier E,
	LD	D,B		; multiplicand BC
	LD	E,C
	JR	__m1632_1
__m1632_c:
	LD	A,C
__m1632_1:
	CALL	__mul8x16	; AHL = A * DE
	LD	E,A
	LD	D,0
	RET
__m1632_2:
	PUSH	BC
	LD	A,C
	CALL	__mul8x16	; P0 = AHL = C * DE
	PUSH	HL
	LD	C,A		; C = P0 bits 16..23
	LD	A,B
	CALL	__mul8x16	; P1 = AHL = B * DE
	POP	DE		; DE = P0 bits 0..15
	LD	B,A		; B = P1 bits 16..23
	LD	A,D		; result = P0 + (P1 << 8)
	ADD	A,L
	LD	D,A		; D = byte 1
	LD	A,C
	ADC	A,H
	LD	C,A		; C = byte 2
	LD	A,B
	ADC	A,0		; A = byte 3
	LD	L,E
	LD	H,D
	LD	E,C
	LD	D,A
	POP	BC
	RET

	END
