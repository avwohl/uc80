; rt_fdiv.mac - __fdiv
; Split from rt_float.mac

	.Z80

	EXTRN	__tmp32
	EXTRN	__fexp1
	EXTRN	__fexp2
	EXTRN	__fman1
	EXTRN	__fman2
	EXTRN	__fpack
	EXTRN	__fsgn1
	EXTRN	__fsgn2
	EXTRN	__funpack

	CSEG
; ============================================================
; Float Division: DEHL = DEHL / (__tmp32)
; Native implementation using long division.  The quotient has 26 bits;
; the two extra bits and the remainder round the result to nearest, ties
; to even.  A result below the smallest normal number is zero.
; ============================================================
	PUBLIC	__fdiv
__fdiv:
	PUSH	BC
	PUSH	IX

	; dividend infinity or NaN?
	LD	A,D
	AND	7FH
	CP	7FH
	JR	NZ,@fdiv_n1
	BIT	7,E
	JR	Z,@fdiv_n1
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	JR	NZ,@fdiv_nan		; NaN / x
	LD	A,(__tmp32+3)		; inf / x
	AND	7FH
	CP	7FH
	JR	NZ,__fdiv_divzero	; inf / finite: infinity
	LD	A,(__tmp32+2)
	BIT	7,A
	JR	Z,__fdiv_divzero
@fdiv_nan:				; inf / inf, inf / NaN, x / NaN
	LD	DE,07FC0H
	LD	HL,0
	JR	@fdiv_exit
@fdiv_n1:
	; divisor infinity or NaN?
	LD	A,(__tmp32+3)
	AND	7FH
	CP	7FH
	JR	NZ,@fdiv_n2
	LD	A,(__tmp32+2)
	BIT	7,A
	JR	Z,@fdiv_n2
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,@fdiv_nan
	JR	@fdiv_szero		; finite / infinity: a signed zero
@fdiv_n2:

	; Check for zero divisor -> infinity (or a NaN for 0/0)
	LD	A,(__tmp32+3)
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+2)
	OR	B
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,__fdiv_check_dividend
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fdiv_divzero
	LD	DE,07FC0H		; 0/0: a quiet NaN
	LD	HL,0
	JR	@fdiv_exit
__fdiv_divzero:
	LD	A,D
	LD	B,A
	LD	A,(__tmp32+3)
	XOR	B
	AND	80H
	OR	7FH
	LD	D,A
	LD	E,80H			; +-infinity
	LD	HL,0
	JR	@fdiv_exit

__fdiv_check_dividend:
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fdiv_do_div
@fdiv_szero:				; zero or finite / infinity: the sign is the xor
	LD	A,D
	LD	B,A
	LD	A,(__tmp32+3)
	XOR	B
	AND	80H
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_do_div:
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	LD	(__fsgn1),A

	; biased exponent of the quotient: e1 - e2 + 127 (it may be out of
	; range; the range is checked after the rounding)
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	OR	A
	SBC	HL,DE
	LD	DE,127
	ADD	HL,DE
	LD	(__fexp1),HL

	CALL	__fdiv_man

	; mantissa in __fman1 (24 bits), exponent in __fexp1
	LD	HL,(__fexp1)
	BIT	7,H
	JR	NZ,__fdiv_underflow
	LD	A,H
	OR	A
	JR	NZ,__fdiv_inf
	LD	A,L
	OR	A
	JR	Z,__fdiv_underflow
	CP	255
	JR	NC,__fdiv_inf
	LD	B,H
	LD	C,L
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	A,(__fsgn1)
	CALL	__fpack

@fdiv_exit:
	POP	IX
	POP	BC
	RET

__fdiv_underflow:
	LD	A,(__fsgn1)
	AND	80H
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_inf:
	LD	A,(__fsgn1)
	AND	80H
	OR	7FH
	LD	D,A
	LD	E,80H
	LD	HL,0
	JR	@fdiv_exit

; ------------------------------------------------------------
; __fdiv_man: divide the 24-bit mantissa in __fman1 by the one in __fman2.
; Out: __fman1 = the rounded 24-bit quotient (bit 23 set), __fexp1 adjusted.
;
; Restoring division, 26 steps.  The remainder is in DE:HL, the divisor in
; BC (low 16 bits) and (IX+2) (high 8 bits), and the quotient in the second
; register set (DE':HL') with the step counter in B'.
; ------------------------------------------------------------
__fdiv_man:
	LD	IX,__fman2
	LD	BC,(__fman2)
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	EXX
	LD	HL,0
	LD	DE,0
	LD	B,26
	EXX
@fdiv_lp:
	PUSH	DE
	PUSH	HL
	OR	A
	SBC	HL,BC
	LD	A,E
	SBC	A,(IX+2)
	LD	E,A
	LD	A,D
	SBC	A,0
	LD	D,A		; DE:HL = remainder - divisor, carry if it is negative
	JR	C,@fdiv_no
	POP	AF
	POP	AF
	SCF
	JR	@fdiv_q
@fdiv_no:
	POP	HL
	POP	DE
	OR	A
@fdiv_q:
	EXX			; quotient = quotient * 2 + the carry
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	EXX
	ADD	HL,HL		; remainder = remainder * 2
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	EXX
	DEC	B
	EXX
	JP	NZ,@fdiv_lp

	; sticky: a non-zero remainder
	LD	A,D
	OR	E
	OR	H
	OR	L
	ADD	A,255
	SBC	A,A
	AND	1
	LD	B,A
	EXX			; DEHL = the quotient, in [2^24, 2^26)
	BIT	1,D
	JR	NZ,@fdiv_lead
	ADD	HL,HL		; put the leading bit at bit 25
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	PUSH	HL
	LD	HL,(__fexp1)
	DEC	HL
	LD	(__fexp1),HL
	POP	HL
@fdiv_lead:
	EXX
	LD	A,B
	EXX
	OR	A
	JR	Z,@fdiv_exact
	SET	0,L
@fdiv_exact:
	; round bit = bit 1, sticky = bit 0
	LD	A,L
	AND	3
	LD	C,A
	SRL	D
	RR	E
	RR	H
	RR	L
	SRL	D
	RR	E
	RR	H
	RR	L
	; C: 0,1 = round down; 2 = tie; 3 = round up
	LD	A,C
	CP	3
	JR	Z,@fdiv_up
	CP	2
	JR	NZ,@fdiv_store
	BIT	0,L
	JR	Z,@fdiv_store
@fdiv_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,@fdiv_store
	INC	DE
@fdiv_store:
	LD	A,D
	OR	A
	JR	Z,@fdiv_fit
	LD	DE,0080H		; the mantissa reached 2^24
	LD	HL,0
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
@fdiv_fit:
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	RET

	COMMON	/rt_fdiv/
	PUBLIC	__wa_rt_fdiv	;!
__wa_rt_fdiv:	;!
__fdiv_rem:
	DS	4

	END
