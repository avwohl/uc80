; rt_fdiv.mac - __fdiv
; Split from rt_float.mac

	.Z80

	EXTRN	__tmp32
	EXTRN	__fexp1
	EXTRN	__fexp2
	EXTRN	__fman1
	EXTRN	__fman2
	EXTRN	__fpack
	EXTRN	__fsgn1
	EXTRN	__fsgn2
	EXTRN	__funpack

	CSEG
; ============================================================
; Float Division: DEHL = DEHL / (__tmp32)
; Native implementation using long division.  The quotient has 26 bits;
; the two extra bits and the remainder round the result to nearest, ties
; to even.  A result below the smallest normal number is zero.
; ============================================================
	PUBLIC	__fdiv
__fdiv:
	PUSH	BC
	PUSH	IX

	; Check for zero divisor -> infinity (or a NaN for 0/0)
	LD	A,(__tmp32+3)
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+2)
	OR	B
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,__fdiv_check_dividend
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fdiv_divzero
	LD	DE,07FC0H		; 0/0: a quiet NaN
	LD	HL,0
	JR	@fdiv_exit
__fdiv_divzero:
	LD	A,D
	LD	B,A
	LD	A,(__tmp32+3)
	XOR	B
	AND	80H
	OR	7FH
	LD	D,A
	LD	E,80H			; +-infinity
	LD	HL,0
	JR	@fdiv_exit

__fdiv_check_dividend:
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fdiv_do_div
	LD	DE,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_do_div:
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	LD	(__fsgn1),A

	; biased exponent of the quotient: e1 - e2 + 127 (it may be out of
	; range; the range is checked after the rounding)
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	OR	A
	SBC	HL,DE
	LD	DE,127
	ADD	HL,DE
	LD	(__fexp1),HL

	CALL	__fdiv_man

	; mantissa in __fman1 (24 bits), exponent in __fexp1
	LD	HL,(__fexp1)
	BIT	7,H
	JR	NZ,__fdiv_underflow
	LD	A,H
	OR	A
	JR	NZ,__fdiv_inf
	LD	A,L
	OR	A
	JR	Z,__fdiv_underflow
	CP	255
	JR	NC,__fdiv_inf
	LD	B,H
	LD	C,L
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	A,(__fsgn1)
	CALL	__fpack

@fdiv_exit:
	POP	IX
	POP	BC
	RET

__fdiv_underflow:
	LD	A,(__fsgn1)
	AND	80H
	LD	D,A
	LD	E,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_inf:
	LD	A,(__fsgn1)
	AND	80H
	OR	7FH
	LD	D,A
	LD	E,80H
	LD	HL,0
	JR	@fdiv_exit

; ------------------------------------------------------------
; __fdiv_man: divide the 24-bit mantissa in __fman1 by the one in __fman2.
; Out: __fman1 = the rounded 24-bit quotient (bit 23 set), __fexp1 adjusted.
; ------------------------------------------------------------
__fdiv_man:
	LD	A,(__fman1)
	LD	(__fdiv_rem),A
	LD	A,(__fman1+1)
	LD	(__fdiv_rem+1),A
	LD	A,(__fman1+2)
	LD	(__fdiv_rem+2),A
	XOR	A
	LD	(__fdiv_rem+3),A	; Clear high byte (for 32-bit shifts)

	LD	(__fman1),A
	LD	(__fman1+1),A
	LD	(__fman1+2),A
	LD	(__fman1+3),A

	LD	B,26			; 26 quotient bits

@fdiv_lp:
	PUSH	BC

	; Compare rem (32-bit) with divisor (24-bit)
	LD	A,(__fdiv_rem+3)
	OR	A
	JR	NZ,@fdiv_sub		; dividend has bit 24+, definitely >= divisor

	LD	A,(__fdiv_rem+2)
	LD	C,A
	LD	A,(__fman2+2)
	CP	C
	JR	C,@fdiv_sub		; divisor < dividend, subtract
	JR	NZ,@fdiv_nosub		; divisor > dividend, no subtract

	LD	A,(__fdiv_rem+1)
	LD	C,A
	LD	A,(__fman2+1)
	CP	C
	JR	C,@fdiv_sub
	JR	NZ,@fdiv_nosub

	LD	A,(__fdiv_rem)
	LD	C,A
	LD	A,(__fman2)
	CP	C
	JR	C,@fdiv_sub
	JR	NZ,@fdiv_nosub

@fdiv_sub:
	LD	A,(__fdiv_rem)
	LD	C,A
	LD	A,(__fman2)
	LD	E,A
	LD	A,C
	SUB	E
	LD	(__fdiv_rem),A

	LD	A,(__fdiv_rem+1)
	LD	C,A
	LD	A,(__fman2+1)
	LD	E,A
	LD	A,C
	SBC	A,E
	LD	(__fdiv_rem+1),A

	LD	A,(__fdiv_rem+2)
	LD	C,A
	LD	A,(__fman2+2)
	LD	E,A
	LD	A,C
	SBC	A,E
	LD	(__fdiv_rem+2),A

	LD	A,(__fdiv_rem+3)
	SBC	A,0
	LD	(__fdiv_rem+3),A

	; quotient = quotient * 2 + 1
	LD	A,(__fman1)
	ADD	A,A
	LD	(__fman1),A
	LD	A,(__fman1+1)
	RLA
	LD	(__fman1+1),A
	LD	A,(__fman1+2)
	RLA
	LD	(__fman1+2),A
	LD	A,(__fman1+3)
	RLA
	LD	(__fman1+3),A
	LD	HL,__fman1
	INC	(HL)
	JR	@fdiv_next

@fdiv_nosub:
	LD	A,(__fman1)
	ADD	A,A
	LD	(__fman1),A
	LD	A,(__fman1+1)
	RLA
	LD	(__fman1+1),A
	LD	A,(__fman1+2)
	RLA
	LD	(__fman1+2),A
	LD	A,(__fman1+3)
	RLA
	LD	(__fman1+3),A

@fdiv_next:
	LD	A,(__fdiv_rem)
	ADD	A,A
	LD	(__fdiv_rem),A
	LD	A,(__fdiv_rem+1)
	RLA
	LD	(__fdiv_rem+1),A
	LD	A,(__fdiv_rem+2)
	RLA
	LD	(__fdiv_rem+2),A
	LD	A,(__fdiv_rem+3)
	RLA
	LD	(__fdiv_rem+3),A

	POP	BC
	DEC	B
	JP	NZ,@fdiv_lp

	; The quotient is in [2^24, 2^26).  Put the leading bit at bit 25.
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	BIT	1,D
	JR	NZ,@fdiv_lead
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	PUSH	HL
	LD	HL,(__fexp1)
	DEC	HL
	LD	(__fexp1),HL
	POP	HL
@fdiv_lead:
	; sticky: a non-zero remainder sets bit 0
	LD	A,(__fdiv_rem)
	LD	B,A
	LD	A,(__fdiv_rem+1)
	OR	B
	LD	B,A
	LD	A,(__fdiv_rem+2)
	OR	B
	LD	B,A
	LD	A,(__fdiv_rem+3)
	OR	B
	JR	Z,@fdiv_exact
	SET	0,L
@fdiv_exact:
	; round bit = bit 1, sticky = bit 0
	LD	A,L
	AND	3
	LD	C,A
	SRL	D
	RR	E
	RR	H
	RR	L
	SRL	D
	RR	E
	RR	H
	RR	L
	; C: 0,1 = round down; 2 = tie; 3 = round up
	LD	A,C
	CP	3
	JR	Z,@fdiv_up
	CP	2
	JR	NZ,@fdiv_store
	BIT	0,L
	JR	Z,@fdiv_store
@fdiv_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,@fdiv_store
	INC	DE
@fdiv_store:
	LD	A,D
	OR	A
	JR	Z,@fdiv_fit
	LD	DE,0080H		; the mantissa reached 2^24
	LD	HL,0
	PUSH	HL
	LD	HL,(__fexp1)
	INC	HL
	LD	(__fexp1),HL
	POP	HL
@fdiv_fit:
	LD	(__fman1),HL
	LD	(__fman1+2),DE
	RET

	COMMON	/rt_fdiv/
__fdiv_rem:
	DS	4

	END
