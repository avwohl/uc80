; rt_fdiv.mac - __fdiv
; Split from rt_float.mac

	.Z80

	EXTRN	__tmp32
	EXTRN	__fexp1
	EXTRN	__fexp2
	EXTRN	__fman1
	EXTRN	__fman2
	EXTRN	__fpack
	EXTRN	__fsgn1
	EXTRN	__fsgn2
	EXTRN	__funpack

	CSEG
; ============================================================
; Float Division: DEHL = DEHL / (__tmp32)
; Native implementation using long division
; ============================================================
	PUBLIC	__fdiv
__fdiv:
	PUSH	BC
	PUSH	IX

	; Check for zero divisor -> infinity
	LD	A,(__tmp32+3)
	AND	7FH
	LD	B,A
	LD	A,(__tmp32+2)
	OR	B
	LD	B,A
	LD	A,(__tmp32+1)
	OR	B
	LD	B,A
	LD	A,(__tmp32)
	OR	B
	JR	NZ,__fdiv_check_dividend
	; Divisor is zero - return infinity
	LD	DE,07F80H		; +infinity
	LD	HL,0
	JR	@fdiv_exit

__fdiv_check_dividend:
	; Check for zero dividend -> zero
	LD	A,D
	AND	7FH
	OR	E
	OR	H
	OR	L
	JR	NZ,__fdiv_do_div
	; Dividend is zero
	LD	DE,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_do_div:
	; Unpack dividend
	CALL	__funpack
	LD	(__fsgn1),A
	LD	(__fexp1),BC
	LD	(__fman1),HL
	LD	(__fman1+2),DE

	; Unpack divisor
	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__funpack
	LD	(__fsgn2),A
	LD	(__fexp2),BC
	LD	(__fman2),HL
	LD	(__fman2+2),DE

	; Result sign = xor of signs
	LD	A,(__fsgn1)
	LD	B,A
	LD	A,(__fsgn2)
	XOR	B
	LD	(__fsgn1),A

	; Result exponent = exp1 - exp2 + 127
	LD	HL,(__fexp1)
	LD	DE,(__fexp2)
	OR	A
	SBC	HL,DE
	LD	DE,127
	ADD	HL,DE
	; Underflow: exp went negative — flush to zero rather than wrapping
	; into a bogus near-one float via the truncated low byte.
	BIT	7,H
	JR	NZ,__fdiv_underflow
	; Overflow: if HL >= 255 the result is inf. (HL > 0xFF is also
	; overflow; check that first.)
	LD	A,H
	OR	A
	JR	NZ,__fdiv_inf
	LD	A,L
	CP	255
	JR	NC,__fdiv_inf
	LD	(__fexp1),HL

	; Divide mantissas using long division
	CALL	__fdiv_man

	; Pack result
	LD	HL,(__fman1)
	LD	DE,(__fman1+2)
	LD	BC,(__fexp1)
	LD	A,(__fsgn1)
	CALL	__fpack

@fdiv_exit:
	POP	IX
	POP	BC
	RET

__fdiv_underflow:
	LD	DE,0
	LD	HL,0
	JR	@fdiv_exit

__fdiv_inf:
	; +/- inf based on result sign (xor'd into __fsgn1 above).
	LD	A,(__fsgn1)
	OR	A
	JR	Z,__fdiv_inf_pos
	LD	DE,0FF80H		; -inf
	LD	HL,0
	JR	@fdiv_exit
__fdiv_inf_pos:
	LD	DE,07F80H		; +inf
	LD	HL,0
	JR	@fdiv_exit

; Mantissa division helper
; Divides __fman1 by __fman2 (24-bit / 24-bit)
; Both have implied 1 at bit 23 (E bit 7, D=0)
; Result stored in __fman1
;
; Algorithm: Non-restoring division
; We compute quo = dividend / divisor
; where both have implied 1, so both are in [1, 2)
; Result is in range (0.5, 2)
;
; Use __fdiv_rem[0..3] for temporary storage of dividend copy
;
__fdiv_man:
	; Copy dividend to __fdiv_rem (we'll shift this and use as working copy)
	LD	A,(__fman1)
	LD	(__fdiv_rem),A
	LD	A,(__fman1+1)
	LD	(__fdiv_rem+1),A
	LD	A,(__fman1+2)
	LD	(__fdiv_rem+2),A
	XOR	A
	LD	(__fdiv_rem+3),A	; Clear high byte (for 32-bit shifts)

	; Clear quotient (will be stored in __fman1)
	LD	(__fman1),A
	LD	(__fman1+1),A
	LD	(__fman1+2),A

	; Loop 24 times for 24 quotient bits
	LD	B,24

@fdiv_lp:
	PUSH	BC

	; Compare dividend (in __fdiv_rem, 32-bit) with divisor (in __fman2, 24-bit)
	; __fdiv_rem can overflow to 32 bits during shifts

	; Check high byte (byte 3) of dividend - divisor is only 24-bit
	LD	A,(__fdiv_rem+3)
	OR	A
	JR	NZ,@fdiv_sub		; dividend has bit 24+, definitely >= divisor

	; High byte is 0, compare 24-bit portion
	; Compare byte 2 (high of 24-bit portion)
	LD	A,(__fdiv_rem+2)
	LD	C,A
	LD	A,(__fman2+2)
	CP	C
	JR	C,@fdiv_sub		; divisor < dividend, subtract
	JR	NZ,@fdiv_nosub		; divisor > dividend, no subtract

	; Byte 2 equal, compare byte 1
	LD	A,(__fdiv_rem+1)
	LD	C,A
	LD	A,(__fman2+1)
	CP	C
	JR	C,@fdiv_sub
	JR	NZ,@fdiv_nosub

	; Byte 1 equal, compare byte 0
	LD	A,(__fdiv_rem)
	LD	C,A
	LD	A,(__fman2)
	CP	C
	JR	C,@fdiv_sub
	JR	NZ,@fdiv_nosub

	; All equal: dividend == divisor, subtract
@fdiv_sub:
	; dividend (32-bit) -= divisor (24-bit)
	LD	A,(__fdiv_rem)
	LD	C,A
	LD	A,(__fman2)
	LD	E,A
	LD	A,C
	SUB	E
	LD	(__fdiv_rem),A

	LD	A,(__fdiv_rem+1)
	LD	C,A
	LD	A,(__fman2+1)
	LD	E,A
	LD	A,C
	SBC	A,E
	LD	(__fdiv_rem+1),A

	LD	A,(__fdiv_rem+2)
	LD	C,A
	LD	A,(__fman2+2)
	LD	E,A
	LD	A,C
	SBC	A,E
	LD	(__fdiv_rem+2),A

	; Handle borrow into byte 3 (subtract 0 with carry)
	LD	A,(__fdiv_rem+3)
	SBC	A,0
	LD	(__fdiv_rem+3),A

	; Set quotient bit (shift left first to preserve carry chain, then set bit 0)
	LD	A,(__fman1)
	ADD	A,A
	LD	(__fman1),A
	LD	A,(__fman1+1)
	ADC	A,A
	LD	(__fman1+1),A
	LD	A,(__fman1+2)
	ADC	A,A
	LD	(__fman1+2),A
	; Now set bit 0 of quotient
	LD	A,(__fman1)
	OR	1
	LD	(__fman1),A
	JR	@fdiv_next

@fdiv_nosub:
	; Don't subtract, just shift quotient left (bit 0 stays 0)
	LD	A,(__fman1)
	ADD	A,A
	LD	(__fman1),A
	LD	A,(__fman1+1)
	ADC	A,A
	LD	(__fman1+1),A
	LD	A,(__fman1+2)
	ADC	A,A
	LD	(__fman1+2),A

@fdiv_next:
	; Shift dividend (32-bit) left by 1 for next iteration
	LD	A,(__fdiv_rem)
	ADD	A,A
	LD	(__fdiv_rem),A
	LD	A,(__fdiv_rem+1)
	ADC	A,A
	LD	(__fdiv_rem+1),A
	LD	A,(__fdiv_rem+2)
	ADC	A,A
	LD	(__fdiv_rem+2),A
	LD	A,(__fdiv_rem+3)
	ADC	A,A
	LD	(__fdiv_rem+3),A

	POP	BC
	DEC	B
	JP	NZ,@fdiv_lp

	; Quotient is now in __fman1 (24 bits)
	; Check if normalization needed (bit 23 should be 1)
	; May need to shift multiple times if quotient is small
@fdiv_norm:
	LD	A,(__fman1+2)
	BIT	7,A
	JR	NZ,@fdiv_dn

	; Bit 23 is 0, shift left and decrement exponent
	LD	A,(__fman1)
	ADD	A,A
	LD	(__fman1),A
	LD	A,(__fman1+1)
	ADC	A,A
	LD	(__fman1+1),A
	LD	A,(__fman1+2)
	ADC	A,A
	LD	(__fman1+2),A

	LD	HL,(__fexp1)
	DEC	HL
	LD	(__fexp1),HL
	JP	@fdiv_norm		; Loop until normalized

@fdiv_dn:
	RET

	COMMON	/rt_fdiv/
; Dividend copy of __fdiv (private to __fdiv)
__fdiv_rem:
	DS	4

	END
