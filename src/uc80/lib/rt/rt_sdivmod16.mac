; rt_sdivmod16.mac - __sdiv16m, __smod16m, __sdm16
; Family K, step 2 (docs/k2_code_size.md)

	.Z80

	EXTRN	__div16

	CSEG
; ============================================================
; 16-bit signed division and modulo that share one body.
;   __sdiv16m: HL = DE / HL (signed, truncated toward zero)
;   __smod16m: HL = DE % HL (signed, the sign of the dividend)
; The compiler calls these two in place of __sdiv16 and __smod16 when
; a program uses both (the two routines take 70 bytes together, these
; three take 49).  A program that uses only one of them keeps the
; routine of rt_sdiv16.mac or rt_smod16.mac.  Each call takes about 20
; T-states more than the separate routines.
; Preserves BC, IX, IY.  Sets __divrem as __div16 does.
; ============================================================
	PUBLIC	__sdiv16m
__sdiv16m:
	LD	A,D
	XOR	H		; S = sign of the quotient, C = 0
	JR	__sdm16

	PUBLIC	__smod16m
__smod16m:
	LD	A,D
	OR	A		; S = sign of the dividend
	SCF			; C = 1: the remainder
	JR	__sdm16

	PUBLIC	__sdm16
__sdm16:
	PUSH	AF
	BIT	7,D
	JR	Z,__sdm16_1
	XOR	A		; DE = -DE
	SUB	E
	LD	E,A
	SBC	A,A
	SUB	D
	LD	D,A
__sdm16_1:
	BIT	7,H
	JR	Z,__sdm16_2
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__sdm16_2:
	CALL	__div16
	POP	AF
	JR	NC,__sdm16_d	; the quotient
	EX	DE,HL		; the remainder: HL = remainder
__sdm16_d:
	RET	P
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
	RET

	END
