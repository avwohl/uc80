; rt_shl16.mac - __shl16
; Split from rt_arith16.mac

	.Z80

	CSEG
; ============================================================
; 16-bit left shift: HL = DE << L  (L >= 16 gives 0; H ignored)
; ============================================================
	PUBLIC	__shl16
__shl16:
	LD	A,L
	EX	DE,HL
	CP	8
	JR	NC,__shl16_8
__shl16_s:
	OR	A
	RET	Z
__shl16_lp:
	ADD	HL,HL
	DEC	A
	JR	NZ,__shl16_lp
	RET
__shl16_8:
	CP	16
	JR	NC,__shl16_z
	LD	H,L		; shift by 8 is a byte move
	LD	L,0
	SUB	8
	JR	__shl16_s
__shl16_z:
	LD	HL,0
	RET

	END
