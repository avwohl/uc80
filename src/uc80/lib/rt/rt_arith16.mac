; rt_arith16.mac - 16-bit arithmetic routines
; Split from runtime.mac

	.Z80

	EXTRN	__mul8x16
	EXTRN	__dv8n
	EXTRN	__dv8w


	CSEG

; ============================================================
; 16-bit multiplication: HL = DE * HL (low 16 bits; signed and
; unsigned give the same bits)
; Preserves BC, IX, IY.  Clobbers A, DE, flags.
; When either operand fits in 8 bits it is the multiplier of one
; __mul8x16.  An operand in -255..-1 is negated to 1..255 and the
; product negated back.  Otherwise
;   DE*HL mod 2^16 = DE*L + ((E*H) mod 256)<<8.
; ============================================================
	PUBLIC	__mul16
__mul16:
	LD	A,H
	OR	A
	JR	NZ,__mul16_h
	OR	L		; A = L
	JP	__mul8x16	; HL = DE * L
__mul16_h:
	LD	A,D
	OR	A
	JR	NZ,__mul16_n
	LD	A,E
	EX	DE,HL
	JP	__mul8x16	; HL = HL * E
__mul16_n:
	LD	A,H
	INC	A
	JR	NZ,__mul16_n2	; H <> 0FFH
	SUB	L		; A = -L (A was 0)
	JP	NZ,__mul16ng	; HL = -(DE * -HL)
__mul16_n2:
	LD	A,D
	INC	A
	JP	NZ,__mul16w	; D <> 0FFH
	SUB	E		; A = -E
	JP	Z,__mul16w	; DE = -256
	EX	DE,HL
	JP	__mul16ng	; HL = -(HL * -DE)

; ============================================================
; __mul16ng - HL = -(DE * A), A = 1..255.  Part of __mul16.
; __mul16w  - HL = DE * HL when neither operand fits in 8 bits:
;   DE*L + ((E*H) mod 256)<<8.  Part of __mul16.
; Kept apart from __mul16 so that the common 8-bit cases are one
; short routine.  Same registers as __mul16.
; ============================================================
	PUBLIC	__mul16ng
__mul16ng:
	CALL	__mul8x16
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
	RET

	PUBLIC	__mul16w
__mul16w:
	PUSH	HL
	LD	A,L
	CALL	__mul8x16	; HL = DE * L
	EX	(SP),HL		; HL = right operand, stack = partial
	LD	A,H
	LD	D,0		; DE = E
	CALL	__mul8x16	; L = (H * E) & 0FFH
	LD	A,L
	POP	HL
	ADD	A,H
	LD	H,A
	RET

; ============================================================
; 16-bit unsigned division: HL = DE / HL
; Also sets __divrem to remainder (DE % HL), and returns the
; remainder in DE.  Division by zero: HL = 0, remainder 0.
; Preserves BC, IX, IY.  Clobbers A, flags.
; ============================================================
	PUBLIC	__div16
	PUBLIC	__divrem
__div16:
	EX	DE,HL		; HL = dividend, DE = divisor
	LD	A,D
	OR	E
	JR	Z,__div16_zero
	PUSH	BC
	LD	A,D
	OR	A
	JR	NZ,__div16_w
	LD	C,E		; divisor < 256
	LD	A,H
	CP	C
	JR	C,__div16_lo	; H < divisor: quotient < 256
	LD	E,H
	XOR	A
	CALL	__dv8n		; E = quotient high byte, A = remainder
	LD	H,E
	LD	E,L
	CALL	__dv8n		; E = quotient low byte
	LD	L,E
	JR	__div16_n
__div16_lo:
	LD	E,L		; A = H is the remainder so far
	CALL	__dv8n
	LD	L,E
	LD	H,0
__div16_n:
	LD	E,A
	LD	D,0
	JR	__div16_done
__div16_w:
	LD	A,L		; divisor >= 256: quotient < 256
	LD	L,H
	LD	H,0
	CALL	__dv8w		; A = quotient, HL = remainder
	EX	DE,HL
	LD	L,A
	LD	H,0
__div16_done:
	LD	(__divrem),DE
	POP	BC
	RET
__div16_zero:
	LD	HL,0
	LD	(__divrem),HL
	LD	D,H
	LD	E,L
	RET

	DSEG
__divrem:
	DW	0

	CSEG

; ============================================================
; 16-bit unsigned modulo: HL = DE % HL
; ============================================================
	PUBLIC	__mod16
__mod16:
	CALL	__div16		; remainder in DE
	EX	DE,HL
	RET

; ============================================================
; 16-bit signed division: HL = DE / HL (signed)
; Truncates toward zero.  Sets __divrem to |DE| % |HL|.
; ============================================================
	PUBLIC	__sdiv16
__sdiv16:
	LD	A,D
	XOR	H
	PUSH	AF		; S flag = sign of the quotient
	BIT	7,D
	JR	Z,__sdiv16_1
	XOR	A		; DE = -DE
	SUB	E
	LD	E,A
	SBC	A,A
	SUB	D
	LD	D,A
__sdiv16_1:
	BIT	7,H
	JR	Z,__sdiv16_2
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__sdiv16_2:
	CALL	__div16
	POP	AF
	RET	P
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
	RET

; ============================================================
; 16-bit signed modulo: HL = DE % HL (signed)
; Result has same sign as dividend (DE)
; ============================================================
	PUBLIC	__smod16
__smod16:
	LD	A,D
	OR	A
	PUSH	AF		; S flag = sign of the dividend
	JP	P,__smod16_1
	XOR	A		; DE = -DE
	SUB	E
	LD	E,A
	SBC	A,A
	SUB	D
	LD	D,A
__smod16_1:
	BIT	7,H
	JR	Z,__smod16_2
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
__smod16_2:
	CALL	__div16
	EX	DE,HL		; HL = remainder
	POP	AF
	RET	P
	XOR	A		; HL = -HL
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
	RET

; ============================================================
; 16-bit left shift: HL = DE << L  (L >= 16 gives 0; H ignored)
; ============================================================
	PUBLIC	__shl16
__shl16:
	LD	A,L
	EX	DE,HL
	CP	8
	JR	NC,__shl16_8
__shl16_s:
	OR	A
	RET	Z
__shl16_lp:
	ADD	HL,HL
	DEC	A
	JR	NZ,__shl16_lp
	RET
__shl16_8:
	CP	16
	JR	NC,__shl16_z
	LD	H,L		; shift by 8 is a byte move
	LD	L,0
	SUB	8
	JR	__shl16_s
__shl16_z:
	LD	HL,0
	RET

; ============================================================
; 16-bit logical right shift: HL = DE >> L (unsigned)
; ============================================================
	PUBLIC	__shr16
__shr16:
	LD	A,L
	EX	DE,HL
	CP	8
	JR	NC,__shr16_8
	OR	A
	RET	Z
__shr16_lp:
	SRL	H
	RR	L
	DEC	A
	JR	NZ,__shr16_lp
	RET
__shr16_8:
	CP	16
	JR	NC,__shr16_z
	LD	L,H		; shift by 8 is a byte move
	LD	H,0
	SUB	8
	RET	Z
__shr16_b:
	SRL	L
	DEC	A
	JR	NZ,__shr16_b
	RET
__shr16_z:
	LD	HL,0
	RET

; ============================================================
; 16-bit arithmetic right shift: HL = DE >> L (signed)
; ============================================================
	PUBLIC	__sar16
__sar16:
	LD	A,L
	EX	DE,HL
	CP	8
	JR	NC,__sar16_8
	OR	A
	RET	Z
__sar16_lp:
	SRA	H
	RR	L
	DEC	A
	JR	NZ,__sar16_lp
	RET
__sar16_8:
	CP	16
	JR	NC,__sar16_f
	SUB	8		; shift by 8 is a byte move and a
	LD	L,H		; sign fill
	LD	H,0
	BIT	7,L
	JR	Z,__sar16_p
	DEC	H
__sar16_p:
	OR	A
	RET	Z
__sar16_b:
	SRA	L
	DEC	A
	JR	NZ,__sar16_b
	RET
__sar16_f:
	LD	A,H		; shift >= 16: 0 or -1 by the sign
	RLA
	SBC	A,A
	LD	H,A
	LD	L,A
	RET

; ============================================================
; __clz16 — count leading zeros of 16-bit HL.
; Undefined for x=0 per GCC. Returns 16 if HL == 0 (defensive).
; ============================================================
	PUBLIC	__clz16
__clz16:
	LD	A,H
	OR	L
	JR	Z,__clz16_zero
	PUSH	BC
	LD	B,0		; counter
	; Probe bits from high (15) down to 0
__clz16_lp:
	BIT	7,H
	JR	NZ,__clz16_done
	INC	B
	ADD	HL,HL
	JR	__clz16_lp
__clz16_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__clz16_zero:
	LD	HL,16
	RET

; ============================================================
; __clrsb16 — count leading sign bits minus 1 (16-bit signed HL).
; clrsb(x) = clz(x ^ (x >> 15)) - 1, with clrsb(0) and clrsb(-1) = 15.
; ============================================================
	PUBLIC	__clrsb16
__clrsb16:
	; If MSB set (negative), XOR with 0xFFFF (flip all bits).
	; Otherwise leave HL alone.
	BIT	7,H
	JR	Z,__clrsb16_pos
	; Negative: XOR HL with 0xFFFF
	LD	A,H
	XOR	0FFH
	LD	H,A
	LD	A,L
	XOR	0FFH
	LD	L,A
__clrsb16_pos:
	; Now HL has leading 0 bits we count, MSB is 0.
	LD	A,H
	OR	L
	JR	Z,__clrsb16_all_same	; all bits matched sign → 15
	CALL	__clz16
	DEC	HL
	RET
__clrsb16_all_same:
	LD	HL,15
	RET

; ============================================================
; __ctz16 — count trailing zeros of 16-bit HL.
; Undefined for x=0 per GCC. Returns 16 if HL == 0 (defensive).
; ============================================================
	PUBLIC	__ctz16
__ctz16:
	LD	A,H
	OR	L
	JR	Z,__ctz16_zero
	PUSH	BC
	LD	B,0
__ctz16_lp:
	BIT	0,L
	JR	NZ,__ctz16_done
	INC	B
	SRL	H
	RR	L
	JR	__ctz16_lp
__ctz16_done:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ctz16_zero:
	LD	HL,16
	RET

; ============================================================
; __popcount16 — count set bits in HL.
; ============================================================
	PUBLIC	__popcount16
__popcount16:
	PUSH	BC
	LD	B,0		; counter
	LD	C,16		; bits remaining
__popcount16_lp:
	SRL	H
	RR	L
	JR	NC,__popcount16_skip
	INC	B
__popcount16_skip:
	DEC	C
	JR	NZ,__popcount16_lp
	LD	L,B
	LD	H,0
	POP	BC
	RET

; ============================================================
; __ffs16 — find lowest set bit (1-indexed), 0 if none.
; Models __builtin_ffs / POSIX ffs for 16-bit operands. uc80 calls
; this from gen_call when the user invokes ``__builtin_ffs(int)``.
; In:  HL = value
; Out: HL = 1..16 (position of lowest set bit) or 0 if HL==0
; ============================================================
	PUBLIC	__ffs16
__ffs16:
	LD	A,H
	OR	L
	JR	Z,__ffs16_zero
	PUSH	BC
	LD	B,1		; current bit position
	LD	A,L
__ffs16_lo:
	RRCA
	JR	C,__ffs16_found
	INC	B
	LD	C,A
	LD	A,B
	CP	9
	LD	A,C
	JR	NZ,__ffs16_lo
	; First 8 bits all zero; move to high byte
	LD	A,H
__ffs16_hi:
	RRCA
	JR	C,__ffs16_found
	INC	B
	JR	__ffs16_hi
__ffs16_found:
	LD	L,B
	LD	H,0
	POP	BC
	RET
__ffs16_zero:
	LD	HL,0
	RET

; ============================================================
; Indirect call through HL
; ============================================================
	PUBLIC	__callhl
__callhl:
	JP	(HL)		; Jump to address in HL
