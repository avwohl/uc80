; rt_div64.mac - __div64
; Split from rt_arith64.mac

	.Z80

	EXTRN	__acc64
	EXTRN	__div64_dvd
	EXTRN	__rem64
	EXTRN	__tmp64

	CSEG
	PUBLIC	__div64
__div64:
	PUSH	BC
	PUSH	DE

	; Save dividend (__acc64) to __div64_dvd
	LD	HL,(__acc64)
	LD	(__div64_dvd),HL
	LD	HL,(__acc64+2)
	LD	(__div64_dvd+2),HL
	LD	HL,(__acc64+4)
	LD	(__div64_dvd+4),HL
	LD	HL,(__acc64+6)
	LD	(__div64_dvd+6),HL

	; Quotient in __acc64 (start at 0)
	LD	HL,0
	LD	(__acc64),HL
	LD	(__acc64+2),HL
	LD	(__acc64+4),HL
	LD	(__acc64+6),HL

	; Remainder starts at 0
	LD	(__rem64),HL
	LD	(__rem64+2),HL
	LD	(__rem64+4),HL
	LD	(__rem64+6),HL

	LD	B,64		; 64 bits

__div64_loop:
	; Shift dividend left, MSB into carry
	LD	HL,(__div64_dvd)
	ADD	HL,HL
	LD	(__div64_dvd),HL
	LD	HL,(__div64_dvd+2)
	ADC	HL,HL
	LD	(__div64_dvd+2),HL
	LD	HL,(__div64_dvd+4)
	ADC	HL,HL
	LD	(__div64_dvd+4),HL
	LD	HL,(__div64_dvd+6)
	ADC	HL,HL
	LD	(__div64_dvd+6),HL

	; Rotate carry into remainder (shift remainder left, carry in LSB)
	LD	HL,(__rem64)
	ADC	HL,HL
	LD	(__rem64),HL
	LD	HL,(__rem64+2)
	ADC	HL,HL
	LD	(__rem64+2),HL
	LD	HL,(__rem64+4)
	ADC	HL,HL
	LD	(__rem64+4),HL
	LD	HL,(__rem64+6)
	ADC	HL,HL
	LD	(__rem64+6),HL

	; Shift quotient (__acc64) left
	LD	HL,(__acc64)
	ADD	HL,HL
	LD	(__acc64),HL
	LD	HL,(__acc64+2)
	ADC	HL,HL
	LD	(__acc64+2),HL
	LD	HL,(__acc64+4)
	ADC	HL,HL
	LD	(__acc64+4),HL
	LD	HL,(__acc64+6)
	ADC	HL,HL
	LD	(__acc64+6),HL

	; Check if remainder >= divisor (__tmp64)
	; Compare from MSW to LSW
	LD	HL,(__rem64+6)
	LD	DE,(__tmp64+6)
	OR	A
	SBC	HL,DE
	JR	NZ,__div64_chk	; Not equal at word 3
	LD	HL,(__rem64+4)
	LD	DE,(__tmp64+4)
	SBC	HL,DE
	JR	NZ,__div64_chk
	LD	HL,(__rem64+2)
	LD	DE,(__tmp64+2)
	SBC	HL,DE
	JR	NZ,__div64_chk
	LD	HL,(__rem64)
	LD	DE,(__tmp64)
	SBC	HL,DE
__div64_chk:
	JR	C,__div64_nosub	; remainder < divisor, skip

	; remainder >= divisor: subtract divisor from remainder
	LD	HL,(__rem64)
	LD	DE,(__tmp64)
	OR	A
	SBC	HL,DE
	LD	(__rem64),HL
	LD	HL,(__rem64+2)
	LD	DE,(__tmp64+2)
	SBC	HL,DE
	LD	(__rem64+2),HL
	LD	HL,(__rem64+4)
	LD	DE,(__tmp64+4)
	SBC	HL,DE
	LD	(__rem64+4),HL
	LD	HL,(__rem64+6)
	LD	DE,(__tmp64+6)
	SBC	HL,DE
	LD	(__rem64+6),HL

	; Set LSB of quotient
	LD	HL,(__acc64)
	SET	0,L
	LD	(__acc64),HL

__div64_nosub:
	DJNZ	__div64_loop
	; B wrapped from 0 to 255 for first 255, then need to handle remaining
	; Actually DJNZ with B=64 will loop 64 times correctly
	; (B goes 64->63->...->1->0, DJNZ stops when B reaches 0)

	POP	DE
	POP	BC
	RET

	END
