; lc_vm.mac - GENERATED from vmsrc/lc_vm.mac.in and vmsrc/lc_vm.vc by
; gen_vm_modules.py
; Do not edit this file: edit the two source files and run the script.
;
; The float interpreter of the math library.  A math kernel (sin, exp,
; pow, ...) is a short program for a stack machine with 32-bit float
; elements.  An operation is one byte, a float operation costs about two
; bytes of program instead of the 25 to 30 bytes that the compiler writes
; for it, and the interpreter is shared by all kernels.  The programs are in
; vmsrc/*.vc (a small subset of C); gen_vm_modules.py compiles them.
; docs/libm.md describes the machine.
;
; Registers: BC = the program counter, IX = the top of the stack.  The
; float routines of the runtime keep BC and IX.
;
; A kernel is called like a C function.  Its stub loads the address of the
; program in HL and jumps to __vm_run.  The program starts with three
; bytes: the number of float arguments, the number of pointer arguments
; (after the floats) and the number of constants.  The constants (4 bytes
; each) and the code follow.
;
; Operations (one byte):
;   00 RET   01 ADD  02 SUB  03 MUL  04 DIV  05 NEG  06 ABS  07 DROP
;   08 POLY first,count  (x -> c0 + c1*x + ...  with the constants first...)
;   09 TRUNC (x -> float(int(x)))  0A 2SUM  0B 2PROD  0C FIN k
;   20+n PICK n (push a copy of the element n below the top)
;   40+n PUT n  (pop, store into the element n below the new top)
;   60+n LDC n  (push constant n)
;   80 JLT  81 JLE  82 JGT  83 JGE  84 JEQ  85 JNE  (pop b, a; jump by the
;   signed byte after the code when a op b)  86 JMP
;   87 STP0  88 STP1  (pop, store a float through pointer argument 0 or 1)
;   89 STI0  8A STI1  (pop, store int(x) as 2 bytes through the pointer)
	.Z80

	CSEG

	EXTRN	__fadd
	EXTRN	__fsub
	EXTRN	__fmul
	EXTRN	__fdiv
	EXTRN	__fcmp
	EXTRN	__ftoi
	EXTRN	__itof
	EXTRN	__tmp32

	PUBLIC	__vm_run

; ------------------------------------------------------------
; __vm_run: HL = the program.  The C arguments are on the stack.
; ------------------------------------------------------------
__vm_run:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	B,(HL)		; B = the number of floats
	INC	HL
	LD	C,(HL)		; C = the number of pointers
	INC	HL
	LD	E,(HL)		; E = the number of constants
	INC	HL
	LD	(_vm_pool),HL
	LD	D,0
	EX	DE,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,DE		; HL = the code
	PUSH	HL
	PUSH	BC
	PUSH	IX
	POP	HL
	LD	DE,4
	ADD	HL,DE		; HL = the arguments
	LD	A,B
	ADD	A,A
	ADD	A,A
	LD	DE,_vm_stk
	CALL	_vm_cp
	LD	A,C
	ADD	A,A
	LD	DE,_vm_ptr
	CALL	_vm_cp
	LD	A,B
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	LD	IX,_vm_stk-4
	ADD	IX,DE
	POP	BC
	POP	BC		; BC = the code
	CALL	_vm_next
	LD	L,(IX+0)
	LD	H,(IX+1)
	LD	E,(IX+2)
	LD	D,(IX+3)
	POP	IX
	RET

; copy A bytes from HL to DE (nothing for 0); HL ends after the source
_vm_cp:
	OR	A
	RET	Z
	PUSH	BC
	LD	C,A
	LD	B,0
	LDIR
	POP	BC
	RET

; ------------------------------------------------------------
; The loop: run the program at BC until a RET
; ------------------------------------------------------------
_vm_next:
	LD	A,(BC)
	INC	BC
	LD	D,A
	CP	20H
	JR	C,_vm_tab
	CP	80H
	JR	C,_vm_cls
	AND	1FH
	ADD	A,13
_vm_tab:
	ADD	A,A
	LD	L,A
	LD	H,0
	LD	DE,_vm_tbl
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	JP	(HL)
_vm_cls:
	CP	40H
	JR	C,_vm_pick
	CP	60H
	JR	C,_vm_put

; LDC n: push constant n
_vm_ldc:
	LD	A,D
	AND	1FH
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	LD	HL,(_vm_pool)
	ADD	HL,DE
	JR	_vm_push

; PICK n: push a copy of the element n below the top
_vm_pick:
	LD	A,D
	AND	1FH
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	PUSH	IX
	POP	HL
	OR	A
	SBC	HL,DE
; push the 4 bytes at HL
_vm_push:
	LD	DE,4
	ADD	IX,DE
	PUSH	IX
	POP	DE
	PUSH	BC
	LD	BC,4
	LDIR
	POP	BC
	JR	_vm_next

; PUT n: pop, store the value into the element n below the new top
_vm_put:
	LD	A,D
	AND	1FH
	INC	A
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	PUSH	IX
	POP	HL
	PUSH	HL
	OR	A
	SBC	HL,DE
	EX	DE,HL
	POP	HL
	PUSH	BC
	LD	BC,4
	LDIR
	POP	BC
_vm_drop:
	LD	DE,-4
	ADD	IX,DE
	JR	_vm_next

; b -> __tmp32, pop, a -> DEHL
_vm_getab:
	LD	L,(IX+0)
	LD	H,(IX+1)
	LD	E,(IX+2)
	LD	D,(IX+3)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,-4
	ADD	IX,DE
	LD	L,(IX+0)
	LD	H,(IX+1)
	LD	E,(IX+2)
	LD	D,(IX+3)
	RET

_vm_add:
	LD	HL,__fadd
	JR	_vm_bin
_vm_sub:
	LD	HL,__fsub
	JR	_vm_bin
_vm_mul:
	LD	HL,__fmul
	JR	_vm_bin
_vm_div:
	LD	HL,__fdiv
_vm_bin:
	LD	DE,_vm_store
	PUSH	DE
	PUSH	HL
	CALL	_vm_getab
	RET
_vm_store:
	LD	(IX+0),L
	LD	(IX+1),H
	LD	(IX+2),E
	LD	(IX+3),D
	JR	_vm_next

_vm_neg:
	LD	A,(IX+3)
	XOR	80H
	LD	(IX+3),A
	JR	_vm_next
_vm_abs:
	RES	7,(IX+3)
	JR	_vm_next

; TRUNC: x -> float(int(x))
_vm_trunc:
	LD	L,(IX+0)
	LD	H,(IX+1)
	LD	E,(IX+2)
	LD	D,(IX+3)
	PUSH	IX
	CALL	__ftoi
	CALL	__itof
	POP	IX
	JR	_vm_store

; the conditional jumps: A = the conditions that make the jump, as bits
; 1 (a < b), 2 (a = b), 4 (a > b)
_vm_jlt:
	LD	A,1
	JR	_vm_jcc
_vm_jle:
	LD	A,3
	JR	_vm_jcc
_vm_jgt:
	LD	A,4
	JR	_vm_jcc
_vm_jge:
	LD	A,6
	JR	_vm_jcc
_vm_jeq:
	LD	A,2
	JR	_vm_jcc
_vm_jne:
	LD	A,5
_vm_jcc:
	PUSH	AF
	CALL	_vm_getab
	CALL	__fcmp
	LD	A,2
	JR	Z,_vm_j1
	LD	A,1
	JR	C,_vm_j1
	LD	A,4
_vm_j1:
	POP	HL
	AND	H
	LD	A,(BC)
	INC	BC
	JR	Z,_vm_next
	JR	_vm_jt
_vm_jmp:
	LD	A,(BC)
	INC	BC
_vm_jt:
	LD	L,A
	ADD	A,A
	SBC	A,A
	LD	H,A
	ADD	HL,BC
	LD	B,H
	LD	C,L
	JR	_vm_next

; STP k and STI k: pop and store through the pointer argument k
_vm_stp0:
	LD	HL,_vm_ptr
	JR	_vm_stp
_vm_stp1:
	LD	HL,_vm_ptr+2
_vm_stp:
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	PUSH	IX
	POP	HL
	PUSH	BC
	LD	BC,4
	LDIR
	POP	BC
	JR	_vm_drop
_vm_sti0:
	LD	HL,_vm_ptr
	JR	_vm_sti
_vm_sti1:
	LD	HL,_vm_ptr+2
_vm_sti:
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	PUSH	DE
	LD	L,(IX+0)
	LD	H,(IX+1)
	LD	E,(IX+2)
	LD	D,(IX+3)
	PUSH	IX
	CALL	__ftoi
	POP	IX
	POP	DE
	LD	A,L
	LD	(DE),A
	INC	DE
	LD	A,H
	LD	(DE),A
	JR	_vm_drop

; POLY first,count: x -> c[first] + c[first+1]*x + ... (Horner's rule)
_vm_poly:
	LD	(_vm_sp),IX
	PUSH	IX
	POP	HL
	LD	DE,_vm_x
	PUSH	BC
	LD	BC,4
	LDIR
	POP	BC
	LD	A,(BC)
	INC	BC
	LD	E,A		; E = the first constant
	LD	A,(BC)
	INC	BC
	LD	(_vm_cnt),A
	ADD	A,E
	DEC	A
	LD	L,A
	LD	H,0
	ADD	HL,HL
	ADD	HL,HL
	LD	DE,(_vm_pool)
	ADD	HL,DE
	PUSH	HL
	POP	IX		; IX = the last constant
	LD	L,(IX+0)
	LD	H,(IX+1)
	LD	E,(IX+2)
	LD	D,(IX+3)
_vm_pl:
	LD	A,(_vm_cnt)
	DEC	A
	LD	(_vm_cnt),A
	JR	Z,_vm_pd
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_vm_x)
	LD	DE,(_vm_x+2)
	CALL	__fmul
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,-4
	ADD	IX,DE
	LD	L,(IX+0)
	LD	H,(IX+1)
	LD	E,(IX+2)
	LD	D,(IX+3)
	CALL	__fadd
	JR	_vm_pl
_vm_pd:
	LD	IX,(_vm_sp)
	JR	_vm_store

; 2SUM and 2PROD: run a program of this module
_vm_2sum:
	LD	HL,_vm_p2sum
	JR	_vm_sub1
_vm_2prod:
	LD	HL,_vm_p2prod
_vm_sub1:
	PUSH	BC
	LD	B,H
	LD	C,L
	CALL	_vm_next
	POP	BC
	JR	_vm_next

; FIN k: keep the top 2 elements, remove the k elements below them, return
_vm_fin:
	LD	A,(BC)
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	PUSH	IX
	POP	HL
	LD	BC,4
	OR	A
	SBC	HL,BC		; HL = the second element from the top
	PUSH	HL
	OR	A
	SBC	HL,DE
	EX	DE,HL		; DE = the place of the first removed element
	POP	HL
	LD	BC,8
	LDIR
	LD	HL,-4
	ADD	HL,DE
	PUSH	HL
	POP	IX
_vm_ret:
	RET

_vm_tbl:
	DW	_vm_ret, _vm_add, _vm_sub, _vm_mul, _vm_div, _vm_neg, _vm_abs
	DW	_vm_drop, _vm_poly, _vm_trunc, _vm_2sum, _vm_2prod, _vm_fin
	DW	_vm_jlt, _vm_jle, _vm_jgt, _vm_jge, _vm_jeq, _vm_jne, _vm_jmp
	DW	_vm_stp0, _vm_stp1, _vm_sti0, _vm_sti1

;;SUBS

	COMMON	/lc_vm/
_vm_pool:
	DS	2
_vm_ptr:
	DS	4
_vm_x:
	DS	4
_vm_sp:
	DS	2
_vm_cnt:
	DS	1
_vm_stk:
	DS	160

	END
