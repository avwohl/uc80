/* lc_m_2x.vc - the error-free transformations: the sum or the product of
 * two floats and its exact rounding error.  The programs use them through
 * twosum(a, b) and twoprod(a, b). */

/* s + e = a + b exactly (Knuth) */
sub2 m_2sum(float a, float b)
{
    float s = a + b;
    float bb = s - a;
    float e = (a - (s - bb)) + (b - bb);
    return2(s, e);
}

/* p + e = a * b exactly (Dekker, with the Veltkamp split) */
sub2 m_2prod(float a, float b)
{
    float p = a * b;
    float ca = 4097.0f * a;
    float ah = ca - (ca - a);
    float al = a - ah;
    float cb = 4097.0f * b;
    float bh = cb - (cb - b);
    float bl = b - bh;
    float e = ((ah * bh - p) + ah * bl + al * bh) + al * bl;
    return2(p, e);
}
