/* lc_tanh.vc - tanh.  Up to |x| = 0.6 a kernel x + x*z*P(z); above,
 * tanh = -t/(t+2) with t = expm1(-2|x|); from |x| = 9.1 the result is 1. */
#include "vm.vh"

static const float tanh_p[] = {
    -0.333333343f, 0.133333132f, -0.0539615527f, 0.0217883438f,
    -0.00841013808f, 0.00237083971f
};

/* ALIAS: tanh = tanhf tanhl */
float tanh(float x)
{
    float ax, z, y, t;

    if (expo(x) == 255.0f) {
        if (fabs(x) > inf)
            return x;
        if (sgn(x) != 0.0f)
            return -1.0f;
        return 1.0f;
    }
    if (expo(x) < 114.0f)
        return x;
    ax = fabs(x);
    if (ax >= 9.1f) {
        y = 1.0f;
    } else if (ax < 0.6f) {
        z = ax * ax;
        y = ax + ax * z * poly(z, tanh_p);
    } else {
        t = expm1(-2.0f * ax);
        y = -t / (t + 2.0f);
    }
    if (sgn(x) != 0.0f)
        return -y;
    return y;
}
