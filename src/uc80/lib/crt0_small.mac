; crt0_small.mac - C Runtime Startup for CP/M, short BSS clear
; (the compiler embeds this file when the program has a small BSS;
; crt0.mac has the fast clear for a large BSS)
; uc80 C Compiler
;
; This is the startup code that:
; 1. Sets up the stack from BDOS
; 2. Zeros BSS (COMMON segment - uninitialized static storage)
; 3. Calls main()
; 4. Returns exit code to CP/M

	.Z80

	CSEG

	PUBLIC	__start

	EXTRN	_main
	EXTRN	__exit_hook
	EXTRN	__bss_start
	EXTRN	__bss_end

; CP/M program entry point (at 0100H after linking)
__start:
	; Get stack pointer from BDOS (address 6 contains top of TPA)
	LD	HL,(6)
	LD	SP,HL

	; Zero BSS region (COMMON segment)
	; C standard requires static storage to be zero-initialized.
	; The BSS always holds __exit_hook (2 bytes), so its size is at least 2.
	; The count is a link-time expression.  Any size up to 65536 bytes works.
	LD	BC,__bss_end-__bss_start-1
	LD	HL,__bss_start
	LD	(HL),0
	LD	DE,__bss_start+1
	LDIR
__nobss:

	; Call main - return value left in HL (16-bit), DEHL (32-bit), or
	; __tmp64 (64-bit) depending on the main() return type width.
	CALL	_main

	; Returning from main is exit(): the program runs the atexit handlers
	; and closes its open files.  The word __exit_hook (in lc_exit_hook, in
	; BSS) holds the address of that code.  It is 0 until atexit() or fopen()
	; puts the address in it, and JP (HL) to address 0 is the warm boot, so a
	; program that links no exit code only returns to CP/M.
	;
	; CP/M has no standard register convention for passing a program exit
	; status, so the return value from main() is discarded here regardless
	; of its width.
	LD	HL,(__exit_hook)
	JP	(HL)

	END	__start
