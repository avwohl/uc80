_casin:
_cacos:
_catan:
_casinh:
_cacosh:
_catanh:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	DE,_cplx_res
	LD	BC,8
	LDIR
	LD	HL,_cplx_res
	POP	IX
	RET

; Complex multiply: __cplx_l * __cplx_r -> __cplx_result
; Stub implementation - returns __cplx_l
__cmul:
	LD	HL,__cplx_l
	LD	DE,__cplx_result
	LD	BC,8
	LDIR
	RET

; Complex divide: __cplx_l / __cplx_r -> __cplx_result
; Stub implementation - returns __cplx_l
__cdiv:
	LD	HL,__cplx_l
	LD	DE,__cplx_result
	LD	BC,8
	LDIR
	RET

