; ============================================================
; lc_wcstombs.mac
; ============================================================
; lc_wcstombs.mac - split from lc_wchar.mac


	CSEG

; size_t wcstombs(char *dest, const wchar_t *src, size_t n)
; Convert wide string to multibyte string
; C locale: copy low bytes if <= 255
	PUBLIC	_wcstombs
_wcstombs:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	LD	BC,0		; Count = 0

_wcstombs_loop:
	; Check if count < n
	LD	L,(IX+8)
	LD	H,(IX+9)	; HL = n
	OR	A
	SBC	HL,BC
	JR	Z,_wcstombs_done
	JR	C,_wcstombs_done

	; Get wchar at src[count]
	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = src
	PUSH	BC
	SLA	C
	RL	B		; BC * 2 for wchar_t
	ADD	HL,BC
	POP	BC
	LD	E,(HL)		; Low byte
	INC	HL
	LD	A,(HL)		; High byte
	OR	A
	JR	NZ,_wcstombs_err	; > 255

	; Check for null terminator
	LD	A,E
	OR	A
	JR	Z,_wcstombs_term

	; Store in dest if not NULL
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	A,H
	OR	L
	JR	Z,_wcstombs_nodest
	ADD	HL,BC
	LD	(HL),E

_wcstombs_nodest:
	INC	BC
	JR	_wcstombs_loop

_wcstombs_term:
	; Null terminate
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	A,H
	OR	L
	JR	Z,_wcstombs_done
	ADD	HL,BC
	XOR	A
	LD	(HL),A

_wcstombs_done:
	LD	H,B
	LD	L,C
	POP	BC
	POP	IX
	RET

_wcstombs_err:
	LD	HL,-1
	POP	BC
	POP	IX
	RET

; ============================================================
; char *strrchr(const char *s, int c)
; Find last occurrence of c in s


	CSEG
; ============================================================
; lc_wctomb.mac
; ============================================================
; lc_wctomb.mac - split from lc_wchar.mac


	CSEG

; int wctomb(char *s, wchar_t wc)
; Convert wide character to multibyte
; C locale: just copy low byte if <= 255
	PUBLIC	_wctomb
_wctomb:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = s
	LD	A,H
	OR	L
	JR	Z,_wctomb_null	; s == NULL

	; Get wchar_t
	LD	C,(IX+6)	; Low byte of wc
	LD	A,(IX+7)	; High byte
	OR	A
	JR	NZ,_wctomb_err	; > 255: invalid for C locale

	; Store character
	LD	(HL),C
	LD	HL,1
	POP	IX
	RET

_wctomb_null:
	; s == NULL: return 0 (stateless)
	LD	HL,0
	POP	IX
	RET

_wctomb_err:
	LD	HL,-1
	POP	IX
	RET


	END
