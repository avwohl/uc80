	PUSH	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)		; BCDE = current
	POP	HL

	; Load expected
	PUSH	HL
	PUSH	BC
	PUSH	DE
