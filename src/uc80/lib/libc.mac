	ADD	IX,SP
	LD	A,(IX+4)
	CP	'A'
	JR	C,_tolower_ret
	CP	'Z'+1
	JR	NC,_tolower_ret
	ADD	A,'a'-'A'	; Convert to lowercase
_tolower_ret:
	LD	L,A
	LD	H,0
	POP	IX
	RET


