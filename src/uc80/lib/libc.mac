; ============================================================
; lc_atexit.mac
; ============================================================
; lc_atexit.mac - atexit


MAX_ATEXIT	EQU	32	; the minimum that C 7.24.4.3 requires

	CSEG

; ============================================================
; int atexit(void (*func)(void))
; Register function to be called at exit.
; Returns 0 on success, non-zero when 32 functions are registered.
; ============================================================
	PUBLIC	_atexit
_atexit:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	; Check if we have room
	LD	A,(_atexit_cnt)
	CP	MAX_ATEXIT
	JR	NC,_atexit_fail

	; Get handler address: _atexit_tab + cnt*2
	LD	L,A
	LD	H,0
	ADD	HL,HL
	LD	DE,_atexit_tab
	ADD	HL,DE		; HL = slot address

	; Store function pointer
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(HL),E
	INC	HL
	LD	(HL),D

	; Increment count
	LD	A,(_atexit_cnt)
	INC	A
	LD	(_atexit_cnt),A

	; Returning from main must run the handlers: crt0 jumps through
	; __exit_hook.
	LD	HL,__exit_run
	LD	(__exit_hook),HL

	; Return success
	LD	HL,0
	POP	IX
	RET

_atexit_fail:
	LD	HL,1
	POP	IX
	RET


