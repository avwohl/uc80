	LD	(_atol_tmp),HL
	LD	HL,(_atol_tmp+2)
	ADC	HL,HL
	LD	(_atol_tmp+2),HL
	DJNZ	_atol_shift8

	; acc = acc + tmp (acc*2 + acc*8 = acc*10)
