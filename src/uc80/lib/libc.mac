	LD	H,(IX+7)
	LD	C,(IX+8)	; BC = n
	LD	B,(IX+9)

_strncat_loop:
	LD	A,B		; Check if n == 0
	OR	C
	JR	Z,_strncat_done

	LD	A,(HL)
	OR	A
	JR	Z,_strncat_done	; End of src

	LD	(DE),A
	INC	HL
	INC	DE
	DEC	BC
	JR	_strncat_loop

_strncat_done:
