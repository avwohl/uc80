	JR	NC,_scm_skip
	ADD	HL,DE
_scm_skip:
	SLA	E
	RL	D
	DJNZ	_scm_bit
	LD	A,L		; the new byte
	LD	E,H		; the carry into the next byte
	LD	D,0
	POP	BC
	POP	HL
	LD	(HL),A
	INC	HL
	DJNZ	_scm_byte
	LD	L,E
	LD	H,0
	POP	IX
	RET

