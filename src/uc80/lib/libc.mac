_mph_tp:
	DB	0,0
	DB	0A2H,0F9H,083H,06EH,04EH,044H,015H,029H,0FCH,027H,057H,0D1H
	DB	0F5H,034H,0DDH,0C0H,0DBH,062H,095H,099H,03CH,043H,090H,041H
	DB	0FEH,051H,063H,0ABH,0DEH,0BBH,0C5H,061H,0B7H,024H

	COMMON	/lc_m_phred/
_mph_m:
	DS	3
_mph_w:
	DS	14
_mph_a:
	DS	13
_mph_neg_flag:
	DS	1
_mph_n:
	DS	1
_mph_c:
	DS	1
_mph_df:
	DS	4


