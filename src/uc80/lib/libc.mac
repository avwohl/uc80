	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	B,(IX+6)
	SCF
_scn_loop:
	LD	A,(HL)
	CPL
	ADC	A,0
	LD	(HL),A
	INC	HL
	DJNZ	_scn_loop
	POP	IX
	RET


