	OR	A
	RET
_scn_swe:
	SCF
	RET

; ------------------------------------------------------------
; __scn_arg: HL = the next argument, which is a pointer
; ------------------------------------------------------------
__scn_arg:
	LD	HL,(__scn_ap)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(__scn_ap),HL
	EX	DE,HL
	RET

; ------------------------------------------------------------
; _scn_nx: the next character inside the width, HL = -2 when the width is
; used up
; ------------------------------------------------------------
_scn_nx:
	LD	HL,(_scn_iw)
	BIT	7,H
	JR	NZ,_scn_nxe
	LD	A,H
	OR	L
	JR	Z,_scn_nxe
