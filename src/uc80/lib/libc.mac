	PUBLIC	_signbit
_signbit:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	LD	A,(IX+7)	; D byte, sign in bit 7
	RLCA			; Sign into bit 0
	AND	1
	LD	L,A
	LD	H,0
	POP	IX
	RET


