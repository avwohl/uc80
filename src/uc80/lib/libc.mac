; ============================================================
; lc_fread.mac
; ============================================================
; lc_fread.mac - split from lc_file.mac


	EXTRN	__div16
	EXTRN	__mul16

	CSEG

; ============================================================
; size_t fread(void *ptr, size_t size, size_t nmemb, FILE *stream)
; Read data from stream
; ============================================================
	PUBLIC	_fread
_fread:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Calculate total bytes = size * nmemb
	LD	L,(IX+6)
	LD	H,(IX+7)	; size
	LD	E,(IX+8)
	LD	D,(IX+9)	; nmemb
	CALL	__mul16		; HL = total bytes
	LD	B,H
	LD	C,L		; BC = bytes to read

	; If zero, return 0
	LD	A,B
	OR	C
	JR	Z,_fread_done

	; Save dest pointer
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = dest ptr
	LD	(_fread_ptr),HL

	; Initialize read count
	LD	HL,0
	LD	(_fread_cnt),HL

_fread_loop:
	; Call fgetc(stream)
	LD	L,(IX+10)
	LD	H,(IX+11)	; stream
	PUSH	BC		; Save remaining count
	PUSH	HL
	CALL	_fgetc
	POP	DE		; Clean up arg

	; Check for EOF (returns -1 = 0xFFFF)
	LD	A,H
	AND	L
	INC	A		; If HL=0xFFFF, A becomes 0
	JR	Z,_fread_eof

	; Store byte
	LD	A,L
	LD	HL,(_fread_ptr)
	LD	(HL),A
	INC	HL
	LD	(_fread_ptr),HL

	; Increment count
	LD	HL,(_fread_cnt)
	INC	HL
	LD	(_fread_cnt),HL

	; Decrement BC and continue
	POP	BC		; Restore remaining count
	DEC	BC
	LD	A,B
	OR	C
	JR	NZ,_fread_loop
	JR	_fread_done

_fread_eof:
	POP	BC		; Clean up saved count

_fread_done:
	; Return items read (cnt / size)
	; __div16 does HL = DE / HL, so DE = cnt, HL = size
	LD	E,(IX+6)
	LD	D,(IX+7)	; DE = size (temporarily)
	LD	A,D
	OR	E
	JR	Z,_fread_ret
	LD	HL,(_fread_cnt)	; HL = cnt
	EX	DE,HL		; Now DE = cnt, HL = size
	CALL	__div16		; HL = cnt / size

_fread_ret:
	POP	DE
	POP	BC
	POP	IX
	RET


	COMMON	/lc_fread/

_fread_ptr:	DS	2	; fread dest pointer temp
_fread_cnt:	DS	2	; fread byte counter temp


	CSEG
; ============================================================
; lc_free.mac
; ============================================================
; lc_free.mac - split from lc_malloc.mac



	PUBLIC	__free_hl

	CSEG

; ============================================================
; void free(void *ptr)
; Put the block on the free list (sorted by address) and merge it with
; the free blocks next to it.
; ============================================================
	PUBLIC	_free
_free:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = payload
	CALL	__free_hl
	POP	IX
	RET

; Free the block whose payload is HL (0 is ignored).
; Clobbers AF, BC, DE, HL, IX.
__free_hl:
	LD	A,H
	OR	L
	RET	Z
	DEC	HL
	DEC	HL
	EX	DE,HL		; DE = block
	PUSH	DE
	POP	IX		; IX = block
	LD	BC,_free_head	; BC = address of the link that points at HL
	LD	HL,(_free_head)
_fre_scan:
	LD	A,H
	OR	L
	JR	Z,_fre_here
	LD	A,E
	SUB	L
	LD	A,D
	SBC	A,H		; carry if block < candidate
	JR	C,_fre_here
	INC	HL
	INC	HL
	LD	B,H
	LD	C,L		; BC = &candidate.next
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A		; HL = candidate.next
	JR	_fre_scan
_fre_here:
	; the block goes between the block that owns link BC and HL
	LD	(IX+2),L
	LD	(IX+3),H	; block.next = HL
	LD	A,E
	LD	(BC),A
	INC	BC
	LD	A,D
	LD	(BC),A
	DEC	BC		; the link now points at the block
	LD	A,H
	OR	L
	JR	Z,_fre_prev
	; merge with the next block when it starts where this one ends
	PUSH	HL		; next
	LD	L,(IX+0)
	LD	H,(IX+1)
	INC	HL
	INC	HL
	ADD	HL,DE		; HL = end of this block
	POP	DE		; DE = next
	OR	A
	SBC	HL,DE
	JR	NZ,_fre_prev
	LD	H,D
	LD	L,E		; HL = next block
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = next.size
	INC	HL		; HL = &next.next
	PUSH	HL
	LD	L,(IX+0)
	LD	H,(IX+1)
	ADD	HL,DE
	INC	HL
	INC	HL
	LD	(IX+0),L
	LD	(IX+1),H	; size += next.size + 2
	POP	HL
	LD	A,(HL)
	LD	(IX+2),A
	INC	HL
	LD	A,(HL)
	LD	(IX+3),A	; block.next = next.next
_fre_prev:
	; merge into the previous block when it ends where this one starts
	LD	HL,_free_head
	OR	A
	SBC	HL,BC
	RET	Z		; no previous block: BC is the list head
	DEC	BC
	DEC	BC		; BC = previous block
	LD	H,B
	LD	L,C
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = prev.size
	LD	HL,2
	ADD	HL,DE
	ADD	HL,BC		; HL = end of the previous block
	PUSH	IX
	POP	DE		; DE = this block
	OR	A
	SBC	HL,DE
	RET	NZ
	LD	L,(IX+0)
	LD	H,(IX+1)
	INC	HL
	INC	HL		; HL = this block's size + 2
	LD	A,(BC)
	LD	E,A
	INC	BC
	LD	A,(BC)
	LD	D,A		; DE = prev.size, BC = prev + 1
	ADD	HL,DE
	LD	A,H
	LD	(BC),A
	DEC	BC
	LD	A,L
	LD	(BC),A		; prev.size += size + 2
	INC	BC
	INC	BC		; BC = &prev.next
	LD	A,(IX+2)
	LD	(BC),A
	INC	BC
	LD	A,(IX+3)
	LD	(BC),A		; prev.next = block.next
	RET


	CSEG
; ============================================================
; lc_freopen.mac
; ============================================================
; lc_freopen.mac - split from lc_file.mac



	CSEG

; ============================================================
; FILE *freopen(const char *pathname, const char *mode, FILE *stream)
; Reopen stream with new file
; ============================================================
	PUBLIC	_freopen
_freopen:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Close current stream
	LD	L,(IX+8)
	LD	H,(IX+9)
	PUSH	HL
	CALL	_fclose
	POP	BC

	; Now reopen with new file
	; Can't use the same FILE slot reliably, so just call fopen
	LD	L,(IX+4)
	LD	H,(IX+5)	; pathname
	PUSH	HL
	LD	L,(IX+6)
	LD	H,(IX+7)	; mode
	PUSH	HL
	CALL	_fopen
	POP	BC
	POP	BC

	; HL = new FILE* or NULL
	POP	DE
	POP	BC
	POP	IX
	RET


