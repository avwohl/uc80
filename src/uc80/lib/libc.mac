; ============================================================
; lc_fseek.mac
; ============================================================
; lc_fseek.mac - split from lc_file.mac



	CSEG

; ============================================================
; int fseek(FILE *stream, long offset, int whence)
; Seek to position in file (simplified - sector-based)
; ============================================================
	PUBLIC	_fseek
_fseek:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)	; stream
	LD	A,H
	OR	L
	JR	Z,_fseek_err

	; Check if file
	LD	A,(HL)
	CP	3
	JR	C,_fseek_err

	; Flush buffer first if write mode
	PUSH	HL
	INC	HL
	LD	A,(HL)
	AND	FLAG_WRITE
	JR	Z,_fseek_noflush
	DEC	HL
	CALL	_fflush_internal
	JR	_fseek_doset
_fseek_noflush:
	DEC	HL
_fseek_doset:
	POP	HL
	PUSH	HL

	; Get offset (lower 16 bits only for simplicity)
	LD	E,(IX+6)
	LD	D,(IX+7)	; offset low word

	; Check whence
	LD	A,(IX+10)
	OR	A
	JR	NZ,_fseek_err_pop	; Only SEEK_SET supported

	; Convert byte offset to record number (divide by 128)
	; Shift DE right 7 times
	SRL	D
	RR	E
	SRL	D
	RR	E
	SRL	D
	RR	E
	SRL	D
	RR	E
	SRL	D
	RR	E
	SRL	D
	RR	E
	SRL	D
	RR	E		; DE = record number

	; Set random record in FCB
	POP	HL
	PUSH	HL
	LD	BC,FILE_FCB+33	; r0, r1 in FCB
	ADD	HL,BC
	LD	(HL),E		; r0
	INC	HL
	LD	(HL),D		; r1
	INC	HL
	LD	(HL),0		; r2

	; Clear buffer
	POP	HL
	PUSH	HL
	LD	BC,FILE_BUFPOS
	ADD	HL,BC
	LD	(HL),0		; bufpos
	INC	HL
	LD	(HL),0		; bufcnt

	; Clear EOF flag
	POP	HL
	PUSH	HL
	INC	HL
	LD	A,(HL)
	AND	0FFH - FLAG_EOF
	LD	(HL),A

	POP	HL
	LD	HL,0
	POP	DE
	POP	BC
	POP	IX
	RET

_fseek_err_pop:
	POP	HL
_fseek_err:
	LD	HL,-1
	POP	DE
	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_fsetpos.mac
; ============================================================
; lc_fsetpos.mac - split from lc_file.mac



	CSEG

; ============================================================
; int fsetpos(FILE *stream, const fpos_t *pos)
; Set file position
; Returns 0 on success, non-zero on error
; ============================================================
	PUBLIC	_fsetpos
_fsetpos:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Load position from *pos
	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = pos pointer
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)		; BCDE = position
	PUSH	BC		; High word
	PUSH	DE		; Low word

	; Call fseek(stream, pos, SEEK_SET)
	LD	HL,0
	PUSH	HL		; whence = SEEK_SET
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL		; stream
	; Stack: stream, whence(0), pos_low, pos_high
	; fseek expects: stream, offset_low, offset_high, whence
	; Need to rearrange...

	; Actually let's redo this properly
	POP	HL		; stream
	POP	BC		; whence
	POP	DE		; pos low
	POP	BC		; pos high
	; Now push in correct order for fseek(stream, offset, whence)
	LD	A,0
	PUSH	AF		; whence = SEEK_SET (use AF as 16-bit 0)
	INC	SP		; Adjust for 1-byte push
	DEC	SP
	LD	HL,0
	PUSH	HL		; whence = 0
	PUSH	BC		; offset high
	PUSH	DE		; offset low
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL		; stream
	CALL	_fseek
	; Clean up stack (5 words = 10 bytes)
	LD	HL,10
	ADD	HL,SP
	LD	SP,HL

	; fseek returns 0 on success, -1 on error
	; HL already has return value

	POP	DE
	POP	BC
	POP	IX
	RET


