	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL
	CALL	_ccosh
	POP	BC
	LD	DE,__cplx_r
	LD	BC,8
	LDIR
	CALL	__cdiv
	LD	DE,_cplx_res
	LD	BC,8
	LDIR
	LD	HL,_cplx_res
	POP	IX
	RET

