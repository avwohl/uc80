	LD	HL,(_atol_acc)
	LD	DE,(_atol_acc+2)

	; Apply sign
	LD	A,C
	OR	A
	JR	Z,_atol_ret

	; Negate DEHL
	PUSH	BC
	LD	BC,0
	LD	A,C
	SUB	L
	LD	L,A
	LD	A,C
	SBC	A,H
	LD	H,A
	LD	A,C
	SBC	A,E
	LD	E,A
	LD	A,C
	SBC	A,D
	LD	D,A
	POP	BC

_atol_ret:
	POP	BC
	POP	IX
	RET


