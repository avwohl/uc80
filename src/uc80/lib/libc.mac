	LD	DE,(_atol_tmp)
	ADD	HL,DE
	LD	(_atol_acc),HL
	LD	HL,(_atol_acc+2)
	LD	DE,(_atol_tmp+2)
	ADC	HL,DE
	LD	(_atol_acc+2),HL

	; Add digit
	POP	AF
	LD	E,A
	LD	D,0
	LD	HL,(_atol_acc)
	ADD	HL,DE
	LD	(_atol_acc),HL
	JR	NC,_atol_noc
