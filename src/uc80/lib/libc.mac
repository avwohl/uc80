@AND_S12_fmod:
	ld	A,(??AUTO_fmod+3)
	and	127
	push	AF
	ld	A,(??AUTO_fmod+2)
	ld	E,A
	pop	AF
	or	E
	push	AF
	ld	A,(??AUTO_fmod+1)
	ld	E,A
	pop	AF
	or	E
	push	AF
	ld	A,(??AUTO_fmod)
	ld	E,A
	pop	AF
	or	E
	or	A
	jr nz,@ENDIF10_fmod
@OR_S11_fmod:
	ld	L,(IX+4)
	ld	H,(IX+5)
	ld	E,(IX+6)
	ld	D,(IX+7)
	jp	@fmod_ret
@ENDIF10_fmod:
	ld	HL,??AUTO_fmod+20
	push	HL
	ld	L,(IX+4)
	ld	H,(IX+5)
	ld	E,(IX+6)
	ld	D,(IX+7)
	push	DE
	push	HL
	call	__m_unpack
	pop	BC
	pop	BC
	pop	BC
	ld	(??AUTO_fmod+12),HL
	ld	(??AUTO_fmod+14),DE
	ld	HL,??AUTO_fmod+22
	push	HL
	ld	L,(IX+8)
	ld	H,(IX+9)
	ld	E,(IX+10)
	ld	D,(IX+11)
	push	DE
	push	HL
	call	__m_unpack
	pop	BC
	pop	BC
	pop	BC
	ld	(??AUTO_fmod+16),HL
	ld	(??AUTO_fmod+18),DE
	ld	HL,(??AUTO_fmod+20)
	ld	DE,(??AUTO_fmod+22)
	ld	A,L
	sub	E
	ld	A,H
	sbc	A,D
	jp	PO,@CMP_NV15_fmod
	xor	128
@CMP_NV15_fmod:
	jp	P,@ENDIF14_fmod
	ld	L,(IX+4)
	ld	H,(IX+5)
	ld	E,(IX+6)
	ld	D,(IX+7)
	jp	@fmod_ret
@ENDIF14_fmod:
@WHILE16_fmod:
	ld	HL,(??AUTO_fmod+20)
	ld	DE,(??AUTO_fmod+22)
	ld	A,E
	sub	L
	ld	A,D
	sbc	A,H
	jp	PO,@CMP_NV18_fmod
	xor	128
@CMP_NV18_fmod:
	jp	P,@ENDWHILE17_fmod
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	ld	BC,(??AUTO_fmod+16)
	or	A
	sbc	HL,BC
	ex	DE,HL
	ld	BC,(??AUTO_fmod+18)
	sbc	HL,BC
	jr c,@ENDIF20_fmod
	ld	HL,(??AUTO_fmod+12)
	ld	BC,(??AUTO_fmod+16)
	or	A
	sbc	HL,BC
	ld	(??AUTO_fmod+12),HL
	ld	HL,(??AUTO_fmod+14)
	ld	BC,(??AUTO_fmod+18)
	sbc	HL,BC
	ld	(??AUTO_fmod+14),HL
@ENDIF20_fmod:
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	add	HL,HL
	rl	E
	rl	D
	ld	(??AUTO_fmod+12),HL
	ld	(??AUTO_fmod+14),DE
	ld	HL,(??AUTO_fmod+20)
	dec	HL
	ld	(??AUTO_fmod+20),HL
	jr @WHILE16_fmod
@ENDWHILE17_fmod:
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	ld	BC,(??AUTO_fmod+16)
	or	A
	sbc	HL,BC
	ex	DE,HL
	ld	BC,(??AUTO_fmod+18)
	sbc	HL,BC
	jr c,@ENDIF22_fmod
	ld	HL,(??AUTO_fmod+12)
	ld	BC,(??AUTO_fmod+16)
	or	A
	sbc	HL,BC
	ld	(??AUTO_fmod+12),HL
	ld	HL,(??AUTO_fmod+14)
	ld	BC,(??AUTO_fmod+18)
	sbc	HL,BC
	ld	(??AUTO_fmod+14),HL
@ENDIF22_fmod:
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	ld	A,H
	or	L
	or	E
	or	D
	jr nz,@ENDIF24_fmod
	ld	HL,(??AUTO_fmod)
	ld	DE,(??AUTO_fmod+2)
	ld	HL,0
	ld	E,0
	ld	A,D
	and	128
	ld	D,A
	ld	(??AUTO_fmod+8),HL
	ld	(??AUTO_fmod+10),DE
	ld	HL,(??AUTO_fmod+8)
	ld	DE,(??AUTO_fmod+10)
	jr @fmod_ret
@ENDIF24_fmod:
@WHILE25_fmod:
	ld	A,(??AUTO_fmod+14)
	and	128
	jr nz,@ENDWHILE26_fmod
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	add	HL,HL
	rl	E
	rl	D
	ld	(??AUTO_fmod+12),HL
	ld	(??AUTO_fmod+14),DE
	ld	HL,(??AUTO_fmod+20)
	dec	HL
	ld	(??AUTO_fmod+20),HL
	jr @WHILE25_fmod
@ENDWHILE26_fmod:
	ld	HL,(??AUTO_fmod+20)
	push	HL
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	push	DE
	push	HL
	ld	A,(??AUTO_fmod+3)
	and	128
	add	A,255
	sbc	A,A
	and	1
	ld	L,A
	ld	H,0
	push	HL
	call	__m_pack
	pop	BC
	pop	BC
	pop	BC
	pop	BC
@fmod_ret:
	pop	IX
	ret


; Implicit external functions

; Static storage that starts as zero
	COMMON	/lc_fmod/
; Shared automatic storage
??AUTO_fmod:
	ds	24


	CSEG
; ============================================================
; lc_fopen.mac
; ============================================================
; lc_fopen.mac - split from lc_file.mac

BDOS_OPEN	EQU	15	; Open file
BDOS_DELETE	EQU	19	; Delete file
BDOS_MAKE	EQU	22	; Make (create) file
FILE_SIZE	EQU	170	; Total FILE structure size
FLAG_READ	EQU	10H
MAX_FILES	EQU	4

	PUBLIC	_parse_fcb

	CSEG

; ============================================================
; FILE *fopen(const char *pathname, const char *mode)
; Open a file for reading or writing
; ============================================================
	PUBLIC	_fopen
_fopen:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Find free file slot
	LD	HL,_file_slots
	LD	B,MAX_FILES
_fopen_find:
	PUSH	HL
	INC	HL		; Point to flags
	LD	A,(HL)
	AND	FLAG_OPEN
	POP	HL
	JR	Z,_fopen_found
	LD	DE,FILE_SIZE
	ADD	HL,DE
	DJNZ	_fopen_find
	; No free slot
	LD	HL,0
	JP	_fopen_ret

_fopen_found:
	; HL = FILE structure, save it
	PUSH	HL

	; Parse mode string
	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = mode
	LD	A,(HL)
	LD	B,0		; B = mode flags
	CP	'r'
	JR	Z,_fopen_read
	CP	'w'
	JR	Z,_fopen_write
	CP	'a'
	JR	Z,_fopen_append
	; Invalid mode
	POP	HL
	LD	HL,0
	JP	_fopen_ret

_fopen_read:
	LD	B,FLAG_READ
	JR	_fopen_setup

_fopen_write:
	LD	B,FLAG_WRITE
	JR	_fopen_setup

_fopen_append:
	LD	B,FLAG_WRITE	; Append = write mode
	; (simplified: append not fully supported)

_fopen_setup:
	; B = mode flags, stack has FILE*
	POP	HL		; HL = FILE*
	PUSH	HL
	PUSH	BC		; Save mode

	; Initialize FILE structure
	LD	A,3		; fd = 3+ for files
	LD	(HL),A
	INC	HL
	XOR	A
	LD	(HL),A		; flags = 0 (will set later)
	INC	HL
	LD	A,0FFH
	LD	(HL),A		; unget = none
	INC	HL
	XOR	A
	LD	(HL),A		; bufpos = 0
	INC	HL
	LD	(HL),A		; bufcnt = 0
	INC	HL
	LD	(HL),A		; reserved = 0
	INC	HL		; HL now at FCB

	; Clear FCB (36 bytes)
	PUSH	HL
	LD	B,36
_fopen_clr:
	LD	(HL),A
	INC	HL
	DJNZ	_fopen_clr
	POP	HL		; HL = FCB start

	; Parse pathname into FCB
	; HL = FCB, pathname at IX+4
	PUSH	HL
	LD	E,(IX+4)
	LD	D,(IX+5)	; DE = pathname
	CALL	_parse_fcb
	POP	HL		; HL = FCB

	; Get FILE* back
	POP	BC		; B = mode flags
	POP	DE		; DE = FILE*
	PUSH	DE
	PUSH	BC

	; Set DMA to FILE's buffer
	PUSH	HL
	LD	HL,FILE_BUFFER-FILE_FCB
	ADD	HL,DE
	EX	DE,HL		; DE = buffer address
	LD	C,BDOS_SETDMA
	CALL	BDOS
	POP	DE		; DE = FCB

	; Open or create based on mode
	POP	BC		; B = mode flags
	POP	HL		; HL = FILE*
	PUSH	HL
	PUSH	BC

	LD	A,B
	AND	FLAG_WRITE
	JR	Z,_fopen_doopen

	; Write mode - delete existing, create new
	PUSH	DE
	LD	C,BDOS_DELETE
	CALL	BDOS
	POP	DE
	LD	C,BDOS_MAKE
	CALL	BDOS
	JR	_fopen_check

_fopen_doopen:
	; Read mode - open existing
	LD	C,BDOS_OPEN
	CALL	BDOS

_fopen_check:
	; A = 0xFF on error
	CP	0FFH
	JR	NZ,_fopen_ok

	; Open failed
	POP	BC
	POP	HL
	LD	HL,0
	JP	_fopen_ret

_fopen_ok:
	; Set flags and return FILE*
	POP	BC		; B = mode flags
	POP	HL		; HL = FILE*
	PUSH	HL
	INC	HL		; Point to flags
	LD	A,B
	OR	FLAG_OPEN
	LD	(HL),A
	POP	HL		; Return FILE*
	JR	_fopen_ret

_fopen_ret:
	POP	DE
	POP	BC
	POP	IX
	RET

; ============================================================
; Internal: Parse pathname into FCB
; DE = pathname, HL = FCB
; ============================================================
_parse_fcb:
	PUSH	BC
	PUSH	HL

	; Check for drive letter
	LD	A,(DE)
	INC	DE
	LD	B,A
	LD	A,(DE)
	CP	':'
	JR	NZ,_parse_nodrive
	; Has drive letter
	LD	A,B
	AND	0DFH		; Uppercase
	SUB	'A'-1		; A=1, B=2, etc.
	LD	(HL),A
	INC	DE		; Skip colon
	JR	_parse_name

_parse_nodrive:
	DEC	DE		; Back up
	XOR	A		; Default drive
	LD	(HL),A

_parse_name:
	INC	HL		; Point to filename
	LD	B,8		; 8 chars max
_parse_name_loop:
	LD	A,(DE)
	OR	A
	JR	Z,_parse_pad_name
	CP	'.'
	JR	Z,_parse_ext
	; Store uppercase (only for a-z, leave digits etc. alone)
	CP	'a'
	JR	C,_parse_name_store
	CP	'z'+1
	JR	NC,_parse_name_store
	AND	0DFH
_parse_name_store:
	LD	(HL),A
	INC	HL
	INC	DE
	DJNZ	_parse_name_loop
	; Skip to dot or end
_parse_skip:
	LD	A,(DE)
	OR	A
	JR	Z,_parse_pad_name
	CP	'.'
	JR	Z,_parse_ext
	INC	DE
	JR	_parse_skip

_parse_pad_name:
	; Pad remaining name with spaces
	LD	A,' '
_parse_pad_n:
	LD	A,B
	OR	A
	JR	Z,_parse_ext_start
	LD	A,' '
	LD	(HL),A
	INC	HL
	DEC	B
	JR	_parse_pad_n

_parse_ext:
	INC	DE		; Skip dot
	; Pad any remaining name chars
	JR	_parse_pad_name

_parse_ext_start:
	; Now at extension position (FCB+9)
	LD	B,3		; 3 chars max
_parse_ext_loop:
	LD	A,(DE)
	OR	A
	JR	Z,_parse_pad_ext
	; Uppercase only a-z
	CP	'a'
	JR	C,_parse_ext_store
	CP	'z'+1
	JR	NC,_parse_ext_store
	AND	0DFH
_parse_ext_store:
	LD	(HL),A
	INC	HL
	INC	DE
	DJNZ	_parse_ext_loop
	JR	_parse_done

_parse_pad_ext:
	LD	A,B
	OR	A
	JR	Z,_parse_done
	LD	A,' '
	LD	(HL),A
	INC	HL
	DEC	B
	JR	_parse_pad_ext

_parse_done:
	POP	HL
	POP	BC
	RET


	COMMON	/lc_fopen/


; File slot storage
_file_slots:	DS	680	; 4 FILE structures * 170 bytes each


	CSEG
; ============================================================
; lc_fpclassify.mac
; ============================================================
; lc_fpclassify.mac - _fpclassify
; Split from lc_fpclassify.mac


	CSEG
; ============================================================
; fpclassify(x) - classify floating-point value
; ============================================================
	PUBLIC	_fpclassify
_fpclassify:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	; Extract exponent
	LD	A,(IX+7)	; D byte (SEEEEEEE)
	AND	7FH		; Strip sign (0EEEEEEE)
	ADD	A,A		; Shift left (EEEEEEE0)
	LD	B,A
	LD	A,(IX+6)	; E byte (EMMMMMMM)
	RLCA			; Rotate - exp low bit into bit 0
	AND	1		; Isolate exp low bit
	OR	B		; A = 8-bit biased exponent

	; exp == 0?
	OR	A
	JR	Z,_fpc_expz

	; exp == 255?
	CP	255
	JR	Z,_fpc_exp255

	; Normal (exp 1..254)
	LD	HL,4		; FP_NORMAL
	POP	IX
	RET

_fpc_expz:
	; Check mantissa
	LD	A,(IX+6)
	AND	7FH
	OR	(IX+5)
	OR	(IX+4)
	JR	NZ,_fpc_sub
	; Zero
	LD	HL,2		; FP_ZERO
	POP	IX
	RET

_fpc_sub:
	LD	HL,3		; FP_SUBNORMAL
	POP	IX
	RET

_fpc_exp255:
	; Check mantissa for NaN vs Inf
	LD	A,(IX+6)
	AND	7FH
	OR	(IX+5)
	OR	(IX+4)
	JR	NZ,_fpc_nan
	; Infinity
	LD	HL,1		; FP_INFINITE
	POP	IX
	RET

_fpc_nan:
	LD	HL,0		; FP_NAN
	POP	IX
	RET


	CSEG
; ============================================================
; lc_fprintf.mac
; ============================================================
; lc_fprintf.mac - fprintf, vfprintf (vprintf and vsprintf are in lc_vprintf.mac and lc_vsprintf.mac).
;
; Each of these carried its own formatter, so a conversion the printf
; table knew about was invisible here.  fprintf had no float handler at
; all -- fprintf(stdout, "%f", 1.5) printed an empty field and desynced
; the rest of the argument list -- and none of the four knew %e, %g or
; %F.  See lc_sprintf.mac for why there is only one formatter now.
;
; A va_list in uc80 is a pointer to the arguments, which is exactly the
; base the engine indexes from, so the v* forms set IX = ap and C = 0 and
; are otherwise identical to their variadic counterparts.


	CSEG

	PUBLIC	_fprintf
	PUBLIC	_vfprintf

; int fprintf(FILE *stream, const char *fmt, ...)
_fprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_fprintf_stream),HL

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,_fprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	C,8			; first vararg at IX+8
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL
	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; int vfprintf(FILE *stream, const char *fmt, va_list ap)
_vfprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_fprintf_stream),HL

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,_fprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	E,(IX+8)
	LD	D,(IX+9)		; DE = va_list
	PUSH	HL
	PUSH	DE
	POP	IX			; IX = ap, the argument base
	POP	HL
	LD	C,0
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL
	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; Sink: character in E, out through fputc so the stream's own buffering
; and its text/binary handling stay in charge.  _printf_putc has already
; saved the registers and counts the byte when we return.
_fprintf_sink:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	D,0			; DE = (int)ch, E already holds it
	LD	HL,(_fprintf_stream)
	PUSH	HL			; stream argument
	PUSH	DE			; char argument
	CALL	_fputc
	POP	DE
	POP	DE
	POP	HL
	POP	DE
	POP	BC
	RET

	COMMON	/lc_fprintf/

_fprintf_stream: DS	2


	CSEG
; ============================================================
; lc_fputc.mac
; ============================================================
; lc_fputc.mac - split from lc_file.mac

BDOS_WRITE	EQU	21	; Write sequential


	PUBLIC	_fflush_internal

	CSEG

; ============================================================
; int fputc(int c, FILE *stream)
; Put character to stream
; ============================================================
	PUBLIC	_fputc
_fputc:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = stream

	; Check for NULL
	LD	A,H
	OR	L
	JP	Z,_fputc_err

	; Check if stdout/stderr
	LD	A,(HL)
	CP	3
	JR	NC,_fputc_file

	; Console output.  Only this branch translates LF -> CR LF; the
	; _fputc_file branch below writes raw bytes, so "w" and "wb"
	; streams both stay byte-for-byte what the program handed us.
	LD	E,(IX+4)
	CALL	__conout
	LD	L,(IX+4)
	LD	H,0
	JP	_fputc_ret

_fputc_file:
	; Check if buffer full
	PUSH	HL
	LD	BC,FILE_BUFPOS
	ADD	HL,BC
	LD	A,(HL)
	CP	128
	JR	C,_fputc_store

	; Buffer full - flush it
	POP	HL
	PUSH	HL
	CALL	_fflush_internal
	; Check for error
	LD	A,H
	OR	L
	JR	NZ,_fputc_flerr
	POP	HL
	PUSH	HL
	LD	BC,FILE_BUFPOS
	ADD	HL,BC

_fputc_store:
	; Store byte in buffer
	LD	A,(HL)		; A = bufpos
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	LD	E,A
	LD	D,0
	ADD	HL,DE		; HL = buffer[bufpos]
	LD	A,(IX+4)
	LD	(HL),A		; Store the byte

	; Increment bufpos
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFPOS
	ADD	HL,DE
	INC	(HL)		; bufpos++

	POP	HL
	LD	L,(IX+4)
	LD	H,0
	JP	_fputc_ret

_fputc_flerr:
	POP	HL
_fputc_err:
	LD	HL,-1
_fputc_ret:
	POP	DE
	POP	BC
	POP	IX
	RET

; ============================================================
; Internal: Flush write buffer
; HL = FILE*
; Returns HL=0 success, HL=-1 error
; ============================================================
_fflush_internal:
	PUSH	BC
	PUSH	DE
	PUSH	HL

	; Check bufpos
	LD	BC,FILE_BUFPOS
	ADD	HL,BC
	LD	A,(HL)
	OR	A
	JR	Z,_fflush_ok	; Nothing to flush

	; Pad rest of buffer with Ctrl-Z (CP/M EOF)
	LD	B,A		; B = bytes written
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	LD	E,B
	LD	D,0
	ADD	HL,DE		; HL = buffer[bufpos]
	LD	A,128
	SUB	B
	LD	B,A		; B = bytes to pad
	JR	Z,_fflush_write
	LD	A,1AH		; Ctrl-Z
_fflush_pad:
	LD	(HL),A
	INC	HL
	DJNZ	_fflush_pad

_fflush_write:
	; Set DMA
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_SETDMA
	CALL	BDOS

	; Write record
	POP	HL
	PUSH	HL
	LD	DE,FILE_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_WRITE
	CALL	BDOS

	OR	A
	JR	NZ,_fflush_err

	; Reset bufpos
	POP	HL
	PUSH	HL
	LD	BC,FILE_BUFPOS
	ADD	HL,BC
	LD	(HL),0

_fflush_ok:
	POP	HL
	LD	HL,0
	POP	DE
	POP	BC
	RET

_fflush_err:
	POP	HL
	PUSH	HL
	INC	HL		; flags
	LD	A,(HL)
	OR	FLAG_ERROR
	LD	(HL),A
	POP	HL
	LD	HL,-1
	POP	DE
	POP	BC
	RET


	CSEG
; ============================================================
; lc_fputs.mac
; ============================================================
; lc_fputs.mac - split from lc_file.mac



	CSEG

; ============================================================
; int fputs(const char *s, FILE *stream)
; Write string to stream
; ============================================================
	PUBLIC	_fputs
_fputs:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+6)
	LD	H,(IX+7)	; stream
	LD	A,H
	OR	L
	JR	Z,_fputs_err

	LD	E,(IX+4)	; string
	LD	D,(IX+5)

_fputs_loop:
	LD	A,(DE)
	OR	A
	JR	Z,_fputs_ok

	PUSH	DE
	PUSH	HL
	; Push args for fputc(char, stream)
	PUSH	HL		; stream
	LD	L,A
	LD	H,0
	PUSH	HL		; char
	CALL	_fputc
	POP	BC
	POP	BC
	POP	HL
	POP	DE

	; Check for error
	LD	A,H
	INC	A
	JR	Z,_fputs_err	; HL was -1

	INC	DE
	JR	_fputs_loop

_fputs_ok:
	LD	HL,0
	POP	DE
	POP	BC
	POP	IX
	RET

_fputs_err:
	LD	HL,-1
	POP	DE
	POP	BC
	POP	IX
	RET


