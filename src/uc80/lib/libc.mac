_scn_int:
	LD	(_scn_base),A
	XOR	A
	LD	(_scn_neg),A
	LD	(_scn_any),A
	LD	HL,_scn_num
	LD	A,(_scn_nb)
	LD	B,A
_scn_i0:
	LD	(HL),0
	INC	HL
	DJNZ	_scn_i0
	LD	HL,(__scn_w)
	LD	A,H
	OR	L
	JR	NZ,_scn_i1
	LD	HL,32767
