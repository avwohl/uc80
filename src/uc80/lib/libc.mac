	INC	HL
	LD	A,(IX+6)	; type
	LD	(HL),A
	INC	HL
	XOR	A
	LD	(HL),A		; owner = 0
	INC	HL
	LD	(HL),A		; count = 0

	LD	HL,0		; thrd_success
	POP	IX
	RET


