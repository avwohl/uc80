; lc_snprintf_run.mac - the part that snprintf and vsnprintf share
;
; C 7.23.6.5: write at most size-1 characters plus a terminating NUL, and
; return the number of characters that WOULD have been written had size
; been big enough.  With size 0 nothing is written, not even the NUL.
; _printf_count counts everything the engine produces, whether the sink
; stores the character or drops it, so the count is the return value.


	CSEG

	PUBLIC	_snprintf_out
	PUBLIC	_snprintf_max
	PUBLIC	_snprintf_run

; Run the engine.  The caller has set _snprintf_out and _snprintf_max.
; HL = format string, IX = the base of the arguments, C = the offset of
; the first argument (the same values as for _printf_engine).
; Returns HL = the count.  Destroys AF, BC, DE and HL.
_snprintf_run:
	LD	DE,(_printf_sink)
	PUSH	DE			; the caller's sink, restored below
	LD	DE,_snprintf_sink
	LD	(_printf_sink),DE

	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL

	; Terminate, unless the caller left no room at all.
	LD	HL,(_snprintf_max)
	LD	A,H
	OR	L
	JR	Z,_snp_noterm
	LD	HL,(_snprintf_out)
	LD	(HL),0
_snp_noterm:
	LD	HL,(_printf_count)
	RET

; Sink: character in E, dropped once the buffer is full.  _printf_putc
; counts it either way, which is what makes the return value right.
_snprintf_sink:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,(_snprintf_max)
	LD	A,H
	OR	L
	JR	Z,_snp_drop		; size 0: not even the NUL fits
	LD	B,H
	LD	C,L
	DEC	BC			; keep one byte back for the NUL
	LD	HL,(_printf_count)	; bytes produced so far
	OR	A
	SBC	HL,BC
	JR	NC,_snp_drop		; already at the limit
	LD	HL,(_snprintf_out)
	LD	(HL),E
	INC	HL
	LD	(_snprintf_out),HL
_snp_drop:
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

	COMMON	/lc_snprintf/

_snprintf_out:	DS	2
_snprintf_max:	DS	2


	CSEG
; ============================================================
; lc_sprintf.mac
; ============================================================
; lc_sprintf.mac - sprintf(): the shared printf engine, writing to a buffer.
;
; This file used to carry a second, independent formatter: its own
; CP/JR-Z chain over the conversion characters, its own width and
; precision handling, its own integer and float printers.  It knew %d %u
; %x %s %c %f and little else, so %e, %g and %F reached printf and no
; other member of the family -- they emitted an empty field and, because
; the miss path was `INC HL / JP _sprintf_loop`, did not advance the
; vararg offset either, so every later conversion in the same call read
; the wrong argument.  That is the bug uc80 set out to fix in printf, and
; four of the five entry points still had it.
;
; There is one formatter now.  lc_printf_core's _printf_engine takes the
; frame, the format string, the offset of the first vararg and a sink
; routine; the entry points below are those four things and nothing else,
; so a conversion added to the table is available to all of them at once.


	CSEG

	PUBLIC	_sprintf
	PUBLIC	_sprintf_sink
	PUBLIC	_sprintf_out

; int sprintf(char *str, const char *fmt, ...)
_sprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; str at IX+4, fmt at IX+6, first vararg at IX+8
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(_sprintf_out),DE

	LD	HL,(_printf_sink)
	PUSH	HL			; the caller's sink, restored below
	LD	HL,_sprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	C,8			; first vararg at IX+8
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL	; restore before anything can print

	LD	HL,(_sprintf_out)
	LD	(HL),0			; NUL terminate

	LD	HL,(_printf_count)	; C 7.21.6.6: bytes written, sans NUL
	POP	DE
	POP	BC
	POP	IX
	RET

; Sink: the character is in E.  _printf_putc has already saved every
; register and counts the byte itself once we return.
_sprintf_sink:
	PUSH	HL
	LD	HL,(_sprintf_out)
	LD	(HL),E
	INC	HL
	LD	(_sprintf_out),HL
	POP	HL
	RET

	COMMON	/lc_sprintf/

_sprintf_out:	DS	2	; next byte of the caller's buffer


	CSEG
; ============================================================
; lc_sqrt.mac
; ============================================================
; lc_sqrt.mac - sqrt, sqrtf, sqrtl
;
; Correctly rounded square root with integer arithmetic.  The mantissa M
; (24 bits) becomes the 56-bit number N = M * 2^32 or M * 2^31, whichever
; makes the exponent of the root a whole number.  The digit-by-digit method
; takes 28 bits of the root of N, two bits of N in each of 28 steps:
;   R = R * 4 + the next two bits of N
;   if R >= 4 * Q + 1 then R = R - (4 * Q + 1), Q = 2 * Q + 1, else Q = 2 * Q
; The loop keeps X = 4 * Q in memory.  The mantissa of the result is Q
; rounded at 4 bits: (Q + 8) >> 4.  A tie cannot happen, so the 4 low bits
; of Q are enough.
;
; __vm_sqrt is the routine of the float interpreter (see lc_vm.mac): DEHL = x,
; the result is in DEHL.  It keeps BC and IX.

	CSEG

	PUBLIC	__vm_sqrt
	PUBLIC	_sqrt
	PUBLIC	_sqrtf
	PUBLIC	_sqrtl

__vm_sqrt:
	PUSH	BC
	CALL	_sq_core
	POP	BC
	RET

; double sqrt(double x)
_sqrt:
_sqrtf:
_sqrtl:
	LD	HL,2
	ADD	HL,SP
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = x

; DEHL = x.  Result in DEHL.  Changes AF and BC.
_sq_core:
	LD	A,E
	RLA
	LD	A,D
	RLA			; A = the exponent field, carry = the sign
	JR	C,_sq_neg
	CP	255
	RET	Z		; +inf or a NaN
	OR	A
	JR	NZ,_sq_n
	LD	A,E		; exponent 0: +0 or a subnormal number
	OR	H
	OR	L
	RET	Z
	LD	B,0		; B = the number of shifts
_sq_nl:
	ADD	HL,HL
	RL	E
	INC	B
	BIT	7,E
	JR	Z,_sq_nl
	LD	A,128
	SUB	B
	SRL	A		; the exponent of the root; the carry is 1 when
	JR	_sq_go		; the exponent of x is even
_sq_n:
	SET	7,E		; the implicit bit
	ADD	A,127
	RRA			; (e + 127) / 2; the carry is 1 when e is even
_sq_go:
	PUSH	AF
	PUSH	IX
	LD	D,E		; D:E:H:L = M * 2^8
	LD	E,H
	LD	H,L
	LD	L,0
	JR	C,_sq_c
	SRL	D		; M * 2^7
	RR	E
	RR	H
	RR	L
_sq_c:
	XOR	A
	PUSH	AF		; the bytes of N, the last first
	PUSH	AF
	PUSH	AF
	LD	A,L
	PUSH	AF
	LD	A,H
	PUSH	AF
	LD	A,E
	PUSH	AF
	LD	A,D
	PUSH	AF
	LD	IX,_sq_x
	LD	HL,0
	LD	(_sq_x),HL
	LD	(_sq_x+2),HL
	LD	D,H
	LD	E,L		; R = 0
	LD	(IX+4),7
_sq_outer:
	POP	AF		; A = the next byte of N
	LD	(IX+5),4
_sq_inner:
	RLCA			; R = R * 4 + the next two bits
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	RLCA
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	PUSH	HL
	PUSH	DE
	LD	BC,(_sq_x)
	SCF
	SBC	HL,BC		; R - X - 1
	EX	DE,HL
	LD	BC,(_sq_x+2)
	SBC	HL,BC
	EX	DE,HL
	JR	C,_sq_no
	POP	BC		; R >= X + 1: keep the difference
	POP	BC
	CALL	_sq_shx
	SET	2,(IX+0)	; X = X * 2 + 4
	JR	_sq_next
_sq_no:
	POP	DE
	POP	HL
	CALL	_sq_shx
_sq_next:
	DEC	(IX+5)
	JR	NZ,_sq_inner
	DEC	(IX+4)
	JR	NZ,_sq_outer
	; the mantissa is (X + 32) >> 6
	LD	HL,(_sq_x)
	LD	DE,(_sq_x+2)
	LD	BC,32
	ADD	HL,BC
	JR	NC,_sq_f1
	INC	DE
_sq_f1:
	LD	B,6
_sq_f2:
	SRL	D
	RR	E
	RR	H
	RR	L
	DJNZ	_sq_f2
	POP	IX
	POP	AF		; A = the exponent of the root
	LD	B,A
	LD	A,D
	OR	A
	LD	A,B
	JR	Z,_sq_p
	INC	A		; the mantissa carried to 2^24
	LD	E,80H
_sq_p:
	SRL	A
	LD	D,A
	RET	C
	RES	7,E
	RET

; X = X * 2
_sq_shx:
	SLA	(IX+0)
	RL	(IX+1)
	RL	(IX+2)
	RL	(IX+3)
	RET

; the sign bit is set: -0 is the result for -0, a NaN for a NaN, else a NaN
_sq_neg:
	CP	255
	JR	NZ,_sq_n2
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	RET	NZ		; a NaN
	JR	_sq_nan		; -inf
_sq_n2:
	OR	A
	JR	NZ,_sq_nan
	LD	A,E
	OR	H
	OR	L
	RET	Z		; -0
_sq_nan:
	LD	DE,7FC0H
	LD	HL,0
	RET

	COMMON	/lc_sqrt/
_sq_x:
	DS	6


	CSEG
; ============================================================
; lc_srand.mac
; ============================================================
; lc_srand.mac - split from lc_stdlib.mac



	CSEG

; ============================================================
; void srand(unsigned int seed)
; Initialize random seed
; ============================================================
	PUBLIC	_srand
_srand:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_rand_seed),HL
	POP	IX
	RET


	CSEG
; ============================================================
; lc_sscanf.mac
; ============================================================
; lc_sscanf.mac - GENERATED from csrc/lc_sscanf.c by gen_c_modules.py
; Do not edit this file: edit the C file and run the script.
; Target: Z80
; Generated by uc80


	CSEG

	PUBLIC	_sscanf

; Function sscanf
_sscanf:
