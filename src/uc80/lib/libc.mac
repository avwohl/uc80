; ============================================================
; lc_fflush_int.mac
; ============================================================
; lc_fflush_int.mac - _fflush_internal: write the record in the buffer

BDOS_WRITE	EQU	34	; Write random (the record number is in the FCB, r0 r1)
BDOS_SETDMA	EQU	26	; Set DMA address
FILE_BUFPOS	EQU	3	; Current position in buffer
FILE_BUFFER	EQU	42	; Buffer starts here (128 bytes)

	CSEG

; ============================================================
; Internal: Flush write buffer
; HL = FILE*
; Returns HL=0 success, HL=-1 error
;
; Writes the record in the buffer (record number r0 r1 of the FCB), padded
; with Ctrl-Z after the valid bytes.  It does not move on to the next
; record, so more output after an fflush goes into the same record and no
; Ctrl-Z stays in the middle of the file.  It writes only when a fputc
; changed the buffer since the last write (flag bit 7), so a record that
; fseek loaded and nobody changed is not written back.
; ============================================================
	PUBLIC	_fflush_internal
_fflush_internal:
	PUSH	BC
	PUSH	DE
	PUSH	HL

	INC	HL
	BIT	7,(HL)		; changed since the last write?
	DEC	HL
	JR	Z,_fflush_ok

	; A = valid bytes = the larger of bufpos and bufcnt
	LD	BC,FILE_BUFPOS
	ADD	HL,BC
	LD	A,(HL)
	INC	HL
	CP	(HL)
	JR	NC,_fflush_v
	LD	A,(HL)
_fflush_v:
	OR	A
	JR	Z,_fflush_ok	; Nothing to flush

	; Pad rest of buffer with Ctrl-Z (CP/M EOF)
	LD	B,A		; B = valid bytes
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	LD	E,B
	LD	D,0
	ADD	HL,DE		; HL = buffer[valid]
	LD	A,128
	SUB	B
	LD	B,A		; B = bytes to pad
	JR	Z,_fflush_write
	LD	A,1AH		; Ctrl-Z
_fflush_pad:
	LD	(HL),A
	INC	HL
	DJNZ	_fflush_pad

_fflush_write:
	; Set DMA
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_SETDMA
	CALL	BDOS

	; Write record
	POP	HL
	PUSH	HL
	LD	DE,FILE_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_WRITE
	CALL	BDOS

	OR	A
	JR	NZ,_fflush_err

_fflush_ok:
	POP	HL
	INC	HL
	RES	7,(HL)		; the buffer matches the file
	LD	HL,0
	POP	DE
	POP	BC
	RET

_fflush_err:
	POP	HL
	PUSH	HL
	INC	HL		; flags
	LD	A,(HL)
	OR	FLAG_ERROR
	LD	(HL),A
	POP	HL
	LD	HL,-1
	POP	DE
	POP	BC
	RET


	CSEG
; ============================================================
; lc_fgetc.mac
; ============================================================
; lc_fgetc.mac - split from lc_file.mac

BDOS_READ	EQU	33	; Read random (the record number is in the FCB, r0 r1)
FILE_RECNO	EQU	39	; r0 r1 of the FCB: the number of the next record


