	INC	HL
	LD	A,(HL)
	AND	FLAG_WRITE
	DEC	HL
	JR	Z,_fflush_done_pub

	CALL	_fflush_internal
	POP	DE
	POP	BC
	POP	IX
	RET

_fflush_done_pub:
	LD	HL,0
	POP	DE
	POP	BC
	POP	IX
	RET


