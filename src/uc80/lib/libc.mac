; ============================================================
; lc_malloc.mac
; ============================================================
; lc_malloc.mac - split from lc_malloc.mac


	EXTRN	__END__

	PUBLIC	__malloc_de

	CSEG

; ============================================================
; Allocator: first fit over a free list kept sorted by address.
;
; Every block, free or in use, starts with a 2-byte header holding the
; payload size.  The pointer malloc returns is the payload.  A free
; block keeps the address of the next free block in the first two bytes
; of its payload (so the smallest payload is 2 bytes).
;
;   block:  [size lo][size hi][payload ...]
;   free:   [size lo][size hi][next lo][next hi] ...
;
; malloc: take the first free block that fits.  If it leaves at least 4
; bytes over, the request is carved from the END of that block (the free
; block only shrinks, so the list needs no repair); otherwise the whole
; block is taken.  With no fit the heap grows upwards from __END__
; (ul80 defines it: the first free byte after the program, BSS
; included) until it comes within 255 bytes of the stack pointer.
; free: insert into the list in address order and merge with the free
; neighbours on either side.
; ============================================================
	PUBLIC	_malloc
_malloc:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	E,(IX+4)
	LD	D,(IX+5)	; DE = size
	CALL	__malloc_de
	POP	IX
	RET

; Allocate DE bytes.  Returns HL = payload or 0.  Clobbers AF, BC, DE, IX.
__malloc_de:
	LD	A,D
	OR	A
	JR	NZ,_mde_sized
	LD	A,E
	CP	2
	JR	NC,_mde_sized
	LD	DE,2		; smallest payload holds the free-list link
_mde_sized:
	LD	HL,(_heap_ptr)
	LD	A,H
	OR	L
	JR	NZ,_mde_init
	LD	HL,__END__
	LD	(_heap_ptr),HL
_mde_init:
	LD	BC,_free_head	; BC = address of the link that points at HL
	LD	HL,(_free_head)
_mde_scan:
	LD	A,H
	OR	L
	JR	Z,_mde_grow
	PUSH	HL
	POP	IX		; IX = candidate block
	LD	L,(IX+0)
	LD	H,(IX+1)	; HL = its size
	OR	A
	SBC	HL,DE		; HL = size - request
	JR	C,_mde_next
	LD	A,H
	OR	A
	JR	NZ,_mde_split
	LD	A,L
	CP	4
	JR	C,_mde_whole
_mde_split:
	DEC	HL
	DEC	HL		; HL = size of what is left free
	LD	(IX+0),L
	LD	(IX+1),H
	PUSH	IX
	POP	BC
	ADD	HL,BC
	INC	HL
	INC	HL		; HL = header of the new block, at the end
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL		; HL = payload
	RET
_mde_whole:
	LD	L,(IX+2)
	LD	H,(IX+3)	; HL = next free block
	LD	A,L
	LD	(BC),A		; unlink the candidate
	INC	BC
	LD	A,H
	LD	(BC),A
	PUSH	IX
	POP	HL
	INC	HL
	INC	HL		; HL = payload
	RET
_mde_next:
	PUSH	IX
	POP	BC
	INC	BC
	INC	BC		; BC = &candidate.next
	LD	L,(IX+2)
	LD	H,(IX+3)
	JR	_mde_scan

_mde_grow:
	LD	HL,(_heap_ptr)
	PUSH	HL		; header of the new block
	INC	HL
	INC	HL
	ADD	HL,DE		; HL = new top of heap
	JR	C,_mde_oom
	LD	B,H
	LD	C,L		; BC = new top
	LD	HL,0
	ADD	HL,SP
	PUSH	DE
	LD	DE,255
	OR	A
	SBC	HL,DE		; HL = SP - 255
	POP	DE
	OR	A
	SBC	HL,BC		; carry if the new top is above SP - 255
	JR	C,_mde_oom
	LD	(_heap_ptr),BC
	POP	HL
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL		; HL = payload
	RET
_mde_oom:
	POP	HL
	LD	HL,0
	RET


	COMMON	/lc_malloc/

_heap_ptr:	DS	2


