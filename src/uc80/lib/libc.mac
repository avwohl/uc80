; ============================================================
; lc_exit.mac
; ============================================================
; lc_exit.mac - exit, and the code that runs when main returns


	CSEG

; ============================================================
; void exit(int status)
; Calls the atexit handlers, last registered first, closes the open
; files and returns to CP/M.  CP/M 2.2 has no exit status, so the
; argument is not used.
;
; __exit_run is the same code.  crt0 jumps to it when main returns, through
; the word __exit_hook that atexit() and fopen() set (see crt0.mac).
; ============================================================
	PUBLIC	_exit
	PUBLIC	__exit_run
_exit:
__exit_run:
	; A handler can register another handler, so read the count again
	; for each handler.
	LD	A,(_atexit_cnt)
	OR	A
	JR	Z,_exit_files
	DEC	A
	LD	(_atexit_cnt),A
	LD	L,A
	LD	H,0
	ADD	HL,HL
	LD	DE,_atexit_tab
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = handler address
	LD	HL,__exit_run	; the handler returns to the start of the loop
	PUSH	HL
	PUSH	DE
	RET			; "call" the handler

_exit_files:
	LD	HL,(__exit_fhook)
	LD	A,H
	OR	L
	JR	Z,_exit_done
	LD	DE,_exit_done
	PUSH	DE
	JP	(HL)		; close the open files, then return to _exit_done
_exit_done:
	; Return to CP/M (warm boot)
	JP	0


	CSEG
; ============================================================
; lc_exit_data.mac
; ============================================================
; lc_exit_data.mac - split from lc_stdlib.mac


	PUBLIC	_atexit_cnt
	PUBLIC	_atexit_tab
	PUBLIC	__exit_fhook


	COMMON	/lc_exit_data/


; atexit handler table (32 handlers, the minimum that C 7.24.4.3 requires)
_atexit_cnt:	DS	1	; Number of registered handlers
_atexit_tab:	DS	64	; 32 function pointers (2 bytes each)
; Address of the routine that closes the open files, or 0.  fopen sets it.
__exit_fhook:	DS	2


	CSEG
; ============================================================
; lc_exit_hook.mac
; ============================================================
; lc_exit_hook.mac - the word that crt0 jumps through when main returns
;
; 0 until atexit() or fopen() puts the address of __exit_run (lc_exit.mac) in
; the word.  crt0 does LD HL,(__exit_hook) and JP (HL); a jump to address 0 is
; the warm boot.  The word is in BSS, so the program image does not hold it.

	PUBLIC	__exit_hook

	COMMON	/lc_exit_hook/

__exit_hook:	DS	2


	CSEG
; ============================================================
; lc_exit_now.mac
; ============================================================
; lc_exit_now.mac - _Exit

	CSEG

; ============================================================
; void _Exit(int status)
; Returns to CP/M at once (warm boot).  It runs no atexit function, closes
; no file and writes no buffer.  CP/M 2.2 has no exit status.
; ============================================================
	PUBLIC	__Exit
__Exit:
	JP	0


