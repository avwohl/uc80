; ============================================================
; int fgetc(FILE *stream)
; Get character from stream
; ============================================================
	PUBLIC	_fgetc
_fgetc:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = stream

	; Check for NULL
	LD	A,H
	OR	L
	JP	Z,_fgetc_eof

	; Check if stdin
	LD	A,(HL)
	OR	A
	JR	NZ,_fgetc_file

	; stdin - read from console
	LD	C,CONIN
	CALL	BDOS
	LD	L,A
	LD	H,0
	JP	_fgetc_ret

_fgetc_file:
	; A stream in the writing state (w+, a+, r+ after a write) goes to the
	; reading state first; a stream that cannot read fails here.
	INC	HL
	BIT	3,(HL)
	DEC	HL
	JR	Z,_fgetc_rdy
	PUSH	HL
	CALL	_file_toread
	POP	HL
	JR	NZ,_fgetc_eof
_fgetc_rdy:
	; Check for ungetc char first
	PUSH	HL
	INC	HL
	INC	HL		; unget
	LD	A,(HL)
	CP	0FFH
	JR	Z,_fgetc_nobuf
	; Return unget char
	LD	B,A
	LD	A,0FFH
	LD	(HL),A		; Clear unget
	POP	HL
	LD	L,B
	LD	H,0
	JP	_fgetc_ret

_fgetc_nobuf:
	POP	HL

	; Check EOF flag
	PUSH	HL
	INC	HL		; flags
	LD	A,(HL)
	AND	FLAG_EOF
	JR	NZ,_fgetc_iseof

	; Check if buffer has data
	INC	HL		; unget
	INC	HL		; bufpos
	LD	B,(HL)
	INC	HL		; bufcnt
	LD	A,(HL)
	CP	B		; bufcnt > bufpos?
	JR	Z,_fgetc_refill
	JR	C,_fgetc_refill

	; Get byte from buffer
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE		; HL = buffer start
	LD	E,B
	LD	D,0
	ADD	HL,DE		; HL = buffer[bufpos]
	LD	A,(HL)
	; Check for Ctrl-Z (CP/M EOF marker)
	CP	1AH
	JR	Z,_fgetc_seteof
	LD	E,A		; Save char

	; Increment bufpos
	POP	HL
	PUSH	HL
	LD	BC,FILE_BUFPOS
	ADD	HL,BC
	INC	(HL)

	; Skip CR characters for Unix text compatibility
	LD	A,E
	CP	0DH
	JP	Z,_fgetc_nobuf	; Skip CR, get next char

	POP	HL
	LD	L,E
	LD	H,0
	JP	_fgetc_ret

_fgetc_refill:
	; Need to read more data
	POP	HL
	PUSH	HL

	; Set DMA to buffer
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_SETDMA
	CALL	BDOS

	; Read record
	POP	HL
	PUSH	HL
	LD	DE,FILE_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_READ
	CALL	BDOS

	; A = 0 success, non-zero = EOF/error
	OR	A
	JR	NZ,_fgetc_seteof

	; The next refill reads the next record
	POP	HL
	PUSH	HL
	LD	DE,FILE_RECNO
	ADD	HL,DE
	INC	(HL)
	JR	NZ,_fgetc_rec
	INC	HL
	INC	(HL)
_fgetc_rec:

	; Reset buffer position, set count
	POP	HL
	PUSH	HL
	LD	BC,FILE_BUFPOS
	ADD	HL,BC
	LD	(HL),0		; bufpos = 0
	INC	HL
	LD	(HL),128	; bufcnt = 128

	; Get first byte
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	LD	A,(HL)
	; Check for Ctrl-Z (CP/M EOF marker)
	CP	1AH
	JR	Z,_fgetc_seteof
	LD	E,A

	; Increment bufpos
	POP	HL
	PUSH	HL
	LD	BC,FILE_BUFPOS
	ADD	HL,BC
	INC	(HL)

	; Skip CR characters for Unix text compatibility
	LD	A,E
	CP	0DH
	JP	Z,_fgetc_nobuf	; Skip CR, get next char

	POP	HL
	LD	L,E
	LD	H,0
	JP	_fgetc_ret

_fgetc_seteof:
	POP	HL
	PUSH	HL
	INC	HL		; flags
	LD	A,(HL)
	OR	FLAG_EOF
	LD	(HL),A
_fgetc_iseof:
	POP	HL
_fgetc_eof:
	LD	HL,-1
_fgetc_ret:
	POP	DE
	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_fgetpos.mac
; ============================================================
; lc_fgetpos.mac - split from lc_file.mac



	CSEG

; ============================================================
; int fgetpos(FILE *stream, fpos_t *pos)
; Get current file position
; Returns 0 on success, non-zero on error
; ============================================================
	PUBLIC	_fgetpos
_fgetpos:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Call ftell to get position
	LD	L,(IX+4)
	LD	H,(IX+5)	; stream
	PUSH	HL
	CALL	_ftell
	POP	BC
	; DEHL = position (long)

	; Check for error (returns -1 as 0xFFFFFFFF)
	LD	A,D
	AND	E
	AND	H
	AND	L
	INC	A
	JR	Z,_fgetpos_err

	; Store position at *pos
	LD	C,(IX+6)
	LD	B,(IX+7)	; BC = pos pointer
	LD	A,L
	LD	(BC),A
	INC	BC
	LD	A,H
	LD	(BC),A
	INC	BC
	LD	A,E
	LD	(BC),A
	INC	BC
	LD	A,D
	LD	(BC),A

	LD	HL,0		; Return success
	JR	_fgetpos_ret

_fgetpos_err:
	LD	HL,-1
_fgetpos_ret:
	POP	DE
	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_fgets.mac
; ============================================================
; lc_fgets.mac - split from lc_file.mac



	CSEG

; ============================================================
; char *fgets(char *s, int size, FILE *stream)
; Read line from stream
; ============================================================
	PUBLIC	_fgets
_fgets:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+8)
	LD	H,(IX+9)	; stream
	LD	A,H
	OR	L
	JR	Z,_fgets_null

	LD	E,(IX+4)	; buffer
	LD	D,(IX+5)
	LD	C,(IX+6)	; size
	LD	B,(IX+7)
	PUSH	DE		; Save for return

	DEC	BC		; Leave room for null
	LD	A,B
	OR	C
	JR	Z,_fgets_term

_fgets_loop:
	PUSH	BC
	PUSH	DE
	PUSH	HL		; Save stream
	PUSH	HL		; Pass stream as arg
	CALL	_fgetc
	POP	BC		; Discard arg
	; HL = fgetc return value, save it
	LD	A,H		; Check high byte first
	LD	B,L		; B = character (save before POP)
	POP	HL		; Restore stream to HL
	OR	A
	JR	NZ,_fgets_eof	; EOF if H != 0 (return was 0xFFxx)
	LD	A,B		; A = character
	POP	DE		; Restore dest pointer
	POP	BC		; Restore count

	LD	(DE),A
	INC	DE
	DEC	BC

	CP	0AH		; LF?
	JR	Z,_fgets_term
	CP	0DH		; CR?
	JR	Z,_fgets_term

	LD	A,B
	OR	C
	JR	NZ,_fgets_loop

_fgets_term:
	XOR	A
	LD	(DE),A
	POP	HL		; Return buffer
	POP	DE
	POP	BC
	POP	IX
	RET

_fgets_eof:
	; Stack has: [BC_count][DE_dest]
	; HL = stream (just restored)
	POP	DE		; Restore dest pointer
	POP	BC		; Restore count
	; Check if we read anything
	LD	A,(IX+4)
	CP	E
	JR	NZ,_fgets_term	; Got some data
	LD	A,(IX+5)
	CP	D
	JR	NZ,_fgets_term
	; No data read - return NULL
	; Pop saved buffer before going to _fgets_null
	POP	DE
_fgets_null:
	LD	HL,0
	POP	DE
	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_floadrec.mac
; ============================================================
; lc_floadrec.mac - read a record into the buffer of a file stream
;
; The two states of a file stream are described in lc_ftowrite.mac.

BDOS_READR	EQU	33	; Read random
BDOS_SIZE	EQU	35	; Compute file size

; offsets from the start of the FILE (the register IX holds it)
F_FLAGS		EQU	1
F_UNGET		EQU	2
F_BUFPOS	EQU	3
F_BUFCNT	EQU	4
F_FCB		EQU	6
F_R0		EQU	39
F_R1		EQU	40
F_R2		EQU	41
F_BUFFER	EQU	42


	CSEG

; ============================================================
; Internal: _file_loadrec.  HL = FILE*.  Read the record r0 r1 into the
; buffer.  bufcnt becomes 128 when the record exists, and 0 when it does
; not (then the file ends before it).  Returns Z when the record was read.
; ============================================================
	PUBLIC	_file_loadrec
_file_loadrec:
	PUSH	HL
	LD	DE,F_BUFFER
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_SETDMA
	CALL	BDOS
	POP	HL
	PUSH	HL
	LD	DE,F_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_READR
	CALL	BDOS
	POP	HL
	OR	A
	LD	DE,F_BUFCNT
	ADD	HL,DE
	JR	NZ,_flr_none
	LD	(HL),128
	RET
_flr_none:
	LD	(HL),0
	RET


	CSEG
