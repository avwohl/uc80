	.Z80

; CP/M BDOS function numbers
BDOS	EQU	5		; BDOS entry point
CONOUT	EQU	2		; Console output (char in E)
CONIN	EQU	1		; Console input (char returned in A)
PRTSTR	EQU	9		; Print string (address in DE, '$' terminated)

	CSEG

	CSEG
; ============================================================
; lc_abort.mac
; ============================================================
; lc_abort.mac - split from lc_stdlib.mac


	CSEG

; ============================================================
; void abort(void)
; Abnormal program termination
; ============================================================
	PUBLIC	_abort
_abort:
	; Print abort message
	LD	DE,_abort_msg
	LD	C,PRTSTR
	CALL	BDOS
	; Exit
	JP	0


	DSEG


; abort message
_abort_msg:	DB	'Aborted',0DH,0AH,'$'


	CSEG
; ============================================================
; lc_abs.mac
; ============================================================
; lc_abs.mac - split from lc_stdlib.mac


	CSEG

; ============================================================
; int abs(int n)
; Return absolute value
; ============================================================
	PUBLIC	_abs
_abs:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	BIT	7,H
	JR	Z,_abs_done
	; Negate
	LD	DE,0
	EX	DE,HL
	OR	A
	SBC	HL,DE
_abs_done:
	POP	IX
	RET


