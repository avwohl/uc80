	DJNZ	_mtx_timed_loop

	; Timeout
	LD	HL,2		; thrd_timedout
	JR	_mtx_timed_ret

_mtx_timed_ok:
	LD	HL,0		; thrd_success

_mtx_timed_ret:
	POP	BC
	POP	IX
