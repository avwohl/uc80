; ============================================================
; lc_fgetpos.mac
; ============================================================
; lc_fgetpos.mac - split from lc_file.mac



	CSEG

; ============================================================
; int fgetpos(FILE *stream, fpos_t *pos)
; Get current file position
; Returns 0 on success, non-zero on error
; ============================================================
	PUBLIC	_fgetpos
_fgetpos:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Call ftell to get position
	LD	L,(IX+4)
	LD	H,(IX+5)	; stream
	PUSH	HL
	CALL	_ftell
	POP	BC
	; DEHL = position (long)

	; Check for error (returns -1 as 0xFFFFFFFF)
	LD	A,D
	AND	E
	AND	H
	AND	L
	INC	A
	JR	Z,_fgetpos_err

	; Store position at *pos
	LD	C,(IX+6)
	LD	B,(IX+7)	; BC = pos pointer
	LD	A,L
	LD	(BC),A
	INC	BC
	LD	A,H
	LD	(BC),A
	INC	BC
	LD	A,E
	LD	(BC),A
	INC	BC
	LD	A,D
	LD	(BC),A

	LD	HL,0		; Return success
	JR	_fgetpos_ret

_fgetpos_err:
	LD	HL,-1
_fgetpos_ret:
	POP	DE
	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_fgets.mac
; ============================================================
; lc_fgets.mac - split from lc_file.mac



	CSEG

; ============================================================
; char *fgets(char *s, int size, FILE *stream)
; Read line from stream
; ============================================================
	PUBLIC	_fgets
_fgets:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+8)
	LD	H,(IX+9)	; stream
	LD	A,H
	OR	L
	JR	Z,_fgets_null

	LD	E,(IX+4)	; buffer
	LD	D,(IX+5)
	LD	C,(IX+6)	; size
	LD	B,(IX+7)
	PUSH	DE		; Save for return

	DEC	BC		; Leave room for null
	LD	A,B
	OR	C
	JR	Z,_fgets_term

_fgets_loop:
	PUSH	BC
	PUSH	DE
	PUSH	HL		; Save stream
	PUSH	HL		; Pass stream as arg
	CALL	_fgetc
	POP	BC		; Discard arg
	; HL = fgetc return value, save it
	LD	A,H		; Check high byte first
	LD	B,L		; B = character (save before POP)
	POP	HL		; Restore stream to HL
	OR	A
	JR	NZ,_fgets_eof	; EOF if H != 0 (return was 0xFFxx)
	LD	A,B		; A = character
	POP	DE		; Restore dest pointer
	POP	BC		; Restore count

	LD	(DE),A
	INC	DE
	DEC	BC

	CP	0AH		; LF?
	JR	Z,_fgets_term
