; ============================================================
; lc_assert.mac
; ============================================================
; lc_assert.mac - assert support




	CSEG

; ============================================================
; void _assert_fail(const char *file, int line)
; Called when an assertion fails
; Prints message and exits
; ============================================================
	PUBLIC	__assert_fail
__assert_fail:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	; Print "Assert: "
	LD	HL,_assert_msg
	CALL	_assert_puts

	; Print filename
	LD	L,(IX+4)
	LD	H,(IX+5)
	CALL	_assert_puts

	; Print ":"
	LD	E,':'
	CALL	__conout

	; Print line number
	LD	L,(IX+6)
	LD	H,(IX+7)
	CALL	_assert_prt_dec

	; Print newline (__conout supplies the CR when ___crlf_mode is set)
	LD	E,0AH
	CALL	__conout

	; Exit
	JP	0

; Internal: print string at HL
_assert_puts:
	LD	A,(HL)
	OR	A
	RET	Z
	LD	E,A
	CALL	__conout	; preserves HL
	INC	HL
	JR	_assert_puts

; Internal: print HL as decimal
_assert_prt_dec:
	PUSH	BC
	PUSH	DE
	LD	DE,10
	LD	B,0
_assert_dec_loop:
	CALL	_assert_div
	PUSH	DE
	INC	B
	LD	A,H
	OR	L
	JR	NZ,_assert_dec_loop
_assert_dec_out:
	POP	DE
	LD	A,E
	ADD	A,'0'
	LD	E,A
	PUSH	BC
	CALL	__conout
	POP	BC
	DJNZ	_assert_dec_out
	POP	DE
	POP	BC
	RET

; Simple division: HL = HL / 10, DE = HL % 10
_assert_div:
	PUSH	BC
	LD	BC,0
_assert_div_lp:
	LD	A,H
	OR	A
	JR	NZ,_assert_div_sub
	LD	A,L
	CP	10
	JR	C,_assert_div_dn
_assert_div_sub:
	LD	A,L
	SUB	10
	LD	L,A
	LD	A,H
	SBC	A,0
	LD	H,A
	INC	BC
	JR	_assert_div_lp
_assert_div_dn:
	LD	E,L
	LD	D,0
	LD	H,B
	LD	L,C
	POP	BC
	RET

	DSEG

_assert_msg:	DB	'Assert: ',0


	CSEG
