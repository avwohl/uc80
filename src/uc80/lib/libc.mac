	LD	D,(IX+5)
	LD	(_snprintf_out),DE
	LD	E,(IX+6)
	LD	D,(IX+7)
	LD	(_snprintf_max),DE

	LD	L,(IX+8)
	LD	H,(IX+9)		; HL = format string
	LD	C,10			; first vararg at IX+10
	CALL	_snprintf_run

	POP	DE
	POP	BC
	POP	IX
	RET


