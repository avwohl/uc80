; ============================================================
; lc_printf_all.mac
; ============================================================
; lc_printf_all.mac - default printf format table (all handlers)
; This module provides the full __printf_format_table when no
; #pragma printf is specified. It references all format handlers
; so the linker pulls them all in.




	CSEG

	PUBLIC	__printf_format_table
__printf_format_table:
	DB	'd'
	DW	__printf_handle_d
	DB	'i'
	DW	__printf_handle_d	; %i same as %d
	DB	'u'
	DW	__printf_handle_u
	DB	'o'
	DW	__printf_handle_o
	DB	'x'
	DW	__printf_handle_x
	DB	'X'
	DW	__printf_handle_xu
	DB	's'
	DW	__printf_handle_s
	DB	'c'
	DW	__printf_handle_c
	DB	'p'
	DW	__printf_handle_p
	DB	'l'
	DW	__printf_handle_l
	DB	'f'
	DW	__printf_handle_f
	DB	'F'
	DW	__printf_handle_f	; %F same as %f
	DB	'e'
	DW	__printf_handle_e
	DB	'E'
	DW	__printf_handle_eu
	DB	'g'
	DW	__printf_handle_g
	DB	'G'
	DW	__printf_handle_gu
	DB	0		; sentinel

	PUBLIC	__printf_long_table
__printf_long_table:
	DB	'd'
	DW	__printf_handle_ld
	DB	'i'
	DW	__printf_handle_ld	; %li same as %ld
	DB	'u'
	DW	__printf_handle_lu
	DB	'o'
	DW	__printf_handle_lo
	DB	'x'
	DW	__printf_handle_lx
	DB	'f'
	DW	__printf_handle_f	; %lf same as %f
	DB	'e'
	DW	__printf_handle_e	; %le same as %e
	DB	'E'
	DW	__printf_handle_eu
	DB	'g'
	DW	__printf_handle_g	; %lg same as %g
	DB	'G'
	DW	__printf_handle_gu
	DB	'l'
	DW	__printf_ll_entry
	DB	0		; sentinel

	PUBLIC	__printf_ll_table
__printf_ll_table:
	DB	'd'
	DW	__printf_handle_lld
	DB	'i'
	DW	__printf_handle_lld
	DB	'u'
	DW	__printf_handle_llu
	DB	'x'
	DW	__printf_handle_llx
	DB	0		; sentinel

; The 'll' dispatch entry point - search __printf_ll_table
; This is needed because 'l' handler in lc_printf_l.mac
; references __printf_ll_table directly
__printf_ll_entry:
	; Not used directly - the 'l' handler handles 'll' internally
	RET


	CSEG
; ============================================================
; lc_printf_c.mac
; ============================================================
; lc_printf_c.mac - printf %c handler


	CSEG

	PUBLIC	__printf_handle_c
	PUBLIC	__printf_handle_c32
__printf_handle_c:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	CALL	_phc_out
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

; Same as __printf_handle_c but advances C by 4 - for callers compiled
; with --int=32 where char args occupy a full 32-bit stack slot.
__printf_handle_c32:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	CALL	_phc_out
	POP	BC
	INC	C
	INC	C
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

; Print the character E in a field of _printf_width characters.
_phc_out:
	LD	A,(_printf_width)
	OR	A
	JR	Z,_phc_plain
	DEC	A
	LD	B,A		; padding = width - 1
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_phc_left
	PUSH	DE
	LD	E,' '
	CALL	_printf_padn
	POP	DE
_phc_plain:
	JP	_printf_putc
_phc_left:
	CALL	_printf_putc
	LD	E,' '
	JP	_printf_padn


	CSEG
; ============================================================
; lc_printf_core.mac
; ============================================================
; lc_printf_core.mac - printf core dispatcher
; Table-driven printf: searches __printf_format_table for format handlers
;
; Handler calling convention:
;   Entry: HL = format string ptr (past the specifier char)
;          C  = arg offset byte (relative to IX frame)
;          IX = caller's frame pointer
;   State: _printf_width, _printf_zero, _printf_prec, _printf_hasprec,
;          _printf_upper available via EXTRN
;   Exit:  JP _printf_loop with HL = next format position, C = updated arg offset
;
; The format table is an array of (DB char, DW handler_addr) entries
; terminated by DB 0. It is defined by the codegen (in the user's .mac file)
; when compiling main(), or defaults to a full table.




	CSEG

	PUBLIC	_printf
	PUBLIC	_printf_loop
	PUBLIC	_printf_done
	PUBLIC	_printf_format
	PUBLIC	_printf_unk_echo
	PUBLIC	_printf_prt_hex
	PUBLIC	_printf_nib2a
	PUBLIC	_printf_width
	PUBLIC	_printf_zero
	PUBLIC	_printf_upper
	PUBLIC	_printf_prec
	PUBLIC	_printf_hasprec
	PUBLIC	_printf_alt
	PUBLIC	_printf_left
	PUBLIC	_printf_plus
	PUBLIC	_printf_space
	PUBLIC	_printf_pfxlen
	PUBLIC	_printf_numout
	PUBLIC	_printf_hexfin
	PUBLIC	_printf_hexword
	PUBLIC	_printf_padn
	PUBLIC	_printf_neg
	PUBLIC	_printf_hexbuf
	PUBLIC	_printf_decbuf
	PUBLIC	_printf_dstart
	PUBLIC	_printf_dcnt
	PUBLIC	_printf_ll_w0
	PUBLIC	_printf_ll_w1
	PUBLIC	_printf_ll_w2
	PUBLIC	_printf_ll_w3
	PUBLIC	_prt_float_prec
	PUBLIC	_printf_putc
	PUBLIC	_printf_count
	PUBLIC	__ftmp

; ============================================================
; _printf_putc: output the char in E to CONOUT and bump
; ``_printf_count`` so the printf-family functions can return the
; number of bytes written. All format handlers (lc_printf_*.mac)
; route their output through this helper. Preserves every
; register the caller might depend on.
; ============================================================
_printf_putc:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,(_printf_sink)
	CALL	_printf_sink_call
	LD	HL,(_printf_count)
	INC	HL
	LD	(_printf_count),HL
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

; Call the sink through HL.  The Z80 has no CALL (HL); CALL here pushes
; the return address and JP (HL) enters the sink, which RETs to us.
_printf_sink_call:
	JP	(HL)

; ============================================================
; _printf_engine: the format loop, shared by the whole printf family.
;
; Entry: IX = a frame whose varargs start at IX+C
;        HL = format string
;        C  = offset from IX to the first vararg
;        _printf_sink = routine taking the character in E
; Exit:  HL = bytes written.  Every printf-family entry point is this
;        plus a prologue that sets those four things.
;
; sprintf, snprintf, fprintf, vprintf and friends each used to carry
; their own CP/JR-Z conversion chain, so %e, %g and %F reached only
; printf and the others silently emitted an empty field and left the
; vararg offset alone, desyncing every later conversion in the call.
; ============================================================
	PUBLIC	_printf_engine
_printf_engine:
	PUSH	DE
	LD	DE,0
	LD	(_printf_count),DE
	POP	DE
	JR	_printf_loop

_printf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	HL,__conout	; console sink: the only console write in printf land
	LD	(_printf_sink),HL

	; fmt is at IX+4, first vararg at IX+6
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = format string pointer
	LD	C,6		; C = offset to next argument
	CALL	_printf_engine

	POP	DE
	POP	BC
	POP	IX
	RET

_printf_loop:
	LD	A,(HL)
	OR	A
	JR	Z,_printf_done

	CP	'%'
	JR	Z,_printf_format

	; Regular character - output it
	LD	E,A
	PUSH	HL
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	JR	_printf_loop

_printf_format:
	INC	HL
	; Remember where the conversion specification starts (the first byte
	; after the '%') so _printf_unknown can echo it verbatim.
	LD	(_printf_fmtstart),HL
	; Initialize format state: clear the whole _printf_state block
	PUSH	BC
	LD	DE,_printf_state
	LD	B,11		; length of the _printf_state block
	XOR	A
_printf_clr:
	LD	(DE),A
	INC	DE
	DJNZ	_printf_clr
	POP	BC
	LD	A,(HL)
	OR	A
	JP	Z,_printf_done

	CP	'%'
	JR	Z,_printf_pct

_printf_fmt2:
	; Check for '0' flag (only when not in precision and width is 0)
	CP	'0'
	JR	NZ,_printf_not0
	PUSH	AF
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_printf_0dig
	LD	A,(_printf_width)
	OR	A
	JR	NZ,_printf_0dig
	; Set zero-padding flag
	LD	A,1
	LD	(_printf_zero),A
	POP	AF
	JR	_printf_skip
_printf_0dig:
	POP	AF
	JR	_printf_isdig

_printf_not0:
	; Check for precision start
	CP	'.'
	JR	NZ,_printf_notdot
	PUSH	AF
	LD	A,1
	LD	(_printf_hasprec),A
	POP	AF
	JR	_printf_skip

_printf_notdot:
	; Flags: - + space #
	LD	DE,_printf_left
	CP	'-'
	JR	Z,_printf_setf
	LD	DE,_printf_plus
	CP	'+'
	JR	Z,_printf_setf
	LD	DE,_printf_space
	CP	' '
	JR	Z,_printf_setf
	LD	DE,_printf_alt
	CP	'#'
	JR	NZ,_printf_not_alt
_printf_setf:
	LD	A,1
	LD	(DE),A
	JR	_printf_skip
_printf_not_alt:
	CP	'*'
	JR	Z,_printf_star
	; Check for digits (1-9)
	CP	'1'
	JR	C,_printf_nodig
	CP	'9'+1
	JR	C,_printf_isdig
_printf_nodig:
	; Skip length modifiers: h, z, L
	CP	'h'
	JR	Z,_printf_skip
	CP	'z'
	JR	Z,_printf_skip
	CP	'L'
	JR	Z,_printf_skip

	; === DISPATCH: search __printf_format_table ===
	PUSH	HL		; Save format string position
	PUSH	BC		; Save arg offset
	LD	B,A		; B = format char to find
	LD	HL,__printf_format_table
_printf_search:
	LD	A,(HL)
	OR	A
	JR	Z,_printf_unknown	; End of table, char not found
	CP	B
	JR	Z,_printf_found
	INC	HL		; Skip handler address
	INC	HL
	INC	HL		; Next entry
	JR	_printf_search

_printf_found:
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = handler address
	POP	BC		; Restore arg offset
	POP	HL		; Restore format string ptr
	INC	HL		; Past the specifier char
	PUSH	DE
	RET			; Tail-call handler (JP DE)

_printf_unknown:
	POP	BC		; arg offset - deliberately NOT advanced
	POP	HL		; HL -> the offending conversion char
	INC	HL
	; fall into _printf_unk_echo

; ============================================================
; _printf_unk_echo: echo the conversion specification verbatim.
;
; C23 7.23.6.1p9 makes an invalid conversion specification undefined
; behaviour, so we may choose what to do.  Printing nothing is the worst
; option available: it is invisible AND it silently truncates the output.
; Echo the whole specification instead ("%q", "%.3q", "%ls", ...) so the
; failure is VISIBLE.
;
; LIMITATION, on purpose: this does NOT resync the varargs.  Only a
; handler advances C, and no handler ran, so every later conversion in
; this same printf call still reads the wrong argument.  There is no
; portable way to know an unknown conversion's argument size.  The
; compiler warns about this at compile time whenever the format string is
; a literal; the echo is the safety net for the non-literal case, which
; the compiler cannot see.
;
; Entry: HL -> one byte PAST the offending conversion character
;        _printf_fmtstart -> first byte after the '%'
; Exit:  jumps to _printf_loop with HL unchanged.
; ============================================================
_printf_unk_echo:
	LD	E,'%'
	CALL	_printf_putc	; preserves AF, BC, DE, HL
	LD	DE,(_printf_fmtstart)
_printf_unk_lp:
	LD	A,D		; done once DE has walked up to HL
	CP	H
	JR	NZ,_printf_unk_go
	LD	A,E
	CP	L
	JP	Z,_printf_loop
_printf_unk_go:
	LD	A,(DE)
	PUSH	DE
	LD	E,A
	CALL	_printf_putc
	POP	DE
	INC	DE
	JR	_printf_unk_lp

; '*' width or precision: the value is the next int vararg.
_printf_star:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = the int
	INC	C
	INC	C
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_printf_star_p
	BIT	7,D
	JR	Z,_printf_star_w
	LD	A,1		; negative width: '-' flag and the magnitude
	LD	(_printf_left),A
	LD	HL,0
	OR	A
	SBC	HL,DE
	EX	DE,HL
_printf_star_w:
	CALL	_printf_clamp8
	LD	(_printf_width),A
	POP	HL
	JR	_printf_skip
_printf_star_p:
	BIT	7,D
	JR	Z,_printf_star_pp
	XOR	A		; negative precision: as if none was given
	LD	(_printf_hasprec),A
	POP	HL
	JR	_printf_skip
_printf_star_pp:
	CALL	_printf_clamp8
	LD	(_printf_prec),A
	POP	HL
	JR	_printf_skip

; A = DE limited to 255
_printf_clamp8:
	LD	A,D
	OR	A
	LD	A,E
	RET	Z
	LD	A,255
	RET

_printf_isdig:
	; Parse digit into width or precision
	SUB	'0'
	PUSH	BC
	LD	B,A		; B = new digit
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_printf_precdig
	; Width digit
	LD	A,(_printf_width)
	CP	26		; 26 * 10 > 255: stay at 255 (no wrap-around)
	JR	NC,_printf_wsat
	LD	C,A
	ADD	A,A		; *2
	ADD	A,A		; *4
	ADD	A,C		; *5
	ADD	A,A		; *10
	ADD	A,B		; + digit
	JR	NC,_printf_wstore
_printf_wsat:
	LD	A,255
_printf_wstore:
	LD	(_printf_width),A
	POP	BC
	JR	_printf_skip
_printf_precdig:
	; Precision digit
	LD	A,(_printf_prec)
	CP	26		; stay at 255 (no wrap-around)
	JR	NC,_printf_psat
	LD	C,A
	ADD	A,A
	ADD	A,A
	ADD	A,C
	ADD	A,A
	ADD	A,B
	JR	NC,_printf_pstore
_printf_psat:
	LD	A,255
_printf_pstore:
	LD	(_printf_prec),A
	POP	BC
	; Fall through to _printf_skip

_printf_skip:
	INC	HL
	LD	A,(HL)
	OR	A
	JP	Z,_printf_done
	JR	_printf_fmt2

_printf_pct:
	; Output literal %
	LD	E,'%'
	PUSH	HL
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	JR	_printf_loop

; The engine is a subroutine now, so it returns the count and leaves the
; prologue's POP DE / POP BC / POP IX to whichever entry point ran it.
_printf_done:
	LD	HL,(_printf_count)	; Return count of bytes written
	RET

; ============================================================
; Printf hex.  _printf_prt_hex prints HL (16 bit); the long handlers
; fill _printf_hexbuf themselves (_printf_hexword) and call _printf_hexfin.
; ============================================================
_printf_prt_hex:
	PUSH	BC
	LD	DE,_printf_hexbuf
	CALL	_printf_hexword
	LD	B,4
	CALL	_printf_hexfin
	POP	BC
	RET

; HL = 16-bit value, DE = buffer pointer: append 4 hex characters
_printf_hexword:
	LD	A,H
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_printf_nib2a
	LD	A,H
	AND	0FH
	CALL	_printf_nib2a
	LD	A,L
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_printf_nib2a
	LD	A,L
	AND	0FH
	JR	_printf_nib2a

; B = number of hex characters in _printf_hexbuf.  Drop leading zeros
; (keep one), then print through _printf_numout.
_printf_hexfin:
	LD	HL,_printf_hexbuf
_printf_hf_lz:
	LD	A,B
	CP	1
	JR	Z,_printf_hf_set
	LD	A,(HL)
	CP	'0'
	JR	NZ,_printf_hf_set
	INC	HL
	DEC	B
	JR	_printf_hf_lz
_printf_hf_set:
	LD	(_printf_dstart),HL
	LD	A,B
	LD	(_printf_dcnt),A
	; '#' flag: prefix 0x/0X when the value is not zero
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_printf_numout
	LD	A,(HL)
	CP	'0'
	JR	Z,_printf_numout
	LD	A,2
	LD	(_printf_pfxlen),A
	; fall into _printf_numout

; ============================================================
; _printf_numout: print one integer conversion.  Shared by every
; integer handler, so flags, width and precision work the same for
; %d %u %o %x %X and the l and ll forms.
;
; Entry: _printf_dstart -> the digits, _printf_dcnt = how many
;        _printf_neg: 0 unsigned, 1 negative, 2 signed and not negative
;        _printf_pfxlen: 2 to print 0x (0X when _printf_upper), else 0
;        _printf_width/_zero/_left/_plus/_space/_prec/_hasprec
; Exit:  BC preserved.
; ============================================================
_printf_numout:
	PUSH	BC
	LD	A,(_printf_neg)
	OR	A
	JR	Z,_pn_nosign
	LD	B,'-'
	CP	1
	JR	Z,_pn_sgn
	LD	B,'+'
	LD	A,(_printf_plus)
	OR	A
	JR	NZ,_pn_sgn
	LD	B,' '
	LD	A,(_printf_space)
	OR	A
	JR	NZ,_pn_sgn
_pn_nosign:
	LD	B,0
_pn_sgn:
	LD	A,B
	LD	(_pn_sign),A
	; B = digit count, C = extra leading zeros from the precision
	LD	A,(_printf_dcnt)
	LD	B,A
	LD	C,0
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_pn_cnt
	XOR	A		; a precision cancels the '0' flag
	LD	(_printf_zero),A
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_pn_pz
	LD	A,B		; precision 0 and value 0: no digits at all
	DEC	A
	JR	NZ,_pn_cnt
	LD	HL,(_printf_dstart)
	LD	A,(HL)
	CP	'0'
	JR	NZ,_pn_cnt
	LD	B,0
	JR	_pn_cnt
_pn_pz:
	SUB	B
	JR	C,_pn_cnt
	LD	C,A
_pn_cnt:
	LD	A,B
	LD	(_pn_n),A
	LD	A,C
	LD	(_pn_zeros),A
	ADD	A,B		; B = characters before any padding
	JR	NC,_pn_t1
	LD	A,255		; the width is at most 255: saturate, never wrap
_pn_t1:
	LD	B,A
	LD	A,(_pn_sign)
	OR	A
	JR	Z,_pn_ns
	LD	A,B
	INC	A
	JR	Z,_pn_ns	; already 255
	LD	B,A
_pn_ns:
	LD	A,(_printf_pfxlen)
	ADD	A,B
	JR	NC,_pn_t2
	LD	A,255
_pn_t2:
	LD	B,A
	LD	A,(_printf_width)
	SUB	B
	JR	NC,_pn_pad
	XOR	A
_pn_pad:
	LD	(_pn_padn),A
	LD	B,A
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_pn_body
	LD	A,(_printf_zero)
	OR	A
	JR	NZ,_pn_zp
	LD	E,' '
	CALL	_printf_padn
	JR	_pn_body
_pn_zp:
	CALL	_pn_sp
	LD	E,'0'
	CALL	_printf_padn
	JR	_pn_dig
_pn_body:
	CALL	_pn_sp
_pn_dig:
	LD	A,(_pn_zeros)
	LD	B,A
	LD	E,'0'
	CALL	_printf_padn
	LD	A,(_pn_n)
	OR	A
	JR	Z,_pn_tail
	LD	B,A
	LD	HL,(_printf_dstart)
_pn_dl:
	LD	E,(HL)
	CALL	_printf_putc
	INC	HL
	DJNZ	_pn_dl
_pn_tail:
	LD	A,(_printf_left)
	OR	A
	JR	Z,_pn_done
	LD	A,(_pn_padn)
	LD	B,A
	LD	E,' '
	CALL	_printf_padn
_pn_done:
	POP	BC
	RET

; sign character and 0x prefix
_pn_sp:
	LD	A,(_pn_sign)
	OR	A
	JR	Z,_pn_sp1
	LD	E,A
	CALL	_printf_putc
_pn_sp1:
	LD	A,(_printf_pfxlen)
	OR	A
	RET	Z
	LD	E,'0'
	CALL	_printf_putc
	LD	A,(_printf_upper)
	LD	E,'x'
	OR	A
	JR	Z,_pn_sp2
	LD	E,'X'
_pn_sp2:
	JP	_printf_putc

; Output the character E, B times (B may be 0).  Clobbers AF, B.
_printf_padn:
	LD	A,B
	OR	A
	RET	Z
_printf_padn1:
	CALL	_printf_putc
	DJNZ	_printf_padn1
	RET

; Convert nibble (0-15) in A to ASCII hex char, store at (DE), advance DE
_printf_nib2a:
	ADD	A,'0'
	CP	'9'+1
	JR	C,_printf_nib_ok
	PUSH	BC
	LD	B,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,B
	POP	BC
	JR	Z,_printf_nib_lo
	ADD	A,7
	JR	_printf_nib_ok
_printf_nib_lo:
	ADD	A,39
_printf_nib_ok:
	LD	(DE),A
	INC	DE
	RET

; ============================================================
; Internal: print HL as decimal (no padding, simple)
; ============================================================
	PUBLIC	_prt_dec
_prt_dec:
	PUSH	BC
	PUSH	DE
	LD	DE,10
	LD	B,0
_prt_dec_loop:
	CALL	_prt_div16
	PUSH	DE
	INC	B
	LD	A,H
	OR	L
	JR	NZ,_prt_dec_loop
_prt_dec_out:
	POP	DE
	LD	A,E
	ADD	A,'0'
	LD	E,A
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	DJNZ	_prt_dec_out
	POP	DE
	POP	BC
	RET

; ============================================================
; Internal: HL = HL / 10, DE = HL % 10
; ============================================================
	PUBLIC	_prt_div16
_prt_div16:
	PUSH	BC
	LD	BC,0
	LD	DE,0
_prt_div16_lp:
	LD	A,H
	OR	A
	JR	NZ,_prt_div16_sub
	LD	A,L
	CP	10
	JR	C,_prt_div16_dn
_prt_div16_sub:
	LD	A,L
	SUB	10
	LD	L,A
	LD	A,H
	SBC	A,0
	LD	H,A
	INC	BC
	JR	_prt_div16_lp
_prt_div16_dn:
	LD	E,L
	LD	D,0
	LD	H,B
	LD	L,C
	POP	BC
	RET

	DSEG

_printf_count:	DS	2	; running byte count, returned by printf-family
	PUBLIC	_printf_sink
_printf_sink:	DW	__conout	; where _printf_putc sends each byte
_printf_fmtstart:	DS	2	; first byte after '%', for _printf_unknown
; One buffer for the digits of an integer conversion.  Hex handlers fill it
; from the start (up to 16 digits for %llx), the 32/64-bit decimal handlers
; too; the 16-bit decimal and octal handlers fill it backwards from +24.
_printf_hexbuf:
_printf_decbuf:	DS	24
_printf_dstart:	DS	2
_printf_dcnt:	DB	0
_pn_sign:	DB	0
_pn_n:		DB	0
_pn_zeros:	DB	0
_pn_padn:	DB	0
; Per-conversion state, cleared at every '%' (keep it contiguous, 11 bytes)
_printf_state:
_printf_width:	DB	0
_printf_zero:	DB	0
_printf_upper:	DB	0
_printf_prec:	DB	0
_printf_hasprec:	DB	0
_printf_alt:	DB	0	; '#' flag - alt form for o/x/X
_printf_left:	DB	0	; '-' flag
_printf_plus:	DB	0	; '+' flag
_printf_space:	DB	0	; ' ' flag
_printf_neg:	DB	0	; 0 unsigned, 1 negative, 2 signed non-negative
_printf_pfxlen:	DB	0	; 2 = print 0x

_printf_ll_w0:	DS	2
_printf_ll_w1:	DS	2
_printf_ll_w2:	DS	2
_printf_ll_w3:	DS	2
_prt_float_prec:	DB	6
__ftmp:		DS	4


	CSEG
; ============================================================
; lc_printf_d.mac
; ============================================================
; lc_printf_d.mac - printf %d/%i handler


	CSEG

	PUBLIC	__printf_handle_d
__printf_handle_d:
	; Entry: HL = format ptr (past 'd'), C = arg offset, IX = frame
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = value
	EX	DE,HL		; HL = value
	LD	A,2		; signed, not negative
	BIT	7,H
	JR	Z,_phd_pos
	DEC	A		; negative: 1, and HL = -HL
	LD	(_printf_neg),A
	LD	A,L
	CPL
	LD	L,A
	LD	A,H
	CPL
	LD	H,A
	INC	HL
	JR	_phd_go
_phd_pos:
	LD	(_printf_neg),A
_phd_go:
	CALL	_printf_dec16
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_dec16.mac
; ============================================================
; lc_printf_dec16.mac - 16-bit unsigned decimal digits for %d and %u


	CSEG

; Entry: HL = value.  Exit: _printf_dstart/_printf_dcnt describe the digits.
	PUBLIC	_printf_dec16
_printf_dec16:
	PUSH	BC
	PUSH	IX
	LD	IX,_printf_decbuf+24
	LD	B,0
_pd16_lp:
	LD	DE,10
	CALL	_prt_div16
	LD	A,E
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	LD	A,H
	OR	L
	JR	NZ,_pd16_lp
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	IX
	POP	BC
	RET


	CSEG
; ============================================================
; lc_printf_e.mac
; ============================================================
; lc_printf_e.mac - printf %e / %E handler (float, scientific notation)
;
; Style [-]d.ddde+dd per C17 7.21.6.1 p8.  The exponent always carries at
; least two digits; binary32 tops out at |exponent| = 38, so exactly two is
; always enough.
;
; Handler ABI (see lc_printf_core.mac): entered by a tail JP with HL = format
; pointer past the specifier, C = vararg offset from IX, IX = printf's frame.
; A handler never returns - it falls back into _printf_loop.
;
; ---------------------------------------------------------------------------
; ACCURACY NOTE.  The float runtime (rt_fadd, rt_fdiv, rt_fmul) rounds to
; nearest, so there is no one-sided bias to correct.  (Before it did, the
; runtime truncated, and this module added one ulp to the rounding term to
; make up for that.  A chain of truncating divisions also drifted downward
; and could cross a decade boundary: "while val >= 10: val /= 10" printed
; 1e20 as 9.999998e+19.)
;
; This module scales with exactly ONE division: it estimates the decimal
; exponent from the binary one, confirms it with an exact comparison against
; the same table constant it is about to divide by, and divides once.
; Comparing and dividing by the same constant makes 1 <= val < 10 true by
; construction, and makes an exact power of ten come out exactly 1.0.
;
; What remains is inherent to binary32: 24 bits carry about 7.2 decimal
; digits, so the 7th significant digit -- the last one the default "%e"
; prints -- can differ by one from a correctly-rounded conversion.  Measured
; against glibc over 1500 random values: precision 0 to 2 about 99.5%
; exact, 4 about 98.5%, 5 about 97.6%, 6 about 84%, and the result is never
; off by more than one in the last printed digit.  Precision above 8 is
; meaningless here.  Exact ties round away from zero rather than to even, so
; "%.0e" of 2.5 is 3e+00 where glibc, rounding to even, prints 2e+00.  A
; value within one ulp of a decade boundary can round across it: "%e" of
; 9.9999995 gives 1.000000e+01 where glibc gives 9.999999e+00, which is the
; same one-digit error seen from the other side.
; ---------------------------------------------------------------------------


	EXTRN	__fmul
	EXTRN	__fdiv
	EXTRN	__fsub
	EXTRN	__fadd
	EXTRN	__fcmp
	EXTRN	__itof
	EXTRN	__ftoi
	EXTRN	__tmp32

	CSEG

	PUBLIC	__printf_handle_e
	PUBLIC	__printf_handle_eu
	PUBLIC	_prt_float_e
	PUBLIC	_prt_e_scale
	PUBLIC	_prt_e_round
	PUBLIC	_prt_e_digit
	PUBLIC	_prt_e_d0
	PUBLIC	_prt_e_dn
	PUBLIC	_prt_e_expout
	PUBLIC	_prt_e_ld10
	PUBLIC	_prt_e_spec
	PUBLIC	_prt_e_val
	PUBLIC	_prt_e_dexp

; ============================================================
; %E - set the uppercase flag and fall into %e (same shape as
; __printf_handle_xu in lc_printf_x.mac)
; ============================================================
__printf_handle_eu:
	PUSH	AF
	LD	A,1
	LD	(_printf_upper),A
	POP	AF
	JR	__printf_handle_e

__printf_handle_e:
	; Fetch the 4-byte float argument into __ftmp.  uc80's double IS
	; binary32, so there is no default-argument promotion to undo.
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(__ftmp),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(__ftmp+2),DE
	; precision: default 6
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phe_def
	LD	A,(_printf_prec)
	JR	_phe_setp
_phe_def:
	LD	A,6
_phe_setp:
	LD	(_prt_float_prec),A
	CALL	_prt_float_e
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop

; ============================================================
; _prt_float_e - print __ftmp in %e style with _prt_float_prec
; fraction digits.
; ============================================================
_prt_float_e:
	PUSH	BC
	PUSH	DE
	PUSH	IX
	XOR	A
	LD	(_prt_e_dexp),A

	CALL	_prt_e_spec		; infinity / NaN
	JP	C,_pfe_done

	LD	DE,(__ftmp)
	LD	HL,(__ftmp+2)		; H = byte3 (sign+exponent)

	; sign
	BIT	7,H
	JR	Z,_pfe_pos
	PUSH	HL
	PUSH	DE
	LD	E,'-'
	CALL	_printf_putc
	POP	DE
	POP	HL
	RES	7,H
_pfe_pos:
	EX	DE,HL			; DEHL = |value|
	LD	(_prt_e_val),HL
	LD	(_prt_e_val+2),DE

	; zero needs no scaling; _prt_e_dexp is already 0 and every digit
	; the loop below produces is 0, which is exactly "0.000000e+00".
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,_pfe_noscale
	CALL	_prt_e_scale
_pfe_noscale:
	LD	A,(_prt_float_prec)
	CALL	_prt_e_round

	CALL	_prt_e_d0
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc

	LD	A,(_prt_float_prec)
	OR	A
	JR	Z,_pfe_nodot
	LD	E,'.'
	CALL	_printf_putc
	LD	A,(_prt_float_prec)
	LD	B,A
_pfe_flp:
	PUSH	BC
	CALL	_prt_e_digit
	POP	BC
	DJNZ	_pfe_flp
	JR	_pfe_exp
_pfe_nodot:
	; "%#.0e" keeps the point even with no digits after it
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_pfe_exp
	LD	E,'.'
	CALL	_printf_putc
_pfe_exp:
	CALL	_prt_e_expout
_pfe_done:
	POP	IX
	POP	DE
	POP	BC
	RET

; ============================================================
; _prt_e_spec - if __ftmp is an infinity or a NaN, print it and return
; with carry SET; otherwise print nothing and return with carry clear.
; Shared with %g.  C17 7.21.6.1 p8 wants "inf"/"nan" for e and g, and
; the uppercase spellings for E and G.
; ============================================================
_prt_e_spec:
	LD	DE,(__ftmp)
	LD	HL,(__ftmp+2)
	LD	A,H
	ADD	A,A
	LD	B,A
	LD	A,L
	RLCA
	AND	1
	OR	B
	CP	255
	JR	Z,_psp_yes
	OR	A			; clear carry: an ordinary number
	RET
_psp_yes:
	LD	A,L			; mantissa bits 22..16
	AND	7FH
	OR	D
	OR	E
	LD	D,A			; D nonzero => NaN, zero => infinity
	BIT	7,H
	JR	Z,_psp_nosign
	LD	E,'-'
	CALL	_printf_putc
_psp_nosign:
	LD	A,D
	OR	A
	LD	HL,_psp_sinf
	JR	Z,_psp_str
	LD	HL,_psp_snan
_psp_str:
	LD	B,3
_psp_lp:
	LD	A,(HL)
	PUSH	HL
	PUSH	BC
	LD	B,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,B
	JR	NZ,_psp_up
	OR	20H			; lowercase unless %E / %G
_psp_up:
	LD	E,A
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	DJNZ	_psp_lp
	SCF
	RET

_psp_sinf:	DB	'INF'
_psp_snan:	DB	'NAN'

; ============================================================
; _prt_e_expout - emit the exponent field: 'e'/'E', sign, two digits.
; Shared with %g.
; ============================================================
_prt_e_expout:
	LD	A,(_printf_upper)
	OR	A
	LD	E,'e'
	JR	Z,_pee_c
	LD	E,'E'
_pee_c:
	CALL	_printf_putc
	LD	A,(_prt_e_dexp)
	BIT	7,A
	JR	Z,_pee_plus
	NEG
	PUSH	AF
	LD	E,'-'
	CALL	_printf_putc
	POP	AF
	JR	_pee_dig
_pee_plus:
	PUSH	AF
	LD	E,'+'
	CALL	_printf_putc
	POP	AF
_pee_dig:
	LD	C,'0'
_pee_tens:
	CP	10
	JR	C,_pee_tdone
	SUB	10
	INC	C
	JR	_pee_tens
_pee_tdone:
	PUSH	AF
	LD	E,C
	CALL	_printf_putc
	POP	AF
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	RET

; ============================================================
; _prt_e_scale - scale _prt_e_val into [1,10) and leave the decimal
; exponent in _prt_e_dexp.  Exactly one division; see the accuracy
; note at the top of the file.
; ============================================================
_prt_e_scale:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	_pe_bexp
	SUB	127			; A = unbiased binary exponent
	CALL	_pe_est			; A = floor(A * log10 2)
	LD	(_prt_e_dexp),A

	; try exponent+1: val >= 10^(est+1) ?
	CP	38
	JR	Z,_pes_lower		; 10^39 is out of binary32 range
	INC	A
	CALL	_prt_e_ld10
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fcmp
	JR	C,_pes_lower
	LD	A,(_prt_e_dexp)
	INC	A
	LD	(_prt_e_dexp),A
	JR	_pes_div

_pes_lower:
	; else try exponent-1: val < 10^est ?
	LD	A,(_prt_e_dexp)
	CP	0C2H			; -38: no smaller normal exists
	JR	Z,_pes_div
	CALL	_prt_e_ld10
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fcmp
	JR	NC,_pes_div
	LD	A,(_prt_e_dexp)
	DEC	A
	LD	(_prt_e_dexp),A

_pes_div:
	LD	A,(_prt_e_dexp)
	CP	0C2H			; -38
	JR	NZ,_pes_dodiv
	; 10^-38 is denormal in binary32 (FLT_MIN is 1.1755e-38) and
	; rt_float flushes denormals to zero, so a division by it would
	; return infinity.  Scale that one decade by multiplying instead:
	; every value with this exponent lies in [FLT_MIN, 1e-37), so
	; v * 1e38 lands in [1.17, 10) as required.
	LD	A,38
	CALL	_prt_e_ld10
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fmul
	JR	_pes_store
_pes_dodiv:
	CALL	_prt_e_ld10
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fdiv
_pes_store:
	LD	(_prt_e_val),HL
	LD	(_prt_e_val+2),DE

	; Guards.  Neither has ever been observed to fire, because the
	; compare above used the very constant we just divided by: the
	; quotient is >= 1 by construction and < 10 up to the table's own
	; rounding.  Verified by simulating rt_float exactly over every
	; binade edge, 4000 random normals and the whole 10^-38 decade
	; (where the multiply above yields 1.175 to 9.999998).  They cost
	; 30 bytes and make the [1,10) invariant unconditional.
	CALL	_pe_ld10_1
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fcmp
	JR	C,_pes_chklo
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fdiv			; __tmp32 still holds 10.0
	LD	(_prt_e_val),HL
	LD	(_prt_e_val+2),DE
	LD	A,(_prt_e_dexp)
	INC	A
	LD	(_prt_e_dexp),A
_pes_chklo:
	LD	HL,0
	LD	(__tmp32),HL
	LD	HL,3F80H		; 1.0
	LD	(__tmp32+2),HL
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fcmp
	JR	NC,_pes_out
	CALL	_pe_mul10
	LD	A,(_prt_e_dexp)
	DEC	A
	LD	(_prt_e_dexp),A
_pes_out:
	POP	HL
	POP	DE
	POP	BC
	RET

; ============================================================
; _prt_e_round - add the rounding increment for A fraction digits:
;   0.5 * 0.1^A
; It was 0.5 * 0.1^A + ulp(val) while rt_float truncated; the runtime rounds
; to nearest now, and the ulp would round some values up by one digit.
; If the sum carries past 10.0 the value must have been all nines, so
; the answer is exactly 1.0 with the exponent bumped.
; ============================================================
_prt_e_round:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,0
	LD	DE,3F00H		; 0.5
	OR	A
	JR	Z,_per_hsave
	LD	B,A
_per_lp:
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,3DCCH
	LD	HL,0CCCDH		; 0.1
	CALL	__fmul
	DJNZ	_per_lp
_per_hsave:
	LD	(_prt_e_half),HL
	LD	(_prt_e_half+2),DE
_per_noulp:
	LD	HL,(_prt_e_half)
	LD	DE,(_prt_e_half+2)

_per_add:
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fadd
	LD	(_prt_e_val),HL
	LD	(_prt_e_val+2),DE

	CALL	_pe_ld10_1
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fcmp
	JR	C,_per_out
	LD	HL,0
	LD	(_prt_e_val),HL
	LD	HL,3F80H		; 1.0
	LD	(_prt_e_val+2),HL
	LD	A,(_prt_e_dexp)
	INC	A
	LD	(_prt_e_dexp),A
_per_out:
	POP	HL
	POP	DE
	POP	BC
	RET

; ============================================================
; _prt_e_digit - next fraction digit, printed.
; _prt_e_dn    - val *= 10, then the integer part in A, removed from val.
; _prt_e_d0    - integer part of val in A, removed from val.
; ============================================================
_prt_e_digit:
	CALL	_prt_e_dn
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	RET

_prt_e_dn:
	CALL	_pe_mul10
	; fall through

_prt_e_d0:
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__ftoi
	LD	A,L
	PUSH	AF
	LD	H,0
	LD	L,A
	LD	DE,0
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	CALL	__fsub
	LD	(_prt_e_val),HL
	LD	(_prt_e_val+2),DE
	POP	AF
	RET

; ============================================================
; Internal helpers
; ============================================================

; _pe_mul10: _prt_e_val *= 10.0
_pe_mul10:
	LD	HL,(_prt_e_val)
	LD	DE,(_prt_e_val+2)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,4120H		; 10.0
	LD	HL,0
	CALL	__fmul
	LD	(_prt_e_val),HL
	LD	(_prt_e_val+2),DE
	RET

; _pe_ld10_1: __tmp32 = 10.0
_pe_ld10_1:
	LD	HL,0
	LD	(__tmp32),HL
	LD	HL,4120H
	LD	(__tmp32+2),HL
	RET

; _pe_bexp: A = biased binary exponent of _prt_e_val (0..255).
; In DEHL form D holds bits 31..24 and E bits 23..16, so the exponent
; is (D << 1) | (E >> 7).  The sign bit is already cleared.
_pe_bexp:
	PUSH	BC
	PUSH	DE
	LD	DE,(_prt_e_val+2)
	LD	A,E
	RLCA
	AND	1
	LD	B,A
	LD	A,D
	ADD	A,A
	OR	B
	POP	DE
	POP	BC
	RET

; _pe_est: A = floor(A * log10 2) for a signed A, using 77/256 as the
; multiplier (error 2.4e-4 per unit, at most 0.031 over the whole
; exponent range).  The caller's +1/-1 refinement absorbs that.
_pe_est:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	C,0
	BIT	7,A
	JR	Z,_pes_epos
	NEG
	LD	C,1
_pes_epos:
	LD	L,A
	LD	H,0
	LD	D,H
	LD	E,L			; DE = n
	ADD	HL,HL			; 2n
	ADD	HL,HL			; 4n
	ADD	HL,DE			; 5n
	ADD	HL,HL			; 10n
	ADD	HL,HL			; 20n
	ADD	HL,HL			; 40n
	ADD	HL,HL			; 80n
	OR	A
	SBC	HL,DE			; 79n
	OR	A
	SBC	HL,DE			; 78n
	OR	A
	SBC	HL,DE			; 77n
	LD	A,C
	OR	A
	LD	A,H			; floor for a positive argument
	JR	Z,_pes_edone
	LD	A,L			; negative: floor = -ceil(n*77/256)
	OR	A
	LD	A,H
	JR	Z,_pes_eneg
	INC	A
_pes_eneg:
	NEG
_pes_edone:
	POP	HL
	POP	DE
	POP	BC
	RET

; _prt_e_ld10: __tmp32 = 10^A for a signed A in [-38,38].
_prt_e_ld10:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	BIT	7,A
	JR	NZ,_pel_neg
	LD	L,A
	LD	H,0
	ADD	HL,HL
	ADD	HL,HL
	LD	DE,_p10pos
	JR	_pel_go
_pel_neg:
	NEG
	DEC	A
	LD	L,A
	LD	H,0
	ADD	HL,HL
	ADD	HL,HL
	LD	DE,_p10neg
_pel_go:
	ADD	HL,DE
	LD	DE,__tmp32
	LD	BC,4
	LDIR
	POP	HL
	POP	DE
	POP	BC
	RET

; 10^0 .. 10^38, indexed by k*4.  Every entry is a normal binary32.
_p10pos:
	DW	0000H,3F80H	; 1e0
	DW	0000H,4120H	; 1e1
	DW	0000H,42C8H	; 1e2
	DW	0000H,447AH	; 1e3
	DW	4000H,461CH	; 1e4
	DW	5000H,47C3H	; 1e5
	DW	2400H,4974H	; 1e6
	DW	9680H,4B18H	; 1e7
	DW	0BC20H,4CBEH	; 1e8
	DW	6B28H,4E6EH	; 1e9
	DW	02F9H,5015H	; 1e10
	DW	43B7H,51BAH	; 1e11
	DW	0D4A5H,5368H	; 1e12
	DW	84E7H,5511H	; 1e13
	DW	0E621H,56B5H	; 1e14
	DW	5FA9H,5863H	; 1e15
	DW	1BCAH,5A0EH	; 1e16
	DW	0A2BCH,5BB1H	; 1e17
	DW	0B6BH,5D5EH	; 1e18
	DW	0C723H,5F0AH	; 1e19
	DW	78ECH,60ADH	; 1e20
	DW	0D727H,6258H	; 1e21
	DW	8678H,6407H	; 1e22
	DW	6816H,65A9H	; 1e23
	DW	0C21CH,6753H	; 1e24
	DW	5951H,6904H	; 1e25
	DW	6FA6H,6AA5H	; 1e26
	DW	0CB8FH,6C4EH	; 1e27
	DW	3F39H,6E01H	; 1e28
	DW	8F08H,6FA1H	; 1e29
	DW	0F2CAH,7149H	; 1e30
	DW	6F7CH,72FCH	; 1e31
	DW	0C5AEH,749DH	; 1e32
	DW	3719H,7645H	; 1e33
	DW	84DFH,77F6H	; 1e34
	DW	130CH,799AH	; 1e35
	DW	97CEH,7B40H	; 1e36
	DW	0BDC2H,7CF0H	; 1e37
	DW	7699H,7E96H	; 1e38

; 10^-1 .. 10^-37, indexed by (-k-1)*4.  The table stops at 10^-37
; because 10^-38 is DENORMAL in binary32 (FLT_MIN is 1.1755e-38) and
; rt_float.mac flushes denormals to zero -- dividing by it would give
; infinity.  _pes_div scales that one decade by multiplying instead.
_p10neg:
	DW	0CCCDH,3DCCH	; 1e-1
	DW	0D70AH,3C23H	; 1e-2
	DW	126FH,3A83H	; 1e-3
	DW	0B717H,38D1H	; 1e-4
	DW	0C5ACH,3727H	; 1e-5
	DW	37BDH,3586H	; 1e-6
	DW	0BF95H,33D6H	; 1e-7
	DW	0CC77H,322BH	; 1e-8
	DW	705FH,3089H	; 1e-9
	DW	0E6FFH,2EDBH	; 1e-10
	DW	0EBFFH,2D2FH	; 1e-11
	DW	0BCCCH,2B8CH	; 1e-12
	DW	2E13H,29E1H	; 1e-13
	DW	24DCH,2834H	; 1e-14
	DW	1D7DH,2690H	; 1e-15
	DW	9595H,24E6H	; 1e-16
	DW	77AAH,2338H	; 1e-17
	DW	92EFH,2193H	; 1e-18
	DW	1E4AH,1FECH	; 1e-19
	DW	0E508H,1E3CH	; 1e-20
	DW	1DA0H,1C97H	; 1e-21
	DW	0C901H,1AF1H	; 1e-22
	DW	6D9AH,1941H	; 1e-23
	DW	0BE15H,179AH	; 1e-24
	DW	9688H,15F7H	; 1e-25
	DW	1206H,1446H	; 1e-26
	DW	74D2H,129EH	; 1e-27
	DW	87B6H,10FDH	; 1e-28
	DW	0D2F8H,0F4AH	; 1e-29
	DW	4260H,0DA2H	; 1e-30
	DW	0CEB3H,0C01H	; 1e-31
	DW	0B11FH,0A4FH	; 1e-32
	DW	274CH,08A6H	; 1e-33
	DW	0EC3DH,0704H	; 1e-34
	DW	0AD2EH,0554H	; 1e-35
	DW	2425H,03AAH	; 1e-36
	DW	1CEAH,0208H	; 1e-37

	COMMON	/lc_printf_e/

_prt_e_val:	DS	4
_prt_e_half:	DS	4
_prt_e_dexp:	DS	1


	CSEG
; ============================================================
; lc_printf_f.mac
; ============================================================
; lc_printf_f.mac - printf %f handler (float)


	CSEG

	PUBLIC	__printf_handle_f
	PUBLIC	__printf_handle_fu

; %F - set the uppercase flag and fall into %f, so an infinity prints INF
; and a NaN NAN (C17 7.21.6.1 p8).  Same shape as __printf_handle_eu.
__printf_handle_fu:
	PUSH	AF
	LD	A,1
	LD	(_printf_upper),A
	POP	AF
	JR	__printf_handle_f

__printf_handle_f:
	; Float is 32 bits (4 bytes) on stack
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	; Load 32-bit float from (HL) into __ftmp
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(__ftmp),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(__ftmp+2),DE
	; Set precision
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phf_defprec
	LD	A,(_printf_prec)
	LD	(_prt_float_prec),A
	JR	_phf_go
_phf_defprec:
	LD	A,6
	LD	(_prt_float_prec),A
_phf_go:
	CALL	_prt_float
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_g.mac
; ============================================================
; lc_printf_g.mac - printf %g / %G handler
;
; C17 7.21.6.1 p8, implemented literally:
;   P is the precision (6 if absent, 1 if given as zero) and X is the
;   exponent of the value AFTER it has been rounded to P significant
;   digits.  Style e is used when X < -4 or X >= P, style f otherwise.
;   Trailing zeros are removed from the fractional portion unless the
;   '#' flag is present, and the decimal point goes with them if no
;   fractional digits survive.
;
; Every digit comes from the [1,10) mantissa produced by _prt_e_scale in
; lc_printf_e.mac, never from lc_printf_core's _prt_dec.  That is
; deliberate: %g routinely needs a six-digit integer part ("%g" of
; 123456.0 is "123456") and _prt_dec is 16-bit only, which is why "%f"
; of the same value prints garbage while "%g" does not.
;
; Trailing zeros are suppressed WITHOUT a digit buffer.  _g_putf holds
; back zeros and a pending '.' and emits them only when a nonzero digit
; turns up; anything still pending when the conversion ends simply never
; gets written.  That is O(1) RAM instead of a 40-byte buffer.
;
; This module pulls lc_printf_e.mac in.  Keeping them together is
; deliberate (see the note in build_libs.py's directory): splitting the
; shared scaler into a third module would save about 500 bytes for a
; program that uses %g but not %e, and mbasic links both anyway.



	CSEG

	PUBLIC	__printf_handle_g
	PUBLIC	__printf_handle_gu
	PUBLIC	_prt_float_g

; ============================================================
; %G - set the uppercase flag and fall into %g
; ============================================================
__printf_handle_gu:
	PUSH	AF
	LD	A,1
	LD	(_printf_upper),A
	POP	AF
	JR	__printf_handle_g

__printf_handle_g:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(__ftmp),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(__ftmp+2),DE
	; P = precision; absent means 6, an explicit 0 means 1
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phg_def
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_phg_setp
	LD	A,1
	JR	_phg_setp
_phg_def:
	LD	A,6
_phg_setp:
	LD	(_g_prec),A
	CALL	_prt_float_g
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop

; ============================================================
; _prt_float_g - print __ftmp in %g style with _g_prec significant
; digits.
; ============================================================
_prt_float_g:
	PUSH	BC
	PUSH	DE
	PUSH	IX
	XOR	A
	LD	(_g_pend),A
	LD	(_g_dot),A
	LD	(_prt_e_dexp),A

	CALL	_prt_e_spec		; infinity / NaN
	JP	C,_pfg_done

	LD	DE,(__ftmp)
	LD	HL,(__ftmp+2)

	BIT	7,H
	JR	Z,_pfg_pos
	PUSH	HL
	PUSH	DE
	LD	E,'-'
	CALL	_printf_putc
	POP	DE
	POP	HL
	RES	7,H
_pfg_pos:
	EX	DE,HL			; DEHL = |value|
	LD	(_prt_e_val),HL
	LD	(_prt_e_val+2),DE

	; Zero needs no scaling.  With X = 0 it takes the style-f path
	; below and produces "0" - or "0.00000" under '#', which is what
	; C requires and what a special-cased "print 0 and stop" would
	; get wrong.
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,_pfg_noscale
	CALL	_prt_e_scale
_pfg_noscale:
	; round to P significant digits, i.e. P-1 fraction digits of the
	; scaled mantissa.  This happens BEFORE the style is chosen
	; because p8 defines X as the exponent of the CONVERTED value.
	LD	A,(_g_prec)
	DEC	A
	CALL	_prt_e_round

	; style e if X < -4 or X >= P, else style f
	LD	A,(_prt_e_dexp)
	LD	B,A
	ADD	A,4
	JP	M,_pfg_style_e
	LD	A,B
	BIT	7,A
	JR	NZ,_pfg_style_f		; -4 <= X < 0
	LD	HL,_g_prec
	CP	(HL)
	JR	NC,_pfg_style_e

; ---------------- style f ----------------
_pfg_style_f:
	LD	A,(_prt_e_dexp)
	BIT	7,A
	JR	NZ,_pfg_f_neg

	; X >= 0: X+1 integer digits, emitted unfiltered
	INC	A
	LD	B,A
	CALL	_prt_e_d0
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	DEC	B
	JR	Z,_pfg_f_frac
_pfg_f_ilp:
	PUSH	BC
	CALL	_prt_e_dn
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	POP	BC
	DJNZ	_pfg_f_ilp
_pfg_f_frac:
	; P-1-X fraction digits, filtered
	LD	A,(_g_prec)
	DEC	A
	LD	HL,_prt_e_dexp
	SUB	(HL)
	JR	Z,_pfg_end
	LD	B,A
	LD	A,1
	LD	(_g_dot),A
_pfg_f_flp:
	PUSH	BC
	CALL	_prt_e_dn
	CALL	_g_putf
	POP	BC
	DJNZ	_pfg_f_flp
	JR	_pfg_end

_pfg_f_neg:
	; -4 <= X <= -1: "0.", then -X-1 zeros, then P digits.  That is
	; P-1-X fraction characters in total, as required.
	LD	E,'0'
	CALL	_printf_putc
	LD	A,1
	LD	(_g_dot),A
	LD	A,(_prt_e_dexp)
	NEG
	DEC	A
	JR	Z,_pfg_fn_sig
	LD	B,A
_pfg_fn_zlp:
	PUSH	BC
	XOR	A
	CALL	_g_putf
	POP	BC
	DJNZ	_pfg_fn_zlp
_pfg_fn_sig:
	CALL	_prt_e_d0
	CALL	_g_putf
	LD	A,(_g_prec)
	DEC	A
	JR	Z,_pfg_end
	LD	B,A
_pfg_fn_lp:
	PUSH	BC
	CALL	_prt_e_dn
	CALL	_g_putf
	POP	BC
	DJNZ	_pfg_fn_lp
	JR	_pfg_end

; ---------------- style e ----------------
_pfg_style_e:
	CALL	_prt_e_d0
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	LD	A,(_g_prec)
	DEC	A
	JR	Z,_pfg_e_exp
	LD	B,A
	LD	A,1
	LD	(_g_dot),A
_pfg_e_lp:
	PUSH	BC
	CALL	_prt_e_dn
	CALL	_g_putf
	POP	BC
	DJNZ	_pfg_e_lp
_pfg_e_exp:
	CALL	_g_alt_dot
	CALL	_prt_e_expout
	JR	_pfg_done

_pfg_end:
	CALL	_g_alt_dot
_pfg_done:
	POP	IX
	POP	DE
	POP	BC
	RET

; ============================================================
; _g_putf - emit one fraction digit through the trailing-zero filter.
; A zero is only counted; a nonzero digit first flushes the pending
; '.' and the pending zeros.  Whatever is still pending when the
; conversion ends is dropped, which is exactly "trailing zeros are
; removed ... the decimal-point character is removed if there is no
; fractional portion remaining".  Under '#' nothing is held back.
; ============================================================
_g_putf:
	OR	A
	JR	NZ,_gpf_nz
	PUSH	AF
	LD	A,(_printf_alt)
	OR	A
	JR	NZ,_gpf_keep
	POP	AF
	LD	A,(_g_pend)
	INC	A
	LD	(_g_pend),A
	RET
_gpf_keep:
	POP	AF
_gpf_nz:
	PUSH	AF
	LD	A,(_g_dot)
	CP	1			; armed but not yet written?
	JR	NZ,_gpf_nodot
	LD	A,2
	LD	(_g_dot),A
	LD	E,'.'
	CALL	_printf_putc
_gpf_nodot:
	LD	A,(_g_pend)
	OR	A
	JR	Z,_gpf_out
	LD	B,A
	XOR	A
	LD	(_g_pend),A
_gpf_zlp:
	PUSH	BC
	LD	E,'0'
	CALL	_printf_putc
	POP	BC
	DJNZ	_gpf_zlp
_gpf_out:
	POP	AF
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	RET

; ============================================================
; _g_alt_dot - under '#' the result always contains a decimal point,
; even when no fraction digit was ever emitted ("%#g" of 100000.0 is
; "100000." - the point is never armed there, so testing only the
; "armed" state would miss it).
; ============================================================
_g_alt_dot:
	LD	A,(_printf_alt)
	OR	A
	RET	Z
	LD	A,(_g_dot)
	CP	2			; already written?
	RET	Z
	LD	A,2
	LD	(_g_dot),A
	LD	E,'.'
	CALL	_printf_putc
	RET

	DSEG

_g_prec:	DB	6
_g_pend:	DB	0
_g_dot:		DB	0


	CSEG
; ============================================================
; lc_printf_l.mac
; ============================================================
; lc_printf_l.mac - printf 'l' length prefix handler
; Dispatches to __printf_long_table, or 'll' to __printf_ll_table


	CSEG

	PUBLIC	__printf_handle_l
__printf_handle_l:
	; HL points past the 'l' in format string
	; Read next char
	LD	A,(HL)
	INC	HL

	CP	'l'
	JR	Z,_phl_ll

	; Search __printf_long_table for this char
	PUSH	HL
	PUSH	BC
	LD	B,A		; B = format char
	LD	HL,__printf_long_table
_phl_search:
	LD	A,(HL)
	OR	A
	JR	Z,_phl_unknown
	CP	B
	JR	Z,_phl_found
	INC	HL
	INC	HL
	INC	HL
	JR	_phl_search

_phl_found:
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = handler address
	POP	BC
	POP	HL
	PUSH	DE
	RET			; Tail-call handler

_phl_unknown:
	; %l<something we have no handler for>, e.g. %ls.  Echo the whole
	; specification instead of dropping it silently; HL already points
	; one byte past the conversion char, which is what the echo wants.
	POP	BC
	POP	HL
	JP	_printf_unk_echo

_phl_ll:
	; 'll' prefix - search __printf_ll_table
	LD	A,(HL)
	INC	HL
	PUSH	HL
	PUSH	BC
	LD	B,A
	LD	HL,__printf_ll_table
_phl_ll_search:
	LD	A,(HL)
	OR	A
	JR	Z,_phl_ll_unknown
	CP	B
	JR	Z,_phl_ll_found
	INC	HL
	INC	HL
	INC	HL
	JR	_phl_ll_search

_phl_ll_found:
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	POP	BC
	POP	HL
	PUSH	DE
	RET

_phl_ll_unknown:
	; %ll<no handler> - same treatment as _phl_unknown.
	POP	BC
	POP	HL
	JP	_printf_unk_echo


	CSEG
; ============================================================
; lc_printf_ld.mac
; ============================================================
; lc_printf_ld.mac - printf %ld handler (signed long decimal)


	CSEG

	PUBLIC	__printf_handle_ld
__printf_handle_ld:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	; Get 32-bit value
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = low word
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A		; HL = high word
	EX	DE,HL		; DEHL = 32-bit value

	LD	A,2		; signed, not negative
	LD	(_printf_neg),A
	BIT	7,D
	JR	Z,_phld_pos

	LD	A,1		; negative: remember, then negate DEHL
	LD	(_printf_neg),A
	LD	BC,0
	LD	A,C
	SUB	L
	LD	L,A
	LD	A,C
	SBC	A,H
	LD	H,A
	LD	A,C
	SBC	A,E
	LD	E,A
	LD	A,C
	SBC	A,D
	LD	D,A

_phld_pos:
	CALL	_printf_dec32
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,4		; Long is 4 bytes
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_lld.mac
; ============================================================
; lc_printf_lld.mac - printf %lld handler (signed long long decimal)



	CSEG

	PUBLIC	__printf_handle_lld
__printf_handle_lld:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	; Read 8 bytes (64 bits) into _prt64_val
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val+2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val+4),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_prt64_val+6),DE

	; Check sign (bit 7 of highest byte)
	LD	A,2		; signed, not negative
	LD	(_printf_neg),A
	LD	A,D
	AND	80H
	JR	Z,_phlld_pos

	LD	A,1		; negative: remember, then negate below
	LD	(_printf_neg),A

	; Negate 64-bit value (0 - _prt64_val)
	XOR	A		; Clear carry
	LD	HL,0
	LD	DE,(_prt64_val)
	SBC	HL,DE
	LD	(_prt64_val),HL
	LD	HL,0
	LD	DE,(_prt64_val+2)
	SBC	HL,DE
	LD	(_prt64_val+2),HL
	LD	HL,0
	LD	DE,(_prt64_val+4)
	SBC	HL,DE
	LD	(_prt64_val+4),HL
	LD	HL,0
	LD	DE,(_prt64_val+6)
	SBC	HL,DE
	LD	(_prt64_val+6),HL

_phlld_pos:
	CALL	_printf_dec64
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,8		; Long long is 8 bytes
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_llu.mac
; ============================================================
; lc_printf_llu.mac - printf %llu handler (unsigned long long decimal)


	CSEG

	PUBLIC	__printf_handle_llu
__printf_handle_llu:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	; Read 8 bytes (64 bits) into _prt64_val
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val+2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val+4),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_prt64_val+6),DE

	CALL	_printf_dec64
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,8		; Long long is 8 bytes
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_llx.mac
; ============================================================
; lc_printf_llx.mac - printf %llx handler (long long hex)



	CSEG

	PUBLIC	__printf_handle_llx
__printf_handle_llx:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	; Read 8 bytes (64 bits)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w0),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w1),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_printf_ll_w3),DE
	; 16 nibbles, high word first, into _printf_hexbuf
	LD	DE,_printf_hexbuf
	LD	HL,(_printf_ll_w3)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w2)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w1)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w0)
	CALL	_printf_hexword
	LD	B,16
	CALL	_printf_hexfin
	POP	BC
	LD	A,C
	ADD	A,8
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_lo.mac
; ============================================================
; lc_printf_lo.mac - printf %lo handler (unsigned long octal)



	CSEG

	PUBLIC	__printf_handle_lo
__printf_handle_lo:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = value
	; Store DEHL to work area
	LD	(_plo_val),HL
	LD	(_plo_val+2),DE
	PUSH	IX
	LD	IX,_printf_decbuf+24
	LD	B,0		; digit counter
_plo_cvt:
	LD	A,(_plo_val)
	AND	07h		; remainder = value & 7
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	; Shift 32-bit _plo_val right by 3 (divide by 8)
	; Byte order: _plo_val+0 (low) .. _plo_val+3 (high)
	; Do 3 single-bit right shifts
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Second shift
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Third shift
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Check if quotient is zero
	LD	HL,(_plo_val)
	LD	A,H
	OR	L
	JR	NZ,_plo_cvt
	LD	HL,(_plo_val+2)
	LD	A,H
	OR	L
	JR	NZ,_plo_cvt
	; '#' flag: force the first digit to be '0'
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_plo_set
	LD	A,(IX+0)
	CP	'0'
	JR	Z,_plo_set_z
	DEC	IX
	LD	(IX+0),'0'
	INC	B
	JR	_plo_set
_plo_set_z:
	; value 0 with '#': "%#.0o" still prints "0"
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_plo_set
	INC	A
	LD	(_printf_prec),A
_plo_set:
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	IX
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop

	COMMON	/lc_printf_lo/
_plo_val:	DS	4


	CSEG
; ============================================================
; lc_printf_lu.mac
; ============================================================
; lc_printf_lu.mac - printf %lu handler (unsigned long decimal)


	CSEG

	PUBLIC	__printf_handle_lu
__printf_handle_lu:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = value
	CALL	_printf_dec32
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_lx.mac
; ============================================================
; lc_printf_lx.mac - printf %lx and %lX handlers (long hex)



	CSEG

	PUBLIC	__printf_handle_lx
	PUBLIC	__printf_handle_lxu

; %lX / %X-under-int32: set uppercase flag, fall through to %lx path
__printf_handle_lxu:
	LD	A,1
	LD	(_printf_upper),A
	; fall through

__printf_handle_lx:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = value (DE=high, HL=low)

	; 8 nibbles, high word first, into _printf_hexbuf
	PUSH	HL		; low word
	EX	DE,HL		; HL = high word
	LD	DE,_printf_hexbuf
	CALL	_printf_hexword
	POP	HL
	CALL	_printf_hexword
	LD	B,8
	CALL	_printf_hexfin
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_o.mac
; ============================================================
; lc_printf_o.mac - printf %o handler (unsigned int octal)


	CSEG

	PUBLIC	__printf_handle_o
__printf_handle_o:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL		; HL = value
	PUSH	IX
	PUSH	BC
	LD	B,0
	LD	IX,_printf_decbuf+24
_pho_cvt:
	LD	A,L
	AND	07h		; remainder = value & 7
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	; Shift HL right by 3 (divide by 8)
	SRL	H
	RR	L
	SRL	H
	RR	L
	SRL	H
	RR	L
	LD	A,H
	OR	L
	JR	NZ,_pho_cvt
	; Alternative form (# flag): C 7.21.6.1 para 6 says force the first
	; digit to be '0'.  Value 0 already gives "0".
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_pho_set
	LD	A,(IX+0)
	CP	'0'
	JR	Z,_pho_set_z
	DEC	IX
	LD	(IX+0),'0'
	INC	B
	JR	_pho_set
_pho_set_z:
	; value 0 with '#': "%#.0o" still prints "0"
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_pho_set
	INC	A
	LD	(_printf_prec),A
_pho_set:
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	BC
	POP	IX
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_s.mac
; ============================================================
; lc_printf_s.mac - printf %s handler


	CSEG

	PUBLIC	__printf_handle_s
__printf_handle_s:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = string pointer

	XOR	A
	LD	(_phs_pad),A
	LD	A,(_printf_width)
	OR	A
	JR	Z,_phs_print	; no field width: nothing to count

	; Count the characters that will be printed, but never more than
	; the width: B = min(width, precision if any).
	LD	B,A
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_cnt
	LD	A,(_printf_prec)
	CP	B
	JR	NC,_phs_cnt
	LD	B,A
_phs_cnt:
	LD	H,D
	LD	L,E
	LD	C,0
_phs_c1:
	LD	A,C
	CP	B
	JR	NC,_phs_cd
	LD	A,(HL)
	OR	A
	JR	Z,_phs_cd
	INC	HL
	INC	C
	JR	_phs_c1
_phs_cd:
	LD	A,(_printf_width)
	SUB	C		; padding = width - printed characters
	LD	(_phs_pad),A
	LD	B,A
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_phs_print
	PUSH	DE
	LD	E,' '
	CALL	_printf_padn
	POP	DE

_phs_print:
	; Load precision limit into B
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_nop
	LD	A,(_printf_prec)
	LD	B,A
	JR	_phs_loop
_phs_nop:
	LD	B,0

_phs_loop:
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_nolim
	LD	A,B
	OR	A
	JR	Z,_phs_done
	DEC	B
_phs_nolim:
	LD	A,(DE)
	OR	A
	JR	Z,_phs_done
	PUSH	DE
	PUSH	BC
	LD	E,A
	CALL	_printf_putc
	POP	BC
	POP	DE
	INC	DE
	JR	_phs_loop

_phs_done:
	LD	A,(_printf_left)
	OR	A
	JR	Z,_phs_ret
	LD	A,(_phs_pad)
	LD	B,A
	LD	E,' '
	CALL	_printf_padn
_phs_ret:
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

	COMMON	/lc_printf_s/
_phs_pad:	DS	1


	CSEG
; ============================================================
; lc_printf_u.mac
; ============================================================
; lc_printf_u.mac - printf %u handler


	CSEG

	PUBLIC	__printf_handle_u
__printf_handle_u:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL		; HL = value
	CALL	_printf_dec16
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_x.mac
; ============================================================
; lc_printf_x.mac - printf %x, %X, %p handlers


	CSEG

	PUBLIC	__printf_handle_x
	PUBLIC	__printf_handle_xu
	PUBLIC	__printf_handle_p

__printf_handle_xu:
	; %X handler - set uppercase flag and fall through
	LD	A,1
	LD	(_printf_upper),A
	JR	__printf_handle_x

__printf_handle_p:
	; Pointer - same as %x

__printf_handle_x:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	; _printf_prt_hex also handles the '#' prefix (0x / 0X) per
	; C 7.21.6.1 para 6, plus width, flags and precision.
	CALL	_printf_prt_hex
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_prt_dec32.mac
; ============================================================
; lc_prt_dec32.mac - print DEHL as 32-bit decimal


; Output goes through _printf_putc, not straight to __conout, so the
; digits are counted in _printf_count and the printf family returns the
; number of bytes it actually wrote.  Writing directly meant printf("%ld")
; returned 3 for a ten-byte "[1234567]\n".  Every caller of _prt_dec32
; (printf core, %ld, %lu, fprintf) links the printf core that defines it.

	CSEG

	PUBLIC	_prt_dec32
	PUBLIC	_printf_dec32

; _printf_dec32: DEHL -> decimal digits in _printf_decbuf, described by
; _printf_dstart/_printf_dcnt.  _prt_dec32 prints them.
_printf_dec32:
	PUSH	BC
	PUSH	IX

	; Store value in work area
	LD	(_prt32_val),HL
	LD	(_prt32_val+2),DE

	LD	B,0		; Digit counter

_prt32_loop:
	CALL	_div32_10
	PUSH	AF		; Save digit (remainder)
	INC	B

	; Check if quotient is zero
	LD	HL,(_prt32_val)
	LD	A,H
	OR	L
	JR	NZ,_prt32_loop
	LD	HL,(_prt32_val+2)
	LD	A,H
	OR	L
	JR	NZ,_prt32_loop

	LD	HL,_printf_decbuf
	LD	(_printf_dstart),HL
	LD	A,B
	LD	(_printf_dcnt),A
_prt32_out:
	POP	AF
	ADD	A,'0'
	LD	(HL),A
	INC	HL
	DJNZ	_prt32_out

	POP	IX
	POP	BC
	RET

_prt_dec32:
	CALL	_printf_dec32
	PUSH	BC
	LD	HL,(_printf_dstart)
	LD	A,(_printf_dcnt)
	LD	B,A
_prt32_raw:
	LD	E,(HL)
	CALL	_printf_putc
	INC	HL
	DJNZ	_prt32_raw
	POP	BC
	RET

; Internal: divide _prt32_val by 10
; Returns remainder in A, quotient stored back in _prt32_val
	PUBLIC	_div32_10
_div32_10:
	PUSH	BC
	PUSH	DE
	PUSH	HL

	LD	DE,0		; DE = running remainder
	LD	B,32

_div32_10_loop:
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL

	LD	HL,(_prt32_val)
	ADD	HL,HL
	LD	(_prt32_val),HL
	LD	HL,(_prt32_val+2)
	ADC	HL,HL
	LD	(_prt32_val+2),HL
	JR	NC,_div32_10_nc1
	INC	DE
_div32_10_nc1:

	LD	A,D
	OR	A
	JR	NZ,_div32_10_sub
	LD	A,E
	CP	10
	JR	C,_div32_10_nosub

_div32_10_sub:
	LD	A,E
	SUB	10
	LD	E,A
	LD	A,D
	SBC	A,0
	LD	D,A

	LD	HL,(_prt32_val)
	INC	HL
	LD	(_prt32_val),HL

_div32_10_nosub:
	DJNZ	_div32_10_loop

	LD	A,E

	POP	HL
	POP	DE
	POP	BC
	RET

	COMMON	/lc_prt_dec32/
	PUBLIC	_prt32_val
_prt32_val:	DS	4


	CSEG
; ============================================================
; lc_prt_dec64.mac
; ============================================================
; lc_prt_dec64.mac - print 64-bit value as unsigned decimal


	CSEG

	PUBLIC	_printf_dec64
; Input: 8-byte value already stored in _prt64_val.
; Output: decimal digits in _printf_decbuf (_printf_dstart/_printf_dcnt).
_printf_dec64:
	PUSH	BC
	PUSH	IX

	LD	B,0		; Digit counter

_prt64_loop:
	CALL	_div64_10
	PUSH	AF		; Save digit (remainder)
	INC	B

	; Check if quotient is zero (all 8 bytes)
	LD	HL,(_prt64_val)
	LD	A,H
	OR	L
	JR	NZ,_prt64_loop
	LD	HL,(_prt64_val+2)
	LD	A,H
	OR	L
	JR	NZ,_prt64_loop
	LD	HL,(_prt64_val+4)
	LD	A,H
	OR	L
	JR	NZ,_prt64_loop
	LD	HL,(_prt64_val+6)
	LD	A,H
	OR	L
	JR	NZ,_prt64_loop

	LD	HL,_printf_decbuf
	LD	(_printf_dstart),HL
	LD	A,B
	LD	(_printf_dcnt),A
_prt64_out:
	POP	AF
	ADD	A,'0'
	LD	(HL),A
	INC	HL
	DJNZ	_prt64_out

	POP	IX
	POP	BC
	RET

; Internal: divide _prt64_val (8 bytes) by 10
; Returns remainder in A, quotient stored back in _prt64_val
_div64_10:
	PUSH	BC
	PUSH	DE
	PUSH	HL

	LD	DE,0		; DE = running remainder
	LD	B,64

_div64_10_loop:
	; Shift remainder left by 1
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL

	; Shift _prt64_val left by 1 (64 bits, MSB first carries into DE)
	LD	HL,(_prt64_val)
	ADD	HL,HL
	LD	(_prt64_val),HL
	LD	HL,(_prt64_val+2)
	ADC	HL,HL
	LD	(_prt64_val+2),HL
	LD	HL,(_prt64_val+4)
	ADC	HL,HL
	LD	(_prt64_val+4),HL
	LD	HL,(_prt64_val+6)
	ADC	HL,HL
	LD	(_prt64_val+6),HL
	JR	NC,_div64_10_nc
	INC	DE
_div64_10_nc:

	; Check if DE >= 10
	LD	A,D
	OR	A
	JR	NZ,_div64_10_sub
	LD	A,E
	CP	10
	JR	C,_div64_10_nosub

_div64_10_sub:
	LD	A,E
	SUB	10
	LD	E,A
	LD	A,D
	SBC	A,0
	LD	D,A

	; Set bit 0 of quotient (lowest byte of _prt64_val)
	LD	HL,(_prt64_val)
	INC	HL
	LD	(_prt64_val),HL

_div64_10_nosub:
	DJNZ	_div64_10_loop

	LD	A,E		; Remainder

	POP	HL
	POP	DE
	POP	BC
	RET

	PUBLIC	_prt64_val
	COMMON	/lc_prt_dec64/
_prt64_val:	DS	8


	CSEG
; ============================================================
; lc_prt_float.mac
; ============================================================
; lc_prt_float.mac - the %f float printer (_prt_float)
; Only lc_printf_f links this module, with the soft-float runtime it needs.
; _printf_putc, _printf_upper, __ftmp and _prt_float_prec stay in
; lc_printf_core because the %e and %g handlers share them.


	EXTRN	__fmul
	EXTRN	__fsub
	EXTRN	__ftoi
	EXTRN	__itof
	EXTRN	__fadd
	EXTRN	__tmp32

	PUBLIC	_prt_float

	CSEG

; ============================================================
; Internal: print float from __ftmp (IEEE 754 single precision)
; This is included in core since it's complex and shares state
; ============================================================

_prt_float:
	PUSH	BC
	PUSH	DE
	PUSH	IX

	; Load float from __ftmp into HLDE
	LD	DE,(__ftmp)
	LD	HL,(__ftmp+2)

	; Sign first, then zero.  The zero test masks the sign bit off, so
	; testing it first sent -0.0 to _prt_float_zero with the '-' never
	; emitted: printf("%f", -0.0) printed "0.000000".  C 7.21.6.1 says
	; the sign of a negative value is always printed, and negative zero
	; is a negative value.
	BIT	7,H
	JR	Z,_prt_float_signdone

	PUSH	HL
	PUSH	DE
	LD	E,'-'
	CALL	_printf_putc
	POP	DE
	POP	HL
	RES	7,H

_prt_float_signdone:
	; An all-ones exponent is an infinity or a NaN.  Test it here, on
	; the value as it arrived: the rounding pass below runs the bits
	; through __fadd, which does not preserve the mantissa that tells
	; the two apart, so a NaN reaching that point printed as "inf".
	LD	A,H
	ADD	A,A
	LD	B,A
	LD	A,L
	RLCA
	LD	A,B
	ADC	A,0
	CP	255
	JP	Z,_prt_float_inf

	; Check for zero (the sign bit is already cleared)
	LD	A,H
	OR	L
	OR	D
	OR	E
	JP	Z,_prt_float_zero

_prt_float_pos:
	EX	DE,HL
	LD	(__fwork),HL
	LD	(__fwork+2),DE

	; Pre-round
	PUSH	DE
	PUSH	HL
	LD	DE,3F00H
	LD	HL,0
	LD	A,(_prt_float_prec)
	OR	A
	JR	Z,_prt_round_add
	LD	B,A
_prt_round_lp:
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,3DCCH
	LD	HL,0CCCDH
	CALL	__fmul
	DJNZ	_prt_round_lp
_prt_round_add:
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	_prt_addz
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	POP	HL
	POP	DE

	; Reload rounded value
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	EX	DE,HL

	; Extract exponent
	LD	A,H
	ADD	A,A
	LD	B,A
	LD	A,L
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A

	CP	255
	JP	Z,_prt_float_inf

	OR	A
	JP	Z,_prt_float_zero

	; Above 2^31 the integer no longer fits the int32 that __ftoi
	; returns -- it saturates at 2147483647 and the fraction loop then
	; emits bytes that are not even digits.  Such a value is an exact
	; integer (a float has 24 mantissa bits), so print it exactly.
	; Compare the BIASED exponent: 127+31 = 158.  Subtracting the bias
	; first and comparing against 31 would be a signed test written
	; with an unsigned CP, and every |value| < 1 (negative unbiased
	; exponent, so 0xFF..0x80 as a byte) would take the big path.
	LD	A,B
	CP	158			; unbiased exponent >= 31, i.e. >= 2^31
	JP	NC,_prt_float_big

	; ---- Integer part ----
	; __ftoi truncates the pre-rounded value to a 32-bit integer and
	; _prt_dec32 prints all 32 bits of it, which is what the %ld
	; handler already does.
	;
	; This replaces a hand-rolled mantissa walk that assembled the
	; integer part in H:L:E and then printed it with the 16-bit
	; _prt_dec, dropping E: every |value| >= 65536 came out wrong,
	; and often not even as digits, because the leftover low byte
	; was emitted as a character.  1000000.0 printed as "3906.00///".
	; The >= 2^24 path shifted a 16-bit HL left and yielded 0.
	; sprintf in this same libc has always done it the way below.
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__ftoi
	LD	(__fint),HL
	LD	(__fint+2),DE
	CALL	_prt_dec32

	CALL	_prt_float_point

	; frac = value - (float)int
	LD	HL,(__fint)
	LD	DE,(__fint+2)
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__fsub
	LD	(__fwork),HL
	LD	(__fwork+2),DE

	LD	A,(_prt_float_prec)
	LD	B,A
	OR	A
	JP	Z,_prt_float_done
	JP	_prt_float_frac

_prt_float_frac:
	PUSH	BC
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,4120H
	LD	HL,0
	CALL	__fmul
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	CALL	__ftoi
	LD	A,L
	PUSH	AF
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	POP	AF
	LD	L,A
	LD	H,0
	LD	DE,0
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(__fwork)
	LD	DE,(__fwork+2)
	CALL	__fsub
	LD	(__fwork),HL
	LD	(__fwork+2),DE
	POP	BC
	DJNZ	_prt_float_frac
	JP	_prt_float_done

; ============================================================
; %f for |value| >= 2^31.
;
; value = mantissa * 2^(e-23) with a 24-bit mantissa, so it is a whole
; number and its decimal form is exact.  Feed the mantissa's bits into
; a decimal accumulator most significant first, then double (e-23) more
; times.  Doubling a decimal digit string is exact at every step, so the
; digits printed are the value's own -- unlike scaling by powers of ten
; in float, which runs out of precision after about seven digits.
;
; Entry: HL = high half of |value| (L holds the top mantissa bits),
;        DE = low half, A = biased exponent.
; ============================================================
_prt_float_big:
	PUSH	AF
	LD	A,E
	LD	(_pbig_m),A
	LD	A,D
	LD	(_pbig_m+1),A
	LD	A,L
	AND	7FH
	OR	80H			; restore the implicit leading 1
	LD	(_pbig_m+2),A

	XOR	A
	LD	HL,_prt_big
	LD	B,40
_pbig_clr:
	LD	(HL),A
	INC	HL
	DJNZ	_pbig_clr
	LD	A,1
	LD	(_prt_biglen),A

	LD	B,24
_pbig_bits:
	PUSH	BC
	LD	A,(_pbig_m)
	ADD	A,A
	LD	(_pbig_m),A
	LD	A,(_pbig_m+1)
	ADC	A,A
	LD	(_pbig_m+1),A
	LD	A,(_pbig_m+2)
	ADC	A,A
	LD	(_pbig_m+2),A
	LD	A,0
	ADC	A,0			; A = the bit shifted out of the top
	CALL	_pbig_dbl
	POP	BC
	DJNZ	_pbig_bits

	POP	AF
	SUB	150			; (e - 127) - 23, straight off the biased form
	JR	Z,_pbig_print
	LD	B,A
_pbig_more:
	PUSH	BC
	XOR	A
	CALL	_pbig_dbl
	POP	BC
	DJNZ	_pbig_more

_pbig_print:
	LD	A,(_prt_biglen)
	LD	B,A
	LD	HL,_prt_big
	LD	D,0
	LD	E,A
	ADD	HL,DE
	DEC	HL			; most significant digit
_pbig_po:
	PUSH	BC
	PUSH	HL
	LD	A,(HL)
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	POP	HL
	DEC	HL
	POP	BC
	DJNZ	_pbig_po
	JP	_prt_float_dot_zeros

; Double the decimal accumulator, adding the carry-in in A.
_pbig_dbl:
	LD	C,A
	LD	HL,_prt_big
	LD	A,(_prt_biglen)
	LD	B,A
_pbig_dl:
	LD	A,(HL)
	ADD	A,A
	ADD	A,C
	LD	C,0
	CP	10
	JR	C,_pbig_nc
	SUB	10
	LD	C,1
_pbig_nc:
	LD	(HL),A
	INC	HL
	DJNZ	_pbig_dl
	LD	A,C
	OR	A
	RET	Z
	LD	(HL),1
	LD	A,(_prt_biglen)
	INC	A
	LD	(_prt_biglen),A
	RET

; Emit the decimal point, unless there are no digits to follow it.
; C 7.21.6.1: for %f the point appears only when the precision is
; non-zero, or when the # flag asks for it.  printf("%.0f", 2.0) was
; printing "2." , which no conforming implementation produces and which
; %e and %g in this same libc already got right.
_prt_float_point:
	LD	A,(_prt_float_prec)
	OR	A
	JR	NZ,_prt_float_point_yes
	LD	A,(_printf_alt)
	OR	A
	RET	Z
_prt_float_point_yes:
	LD	E,'.'
	JP	_printf_putc

_prt_float_zero:
	LD	E,'0'
	CALL	_printf_putc
_prt_float_dot_zeros:
	CALL	_prt_float_point
	LD	A,(_prt_float_prec)
	LD	B,A
	OR	A
	JR	Z,_prt_float_done
_prt_float_z2:
	PUSH	BC
	LD	E,'0'
	CALL	_printf_putc
	POP	BC
	DJNZ	_prt_float_z2
	JR	_prt_float_done

; HL holds the high word and DE the low word, sign already emitted.  A
; zero mantissa is an infinity, anything else a NaN; C17 7.21.6.1 p8 wants
; the uppercase spellings for %F.
_prt_float_inf:
	LD	A,L
	AND	7FH
	OR	D
	OR	E
	LD	HL,_prt_float_sinf
	JR	Z,_prt_float_spec
	LD	HL,_prt_float_snan
_prt_float_spec:
	LD	B,3
_prt_float_spec1:
	LD	A,(HL)
	PUSH	HL
	PUSH	BC
	LD	B,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,B
	JR	NZ,_prt_float_specu
	OR	20H			; lowercase unless %F
_prt_float_specu:
	LD	E,A
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	DJNZ	_prt_float_spec1

_prt_float_done:
	POP	IX
	POP	DE
	POP	BC
	RET

; ============================================================
; _prt_addz - DEHL = DEHL + (__tmp32), both positive, rounded toward zero.
; __fadd rounds to nearest.  The pre-round step above adds half a unit of
; the last printed digit, and the digit loop then cuts the result off, so
; the sum has to be the largest float that is not above the exact sum.
; The error of the nearest sum is found with the exact subtractions
; s - x and d - (s - x); if it is negative, the sum is one float too high.
; ============================================================
_prt_addz:
	LD	(_pz_x),HL
	LD	(_pz_x+2),DE
	LD	HL,(__tmp32)
	LD	(_pz_d),HL
	LD	HL,(__tmp32+2)
	LD	(_pz_d+2),HL
	LD	HL,(_pz_x)
	CALL	__fadd			; DEHL = s (DE still holds the high word)
	LD	(_pz_s),HL
	LD	(_pz_s+2),DE
	LD	HL,(_pz_x)
	LD	(__tmp32),HL
	LD	HL,(_pz_x+2)
	LD	(__tmp32+2),HL
	LD	HL,(_pz_s)
	LD	DE,(_pz_s+2)
	CALL	__fsub			; s - x
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_pz_d)
	LD	DE,(_pz_d+2)
	CALL	__fsub			; d - (s - x), the error of s
	LD	A,D
	LD	HL,(_pz_s)
	LD	DE,(_pz_s+2)
	OR	A
	RET	P			; the error is not negative
	LD	A,D			; the sum is one float too high
	OR	E
	OR	H
	OR	L
	RET	Z
	DEC	HL
	LD	A,H
	AND	L
	INC	A
	RET	NZ
	DEC	DE
	RET


	DSEG

_prt_float_sinf:	DB	'INF'
_prt_float_snan:	DB	'NAN'
__fwork:	DS	4
_pz_x:		DS	4
_pz_d:		DS	4
_pz_s:		DS	4
__fint:		DS	4	; %f integer part, as a 32-bit integer
_pbig_m:	DS	3	; %f >= 2^31: the 24-bit mantissa, shifted out MSB first
_prt_big:	DS	40	; %f >= 2^31: decimal digits, least significant first
_prt_biglen:	DB	1


	CSEG
; ============================================================
; lc_prt_hex.mac
; ============================================================
; lc_prt_hex.mac - hex printing helpers
;
; _prt_hex and _prt_hex4 honor the _printf_upper flag: when nonzero,
; hex digits A-F are uppercase; otherwise lowercase.  The flag is
; defined in lc_printf_core.mac and set by %X / %lX / %llX handlers.



	CSEG

; Convert nibble 0-15 in A to ASCII hex, honoring _printf_upper.
; Preserves BC; clobbers flags.
_prt_hex_nib:
	ADD	A,'0'
	CP	'9'+1
	RET	C		; 0-9: done
	PUSH	HL
	LD	H,A		; stash A
	LD	A,(_printf_upper)
	OR	A
	LD	A,H
	POP	HL
	JR	Z,_prt_hex_nib_lo
	ADD	A,7		; 'A'..'F'
	RET
_prt_hex_nib_lo:
	ADD	A,39		; 'a'..'f'
	RET

; Print HL as hex (no leading zeros)
	PUBLIC	_prt_hex
_prt_hex:
	PUSH	BC
	LD	B,0		; B=1 means we've printed a non-zero digit
	LD	A,H
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_prt_hexd
	LD	A,H
	AND	0FH
	CALL	_prt_hexd
	LD	A,L
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_prt_hexd
	LD	A,L
	AND	0FH
	OR	A
	JR	NZ,_prt_hexf
	PUSH	AF
	LD	A,B
	OR	A
	POP	AF
	JR	NZ,_prt_hexf
	LD	A,'0'
	LD	E,A
	CALL	__conout
	POP	BC
	RET
_prt_hexf:
	LD	B,1
	CALL	_prt_hex_nib
	LD	E,A
	CALL	__conout
	POP	BC
	RET

_prt_hexd:
	OR	A
	JR	NZ,_prt_hexd1
	LD	A,B
	OR	A
	RET	Z
	XOR	A
_prt_hexd1:
	LD	B,1
	CALL	_prt_hex_nib
	LD	E,A
	PUSH	BC
	CALL	__conout
	POP	BC
	RET

; Print HL as 4-digit hex (always all 4 digits, with leading zeros)
	PUBLIC	_prt_hex4
_prt_hex4:
	PUSH	BC
	LD	A,H
	CALL	_prt_hex4_byte
	LD	A,L
	CALL	_prt_hex4_byte
	POP	BC
	RET
_prt_hex4_byte:
	PUSH	AF
	RRCA
	RRCA
	RRCA
	RRCA
	CALL	_prt_hex4_nib
	POP	AF
_prt_hex4_nib:
	AND	0FH
	CALL	_prt_hex_nib
	LD	E,A
	CALL	__conout
	RET


	CSEG
; ============================================================
; lc_putc.mac
; ============================================================
; lc_putc.mac - split from lc_file.mac



	CSEG

; ============================================================
; int putc(int c, FILE *stream)
; Put character to stream (equivalent to fputc)
; ============================================================
	PUBLIC	_putc
_putc:
	JP	_fputc		; Just tail-call fputc


	CSEG
; ============================================================
; lc_putchar.mac
; ============================================================
; lc_putchar.mac - putchar



	CSEG

; ============================================================
; int putchar(int c)
; Output a character to console
; Argument: character on stack at IX+4
; Returns: the character written, or EOF (-1) on error
; ============================================================
	PUBLIC	_putchar
_putchar:
	; Minimal implementation - doesn't touch IX
	; Stack at entry: [ret_addr][arg]
	POP	HL		; Get return address
	POP	DE		; Get argument (char in E)
	PUSH	DE		; Restore arg for caller cleanup
	PUSH	HL		; Restore return address

	CALL	__conout

	; Return value - get arg again
	LD	HL,2
	ADD	HL,SP		; Points to arg (after ret addr)
	LD	L,(HL)
	LD	H,0
	RET


	CSEG
; ============================================================
; lc_puts.mac
; ============================================================
; lc_puts.mac - split from lc_puts.mac



	CSEG

; ============================================================
; int puts(const char *s)
; Output a string followed by newline
; Argument: pointer to string on stack at IX+4
; Returns: non-negative on success, EOF (-1) on error
; ============================================================
	PUBLIC	_puts
_puts:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	; Get string pointer
	LD	L,(IX+4)
	LD	H,(IX+5)

_puts_loop:
	LD	A,(HL)
	OR	A
	JR	Z,_puts_newline	; End of string

	LD	E,A		; Character in E
	CALL	__conout	; preserves HL
	INC	HL
	JR	_puts_loop

_puts_newline:
	; Output newline.  __conout supplies the CR when ___crlf_mode is
	; set; puts() used to hard-code CR LF here while printf/putchar/
	; fputs emitted a bare LF, so one program printed two different
	; line terminators depending on which stdio call it used.
	LD	E,0AH
	CALL	__conout

	; Return 0 (success)
	LD	HL,0

	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_qsort.mac
; ============================================================
; lc_qsort.mac - qsort (bsearch is in lc_bsearch.mac)


	CSEG

; ============================================================
; void qsort(void *base, size_t nmemb, size_t size,
;            int (*compar)(const void *, const void *))
;
; Calling convention (uc80): arguments are pushed right to left, so the
; FIRST argument is the LAST one pushed and sits nearest the return
; address; the result comes back in HL.  To call compar(a, b):
;	PUSH b / PUSH a / CALL compar / POP / POP
; The comparator may clobber every register except IX and SP, and it may
; also change its own argument slots (C parameters are writable), so a
; value that must survive the call is pushed separately, under the
; arguments, and popped after them.
;
; Algorithm:
;  - nmemb <= QS_THR: insertion sort only.
;  - Otherwise first check for one run: if the array is already in
;    order (non-decreasing), return; if it is in reverse order
;    (non-increasing), reverse it and return.  This costs nmemb-1
;    comparisons at most, and on random input it stops after two or three.
;  - Then a non-recursive quicksort: parts of more than QS_THR elements
;    are split with a Hoare partition around a median-of-three pivot.
;    The pivot stays in the array (QS_MID follows it when it is swapped).
;    Both scans stop on keys equal to the pivot, so all-equal input splits
;    in the middle and stays O(n log n).
;  - The larger part is pushed on the machine stack as (lo, hi) and the
;    loop continues with the smaller part, so the stack holds at most
;    log2(nmemb) entries (4 bytes each, at most 64 bytes).
;  - Parts of QS_THR elements or fewer are left alone; one final
;    insertion sort over the whole array finishes them (each element is
;    then less than QS_THR places from its final position).
;  - Elements are addressed with byte pointers stepped by size.  There is
;    no multiplication or division in the loops: part lengths are kept in
;    bytes, and the middle element is lo + ((hi-lo) - (k odd ? size : 0))/2
;    where k = (hi-lo)/size; k is odd when (hi-lo) AND (size AND -size)
;    is not zero.
;
; Reentrancy: the working variables live in static storage (fast 16-bit
; absolute loads), but qsort copies them to its stack frame on entry and
; copies them back on exit.  So a comparator that itself calls qsort (or
; calls a function that calls qsort) works.  An interrupt handler that
; calls qsort while another qsort runs is NOT supported (the static copy
; is live between the save and the restore).
;
; Stack on entry (after PUSH IX): base(IX+4), nmemb(IX+6), size(IX+8),
; compar(IX+10).  Preserves BC and IX.
; ============================================================
QS_THR	EQU	8		; parts of <= QS_THR elements go to insertion sort

	PUBLIC	_qsort
_qsort:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	; Save the static working area on the stack (for nested calls).
	LD	HL,-QS_NV
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL			; DE = save area
	LD	HL,QS_VARS
	LD	BC,QS_NV
	LDIR

	; size == 0 or nmemb < 2: nothing to do
	LD	L,(IX+8)
	LD	H,(IX+9)
	LD	A,H
	OR	L
	JP	Z,qs_exit
	LD	(QS_SIZE),HL
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	DE,2
	OR	A
	SBC	HL,DE
	JP	C,qs_exit

	; Trampolines: QS_TRAMP: JP compar; QS_SWJ: JP qs_sw2 or qs_swg
	LD	A,0C3H
	LD	(QS_TRAMP),A
	LD	(QS_SWJ),A
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	(QS_TRAMP+1),HL
	LD	HL,(QS_SIZE)
	LD	DE,qs_swg
	DEC	H
	INC	H
	JR	NZ,qs_e1
	LD	A,L
	CP	2
	JR	NZ,qs_e1
	LD	DE,qs_sw2
qs_e1:
	LD	(QS_SWJ+1),DE

	; QS_MASK = size AND -size (lowest set bit of size)
	LD	HL,(QS_SIZE)
	XOR	A
	SUB	L
	LD	E,A
	LD	A,0
	SBC	A,H
	LD	D,A			; DE = -size
	LD	A,E
	AND	L
	LD	E,A
	LD	A,D
	AND	H
	LD	D,A
	LD	(QS_MASK),DE

	; QS_THB = QS_THR*size, 0FFFFH if that overflows
	LD	DE,(QS_SIZE)
	LD	HL,0
	LD	B,QS_THR
qs_e2:
	ADD	HL,DE
	JR	C,qs_e3
	DJNZ	qs_e2
	JR	qs_e4
qs_e3:
	LD	HL,0FFFFH
qs_e4:
	LD	(QS_THB),HL

	; lo = base, hi = base + (nmemb-1)*size
	LD	L,(IX+6)
	LD	H,(IX+7)
	DEC	HL
	CALL	qs_mul
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(QS_LO),DE
	LD	(QS_BASE),DE
	ADD	HL,DE
	LD	(QS_HI),HL
	LD	(QS_LAST),HL
	LD	HL,0
	ADD	HL,SP
	LD	(QS_SP0),HL		; SP with an empty partition stack

	; Small array: straight to insertion sort.
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	DE,QS_THR+1
	OR	A
	SBC	HL,DE
	JP	C,qs_ins

; ---- run check: already sorted, or reverse sorted? ----
	LD	HL,(QS_LO)
	CALL	qs_cnext		; compar(p, p+size), p = lo
	BIT	7,H
	JR	NZ,qs_asc1		; < 0: ascending so far
	LD	A,H
	OR	L
	JR	NZ,qs_desc		; > 0: try descending
qs_asc1:
	; ascending: check compar(p, p+size) <= 0 for all p < hi
	LD	HL,(QS_LO)
qs_asc:
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JP	Z,qs_exit		; p == hi: all in order
	EX	DE,HL			; HL = p
	PUSH	HL
	CALL	qs_cnext
	POP	DE			; DE = p
	BIT	7,H
	EX	DE,HL
	JR	NZ,qs_asc		; < 0
	LD	A,D
	OR	E
	JR	Z,qs_asc		; == 0
	JR	qs_part			; > 0: not sorted
qs_desc:
	; descending: check compar(p, p+size) >= 0 for all p < hi
	LD	HL,(QS_LO)
qs_dsc:
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JR	Z,qs_rev		; p == hi: all in reverse order
	EX	DE,HL			; HL = p
	PUSH	HL
	CALL	qs_cnext
	POP	DE			; DE = p
	BIT	7,H
	EX	DE,HL
	JR	Z,qs_dsc		; >= 0
	JR	qs_part			; < 0: not in reverse order
qs_rev:
	; reverse the array: swap lo and hi, step inward
	LD	HL,(QS_LO)
	LD	DE,(QS_HI)
qs_rev1:
	PUSH	HL
	PUSH	DE
	CALL	QS_SWJ
	POP	HL
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE			; hi -= size
	EX	(SP),HL			; HL = lo
	ADD	HL,DE			; lo += size
	POP	DE			; DE = hi
	PUSH	HL
	OR	A
	SBC	HL,DE
	POP	HL
	JR	C,qs_rev1		; while lo < hi
	JP	qs_exit

; ---- partition [QS_LO..QS_HI], more than QS_THR elements ----
qs_part:
	; mid = lo + (d - (k odd ? size : 0)) / 2, d = hi - lo = k*size
	LD	HL,(QS_HI)
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	LD	A,(QS_MASK)
	AND	L
	LD	B,A
	LD	A,(QS_MASK+1)
	AND	H
	OR	B
	JR	Z,qs_p1
	LD	BC,(QS_SIZE)
	SBC	HL,BC			; CY is clear after OR B
qs_p1:
	SRL	H
	RR	L
	ADD	HL,DE
	LD	(QS_MID),HL

	; Median of three: order *lo <= *mid <= *hi.
	CALL	qs_ord			; mid < lo: swap
	LD	HL,(QS_HI)
	LD	DE,(QS_MID)
	CALL	qs_ord			; hi < mid: swap
	JR	Z,qs_m3
	LD	HL,(QS_MID)
	LD	DE,(QS_LO)
	CALL	qs_ord			; mid < lo: swap
qs_m3:
	; l = lo + size, r = hi - size
	LD	DE,(QS_SIZE)
	LD	HL,(QS_LO)
	ADD	HL,DE
	LD	(QS_L),HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	LD	(QS_R),HL

qs_scan:
	; while (compar(l, mid) < 0) l += size;
	LD	HL,(QS_L)
qs_sl:
	PUSH	HL			; keep l
	LD	DE,(QS_MID)
	PUSH	DE			; b = mid
	PUSH	HL			; a = l
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	DE			; DE = l
	JR	Z,qs_sl9
	LD	HL,(QS_SIZE)
	ADD	HL,DE
	JP	qs_sl
qs_sl9:
	LD	(QS_L),DE

	; while (compar(mid, r) < 0) r -= size;
	LD	HL,(QS_R)
qs_sr:
	PUSH	HL			; keep r
	PUSH	HL			; b = r
	LD	HL,(QS_MID)
	PUSH	HL			; a = mid
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	HL			; HL = r
	JR	Z,qs_sr9
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE
	JP	qs_sr
qs_sr9:
	LD	(QS_R),HL
	EX	DE,HL			; DE = r
	LD	HL,(QS_L)
	OR	A
	SBC	HL,DE
	JR	Z,qs_eq			; l == r: step both and stop
	JR	NC,qs_split		; l > r: done
	; l < r: swap, keep QS_MID on the pivot
	ADD	HL,DE			; HL = l, DE = r
	CALL	QS_SWJ
	LD	HL,(QS_MID)
	LD	DE,(QS_L)
	OR	A
	SBC	HL,DE
	JR	NZ,qs_pv1
	LD	HL,(QS_R)
	LD	(QS_MID),HL
	JR	qs_adv
qs_pv1:
	LD	HL,(QS_MID)
	LD	DE,(QS_R)
	OR	A
	SBC	HL,DE
	JR	NZ,qs_adv
	LD	HL,(QS_L)
	LD	(QS_MID),HL
qs_adv:
	CALL	qs_step
	; loop while l <= r  (qs_step leaves DE = l, HL = r)
	OR	A
	SBC	HL,DE
	JP	NC,qs_scan
	JR	qs_split

qs_eq:
	CALL	qs_step

qs_split:
	; Parts: [lo..r] and [l..hi]; byte lengths ld = r-lo, rd = hi-l
	; (a part has QS_THR elements or fewer when its length < QS_THB).
	LD	HL,(QS_R)
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	LD	(QS_LD),HL
	LD	HL,(QS_HI)
	LD	DE,(QS_L)
	OR	A
	SBC	HL,DE
	LD	(QS_RD),HL
	LD	DE,(QS_THB)
	OR	A
	SBC	HL,DE
	JR	NC,qs_rbig
	; right part small: if the left part is small too, pop
	LD	HL,(QS_LD)
	OR	A
	SBC	HL,DE
	JR	C,qs_pop
qs_goleft:
	LD	HL,(QS_R)
	LD	(QS_HI),HL
	JP	qs_part
qs_rbig:
	; right part big.  Left part small: continue with the right part.
	LD	HL,(QS_LD)
	OR	A
	SBC	HL,DE
	JR	C,qs_goright
	; both big: push the larger, continue with the smaller
	LD	HL,(QS_LD)
	LD	DE,(QS_RD)
	OR	A
	SBC	HL,DE
	JR	C,qs_pushr		; ld < rd: push right
	; push left (lo, r), continue with the right part
	LD	HL,(QS_R)
	PUSH	HL
	LD	HL,(QS_LO)
	PUSH	HL
qs_goright:
	LD	HL,(QS_L)
	LD	(QS_LO),HL
	JP	qs_part
qs_pushr:
	; push right (l, hi), continue with the left part
	LD	HL,(QS_HI)
	PUSH	HL
	LD	HL,(QS_L)
	PUSH	HL
	JR	qs_goleft

qs_pop:
	LD	HL,(QS_SP0)
	OR	A
	SBC	HL,SP
	JR	Z,qs_ins0
	POP	HL
	LD	(QS_LO),HL
	POP	HL
	LD	(QS_HI),HL
	JP	qs_part

; ---- final insertion sort over the whole array ----
qs_ins0:
	; lo = base, hi = last element
	LD	HL,(QS_BASE)
	LD	(QS_LO),HL
	LD	HL,(QS_LAST)
	LD	(QS_HI),HL
qs_ins:
	LD	HL,(QS_LO)
	LD	(QS_L),HL		; p = lo
qs_iouter:
	LD	HL,(QS_L)
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	LD	(QS_L),HL
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JR	C,qs_exit		; p > hi: done
	EX	DE,HL			; HL = q = p
qs_iinner:
	; while (q > lo && compar(q - size, q) > 0) { swap; q -= size; }
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	JR	Z,qs_iouter		; q == lo
	ADD	HL,DE
	PUSH	HL			; keep q
	PUSH	HL			; b = q
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE
	PUSH	HL			; a = q - size
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	JR	NZ,qs_ino		; < 0: in place
	LD	A,H
	OR	L
	JR	Z,qs_ino		; == 0: in place
	POP	DE			; DE = q
	LD	HL,(QS_SIZE)
	EX	DE,HL			; HL = q, DE = size
	OR	A
	SBC	HL,DE			; HL = q - size
	PUSH	HL			; new q
	ADD	HL,DE
	EX	DE,HL			; DE = q
	POP	HL			; HL = q - size
	PUSH	HL
	CALL	QS_SWJ
	POP	HL			; HL = new q
	JR	qs_iinner
qs_ino:
	POP	DE
	JP	qs_iouter

qs_exit:
	; Restore the static working area and return.
	PUSH	IX
	POP	HL
	LD	DE,-(QS_NV+2)
	ADD	HL,DE
	LD	SP,HL			; SP = save area
	LD	DE,QS_VARS
	LD	BC,QS_NV
	LDIR
	LD	HL,QS_NV
	ADD	HL,SP
	LD	SP,HL
	POP	BC
	POP	IX
	RET

; If compar(HL, DE) < 0, swap the elements at HL and DE.
; Returns NZ if it swapped, Z if not.  Clobbers A, BC, DE, HL.
qs_ord:
	PUSH	HL
	PUSH	DE
	PUSH	DE			; b
	PUSH	HL			; a
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	DE
	POP	HL
	RET	Z
	CALL	QS_SWJ
	OR	1			; NZ: swapped
	RET

; HL = compar(HL, HL + size)
qs_cnext:
	EX	DE,HL
	LD	HL,(QS_SIZE)
	ADD	HL,DE
	PUSH	HL			; b = p + size
	PUSH	DE			; a = p
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	RET

; l += size; r -= size.  Returns DE = l, HL = r.
qs_step:
	LD	DE,(QS_SIZE)
	LD	HL,(QS_L)
	ADD	HL,DE
	LD	(QS_L),HL
	LD	HL,(QS_R)
	OR	A
	SBC	HL,DE
	LD	(QS_R),HL
	LD	DE,(QS_L)
	RET

; HL = HL * QS_SIZE  (clobbers A, BC, DE)
qs_mul:
	EX	DE,HL
	LD	BC,(QS_SIZE)
	LD	HL,0
qs_mul1:
	SRL	B
	RR	C
	JR	NC,qs_mul2
	ADD	HL,DE
qs_mul2:
	LD	A,B
	OR	C
	RET	Z
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL
	JR	qs_mul1

; Swap the elements at HL and DE (reached through QS_SWJ).
; Clobbers A, BC, DE, HL.
qs_sw2:
	; size 2
	LD	C,(HL)
	LD	A,(DE)
	LD	(HL),A
	LD	A,C
	LD	(DE),A
	INC	HL
	INC	DE
	LD	C,(HL)
	LD	A,(DE)
	LD	(HL),A
	LD	A,C
	LD	(DE),A
	RET
qs_swg:
	; any size
	LD	BC,(QS_SIZE)
qs_swg1:
	LD	A,(DE)
	LDI				; (DE) <- (HL), DE++, HL++, BC--
	DEC	HL
	LD	(HL),A
	INC	HL
	JP	PE,qs_swg1		; P/V set while BC != 0
	RET

	COMMON	/lc_qsort/
; qsort working storage.  qsort saves these QS_NV bytes on its stack on
; entry and restores them on exit (see "Reentrancy" above).
QS_VARS:
QS_TRAMP:	DS	3	; JP compar
QS_SWJ:		DS	3	; JP qs_sw2 or qs_swg
QS_SIZE:	DS	2	; element size
QS_MASK:	DS	2	; lowest set bit of the element size
QS_THB:		DS	2	; QS_THR * size (bytes), 0FFFFH on overflow
QS_LO:		DS	2	; current part: first element
QS_HI:		DS	2	; current part: last element
QS_MID:		DS	2	; pivot element
QS_L:		DS	2	; left scan pointer (insertion sort: p)
QS_R:		DS	2	; right scan pointer
QS_LD:		DS	2	; left part length - size, in bytes
QS_RD:		DS	2	; right part length - size, in bytes
QS_SP0:		DS	2	; SP with an empty partition stack
QS_BASE:	DS	2	; first element of the array
QS_LAST:	DS	2	; last element of the array
QS_END:
QS_NV	EQU	QS_END-QS_VARS


	CSEG
; ============================================================
; lc_rand.mac
; ============================================================
; lc_rand.mac - split from lc_stdlib.mac



	CSEG

; ============================================================
; int rand(void)
; Returns pseudo-random number 0 to RAND_MAX (32767)
; Uses 16-bit linear congruential generator
; seed = (seed * 25173 + 13849) & 0x7FFF
; ============================================================
	PUBLIC	_rand
_rand:
	PUSH	BC
	LD	BC,(_rand_seed)
	LD	HL,0
	LD	DE,25173
rand_lp:			; HL = seed * 25173 by shift and add; no
	SRL	D		; runtime module (__mul16 pulled ~600 bytes)
	RR	E
	JR	NC,rand_sk
	ADD	HL,BC
rand_sk:
	SLA	C
	RL	B
	LD	A,D
	OR	E
	JR	NZ,rand_lp
	POP	BC
	LD	DE,13849
	ADD	HL,DE		; HL = seed * 25173 + 13849
	LD	A,H
	AND	7FH		; Mask to 0-32767
	LD	H,A
	LD	(_rand_seed),HL
	RET


	CSEG
; ============================================================
; lc_rand_data.mac
; ============================================================
; lc_rand_data.mac - split from lc_stdlib.mac


	PUBLIC	_rand_seed


	DSEG


; rand seed
_rand_seed:	DW	1	; Default seed = 1


	CSEG
; ============================================================
; lc_realloc.mac
; ============================================================
; lc_realloc.mac - split from lc_malloc.mac



	CSEG

; ============================================================
; void *realloc(void *ptr, size_t size)
; NULL ptr: malloc.  Size 0: free, return NULL.  A block that is
; already big enough is returned as is; otherwise allocate, copy the old
; contents and free the old block (the old block stays valid when the
; allocation fails).
; ============================================================
	PUBLIC	_realloc
_realloc:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = ptr
	LD	E,(IX+6)
	LD	D,(IX+7)	; DE = size
	LD	A,H
	OR	L
	JR	NZ,_rea_have
	CALL	__malloc_de
	POP	IX
	RET
_rea_have:
	LD	A,D
	OR	E
	JR	NZ,_rea_do
	CALL	__free_hl
	LD	HL,0
	POP	IX
	RET
_rea_do:
	DEC	HL
	DEC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)		; BC = size of the old block
	INC	HL		; HL = payload
	PUSH	HL		; old payload
	PUSH	BC		; old size
	LD	H,B
	LD	L,C
	OR	A
	SBC	HL,DE		; old size - requested size
	JR	NC,_rea_same
	CALL	__malloc_de	; HL = new payload
	POP	BC		; BC = old size
	POP	DE		; DE = old payload
	LD	A,H
	OR	L
	JR	Z,_rea_ret	; no memory: the old block is untouched
	PUSH	HL		; new payload
	PUSH	DE		; old payload
	EX	DE,HL		; DE = new, HL = old
	LDIR
	POP	HL
	CALL	__free_hl
	POP	HL		; new payload
_rea_ret:
	POP	IX
	RET
_rea_same:
	POP	BC
	POP	HL		; old payload
	POP	IX
	RET


	CSEG
