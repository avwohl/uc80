@ENDIF2_fmod:
	ld	A,(??AUTO_fmod+3)
	and	127
	cp	127
	jr nz,@ENDIF4_fmod
	ld	A,(??AUTO_fmod+2)
	and	128
	jr z,@ENDIF4_fmod
	ld	HL,0
	ld	(??AUTO_fmod+8),HL
	ld	HL,32704
	ld	(??AUTO_fmod+10),HL
	ld	A,(??AUTO_fmod+2)
	and	127
	push	AF
	ld	A,(??AUTO_fmod+1)
	ld	E,A
	pop	AF
	or	E
	push	AF
	ld	A,(??AUTO_fmod)
	ld	E,A
	pop	AF
	or	E
	or	A
	jr z,@TERN_E5_fmod
	ld	L,(IX+4)
	ld	H,(IX+5)
	ld	E,(IX+6)
	ld	D,(IX+7)
	jp @fmod_ret
@TERN_E5_fmod:
	ld	HL,(??AUTO_fmod+8)
	ld	DE,(??AUTO_fmod+10)
@TERN_END6_fmod:
	jp	@fmod_ret
@ENDIF4_fmod:
	ld	A,(??AUTO_fmod+7)
	and	127
	push	AF
	ld	A,(??AUTO_fmod+6)
	ld	E,A
	pop	AF
	or	E
	push	AF
	ld	A,(??AUTO_fmod+5)
	ld	E,A
	pop	AF
	or	E
	push	AF
	ld	A,(??AUTO_fmod+4)
	ld	E,A
	pop	AF
	or	E
	or	A
	jr nz,@ENDIF8_fmod
	ld	HL,0
	ld	(??AUTO_fmod+8),HL
	ld	HL,32704
	ld	(??AUTO_fmod+10),HL
	ld	HL,(??AUTO_fmod+8)
	ld	DE,(??AUTO_fmod+10)
	jp	@fmod_ret
@ENDIF8_fmod:
	ld	A,(??AUTO_fmod+7)
	and	127
	cp	127
	jr nz,@AND_S12_fmod
	ld	A,(??AUTO_fmod+6)
	and	128
	jr nz,@OR_S11_fmod
@AND_S12_fmod:
	ld	A,(??AUTO_fmod+3)
	and	127
	push	AF
	ld	A,(??AUTO_fmod+2)
	ld	E,A
	pop	AF
	or	E
	push	AF
	ld	A,(??AUTO_fmod+1)
	ld	E,A
	pop	AF
	or	E
	push	AF
	ld	A,(??AUTO_fmod)
	ld	E,A
	pop	AF
	or	E
	or	A
	jr nz,@ENDIF10_fmod
@OR_S11_fmod:
	ld	L,(IX+4)
	ld	H,(IX+5)
	ld	E,(IX+6)
	ld	D,(IX+7)
	jp	@fmod_ret
@ENDIF10_fmod:
	ld	HL,??AUTO_fmod+20
	push	HL
	ld	L,(IX+4)
	ld	H,(IX+5)
	ld	E,(IX+6)
	ld	D,(IX+7)
	push	DE
	push	HL
	call	__m_unpack
	pop	BC
	pop	BC
	pop	BC
	ld	(??AUTO_fmod+12),HL
	ld	(??AUTO_fmod+14),DE
	ld	HL,??AUTO_fmod+22
	push	HL
	ld	L,(IX+8)
	ld	H,(IX+9)
	ld	E,(IX+10)
	ld	D,(IX+11)
	push	DE
	push	HL
	call	__m_unpack
	pop	BC
	pop	BC
	pop	BC
	ld	(??AUTO_fmod+16),HL
	ld	(??AUTO_fmod+18),DE
	ld	HL,(??AUTO_fmod+20)
	ld	DE,(??AUTO_fmod+22)
	ld	A,L
	sub	E
	ld	A,H
	sbc	A,D
	jp	PO,@CMP_NV15_fmod
	xor	128
@CMP_NV15_fmod:
	jp	P,@ENDIF14_fmod
	ld	L,(IX+4)
	ld	H,(IX+5)
	ld	E,(IX+6)
	ld	D,(IX+7)
	jp	@fmod_ret
@ENDIF14_fmod:
@WHILE16_fmod:
	ld	HL,(??AUTO_fmod+20)
	ld	DE,(??AUTO_fmod+22)
	ld	A,E
	sub	L
	ld	A,D
	sbc	A,H
	jp	PO,@CMP_NV18_fmod
	xor	128
@CMP_NV18_fmod:
	jp	P,@ENDWHILE17_fmod
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	ld	BC,(??AUTO_fmod+16)
	or	A
	sbc	HL,BC
	ex	DE,HL
	ld	BC,(??AUTO_fmod+18)
	sbc	HL,BC
	jr c,@ENDIF20_fmod
	ld	HL,(??AUTO_fmod+12)
	ld	BC,(??AUTO_fmod+16)
	or	A
	sbc	HL,BC
	ld	(??AUTO_fmod+12),HL
	ld	HL,(??AUTO_fmod+14)
	ld	BC,(??AUTO_fmod+18)
	sbc	HL,BC
	ld	(??AUTO_fmod+14),HL
@ENDIF20_fmod:
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	add	HL,HL
	rl	E
	rl	D
	ld	(??AUTO_fmod+12),HL
	ld	(??AUTO_fmod+14),DE
	ld	HL,(??AUTO_fmod+20)
	dec	HL
	ld	(??AUTO_fmod+20),HL
	jr @WHILE16_fmod
@ENDWHILE17_fmod:
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	ld	BC,(??AUTO_fmod+16)
	or	A
	sbc	HL,BC
	ex	DE,HL
	ld	BC,(??AUTO_fmod+18)
	sbc	HL,BC
	jr c,@ENDIF22_fmod
	ld	HL,(??AUTO_fmod+12)
	ld	BC,(??AUTO_fmod+16)
	or	A
	sbc	HL,BC
	ld	(??AUTO_fmod+12),HL
	ld	HL,(??AUTO_fmod+14)
	ld	BC,(??AUTO_fmod+18)
	sbc	HL,BC
	ld	(??AUTO_fmod+14),HL
@ENDIF22_fmod:
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	ld	A,H
	or	L
	or	E
	or	D
	jr nz,@ENDIF24_fmod
	ld	HL,(??AUTO_fmod)
	ld	DE,(??AUTO_fmod+2)
	ld	HL,0
	ld	E,0
	ld	A,D
	and	128
	ld	D,A
	ld	(??AUTO_fmod+8),HL
	ld	(??AUTO_fmod+10),DE
	ld	HL,(??AUTO_fmod+8)
	ld	DE,(??AUTO_fmod+10)
	jr @fmod_ret
@ENDIF24_fmod:
@WHILE25_fmod:
	ld	A,(??AUTO_fmod+14)
	and	128
	jr nz,@ENDWHILE26_fmod
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	add	HL,HL
	rl	E
	rl	D
	ld	(??AUTO_fmod+12),HL
	ld	(??AUTO_fmod+14),DE
	ld	HL,(??AUTO_fmod+20)
	dec	HL
	ld	(??AUTO_fmod+20),HL
	jr @WHILE25_fmod
@ENDWHILE26_fmod:
	ld	HL,(??AUTO_fmod+20)
	push	HL
	ld	HL,(??AUTO_fmod+12)
	ld	DE,(??AUTO_fmod+14)
	push	DE
	push	HL
	ld	A,(??AUTO_fmod+3)
	and	128
	add	A,255
	sbc	A,A
	and	1
	ld	L,A
	ld	H,0
	push	HL
	call	__m_pack
	pop	BC
	pop	BC
	pop	BC
	pop	BC
@fmod_ret:
	pop	IX
	ret


; Implicit external functions

; Static storage that starts as zero
	COMMON	/lc_fmod/
; Shared automatic storage
??AUTO_fmod:
	ds	24


	CSEG
; ============================================================
; lc_fopen.mac
; ============================================================
; lc_fopen.mac - split from lc_file.mac

BDOS_OPEN	EQU	15	; Open file
BDOS_DELETE	EQU	19	; Delete file
BDOS_MAKE	EQU	22	; Make (create) file
FILE_SIZE	EQU	170	; Total FILE structure size
FLAG_READ	EQU	10H	; can read
FLAG_CANW	EQU	20H	; can write
FLAG_APPEND	EQU	40H	; every write goes to the end

	PUBLIC	_parse_fcb


	CSEG

; ============================================================
; FILE *fopen(const char *pathname, const char *mode)
; Open a file.  Modes: r, w, a, and r+, w+, a+ ("b" and "t" are ignored)
; ============================================================
	PUBLIC	_fopen
	PUBLIC	__fopen_at
; ============================================================
; Internal: __fopen_at(pathname, mode, FILE *slot).  Like fopen, but the
; file goes in the given slot (freopen uses it).
; ============================================================
__fopen_at:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	LD	L,(IX+8)
	LD	H,(IX+9)
	JP	_fopen_found

_fopen:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Find free file slot
	LD	HL,_file_slots
	LD	A,(_file_nmax)
	LD	B,A
_fopen_find:
	PUSH	HL
	INC	HL		; Point to flags
	LD	A,(HL)
	AND	FLAG_OPEN
	POP	HL
	JR	Z,_fopen_found
	LD	DE,FILE_SIZE
	ADD	HL,DE
	DJNZ	_fopen_find
	; No free slot
	LD	HL,0
	JP	_fopen_ret

_fopen_found:
	; HL = FILE structure, save it
	PUSH	HL

	; Parse mode string: r, w or a, then any of "+", "b", "t".
	; B = flags of the stream: r can read, w can write and starts in the
	; writing state, a can write and appends.  "+" adds the other way.
	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = mode
	LD	A,(HL)
	LD	B,FLAG_READ
	CP	'r'
	JR	Z,_fopen_mode
	LD	B,FLAG_CANW+FLAG_WRITE
	CP	'w'
	JR	Z,_fopen_mode
	LD	B,FLAG_CANW+FLAG_APPEND
	CP	'a'
	JR	Z,_fopen_mode
	; Invalid mode
	POP	HL
	LD	HL,0
	JP	_fopen_ret

_fopen_mode:
	INC	HL
	LD	A,(HL)
	OR	A
	JR	Z,_fopen_setup
	CP	'+'
	JR	NZ,_fopen_mode
	LD	A,B
	OR	FLAG_READ+FLAG_CANW
	LD	B,A
	JR	_fopen_mode

_fopen_setup:
	; B = mode flags, stack has FILE*
	POP	HL		; HL = FILE*
	PUSH	HL
	PUSH	BC		; Save mode

	; Initialize FILE structure
	LD	A,3		; fd = 3+ for files
	LD	(HL),A
	INC	HL
	XOR	A
	LD	(HL),A		; flags = 0 (will set later)
	INC	HL
	LD	A,0FFH
	LD	(HL),A		; unget = none
	INC	HL
	XOR	A
	LD	(HL),A		; bufpos = 0
	INC	HL
	LD	(HL),A		; bufcnt = 0
	INC	HL
	LD	(HL),A		; reserved = 0
	INC	HL		; HL now at FCB

	; Clear FCB (36 bytes)
	PUSH	HL
	LD	B,36
_fopen_clr:
	LD	(HL),A
	INC	HL
	DJNZ	_fopen_clr
	POP	HL		; HL = FCB start

	; Parse pathname into FCB
	; HL = FCB, pathname at IX+4
	PUSH	HL
	LD	E,(IX+4)
	LD	D,(IX+5)	; DE = pathname
	CALL	_parse_fcb
	POP	HL		; HL = FCB

	; Get FILE* back
	POP	BC		; B = mode flags
	POP	DE		; DE = FILE*
	PUSH	DE
	PUSH	BC

	; Set DMA to FILE's buffer
	PUSH	HL
	LD	HL,FILE_BUFFER-FILE_FCB
	ADD	HL,DE
	EX	DE,HL		; DE = buffer address
	LD	C,BDOS_SETDMA
	CALL	BDOS
	POP	DE		; DE = FCB

	; Open or create based on mode
	POP	BC		; B = mode flags
	POP	HL		; HL = FILE*
	PUSH	HL
	PUSH	BC

	LD	A,B
	AND	FLAG_WRITE
	JR	Z,_fopen_notw

	; Write mode - delete existing, create new
	PUSH	DE
	LD	C,BDOS_DELETE
	CALL	BDOS
	POP	DE
	LD	C,BDOS_MAKE
	CALL	BDOS
	JR	_fopen_check

_fopen_notw:
	; Append mode - open the file, or create it when there is none
	LD	A,B
	AND	FLAG_APPEND
	JR	Z,_fopen_doopen
	PUSH	DE
	LD	C,BDOS_OPEN
	CALL	BDOS
	POP	DE
	CP	0FFH
	JR	NZ,_fopen_check
	LD	C,BDOS_MAKE
	CALL	BDOS
	JR	_fopen_check

_fopen_doopen:
	; Read mode - open existing
	LD	C,BDOS_OPEN
	CALL	BDOS

_fopen_check:
	; A = 0xFF on error
	CP	0FFH
	JR	NZ,_fopen_ok

	; Open failed
	POP	BC
	POP	HL
	LD	HL,0
	JP	_fopen_ret

_fopen_ok:
	; exit() and the return from main must close the open files.
	LD	HL,__exit_run
	LD	(__exit_hook),HL
	LD	HL,_fclose_all
	LD	(__exit_fhook),HL
	; Set flags and return FILE*
	POP	BC		; B = mode flags
	POP	HL		; HL = FILE*
	PUSH	HL
	INC	HL		; Point to flags
	LD	A,B
	OR	FLAG_OPEN
	LD	(HL),A
	POP	HL		; Return FILE*
	; A stream that appends starts in the reading state at the start of the
	; file.  The first fputc puts it at the end (lc_ftowrite.mac).
	JR	_fopen_ret

_fopen_ret:
	POP	DE
	POP	BC
	POP	IX
	RET

; ============================================================
; Internal: close every open file (exit() calls this through __exit_fhook).
; ============================================================
_fclose_all:
	LD	HL,_file_slots
	LD	A,(_file_nmax)
	LD	B,A
_fclose_all1:
	PUSH	BC
	PUSH	HL
	PUSH	HL		; the argument of fclose
	CALL	_fclose
	POP	HL
	POP	HL
	LD	DE,FILE_SIZE
	ADD	HL,DE
	POP	BC
	DJNZ	_fclose_all1
	RET

; ============================================================
; Internal: Parse pathname into FCB
; DE = pathname, HL = FCB
; ============================================================
_parse_fcb:
	PUSH	BC
	PUSH	HL

	; Check for drive letter
	LD	A,(DE)
	INC	DE
	LD	B,A
	LD	A,(DE)
	CP	':'
	JR	NZ,_parse_nodrive
	; Has drive letter
	LD	A,B
	AND	0DFH		; Uppercase
	SUB	'A'-1		; A=1, B=2, etc.
	LD	(HL),A
	INC	DE		; Skip colon
	JR	_parse_name

_parse_nodrive:
	DEC	DE		; Back up
	XOR	A		; Default drive
	LD	(HL),A

_parse_name:
	INC	HL		; Point to filename
	LD	B,8		; 8 chars max
_parse_name_loop:
	LD	A,(DE)
	OR	A
	JR	Z,_parse_pad_name
	CP	'.'
	JR	Z,_parse_ext
	; Store uppercase (only for a-z, leave digits etc. alone)
	CP	'a'
	JR	C,_parse_name_store
	CP	'z'+1
	JR	NC,_parse_name_store
	AND	0DFH
_parse_name_store:
	LD	(HL),A
	INC	HL
	INC	DE
	DJNZ	_parse_name_loop
	; Skip to dot or end
_parse_skip:
	LD	A,(DE)
	OR	A
	JR	Z,_parse_pad_name
	CP	'.'
	JR	Z,_parse_ext
	INC	DE
	JR	_parse_skip

_parse_pad_name:
	; Pad remaining name with spaces
	LD	A,' '
_parse_pad_n:
	LD	A,B
	OR	A
	JR	Z,_parse_ext_start
	LD	A,' '
	LD	(HL),A
	INC	HL
	DEC	B
	JR	_parse_pad_n

_parse_ext:
	INC	DE		; Skip dot
	; Pad any remaining name chars
	JR	_parse_pad_name

_parse_ext_start:
	; Now at extension position (FCB+9)
	LD	B,3		; 3 chars max
_parse_ext_loop:
	LD	A,(DE)
	OR	A
	JR	Z,_parse_pad_ext
	; Uppercase only a-z
	CP	'a'
	JR	C,_parse_ext_store
	CP	'z'+1
	JR	NC,_parse_ext_store
	AND	0DFH
_parse_ext_store:
	LD	(HL),A
	INC	HL
	INC	DE
	DJNZ	_parse_ext_loop
	JR	_parse_done

_parse_pad_ext:
	LD	A,B
	OR	A
	JR	Z,_parse_done
	LD	A,' '
	LD	(HL),A
	INC	HL
	DEC	B
	JR	_parse_pad_ext

_parse_done:
	POP	HL
	POP	BC
	RET



	CSEG
; ============================================================
; lc_fpclassify.mac
; ============================================================
; lc_fpclassify.mac - _fpclassify
; Split from lc_fpclassify.mac


	CSEG
; ============================================================
; fpclassify(x) - classify floating-point value
; ============================================================
	PUBLIC	_fpclassify
_fpclassify:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	; Extract exponent
	LD	A,(IX+7)	; D byte (SEEEEEEE)
	AND	7FH		; Strip sign (0EEEEEEE)
	ADD	A,A		; Shift left (EEEEEEE0)
	LD	B,A
	LD	A,(IX+6)	; E byte (EMMMMMMM)
	RLCA			; Rotate - exp low bit into bit 0
	AND	1		; Isolate exp low bit
	OR	B		; A = 8-bit biased exponent

	; exp == 0?
	OR	A
	JR	Z,_fpc_expz

	; exp == 255?
	CP	255
	JR	Z,_fpc_exp255

	; Normal (exp 1..254)
	LD	HL,4		; FP_NORMAL
	POP	IX
	RET

_fpc_expz:
	; Check mantissa
	LD	A,(IX+6)
	AND	7FH
	OR	(IX+5)
	OR	(IX+4)
	JR	NZ,_fpc_sub
	; Zero
	LD	HL,2		; FP_ZERO
	POP	IX
	RET

_fpc_sub:
	LD	HL,3		; FP_SUBNORMAL
	POP	IX
	RET

_fpc_exp255:
	; Check mantissa for NaN vs Inf
	LD	A,(IX+6)
	AND	7FH
	OR	(IX+5)
	OR	(IX+4)
	JR	NZ,_fpc_nan
	; Infinity
	LD	HL,1		; FP_INFINITE
	POP	IX
	RET

_fpc_nan:
	LD	HL,0		; FP_NAN
	POP	IX
	RET


	CSEG
; ============================================================
; lc_fprintf.mac
; ============================================================
; lc_fprintf.mac - fprintf, vfprintf (vprintf and vsprintf are in lc_vprintf.mac and lc_vsprintf.mac).
;
; Each of these carried its own formatter, so a conversion the printf
; table knew about was invisible here.  fprintf had no float handler at
; all -- fprintf(stdout, "%f", 1.5) printed an empty field and desynced
; the rest of the argument list -- and none of the four knew %e, %g or
; %F.  See lc_sprintf.mac for why there is only one formatter now.
;
; A va_list in uc80 is a pointer to the arguments, which is exactly the
; base the engine indexes from, so the v* forms set IX = ap and C = 0 and
; are otherwise identical to their variadic counterparts.


	CSEG

	PUBLIC	_fprintf
	PUBLIC	_vfprintf

; int fprintf(FILE *stream, const char *fmt, ...)
_fprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_fprintf_stream),HL

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,_fprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	C,8			; first vararg at IX+8
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL
	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; int vfprintf(FILE *stream, const char *fmt, va_list ap)
_vfprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_fprintf_stream),HL

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,_fprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	E,(IX+8)
	LD	D,(IX+9)		; DE = va_list
	PUSH	HL
	PUSH	DE
	POP	IX			; IX = ap, the argument base
	POP	HL
	LD	C,0
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL
	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; Sink: character in E, out through fputc so the stream's own buffering
; and its text/binary handling stay in charge.  _printf_putc has already
; saved the registers and counts the byte when we return.
_fprintf_sink:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	D,0			; DE = (int)ch, E already holds it
	LD	HL,(_fprintf_stream)
	PUSH	HL			; stream argument
	PUSH	DE			; char argument
	CALL	_fputc
	POP	DE
	POP	DE
	POP	HL
	POP	DE
	POP	BC
	RET

	COMMON	/lc_fprintf/

_fprintf_stream: DS	2


	CSEG
; ============================================================
; lc_fputc.mac
; ============================================================
; lc_fputc.mac - split from lc_file.mac




	CSEG

; ============================================================
; int fputc(int c, FILE *stream)
; Put character to stream
; ============================================================
	PUBLIC	_fputc
_fputc:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = stream

	; Check for NULL
	LD	A,H
	OR	L
	JP	Z,_fputc_err

	; Check if stdout/stderr
	LD	A,(HL)
	CP	3
	JR	NC,_fputc_file

	; Console output.  Only this branch translates LF -> CR LF; the
	; _fputc_file branch below writes raw bytes, so "w" and "wb"
	; streams both stay byte-for-byte what the program handed us.
	LD	E,(IX+4)
	CALL	__conout
	LD	L,(IX+4)
	LD	H,0
	JP	_fputc_ret

_fputc_file:
	; A stream in the reading state (r+, or a+ after a read) goes to the
	; writing state first; a stream that cannot write fails here.
	INC	HL
	BIT	3,(HL)
	DEC	HL
	JR	NZ,_fputc_ready
	PUSH	HL
	CALL	_file_towrite
	POP	HL
	JR	NZ,_fputc_err
_fputc_ready:
	PUSH	HL		; the FILE* stays on the stack
	LD	DE,FILE_BUFPOS
	ADD	HL,DE
	LD	A,(HL)		; A = bufpos
	CP	128
	JR	C,_fputc_store

	; Buffer full - write the record and start the next one
	POP	HL
	PUSH	HL
	CALL	_fflush_internal
	LD	A,H
	OR	L
	JR	NZ,_fputc_flerr
	POP	HL
	PUSH	HL
	CALL	_file_nextrec
	XOR	A		; bufpos = 0

_fputc_store:
	; A = bufpos.  Store the byte in the buffer.
	POP	HL
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	LD	E,A
	LD	D,0
	ADD	HL,DE		; HL = buffer[bufpos]
	LD	A,(IX+4)
	LD	(HL),A		; Store the byte

	; The buffer now differs from the file (flag bit 7).  Increment
	; bufpos.  bufcnt is the number of bytes of the record that are
	; valid (the high water mark), so a flush pads only after them.
	POP	HL
	PUSH	HL
	INC	HL
	SET	7,(HL)
	INC	HL
	INC	HL		; bufpos
	INC	(HL)		; bufpos++
	LD	A,(HL)
	INC	HL
	CP	(HL)
	JR	C,_fputc_hw
	LD	(HL),A		; bufcnt = bufpos
_fputc_hw:

	POP	HL
	LD	L,(IX+4)
	LD	H,0
	JP	_fputc_ret

_fputc_flerr:
	POP	HL
_fputc_err:
	LD	HL,-1
_fputc_ret:
	POP	DE
	POP	BC
	POP	IX
	RET

; ============================================================
; Internal: start the next record.  HL = FILE*
; ============================================================
	PUBLIC	_file_nextrec
_file_nextrec:
	PUSH	HL
	LD	DE,FILE_BUFPOS
	ADD	HL,DE
	XOR	A
	LD	(HL),A		; bufpos = 0
	INC	HL
	LD	(HL),A		; bufcnt = 0
	POP	HL
	PUSH	HL
	LD	DE,FILE_RECNO
	ADD	HL,DE
	INC	(HL)
	JR	NZ,_nextrec_ld
	INC	HL
	INC	(HL)
_nextrec_ld:
	; A stream that can also read, or that fseek moved (byte 5 is not 0),
	; keeps the bytes that the next record already has, so a write into
	; it changes only the bytes written.
	POP	HL
	PUSH	HL
	INC	HL
	BIT	4,(HL)
	POP	HL
	JP	NZ,_file_loadrec
	PUSH	HL
	LD	DE,5
	ADD	HL,DE
	LD	A,(HL)
	POP	HL
	OR	A
	RET	Z
	JP	_file_loadrec


	CSEG
; ============================================================
; lc_fputs.mac
; ============================================================
; lc_fputs.mac - split from lc_file.mac



	CSEG

; ============================================================
; int fputs(const char *s, FILE *stream)
; Write string to stream
; ============================================================
	PUBLIC	_fputs
_fputs:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+6)
	LD	H,(IX+7)	; stream
	LD	A,H
	OR	L
	JR	Z,_fputs_err

	LD	E,(IX+4)	; string
	LD	D,(IX+5)

_fputs_loop:
	LD	A,(DE)
	OR	A
	JR	Z,_fputs_ok

	PUSH	DE
	PUSH	HL
	; Push args for fputc(char, stream)
	PUSH	HL		; stream
	LD	L,A
	LD	H,0
	PUSH	HL		; char
	CALL	_fputc
	POP	BC
	POP	BC
	POP	HL
	POP	DE

	; Check for error
	LD	A,H
	INC	A
	JR	Z,_fputs_err	; HL was -1

	INC	DE
	JR	_fputs_loop

_fputs_ok:
	LD	HL,0
	POP	DE
	POP	BC
	POP	IX
	RET

_fputs_err:
	LD	HL,-1
	POP	DE
	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_fread.mac
; ============================================================
; lc_fread.mac - split from lc_file.mac


	EXTRN	__div16
	EXTRN	__mul16

	CSEG

; ============================================================
; size_t fread(void *ptr, size_t size, size_t nmemb, FILE *stream)
; Read data from stream
; ============================================================
	PUBLIC	_fread
_fread:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Calculate total bytes = size * nmemb
	LD	L,(IX+6)
	LD	H,(IX+7)	; size
	LD	E,(IX+8)
	LD	D,(IX+9)	; nmemb
	CALL	__mul16		; HL = total bytes
	LD	B,H
	LD	C,L		; BC = bytes to read

	; If zero, return 0
	LD	A,B
	OR	C
	JR	Z,_fread_done

	; Save dest pointer
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = dest ptr
	LD	(_fread_ptr),HL

	; Initialize read count
	LD	HL,0
	LD	(_fread_cnt),HL

_fread_loop:
	; Call fgetc(stream)
	LD	L,(IX+10)
	LD	H,(IX+11)	; stream
	PUSH	BC		; Save remaining count
	PUSH	HL
	CALL	_fgetc
	POP	DE		; Clean up arg

	; Check for EOF (returns -1 = 0xFFFF)
	LD	A,H
	AND	L
	INC	A		; If HL=0xFFFF, A becomes 0
	JR	Z,_fread_eof

	; Store byte
	LD	A,L
	LD	HL,(_fread_ptr)
	LD	(HL),A
	INC	HL
	LD	(_fread_ptr),HL

	; Increment count
	LD	HL,(_fread_cnt)
	INC	HL
	LD	(_fread_cnt),HL

	; Decrement BC and continue
	POP	BC		; Restore remaining count
	DEC	BC
	LD	A,B
	OR	C
	JR	NZ,_fread_loop
	JR	_fread_done

_fread_eof:
	POP	BC		; Clean up saved count

_fread_done:
	; Return items read (cnt / size)
	; __div16 does HL = DE / HL, so DE = cnt, HL = size
	LD	E,(IX+6)
	LD	D,(IX+7)	; DE = size (temporarily)
	LD	A,D
	OR	E
	JR	Z,_fread_ret
	LD	HL,(_fread_cnt)	; HL = cnt
	EX	DE,HL		; Now DE = cnt, HL = size
	CALL	__div16		; HL = cnt / size

_fread_ret:
	POP	DE
	POP	BC
	POP	IX
	RET


	COMMON	/lc_fread/

_fread_ptr:	DS	2	; fread dest pointer temp
_fread_cnt:	DS	2	; fread byte counter temp


	CSEG
; ============================================================
; lc_free.mac
; ============================================================
; lc_free.mac - split from lc_malloc.mac



	PUBLIC	__free_hl

	CSEG

; ============================================================
; void free(void *ptr)
; Put the block on the free list (sorted by address) and merge it with
; the free blocks next to it.
; ============================================================
	PUBLIC	_free
_free:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = payload
	CALL	__free_hl
	POP	IX
	RET

; Free the block whose payload is HL (0 is ignored).
; Clobbers AF, BC, DE, HL, IX.
__free_hl:
	LD	A,H
	OR	L
	RET	Z
	DEC	HL
	DEC	HL
	EX	DE,HL		; DE = block
	PUSH	DE
	POP	IX		; IX = block
	LD	BC,_free_head	; BC = address of the link that points at HL
	LD	HL,(_free_head)
_fre_scan:
	LD	A,H
	OR	L
	JR	Z,_fre_here
	LD	A,E
	SUB	L
	LD	A,D
	SBC	A,H		; carry if block < candidate
	JR	C,_fre_here
	INC	HL
	INC	HL
	LD	B,H
	LD	C,L		; BC = &candidate.next
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A		; HL = candidate.next
	JR	_fre_scan
_fre_here:
	; the block goes between the block that owns link BC and HL
	LD	(IX+2),L
	LD	(IX+3),H	; block.next = HL
	LD	A,E
	LD	(BC),A
	INC	BC
	LD	A,D
	LD	(BC),A
	DEC	BC		; the link now points at the block
	LD	A,H
	OR	L
	JR	Z,_fre_prev
	; merge with the next block when it starts where this one ends
	PUSH	HL		; next
	LD	L,(IX+0)
	LD	H,(IX+1)
	INC	HL
	INC	HL
	ADD	HL,DE		; HL = end of this block
	POP	DE		; DE = next
	OR	A
	SBC	HL,DE
	JR	NZ,_fre_prev
	LD	H,D
	LD	L,E		; HL = next block
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = next.size
	INC	HL		; HL = &next.next
	PUSH	HL
	LD	L,(IX+0)
	LD	H,(IX+1)
	ADD	HL,DE
	INC	HL
	INC	HL
	LD	(IX+0),L
	LD	(IX+1),H	; size += next.size + 2
	POP	HL
	LD	A,(HL)
	LD	(IX+2),A
	INC	HL
	LD	A,(HL)
	LD	(IX+3),A	; block.next = next.next
_fre_prev:
	; merge into the previous block when it ends where this one starts
	LD	HL,_free_head
	OR	A
	SBC	HL,BC
	RET	Z		; no previous block: BC is the list head
	DEC	BC
	DEC	BC		; BC = previous block
	LD	H,B
	LD	L,C
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = prev.size
	LD	HL,2
	ADD	HL,DE
	ADD	HL,BC		; HL = end of the previous block
	PUSH	IX
	POP	DE		; DE = this block
	OR	A
	SBC	HL,DE
	RET	NZ
	LD	L,(IX+0)
	LD	H,(IX+1)
	INC	HL
	INC	HL		; HL = this block's size + 2
	LD	A,(BC)
	LD	E,A
	INC	BC
	LD	A,(BC)
	LD	D,A		; DE = prev.size, BC = prev + 1
	ADD	HL,DE
	LD	A,H
	LD	(BC),A
	DEC	BC
	LD	A,L
	LD	(BC),A		; prev.size += size + 2
	INC	BC
	INC	BC		; BC = &prev.next
	LD	A,(IX+2)
	LD	(BC),A
	INC	BC
	LD	A,(IX+3)
	LD	(BC),A		; prev.next = block.next
	RET


	CSEG
; ============================================================
; lc_freopen.mac
; ============================================================
; lc_freopen.mac - split from lc_file.mac



	CSEG

; ============================================================
; FILE *freopen(const char *pathname, const char *mode, FILE *stream)
; Close the file of stream (a file from fopen) and open pathname in the
; same FILE, so the result is stream.  Returns NULL, and does not change
; stream, when stream is NULL, stdin, stdout or stderr: those have no room
; for a file.  Returns NULL, with stream closed, when the open fails.
; ============================================================
	PUBLIC	_freopen
_freopen:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+8)
	LD	H,(IX+9)	; stream
	LD	A,H
	OR	L
	JR	Z,_freopen_no
	LD	A,(HL)
	CP	3
	JR	C,_freopen_no	; stdin/stdout/stderr
	PUSH	HL
	CALL	_fclose
	POP	BC
	POP	IX
	JP	__fopen_at	; the arguments are still on the stack
_freopen_no:
	LD	HL,0
	POP	IX
	RET


