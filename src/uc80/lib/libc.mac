; __I_const: Imaginary unit constant (0.0 + 1.0i)
; real = 0x00000000 (0.0), imag = 0x3F800000 (1.0)
	PUBLIC	___I_const
___I_const:
	DW	0,0		; Real = 0.0
	DW	0,3F80H		; Imag = 1.0

; __make_complex: Create complex from two doubles
; Input: real at IX+4 (4 bytes), imag at IX+8 (4 bytes)
; Output: pointer to result in HL
	PUBLIC	___make_complex,___make_complexf
___make_complex:
___make_complexf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	(_cplx_res),HL
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	(_cplx_res+2),HL
	LD	L,(IX+8)
	LD	H,(IX+9)
	LD	(_cplx_res+4),HL
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	(_cplx_res+6),HL
	LD	HL,_cplx_res
	POP	IX
	RET

; creal: Get real part of complex
; Input: complex pointer at IX+4
; Output: float in DEHL
_creal:
_crealf:
_creall:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	PUSH	DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	POP	HL
	POP	IX
	RET

; cimag: Get imaginary part of complex
; Input: complex pointer at IX+4
; Output: float in DEHL
_cimag:
_cimagf:
_cimagl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	BC,4
	ADD	HL,BC
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	PUSH	DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	POP	HL
	POP	IX
	RET

; cabs: |z| = sqrt(re² + im²)
_cabs:
_cabsf:
_cabsl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	; Get real part
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	INC	HL
	PUSH	BC
	PUSH	DE
	POP	HL
	POP	DE		; DEHL = real
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	CALL	__fmul		; real²
	LD	(_cplx_z),HL
	LD	(_cplx_z+2),DE
	; Get imag part
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	BC,4
	ADD	HL,BC
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	PUSH	BC
	PUSH	DE
	POP	HL
	POP	DE		; DEHL = imag
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	CALL	__fmul		; imag²
	; Add real² + imag²
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	CALL	__fadd
	; sqrt
	PUSH	DE
	PUSH	HL
	CALL	_sqrt
	POP	BC
	POP	BC
	POP	IX
	RET

; carg: arg(z) = atan2(im, re)
_carg:
_cargf:
_cargl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	; Push real (x) first
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	INC	HL
	PUSH	BC
	PUSH	DE
	; Push imag (y)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	PUSH	BC
	PUSH	DE
	CALL	_atan2
	POP	BC
	POP	BC
	POP	BC
	POP	BC
	POP	IX
	RET

; conj: conjugate z* = re - i*im
_conj:
_conjf:
_conjl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	; Copy real unchanged
	LD	DE,_cplx_res
	LD	BC,4
	LDIR
	; Copy and negate imag
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	LD	A,B
	XOR	80H
	LD	B,A
	LD	HL,_cplx_res+4
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL
	LD	(HL),C
	INC	HL
	LD	(HL),B
	LD	HL,_cplx_res
	POP	IX
	RET

; cproj: projection (for finite numbers returns input)
_cproj:
_cprojf:
_cprojl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	POP	IX
	RET

; cexp: e^z = e^re * (cos(im) + i*sin(im))
_cexp:
_cexpf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	DE,_cplx_z
	LD	BC,8
	LDIR
	; e^re
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_exp
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; cos(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_cos
	POP	BC
	POP	BC
	; Real = e^re * cos(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res),HL
	LD	(_cplx_res+2),DE
	; sin(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_sin
	POP	BC
	POP	BC
	; Imag = e^re * sin(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

; clog: log(z) = log(|z|) + i*arg(z)
_clog:
_clogf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL
	; |z|
	PUSH	HL
	CALL	_cabs
	POP	BC
	; log(|z|)
	PUSH	DE
	PUSH	HL
	CALL	_log
	POP	BC
	POP	BC
	LD	(_cplx_res),HL
	LD	(_cplx_res+2),DE
	; arg(z)
	POP	HL
	PUSH	HL
	CALL	_carg
	POP	BC
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

; csqrt: sqrt(z) using polar form
_csqrt:
_csqrtf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL
	; sqrt(|z|)
	PUSH	HL
	CALL	_cabs
	POP	BC
	PUSH	DE
	PUSH	HL
	CALL	_sqrt
	POP	BC
	POP	BC
	LD	(_cplx_w),HL	; r = sqrt(|z|)
	LD	(_cplx_w+2),DE
	; arg(z)/2
	POP	HL
	PUSH	HL
	CALL	_carg
	POP	BC
	; Divide by 2: multiply by 0.5 (0x3F000000)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,0
	LD	DE,3F00H
	CALL	__fmul
	LD	(_cplx_w+4),HL
	LD	(_cplx_w+6),DE
	; Real = r * cos(θ/2)
	PUSH	DE
	PUSH	HL
	CALL	_cos
	POP	BC
	POP	BC
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res),HL
	LD	(_cplx_res+2),DE
	; Imag = r * sin(θ/2)
	LD	HL,(_cplx_w+4)
	LD	DE,(_cplx_w+6)
	PUSH	DE
	PUSH	HL
	CALL	_sin
	POP	BC
	POP	BC
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

; cpow: z^w = e^(w*log(z))
_cpow:
_cpowf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	; z at IX+4, w at IX+6
	LD	L,(IX+4)
	LD	H,(IX+5)
	; log(z)
	PUSH	HL
	CALL	_clog
	POP	BC
	LD	DE,__cplx_l
	LD	BC,8
	LDIR
	; Load w
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	DE,__cplx_r
	LD	BC,8
	LDIR
	; w * log(z)
	CALL	__cmul
	; e^(w*log(z))
	LD	HL,__cplx_result
	PUSH	HL
	CALL	_cexp
	POP	BC
	POP	IX
	RET

; csin: sin(z) = sin(re)*cosh(im) + i*cos(re)*sinh(im)
_csin:
_csinf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	DE,_cplx_z
	LD	BC,8
	LDIR
	; sin(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_sin
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; cosh(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_cosh
	POP	BC
	POP	BC
	; Real = sin(re) * cosh(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res),HL
	LD	(_cplx_res+2),DE
	; cos(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_cos
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; sinh(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_sinh
	POP	BC
	POP	BC
	; Imag = cos(re) * sinh(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

; ccos: cos(z) = cos(re)*cosh(im) - i*sin(re)*sinh(im)
_ccos:
_ccosf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	DE,_cplx_z
	LD	BC,8
	LDIR
	; cos(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_cos
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; cosh(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_cosh
	POP	BC
	POP	BC
	; Real = cos(re) * cosh(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res),HL
	LD	(_cplx_res+2),DE
	; sin(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_sin
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; sinh(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_sinh
	POP	BC
	POP	BC
	; Imag = -sin(re) * sinh(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	A,D
	XOR	80H
	LD	D,A
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

; ctan: tan(z) = sin(z) / cos(z)
_ctan:
_ctanf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	; sin(z)
	PUSH	HL
	CALL	_csin
	POP	BC
	LD	DE,__cplx_l
	LD	BC,8
	LDIR
	; cos(z)
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL
	CALL	_ccos
	POP	BC
	LD	DE,__cplx_r
	LD	BC,8
	LDIR
	CALL	__cdiv
	LD	DE,_cplx_res
	LD	BC,8
	LDIR
	LD	HL,_cplx_res
	POP	IX
	RET

; csinh: sinh(z) = sinh(re)*cos(im) + i*cosh(re)*sin(im)
_csinh:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	DE,_cplx_z
	LD	BC,8
	LDIR
	; sinh(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_sinh
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; cos(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_cos
	POP	BC
	POP	BC
	; Real = sinh(re) * cos(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res),HL
	LD	(_cplx_res+2),DE
	; cosh(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_cosh
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; sin(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_sin
	POP	BC
	POP	BC
	; Imag = cosh(re) * sin(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

; ccosh: cosh(z) = cosh(re)*cos(im) + i*sinh(re)*sin(im)
_ccosh:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	DE,_cplx_z
	LD	BC,8
	LDIR
	; cosh(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_cosh
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; cos(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_cos
	POP	BC
	POP	BC
	; Real = cosh(re) * cos(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res),HL
	LD	(_cplx_res+2),DE
	; sinh(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_sinh
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; sin(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_sin
	POP	BC
	POP	BC
	; Imag = sinh(re) * sin(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

; ctanh: tanh(z) = sinh(z) / cosh(z)
_ctanh:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	; sinh(z)
	PUSH	HL
	CALL	_csinh
	POP	BC
	LD	DE,__cplx_l
	LD	BC,8
	LDIR
	; cosh(z)
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL
	CALL	_ccosh
	POP	BC
	LD	DE,__cplx_r
	LD	BC,8
	LDIR
	CALL	__cdiv
	LD	DE,_cplx_res
	LD	BC,8
	LDIR
	LD	HL,_cplx_res
	POP	IX
	RET

; Inverse trig/hyperbolic - simplified placeholders that return input
_casin:
_cacos:
_catan:
_casinh:
_cacosh:
_catanh:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	DE,_cplx_res
	LD	BC,8
	LDIR
	LD	HL,_cplx_res
	POP	IX
	RET

; Complex multiply: __cplx_l * __cplx_r -> __cplx_result
; Stub implementation - returns __cplx_l
__cmul:
	LD	HL,__cplx_l
	LD	DE,__cplx_result
	LD	BC,8
	LDIR
	RET

; Complex divide: __cplx_l / __cplx_r -> __cplx_result
; Stub implementation - returns __cplx_l
__cdiv:
	LD	HL,__cplx_l
	LD	DE,__cplx_result
	LD	BC,8
	LDIR
	RET

	COMMON	/lc_complex/

; Complex number work areas
_cplx_z:	DS	8	; Input complex
_cplx_w:	DS	8	; Second input / work area
_cplx_res:	DS	8	; Result storage


	CSEG
; ============================================================
; lc_conout.mac
; ============================================================
; lc_conout.mac - the single console-output choke point for libc
;
; EVERY libc routine that writes a character to the CP/M console calls
; __conout.  Nothing else in lc/*.mac may call BDOS function 2 directly;
; the only two `LD C,CONOUT' in the whole library live in this file.
; (See the grep in tests/test_crlf.py, which enforces that.)
;
; A real CP/M console (ADM-3A, Kaypro, Televideo, ...) treats LF as
; "cursor down" only, so a bare LF makes output stair-step down the
; screen.  The CP/M convention is that the *program* emits CR LF.
; __conout does that translation, which C23 7.23.2 explicitly allows
; for a text stream ("Characters can be added, altered, or deleted on
; input and output to conform to differing conventions for representing
; text in the host environment").
;
; A CR is inserted before LF unless the previous character written was
; already a CR, so a program that already prints "\r\n" does not get
; "\r\r\n", and a "\r"-only progress-bar redraw still works.  That
; suppression is the reason every console writer - including the digit
; emitters in lc_prt_dec32/dec64/hex, which never emit a newline
; themselves - has to come through here: if one of them wrote straight
; to BDOS, __conout_last would go stale and a CR could be wrongly
; suppressed.
;
; ___crlf_mode (byte, default 1) disables the translation when zeroed.
; uc80 --no-crlf makes main() zero it; a program can do it itself with
;     #include <stdio.h>       /* declares __crlf_mode */
;     __crlf_mode = 0;
; The C name __crlf_mode becomes ___crlf_mode in assembly because uc80
; prefixes every C identifier with one underscore.
;
; File streams are NOT affected: lc_file.mac routes only its console
; branch (stream id < 3) through __conout, so fwrite/fputc to a real
; FILE * stay byte-for-byte raw in both "w" and "wb" mode.
;
; Entry:  E = character to write
; Exit:   BC, DE, HL preserved; AF destroyed (same as a bare BDOS call,
;         which preserves nothing) - so `CALL __conout' is a drop-in
;         replacement for `LD C,CONOUT / CALL BDOS'.



	CSEG

	PUBLIC	__conout
__conout:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	A,E
	CP	0AH		; LF?
	JR	Z,__conout_lf
	LD	(__conout_last),A	; remember this one (fast path: not LF)
__conout_put:
	LD	C,CONOUT
	CALL	BDOS
	POP	HL
	POP	DE
	POP	BC
	RET

__conout_lf:
	LD	HL,__conout_last
	LD	C,(HL)		; C = previous character written
	LD	(HL),A		; remember this one (LF)
	LD	A,(___crlf_mode)
	OR	A
	JR	Z,__conout_put	; translation disabled - pass LF through
	LD	A,C
	CP	0DH		; already preceded by CR?
	JR	Z,__conout_put
	LD	E,0DH		; no - emit CR first
	LD	C,CONOUT
	CALL	BDOS
	LD	E,0AH
	JR	__conout_put

	DSEG

	PUBLIC	___crlf_mode
___crlf_mode:	DB	1	; non-zero: translate LF -> CR LF
__conout_last:	DB	0	; last character handed to BDOS


	CSEG
; ============================================================
; lc_copysign.mac
; ============================================================
; lc_copysign.mac - _copysign, _copysignf
; Split from lc_fabs.mac


	CSEG
; ============================================================
; copysign(x, y) - return x with sign of y
; ============================================================
	PUBLIC	_copysign
_copysign:
	PUBLIC	_copysignf
_copysignf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	E,(IX+6)
	LD	A,(IX+7)
	AND	7FH		; Clear x sign
	LD	B,A
	LD	A,(IX+11)	; y high byte
	AND	80H		; Get y sign
	OR	B		; Combine
	LD	D,A
	POP	IX
	RET


	CSEG
