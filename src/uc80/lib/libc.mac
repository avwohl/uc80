; ============================================================
; lc_printf_a.mac
; ============================================================
; lc_printf_a.mac - printf %a and %A (hexadecimal floating point)
;
; [-]0xh.hhhhp+d: one hex digit before the point (0 for zero, else 1), the 23
; bits of the fraction of the float as hex digits (24 bits, six digits: the
; bit 0 of the sixth digit is 0), and the exponent of 2 in decimal.  Without
; a precision the zeros at the end are left out and the point appears only
; when digits follow it.  With a precision the digits are rounded to nearest,
; a tie to the even digit; a carry into the first digit gives 2 (0x2p+0),
; as glibc does.  A subnormal float is normalized.
;
; The compiler writes no table entry for 'a' and 'A'.  The printf hook of uc80
; (printf_hook.py) adds them when a format has %a or %A.
;
; Handler ABI (see lc_printf_core.mac): entered by a tail JP with HL = format
; pointer past the specifier, C = vararg offset from IX, IX = printf's frame.
; The code does not change IX and IY.


	CSEG

	PUBLIC	__printf_handle_a
	PUBLIC	__printf_handle_au

__printf_handle_au:
	LD	A,20H		; any non-zero value: the upper case flag
	LD	(_printf_upper),A
__printf_handle_a:
	PUSH	HL
	PUSH	BC
	LD	H,0
	LD	L,C
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	DE,_pa_val
	LD	BC,4
	LDIR
	CALL	_pa_main
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop

_pa_main:
	; ---- the sign character ----
	LD	A,(_pa_val+3)
	LD	B,'-'
	OR	A
	JP	M,_pa_sg
	LD	B,'+'
	LD	A,(_printf_plus)
	OR	A
	JR	NZ,_pa_sg
	LD	B,' '
	LD	A,(_printf_space)
	OR	A
	JR	NZ,_pa_sg
	LD	B,0
_pa_sg:
	LD	A,B
	LD	(_pa_sign),A

	; ---- B = the biased exponent; _pa_m = the 23 bits of the fraction ----
	LD	A,(_pa_val+3)
	ADD	A,A
	LD	B,A
	LD	A,(_pa_val+2)
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A
	LD	A,(_pa_val+2)
	AND	7FH
	LD	(_pa_m+2),A
	LD	C,A
	LD	A,(_pa_val+1)
	LD	(_pa_m+1),A
	OR	C
	LD	C,A
	LD	A,(_pa_val)
	LD	(_pa_m),A
	OR	C
	LD	C,A		; C = 0 when the fraction is 0
	LD	A,B
	CP	255
	JR	NZ,_pa_fin

	; infinity or NaN: the text is padded with spaces
	LD	HL,_pa_inf
	LD	A,C
	OR	A
	JR	Z,_pa_isi
	LD	HL,_pa_nan
_pa_isi:
	LD	(_pa_sptr),HL
	XOR	A
	LD	(_printf_zero),A
	LD	HL,3
	LD	(_pa_len),HL
	LD	A,1
	LD	(_pa_kind),A
	JR	_pa_emit

_pa_fin:
	XOR	A
	LD	(_pa_kind),A
	LD	A,B		; the exponent e
	LD	B,0		; B = the first digit
	OR	A
	JR	Z,_pa_zs
	INC	B
	LD	L,A
	LD	H,0
	LD	DE,-127
	ADD	HL,DE
	LD	(_pa_x),HL
	JR	_pa_nib
_pa_zs:
	LD	HL,0
	LD	(_pa_x),HL
	LD	A,C
	OR	A
	JR	Z,_pa_nib	; zero: 0x0p+0
	; subnormal: value = fraction * 2^-149.  Shift left until bit 23 is
	; set: that bit is the 1 before the point; the exponent is -126 less
	; one for each shift.
	INC	B
	LD	HL,-126
	LD	(_pa_x),HL
_pa_nm:
	LD	A,(_pa_m+2)
	BIT	7,A
	JR	NZ,_pa_nd
	LD	HL,_pa_m
	SLA	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	LD	HL,(_pa_x)
	DEC	HL
	LD	(_pa_x),HL
	JR	_pa_nm
_pa_nd:
	AND	7FH
	LD	(_pa_m+2),A
_pa_nib:
	; the digits: _pa_n[0] = B; then 24 bits = the fraction * 2, high first
	LD	A,B
	LD	(_pa_n),A
	LD	HL,_pa_m
	SLA	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	LD	A,(_pa_m+2)
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	LD	(_pa_n+1),A
	LD	A,(_pa_m+2)
	AND	0FH
	LD	(_pa_n+2),A
	LD	A,(_pa_m+1)
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	LD	(_pa_n+3),A
	LD	A,(_pa_m+1)
	AND	0FH
	LD	(_pa_n+4),A
	LD	A,(_pa_m)
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	LD	(_pa_n+5),A
	LD	A,(_pa_m)
	AND	0FH
	LD	(_pa_n+6),A

	; ---- the number of digits after the point ----
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_pa_prec
	LD	B,6		; no precision: leave out the zeros at the end
	LD	HL,_pa_n+6
_pa_tz:
	LD	A,(HL)
	OR	A
	JR	NZ,_pa_nf
	DEC	HL
	DJNZ	_pa_tz
_pa_nf:
	LD	A,B
	LD	(_pa_nfd),A
	JR	_pa_expo
_pa_prec:
	LD	A,(_printf_prec)
	LD	(_pa_nfd),A
	CP	6
	JR	NC,_pa_expo	; 6 digits or more: nothing to round
	LD	E,A
	LD	D,0
	LD	HL,_pa_n
	ADD	HL,DE
	PUSH	HL		; HL -> the last digit that stays
	INC	HL
	LD	A,(HL)		; the first digit that goes
	CP	8
	JR	C,_pa_rdn	; below half
	JR	NZ,_pa_rup	; above half
	LD	A,5
	SUB	E		; the digits after the first one that goes
	JR	Z,_pa_tie
	LD	B,A
_pa_rs:
	INC	HL
	LD	A,(HL)
	OR	A
	JR	NZ,_pa_rup	; more than half
	DJNZ	_pa_rs
_pa_tie:
	POP	HL		; an exact tie: up when the last digit is odd
	BIT	0,(HL)
	JR	Z,_pa_expo
	JR	_pa_inc
_pa_rdn:
	POP	HL
	JR	_pa_expo
_pa_rup:
	POP	HL
_pa_inc:
	LD	A,(HL)
	INC	A
	CP	16
	JR	Z,_pa_wrap
	LD	(HL),A
	JR	_pa_expo
_pa_wrap:
	LD	(HL),0
	DEC	HL
	JR	_pa_inc

_pa_expo:
	; ---- the exponent: its sign and the digits (1 to 3) ----
	LD	HL,(_pa_x)
	LD	A,'+'
	BIT	7,H
	JR	Z,_pa_xp
	LD	A,'-'
	LD	D,A
	XOR	A
	SUB	L
	LD	L,A
	SBC	A,A
	SUB	H
	LD	H,A
	LD	A,D
_pa_xp:
	LD	(_pa_xs),A
	LD	A,L		; |exponent| is 149 at most
	LD	B,'0'
_pa_h:
	CP	100
	JR	C,_pa_hd
	SUB	100
	INC	B
	JR	_pa_h
_pa_hd:
	LD	C,'0'
_pa_t:
	CP	10
	JR	C,_pa_td
	SUB	10
	INC	C
	JR	_pa_t
_pa_td:
	ADD	A,'0'
	LD	(_pa_xd+2),A
	LD	A,C
	LD	(_pa_xd+1),A
	LD	A,B
	LD	(_pa_xd),A
	LD	HL,_pa_xd
	LD	B,3
	LD	A,(HL)
	CP	'0'
	JR	NZ,_pa_xl
	INC	HL
	DEC	B
	LD	A,(HL)
	CP	'0'
	JR	NZ,_pa_xl
	INC	HL
	DEC	B
_pa_xl:
	LD	(_pa_xptr),HL
	LD	A,B
	LD	(_pa_xn),A

	; ---- the point, and the length of the text without the sign ----
	LD	A,(_pa_nfd)
	LD	HL,_printf_alt
	OR	(HL)
	JR	Z,_pa_nd0
	LD	A,1
_pa_nd0:
	LD	(_pa_dot),A
	LD	E,A
	LD	D,0
	LD	A,(_pa_nfd)
	LD	L,A
	LD	H,0
	ADD	HL,DE
	LD	A,(_pa_xn)
	LD	E,A
	ADD	HL,DE
	LD	DE,5		; 0x, the first digit, p and the sign of the exponent
	ADD	HL,DE
	LD	(_pa_len),HL

	; ---- print the sign, the text and the padding ----
_pa_emit:
	LD	HL,(_pa_len)
	LD	A,(_pa_sign)
	OR	A
	JR	Z,_pa_e1
	INC	HL
_pa_e1:
	LD	A,(_printf_width)
	LD	E,A
	LD	D,0
	EX	DE,HL
	OR	A
	SBC	HL,DE
	LD	A,0
	JR	C,_pa_e2
	LD	A,L
_pa_e2:
	LD	(_pa_pad),A
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_pa_left
	LD	A,(_printf_zero)
	OR	A
	JR	NZ,_pa_zero
	LD	E,' '
	CALL	_pa_padout
	CALL	_pa_signout
	JR	_pa_text
_pa_zero:
	CALL	_pa_signout
	CALL	_pa_prefix
	LD	E,'0'
	CALL	_pa_padout
	JR	_pa_rest
_pa_left:
	CALL	_pa_signout
	CALL	_pa_text
	LD	E,' '
_pa_padout:
	LD	A,(_pa_pad)
	LD	B,A
	JP	_printf_padn

_pa_signout:
	LD	A,(_pa_sign)
	OR	A
	RET	Z
	LD	E,A
	JP	_printf_putc

; "0x" or "0X"
_pa_prefix:
	LD	E,'0'
	CALL	_printf_putc
	LD	E,'x'
	LD	A,(_printf_upper)
	OR	A
	JR	Z,_pa_pf
	LD	E,'X'
_pa_pf:
	JP	_printf_putc

; the text after the sign: for infinity and NaN the three letters, else the
; prefix and the rest
_pa_text:
	LD	A,(_pa_kind)
	OR	A
	JR	Z,_pa_tx
	LD	HL,(_pa_sptr)
	LD	B,3
_pa_tl:
	LD	A,(HL)
	LD	E,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,E
	JR	Z,_pa_tu
	AND	0DFH
_pa_tu:
	LD	E,A
	PUSH	HL
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	DJNZ	_pa_tl
	RET
_pa_tx:
	CALL	_pa_prefix
; the first digit, the point, the digits, p, the sign and the exponent
_pa_rest:
	LD	A,(_pa_n)
	CALL	_pa_hex
	LD	A,(_pa_dot)
	OR	A
	JR	Z,_pa_r1
	LD	E,'.'
	CALL	_printf_putc
_pa_r1:
	LD	A,(_pa_nfd)
	OR	A
	JR	Z,_pa_r3
	LD	B,A
	LD	HL,_pa_n+1
	LD	C,6		; digits that are in the table
_pa_r2:
	XOR	A
	INC	C
	DEC	C
	JR	Z,_pa_r2a
	LD	A,(HL)
	INC	HL
	DEC	C
_pa_r2a:
	PUSH	BC
	PUSH	HL
	CALL	_pa_hex
	POP	HL
	POP	BC
	DJNZ	_pa_r2
_pa_r3:
	LD	E,'p'
	LD	A,(_printf_upper)
	OR	A
	JR	Z,_pa_r4
	LD	E,'P'
_pa_r4:
	CALL	_printf_putc
	LD	A,(_pa_xs)
	LD	E,A
	CALL	_printf_putc
	LD	HL,(_pa_xptr)
	LD	A,(_pa_xn)
	LD	B,A
_pa_r5:
	LD	E,(HL)
	INC	HL
	PUSH	HL
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	HL
	DJNZ	_pa_r5
	RET

; print the hex digit A
_pa_hex:
	ADD	A,'0'
	CP	'9'+1
	JR	C,_pa_hx
	ADD	A,'a'-'9'-1
	LD	E,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,E
	JR	Z,_pa_hx
	SUB	20H
_pa_hx:
	LD	E,A
	JP	_printf_putc

_pa_inf:	DB	'inf'
_pa_nan:	DB	'nan'

	COMMON	/lc_printf_a/	; BSS: every variable is set before it is read

_pa_val:	DS	4
_pa_m:		DS	3
_pa_n:		DS	7
_pa_sign:	DS	1
_pa_sptr:	DS	2
_pa_x:		DS	2
_pa_xs:		DS	1
_pa_xd:		DS	3
_pa_xptr:	DS	2
_pa_xn:		DS	1
_pa_nfd:	DS	1
_pa_dot:	DS	1
_pa_len:	DS	2
_pa_pad:	DS	1
_pa_kind:	DS	1


	CSEG
; ============================================================
; lc_printf_all.mac
; ============================================================
; lc_printf_all.mac - default printf format table (all handlers)
; This module provides the full __printf_format_table when no
; #pragma printf is specified. It references all format handlers
; so the linker pulls them all in.




	CSEG

	PUBLIC	__printf_format_table
__printf_format_table:
	DB	'd'
	DW	__printf_handle_d
	DB	'i'
	DW	__printf_handle_d	; %i same as %d
	DB	'u'
	DW	__printf_handle_u
	DB	'o'
	DW	__printf_handle_o
	DB	'x'
	DW	__printf_handle_x
	DB	'X'
	DW	__printf_handle_xu
	DB	's'
	DW	__printf_handle_s
	DB	'c'
	DW	__printf_handle_c
	DB	'p'
	DW	__printf_handle_p
	DB	'l'
	DW	__printf_handle_l
	DB	'f'
	DW	__printf_handle_f
	DB	'F'
	DW	__printf_handle_f	; %F same as %f
	DB	'e'
	DW	__printf_handle_e
	DB	'E'
	DW	__printf_handle_eu
	DB	'g'
	DW	__printf_handle_g
	DB	'G'
	DW	__printf_handle_gu
	DB	'n'
	DW	__printf_handle_n
	DB	'a'
	DW	__printf_handle_a
	DB	'A'
	DW	__printf_handle_au
	DB	't'
	DW	__printf_handle_skip	; %td: ptrdiff_t is an int
	DB	0		; sentinel

	PUBLIC	__printf_long_table
__printf_long_table:
	DB	'd'
	DW	__printf_handle_ld
	DB	'i'
	DW	__printf_handle_ld	; %li same as %ld
	DB	'u'
	DW	__printf_handle_lu
	DB	'o'
	DW	__printf_handle_lo
	DB	'x'
	DW	__printf_handle_lx
	DB	'X'
	DW	__printf_handle_lxu
	DB	'f'
	DW	__printf_handle_f	; %lf same as %f
	DB	'e'
	DW	__printf_handle_e	; %le same as %e
	DB	'E'
	DW	__printf_handle_eu
	DB	'g'
	DW	__printf_handle_g	; %lg same as %g
	DB	'G'
	DW	__printf_handle_gu
	DB	'l'
	DW	__printf_ll_entry
	DB	0		; sentinel

	PUBLIC	__printf_ll_table
__printf_ll_table:
	DB	'd'
	DW	__printf_handle_lld
	DB	'i'
	DW	__printf_handle_lld
	DB	'u'
	DW	__printf_handle_llu
	DB	'x'
	DW	__printf_handle_llx
	DB	'X'
	DW	__printf_handle_llxu
	DB	'o'
	DW	__printf_handle_llo
	DB	0		; sentinel

; The 'll' dispatch entry point - search __printf_ll_table
; This is needed because 'l' handler in lc_printf_l.mac
; references __printf_ll_table directly
__printf_ll_entry:
	; Not used directly - the 'l' handler handles 'll' internally
	RET


	CSEG
; ============================================================
; lc_printf_c.mac
; ============================================================
; lc_printf_c.mac - printf %c handler


	CSEG

	PUBLIC	__printf_handle_c
	PUBLIC	__printf_handle_c32
__printf_handle_c:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	CALL	_phc_out
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

; Same as __printf_handle_c but advances C by 4 - for callers compiled
; with --int=32 where char args occupy a full 32-bit stack slot.
__printf_handle_c32:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	CALL	_phc_out
	POP	BC
	INC	C
	INC	C
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

; Print the character E in a field of _printf_width characters.
_phc_out:
	LD	A,(_printf_width)
	OR	A
	JR	Z,_phc_plain
	DEC	A
	LD	B,A		; padding = width - 1
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_phc_left
	PUSH	DE
	LD	E,' '
	CALL	_printf_padn
	POP	DE
_phc_plain:
	JP	_printf_putc
_phc_left:
	CALL	_printf_putc
	LD	E,' '
	JP	_printf_padn


	CSEG
; ============================================================
; lc_printf_core.mac
; ============================================================
; lc_printf_core.mac - printf core dispatcher
; Table-driven printf: searches __printf_format_table for format handlers
;
; Handler calling convention:
;   Entry: HL = format string ptr (past the specifier char)
;          C  = arg offset byte (relative to IX frame)
;          IX = caller's frame pointer
;   State: _printf_width, _printf_zero, _printf_prec, _printf_hasprec,
;          _printf_upper available via EXTRN
;   Exit:  JP _printf_loop with HL = next format position, C = updated arg offset
;
; The format table is an array of (DB char, DW handler_addr) entries
; terminated by DB 0. It is defined by the codegen (in the user's .mac file)
; when compiling main(), or defaults to a full table.




	CSEG

	PUBLIC	_printf
	PUBLIC	_printf_loop
	PUBLIC	_printf_done
	PUBLIC	_printf_format
	PUBLIC	_printf_unk_echo
	PUBLIC	_printf_prt_hex
	PUBLIC	_printf_nib2a
	PUBLIC	_printf_width
	PUBLIC	_printf_zero
	PUBLIC	_printf_upper
	PUBLIC	_printf_prec
	PUBLIC	_printf_hasprec
	PUBLIC	_printf_alt
	PUBLIC	_printf_left
	PUBLIC	_printf_plus
	PUBLIC	_printf_space
	PUBLIC	_printf_pfxlen
	PUBLIC	_printf_numout
	PUBLIC	_printf_hexfin
	PUBLIC	_printf_hexword
	PUBLIC	_printf_padn
	PUBLIC	_printf_neg
	PUBLIC	_printf_hexbuf
	PUBLIC	_printf_decbuf
	PUBLIC	_printf_dstart
	PUBLIC	_printf_dcnt
	PUBLIC	_printf_ll_w0
	PUBLIC	_printf_ll_w1
	PUBLIC	_printf_ll_w2
	PUBLIC	_printf_ll_w3
	PUBLIC	_printf_putc
	PUBLIC	_printf_count
	PUBLIC	_printf_skip
	PUBLIC	_printf_fmtstart

; ============================================================
; _printf_putc: output the char in E to CONOUT and bump
; ``_printf_count`` so the printf-family functions can return the
; number of bytes written. All format handlers (lc_printf_*.mac)
; route their output through this helper. Preserves every
; register the caller might depend on.
; ============================================================
_printf_putc:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,(_printf_sink)
	CALL	_printf_sink_call
	LD	HL,(_printf_count)
	INC	HL
	LD	(_printf_count),HL
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

; Call the sink through HL.  The Z80 has no CALL (HL); CALL here pushes
; the return address and JP (HL) enters the sink, which RETs to us.
_printf_sink_call:
	JP	(HL)

; ============================================================
; _printf_engine: the format loop, shared by the whole printf family.
;
; Entry: IX = a frame whose varargs start at IX+C
;        HL = format string
;        C  = offset from IX to the first vararg
;        _printf_sink = routine taking the character in E
; Exit:  HL = bytes written.  Every printf-family entry point is this
;        plus a prologue that sets those four things.
;
; sprintf, snprintf, fprintf, vprintf and friends each used to carry
; their own CP/JR-Z conversion chain, so %e, %g and %F reached only
; printf and the others silently emitted an empty field and left the
; vararg offset alone, desyncing every later conversion in the call.
; ============================================================
	PUBLIC	_printf_engine
_printf_engine:
	PUSH	DE
	LD	DE,0
	LD	(_printf_count),DE
	POP	DE
	JR	_printf_loop

_printf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	HL,__conout	; console sink: the only console write in printf land
	LD	(_printf_sink),HL

	; fmt is at IX+4, first vararg at IX+6
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = format string pointer
	LD	C,6		; C = offset to next argument
	CALL	_printf_engine

	POP	DE
	POP	BC
	POP	IX
	RET

_printf_loop:
	LD	A,(HL)
	OR	A
	JR	Z,_printf_done

	CP	'%'
	JR	Z,_printf_format

	; Regular character - output it
	LD	E,A
	PUSH	HL
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	JR	_printf_loop

_printf_format:
	INC	HL
	; Remember where the conversion specification starts (the first byte
	; after the '%') so _printf_unknown can echo it verbatim.
	LD	(_printf_fmtstart),HL
	; Initialize format state: clear the whole _printf_state block
	PUSH	BC
	LD	DE,_printf_state
	LD	B,11		; length of the _printf_state block
	XOR	A
_printf_clr:
	LD	(DE),A
	INC	DE
	DJNZ	_printf_clr
	POP	BC
	LD	A,(HL)
	OR	A
	JP	Z,_printf_done

	CP	'%'
	JR	Z,_printf_pct

_printf_fmt2:
	; Check for '0' flag (only when not in precision and width is 0)
	CP	'0'
	JR	NZ,_printf_not0
	PUSH	AF
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_printf_0dig
	LD	A,(_printf_width)
	OR	A
	JR	NZ,_printf_0dig
	; Set zero-padding flag
	LD	A,1
	LD	(_printf_zero),A
	POP	AF
	JR	_printf_skip
_printf_0dig:
	POP	AF
	JR	_printf_isdig

_printf_not0:
	; Check for precision start
	CP	'.'
	JR	NZ,_printf_notdot
	PUSH	AF
	LD	A,1
	LD	(_printf_hasprec),A
	POP	AF
	JR	_printf_skip

_printf_notdot:
	; Flags: - + space #
	LD	DE,_printf_left
	CP	'-'
	JR	Z,_printf_setf
	LD	DE,_printf_plus
	CP	'+'
	JR	Z,_printf_setf
	LD	DE,_printf_space
	CP	' '
	JR	Z,_printf_setf
	LD	DE,_printf_alt
	CP	'#'
	JR	NZ,_printf_not_alt
_printf_setf:
	LD	A,1
	LD	(DE),A
	JR	_printf_skip
_printf_not_alt:
	CP	'*'
	JR	Z,_printf_star
	; Check for digits (1-9)
	CP	'1'
	JR	C,_printf_nodig
	CP	'9'+1
	JR	C,_printf_isdig
_printf_nodig:
	; Skip length modifiers: h, z, L
	CP	'h'
	JR	Z,_printf_skip
	CP	'z'
	JR	Z,_printf_skip
	CP	'L'
	JR	Z,_printf_skip

	; === DISPATCH: search __printf_format_table ===
	PUSH	HL		; Save format string position
	PUSH	BC		; Save arg offset
	LD	B,A		; B = format char to find
	LD	HL,__printf_format_table
_printf_search:
	LD	A,(HL)
	OR	A
	JR	Z,_printf_unknown	; End of table, char not found
	CP	B
	JR	Z,_printf_found
	INC	HL		; Skip handler address
	INC	HL
	INC	HL		; Next entry
	JR	_printf_search

_printf_found:
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = handler address
	POP	BC		; Restore arg offset
	POP	HL		; Restore format string ptr
	INC	HL		; Past the specifier char
	PUSH	DE
	RET			; Tail-call handler (JP DE)

_printf_unknown:
	POP	BC		; arg offset - deliberately NOT advanced
	POP	HL		; HL -> the offending conversion char
	INC	HL
	; fall into _printf_unk_echo

; ============================================================
; _printf_unk_echo: echo the conversion specification verbatim.
;
; C23 7.23.6.1p9 makes an invalid conversion specification undefined
; behaviour, so we may choose what to do.  Printing nothing is the worst
; option available: it is invisible AND it silently truncates the output.
; Echo the whole specification instead ("%q", "%.3q", "%ls", ...) so the
; failure is VISIBLE.
;
; LIMITATION, on purpose: this does NOT resync the varargs.  Only a
; handler advances C, and no handler ran, so every later conversion in
; this same printf call still reads the wrong argument.  There is no
; portable way to know an unknown conversion's argument size.  The
; compiler warns about this at compile time whenever the format string is
; a literal; the echo is the safety net for the non-literal case, which
; the compiler cannot see.
;
; Entry: HL -> one byte PAST the offending conversion character
;        _printf_fmtstart -> first byte after the '%'
; Exit:  jumps to _printf_loop with HL unchanged.
; ============================================================
_printf_unk_echo:
	LD	E,'%'
	CALL	_printf_putc	; preserves AF, BC, DE, HL
	LD	DE,(_printf_fmtstart)
_printf_unk_lp:
	LD	A,D		; done once DE has walked up to HL
	CP	H
	JR	NZ,_printf_unk_go
	LD	A,E
	CP	L
	JP	Z,_printf_loop
_printf_unk_go:
	LD	A,(DE)
	PUSH	DE
	LD	E,A
	CALL	_printf_putc
	POP	DE
	INC	DE
	JR	_printf_unk_lp

; '*' width or precision: the value is the next int vararg.
_printf_star:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = the int
	INC	C
	INC	C
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_printf_star_p
	BIT	7,D
	JR	Z,_printf_star_w
	LD	A,1		; negative width: '-' flag and the magnitude
	LD	(_printf_left),A
	LD	HL,0
	OR	A
	SBC	HL,DE
	EX	DE,HL
_printf_star_w:
	CALL	_printf_clamp8
	LD	(_printf_width),A
	POP	HL
	JR	_printf_skip
_printf_star_p:
	BIT	7,D
	JR	Z,_printf_star_pp
	XOR	A		; negative precision: as if none was given
	LD	(_printf_hasprec),A
	POP	HL
	JR	_printf_skip
_printf_star_pp:
	CALL	_printf_clamp8
	LD	(_printf_prec),A
	POP	HL
	JR	_printf_skip

; A = DE limited to 255
_printf_clamp8:
	LD	A,D
	OR	A
	LD	A,E
	RET	Z
	LD	A,255
	RET

_printf_isdig:
	; Parse digit into width or precision
	SUB	'0'
	PUSH	BC
	LD	B,A		; B = new digit
	LD	A,(_printf_hasprec)
	OR	A
	JR	NZ,_printf_precdig
	; Width digit
	LD	A,(_printf_width)
	CP	26		; 26 * 10 > 255: stay at 255 (no wrap-around)
	JR	NC,_printf_wsat
	LD	C,A
	ADD	A,A		; *2
	ADD	A,A		; *4
	ADD	A,C		; *5
	ADD	A,A		; *10
	ADD	A,B		; + digit
	JR	NC,_printf_wstore
_printf_wsat:
	LD	A,255
_printf_wstore:
	LD	(_printf_width),A
	POP	BC
	JR	_printf_skip
_printf_precdig:
	; Precision digit
	LD	A,(_printf_prec)
	CP	26		; stay at 255 (no wrap-around)
	JR	NC,_printf_psat
	LD	C,A
	ADD	A,A
	ADD	A,A
	ADD	A,C
	ADD	A,A
	ADD	A,B
	JR	NC,_printf_pstore
_printf_psat:
	LD	A,255
_printf_pstore:
	LD	(_printf_prec),A
	POP	BC
	; Fall through to _printf_skip

_printf_skip:
	INC	HL
	LD	A,(HL)
	OR	A
	JP	Z,_printf_done
	JR	_printf_fmt2

_printf_pct:
	; Output literal %
	LD	E,'%'
	PUSH	HL
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	POP	HL
	INC	HL
	JR	_printf_loop

; The engine is a subroutine now, so it returns the count and leaves the
; prologue's POP DE / POP BC / POP IX to whichever entry point ran it.
_printf_done:
	LD	HL,(_printf_count)	; Return count of bytes written
	RET

; ============================================================
; Printf hex.  _printf_prt_hex prints HL (16 bit); the long handlers
; fill _printf_hexbuf themselves (_printf_hexword) and call _printf_hexfin.
; ============================================================
_printf_prt_hex:
	PUSH	BC
	LD	DE,_printf_hexbuf
	CALL	_printf_hexword
	LD	B,4
	CALL	_printf_hexfin
	POP	BC
	RET

; HL = 16-bit value, DE = buffer pointer: append 4 hex characters
_printf_hexword:
	LD	A,H
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_printf_nib2a
	LD	A,H
	AND	0FH
	CALL	_printf_nib2a
	LD	A,L
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_printf_nib2a
	LD	A,L
	AND	0FH
	JR	_printf_nib2a

; B = number of hex characters in _printf_hexbuf.  Drop leading zeros
; (keep one), then print through _printf_numout.
_printf_hexfin:
	LD	HL,_printf_hexbuf
_printf_hf_lz:
	LD	A,B
	CP	1
	JR	Z,_printf_hf_set
	LD	A,(HL)
	CP	'0'
	JR	NZ,_printf_hf_set
	INC	HL
	DEC	B
	JR	_printf_hf_lz
_printf_hf_set:
	LD	(_printf_dstart),HL
	LD	A,B
	LD	(_printf_dcnt),A
	; '#' flag: prefix 0x/0X when the value is not zero
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_printf_numout
	LD	A,(HL)
	CP	'0'
	JR	Z,_printf_numout
	LD	A,2
	LD	(_printf_pfxlen),A
	; fall into _printf_numout

; ============================================================
; _printf_numout: print one integer conversion.  Shared by every
; integer handler, so flags, width and precision work the same for
; %d %u %o %x %X and the l and ll forms.
;
; Entry: _printf_dstart -> the digits, _printf_dcnt = how many
;        _printf_neg: 0 unsigned, 1 negative, 2 signed and not negative
;        _printf_pfxlen: 2 to print 0x (0X when _printf_upper), else 0
;        _printf_width/_zero/_left/_plus/_space/_prec/_hasprec
; Exit:  BC preserved.
; ============================================================
_printf_numout:
	PUSH	BC
	LD	A,(_printf_neg)
	OR	A
	JR	Z,_pn_nosign
	LD	B,'-'
	CP	1
	JR	Z,_pn_sgn
	LD	B,'+'
	LD	A,(_printf_plus)
	OR	A
	JR	NZ,_pn_sgn
	LD	B,' '
	LD	A,(_printf_space)
	OR	A
	JR	NZ,_pn_sgn
_pn_nosign:
	LD	B,0
_pn_sgn:
	LD	A,B
	LD	(_pn_sign),A
	; B = digit count, C = extra leading zeros from the precision
	LD	A,(_printf_dcnt)
	LD	B,A
	LD	C,0
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_pn_cnt
	XOR	A		; a precision cancels the '0' flag
	LD	(_printf_zero),A
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_pn_pz
	LD	A,B		; precision 0 and value 0: no digits at all
	DEC	A
	JR	NZ,_pn_cnt
	LD	HL,(_printf_dstart)
	LD	A,(HL)
	CP	'0'
	JR	NZ,_pn_cnt
	LD	B,0
	JR	_pn_cnt
_pn_pz:
	SUB	B
	JR	C,_pn_cnt
	LD	C,A
_pn_cnt:
	LD	A,B
	LD	(_pn_n),A
	LD	A,C
	LD	(_pn_zeros),A
	ADD	A,B		; B = characters before any padding
	JR	NC,_pn_t1
	LD	A,255		; the width is at most 255: saturate, never wrap
_pn_t1:
	LD	B,A
	LD	A,(_pn_sign)
	OR	A
	JR	Z,_pn_ns
	LD	A,B
	INC	A
	JR	Z,_pn_ns	; already 255
	LD	B,A
_pn_ns:
	LD	A,(_printf_pfxlen)
	ADD	A,B
	JR	NC,_pn_t2
	LD	A,255
_pn_t2:
	LD	B,A
	LD	A,(_printf_width)
	SUB	B
	JR	NC,_pn_pad
	XOR	A
_pn_pad:
	LD	(_pn_padn),A
	LD	B,A
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_pn_body
	LD	A,(_printf_zero)
	OR	A
	JR	NZ,_pn_zp
	LD	E,' '
	CALL	_printf_padn
	JR	_pn_body
_pn_zp:
	CALL	_pn_sp
	LD	E,'0'
	CALL	_printf_padn
	JR	_pn_dig
_pn_body:
	CALL	_pn_sp
_pn_dig:
	LD	A,(_pn_zeros)
	LD	B,A
	LD	E,'0'
	CALL	_printf_padn
	LD	A,(_pn_n)
	OR	A
	JR	Z,_pn_tail
	LD	B,A
	LD	HL,(_printf_dstart)
_pn_dl:
	LD	E,(HL)
	CALL	_printf_putc
	INC	HL
	DJNZ	_pn_dl
_pn_tail:
	LD	A,(_printf_left)
	OR	A
	JR	Z,_pn_done
	LD	A,(_pn_padn)
	LD	B,A
	LD	E,' '
	CALL	_printf_padn
_pn_done:
	POP	BC
	RET

; sign character and 0x prefix
_pn_sp:
	LD	A,(_pn_sign)
	OR	A
	JR	Z,_pn_sp1
	LD	E,A
	CALL	_printf_putc
_pn_sp1:
	LD	A,(_printf_pfxlen)
	OR	A
	RET	Z
	LD	E,'0'
	CALL	_printf_putc
	LD	A,(_printf_upper)
	LD	E,'x'
	OR	A
	JR	Z,_pn_sp2
	LD	E,'X'
_pn_sp2:
	JP	_printf_putc

; Output the character E, B times (B may be 0).  Clobbers AF, B.
_printf_padn:
	LD	A,B
	OR	A
	RET	Z
_printf_padn1:
	CALL	_printf_putc
	DJNZ	_printf_padn1
	RET

; Convert nibble (0-15) in A to ASCII hex char, store at (DE), advance DE
_printf_nib2a:
	ADD	A,'0'
	CP	'9'+1
	JR	C,_printf_nib_ok
	PUSH	BC
	LD	B,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,B
	POP	BC
	JR	Z,_printf_nib_lo
	ADD	A,7
	JR	_printf_nib_ok
_printf_nib_lo:
	ADD	A,39
_printf_nib_ok:
	LD	(DE),A
	INC	DE
	RET

; ============================================================
; Internal: print HL as decimal (no padding, simple)
; ============================================================
	PUBLIC	_prt_dec
_prt_dec:
	PUSH	BC
	PUSH	DE
	LD	DE,10
	LD	B,0
_prt_dec_loop:
	CALL	_prt_div16
	PUSH	DE
	INC	B
	LD	A,H
	OR	L
	JR	NZ,_prt_dec_loop
_prt_dec_out:
	POP	DE
	LD	A,E
	ADD	A,'0'
	LD	E,A
	PUSH	BC
	CALL	_printf_putc
	POP	BC
	DJNZ	_prt_dec_out
	POP	DE
	POP	BC
	RET

; ============================================================
; Internal: HL = HL / 10, DE = HL % 10
; ============================================================
	PUBLIC	_prt_div16
_prt_div16:
	; HL < 10: no work.  H = 0: 8 steps (the byte moves to H first).
	; Otherwise 16 steps of shift and trial subtract (about 700 T).
	LD	A,H
	OR	A
	JR	NZ,_prt_div16_w
	LD	A,L
	CP	10
	JR	NC,_prt_div16_b
	LD	E,L		; quotient 0, remainder L
	LD	D,0
	LD	L,D
	RET
_prt_div16_b:
	PUSH	BC
	LD	H,L
	LD	L,0
	LD	B,8
	JR	_prt_div16_go
_prt_div16_w:
	PUSH	BC
	LD	B,16
_prt_div16_go:
	XOR	A		; A = running remainder
_prt_div16_lp:
	ADD	HL,HL		; shift next dividend bit into A
	RLA
	CP	10
	JR	C,_prt_div16_nc
	SUB	10
	INC	L		; quotient bit (bit 0 of HL is free after ADD HL,HL)
_prt_div16_nc:
	DJNZ	_prt_div16_lp
	LD	E,A
	LD	D,0
	POP	BC
	RET

	DSEG

_printf_count:	DS	2	; running byte count, returned by printf-family
	PUBLIC	_printf_sink
_printf_sink:	DW	__conout	; where _printf_putc sends each byte
_printf_fmtstart:	DS	2	; first byte after '%', for _printf_unknown
; One buffer for the digits of an integer conversion.  Hex handlers fill it
; from the start (up to 16 digits for %llx), the 32/64-bit decimal handlers
; too; the 16-bit decimal and octal handlers fill it backwards from +24.
_printf_hexbuf:
_printf_decbuf:	DS	24
_printf_dstart:	DS	2
_printf_dcnt:	DB	0
_pn_sign:	DB	0
_pn_n:		DB	0
_pn_zeros:	DB	0
_pn_padn:	DB	0
; Per-conversion state, cleared at every '%' (keep it contiguous, 11 bytes)
_printf_state:
_printf_width:	DB	0
_printf_zero:	DB	0
_printf_upper:	DB	0
_printf_prec:	DB	0
_printf_hasprec:	DB	0
_printf_alt:	DB	0	; '#' flag - alt form for o/x/X
_printf_left:	DB	0	; '-' flag
_printf_plus:	DB	0	; '+' flag
_printf_space:	DB	0	; ' ' flag
_printf_neg:	DB	0	; 0 unsigned, 1 negative, 2 signed non-negative
_printf_pfxlen:	DB	0	; 2 = print 0x

_printf_ll_w0:	DS	2
_printf_ll_w1:	DS	2
_printf_ll_w2:	DS	2
_printf_ll_w3:	DS	2


	CSEG
; ============================================================
; lc_printf_d.mac
; ============================================================
; lc_printf_d.mac - printf %d/%i handler


	CSEG

	PUBLIC	__printf_handle_d
__printf_handle_d:
	; Entry: HL = format ptr (past 'd'), C = arg offset, IX = frame
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = value
	EX	DE,HL		; HL = value
	LD	A,2		; signed, not negative
	BIT	7,H
	JR	Z,_phd_pos
	DEC	A		; negative: 1, and HL = -HL
	LD	(_printf_neg),A
	LD	A,L
	CPL
	LD	L,A
	LD	A,H
	CPL
	LD	H,A
	INC	HL
	JR	_phd_go
_phd_pos:
	LD	(_printf_neg),A
_phd_go:
	CALL	_printf_dec16
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_dec16.mac
; ============================================================
; lc_printf_dec16.mac - 16-bit unsigned decimal digits for %d and %u


	CSEG

; Entry: HL = value.  Exit: _printf_dstart/_printf_dcnt describe the digits.
	PUBLIC	_printf_dec16
_printf_dec16:
	PUSH	BC
	PUSH	IX
	LD	IX,_printf_decbuf+24
	LD	B,0
_pd16_lp:
	LD	DE,10
	CALL	_prt_div16
	LD	A,E
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	LD	A,H
	OR	L
	JR	NZ,_pd16_lp
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	IX
	POP	BC
	RET


	CSEG
; ============================================================
; lc_printf_hh.mac
; ============================================================
; lc_printf_hh.mac - printf: the hh length modifier
;
; %hhd and %hhu convert the argument to signed char or unsigned char
; (C 7.23.6.1p7).  The printf hook of uc80 (printf_hook.py) puts a short glue
; routine in front of the handler of d, i, u, o, x and X:
;
;     CALL __printf_hhs    (d, i)    or    CALL __printf_hhu    (u, o, x, X)
;     JP   the handler
;
; The routine narrows the int argument on the stack when the specification
; has "hh", and does nothing for "h" or for no modifier.  It handles the
; 16-bit int only.


	CSEG

	PUBLIC	__printf_hhs
	PUBLIC	__printf_hhu

; Entry (as the handler): C = argument offset, IX = frame.  Keeps HL, C.
__printf_hhs:
	LD	A,1
	JR	_pfhh
__printf_hhu:
	XOR	A
_pfhh:
	PUSH	HL
	PUSH	DE
	PUSH	AF		; A = 1 for a signed conversion
	LD	DE,(_printf_fmtstart)
_pfhh_sk:
	LD	A,(DE)		; skip the flags, the width and the precision
	CP	'9'+1
	JR	NC,_pfhh_len
	CP	' '
	JR	C,_pfhh_len
	INC	DE
	JR	_pfhh_sk
_pfhh_len:
	CP	'h'
	JR	NZ,_pfhh_no
	INC	DE
	LD	A,(DE)
	CP	'h'
	JR	NZ,_pfhh_no
	LD	H,0
	LD	L,C
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL -> the low byte of the argument
	POP	AF
	OR	A
	LD	A,(HL)
	INC	HL
	JR	Z,_pfhh_u
	ADD	A,A		; the sign of the low byte
	SBC	A,A		; 0 or 0FFH
	LD	(HL),A
	JR	_pfhh_ret
_pfhh_u:
	LD	(HL),0
_pfhh_ret:
	POP	DE
	POP	HL
	RET
_pfhh_no:
	POP	AF
	JR	_pfhh_ret


	CSEG
; ============================================================
; lc_printf_l.mac
; ============================================================
; lc_printf_l.mac - printf 'l' length prefix handler
; Dispatches to __printf_long_table, or 'll' to __printf_ll_table


	CSEG

	PUBLIC	__printf_handle_l
__printf_handle_l:
	; HL points past the 'l' in format string
	; Read next char
	LD	A,(HL)
	INC	HL

	CP	'l'
	JR	Z,_phl_ll

	; Search __printf_long_table for this char
	PUSH	HL
	PUSH	BC
	LD	B,A		; B = format char
	LD	HL,__printf_long_table
_phl_search:
	LD	A,(HL)
	OR	A
	JR	Z,_phl_unknown
	CP	B
	JR	Z,_phl_found
	INC	HL
	INC	HL
	INC	HL
	JR	_phl_search

_phl_found:
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = handler address
	POP	BC
	POP	HL
	PUSH	DE
	RET			; Tail-call handler

_phl_unknown:
	; %l<something we have no handler for>, e.g. %ls.  Echo the whole
	; specification instead of dropping it silently; HL already points
	; one byte past the conversion char, which is what the echo wants.
	POP	BC
	POP	HL
	JP	_printf_unk_echo

_phl_ll:
	; 'll' prefix - search __printf_ll_table
	LD	A,(HL)
	INC	HL
	PUSH	HL
	PUSH	BC
	LD	B,A
	LD	HL,__printf_ll_table
_phl_ll_search:
	LD	A,(HL)
	OR	A
	JR	Z,_phl_ll_unknown
	CP	B
	JR	Z,_phl_ll_found
	INC	HL
	INC	HL
	INC	HL
	JR	_phl_ll_search

_phl_ll_found:
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	POP	BC
	POP	HL
	PUSH	DE
	RET

_phl_ll_unknown:
	; %ll<no handler> - same treatment as _phl_unknown.
	POP	BC
	POP	HL
	JP	_printf_unk_echo


	CSEG
; ============================================================
; lc_printf_ld.mac
; ============================================================
; lc_printf_ld.mac - printf %ld handler (signed long decimal)


	CSEG

	PUBLIC	__printf_handle_ld
__printf_handle_ld:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	; Get 32-bit value
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = low word
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A		; HL = high word
	EX	DE,HL		; DEHL = 32-bit value

	LD	A,2		; signed, not negative
	LD	(_printf_neg),A
	BIT	7,D
	JR	Z,_phld_pos

	LD	A,1		; negative: remember, then negate DEHL
	LD	(_printf_neg),A
	LD	BC,0
	LD	A,C
	SUB	L
	LD	L,A
	LD	A,C
	SBC	A,H
	LD	H,A
	LD	A,C
	SBC	A,E
	LD	E,A
	LD	A,C
	SBC	A,D
	LD	D,A

_phld_pos:
	CALL	_printf_dec32
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,4		; Long is 4 bytes
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_lld.mac
; ============================================================
; lc_printf_lld.mac - printf %lld handler (signed long long decimal)



	CSEG

	PUBLIC	__printf_handle_lld
__printf_handle_lld:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	; Read 8 bytes (64 bits) into _prt64_val
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val+2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val+4),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_prt64_val+6),DE

	; Check sign (bit 7 of highest byte)
	LD	A,2		; signed, not negative
	LD	(_printf_neg),A
	LD	A,D
	AND	80H
	JR	Z,_phlld_pos

	LD	A,1		; negative: remember, then negate below
	LD	(_printf_neg),A

	; Negate 64-bit value (0 - _prt64_val)
	XOR	A		; Clear carry
	LD	HL,0
	LD	DE,(_prt64_val)
	SBC	HL,DE
	LD	(_prt64_val),HL
	LD	HL,0
	LD	DE,(_prt64_val+2)
	SBC	HL,DE
	LD	(_prt64_val+2),HL
	LD	HL,0
	LD	DE,(_prt64_val+4)
	SBC	HL,DE
	LD	(_prt64_val+4),HL
	LD	HL,0
	LD	DE,(_prt64_val+6)
	SBC	HL,DE
	LD	(_prt64_val+6),HL

_phlld_pos:
	CALL	_printf_dec64
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,8		; Long long is 8 bytes
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_llo.mac
; ============================================================
; lc_printf_llo.mac - printf %llo handler (unsigned long long octal)
;
; The compiler writes no table entry for 'llo'.  The printf hook of uc80
; (printf_hook.py) adds one to the long long table when a format has %llo.


	CSEG

	PUBLIC	__printf_handle_llo
__printf_handle_llo:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w0),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w1),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_printf_ll_w3),DE
	PUSH	IX
	LD	IX,_printf_decbuf+24
	LD	B,0		; digit counter
_pllo_cvt:
	LD	A,(_printf_ll_w0)
	AND	07H
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	LD	D,3		; shift the 64-bit value right by 3
_pllo_sh:
	LD	HL,(_printf_ll_w3)
	SRL	H
	RR	L
	LD	(_printf_ll_w3),HL
	LD	HL,(_printf_ll_w2)
	RR	H
	RR	L
	LD	(_printf_ll_w2),HL
	LD	HL,(_printf_ll_w1)
	RR	H
	RR	L
	LD	(_printf_ll_w1),HL
	LD	HL,(_printf_ll_w0)
	RR	H
	RR	L
	LD	(_printf_ll_w0),HL
	DEC	D
	JR	NZ,_pllo_sh
	LD	HL,(_printf_ll_w0)
	LD	A,H
	OR	L
	LD	HL,(_printf_ll_w1)
	OR	H
	OR	L
	LD	HL,(_printf_ll_w2)
	OR	H
	OR	L
	LD	HL,(_printf_ll_w3)
	OR	H
	OR	L
	JR	NZ,_pllo_cvt
	; '#' flag: force the first digit to be '0'
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_pllo_set
	LD	A,(IX+0)
	CP	'0'
	JR	Z,_pllo_z
	DEC	IX
	LD	(IX+0),'0'
	INC	B
	JR	_pllo_set
_pllo_z:
	; value 0 with '#': "%#.0llo" still prints "0"
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_pllo_set
	INC	A
	LD	(_printf_prec),A
_pllo_set:
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	IX
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,8
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_llu.mac
; ============================================================
; lc_printf_llu.mac - printf %llu handler (unsigned long long decimal)


	CSEG

	PUBLIC	__printf_handle_llu
__printf_handle_llu:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE		; HL = IX + offset
	; Read 8 bytes (64 bits) into _prt64_val
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val+2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_prt64_val+4),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_prt64_val+6),DE

	CALL	_printf_dec64
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,8		; Long long is 8 bytes
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_llx.mac
; ============================================================
; lc_printf_llx.mac - printf %llx handler (long long hex)



	CSEG

	PUBLIC	__printf_handle_llx
__printf_handle_llx:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	; Read 8 bytes (64 bits)
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w0),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w1),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(_printf_ll_w2),DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_printf_ll_w3),DE
	; 16 nibbles, high word first, into _printf_hexbuf
	LD	DE,_printf_hexbuf
	LD	HL,(_printf_ll_w3)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w2)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w1)
	CALL	_printf_hexword
	LD	HL,(_printf_ll_w0)
	CALL	_printf_hexword
	LD	B,16
	CALL	_printf_hexfin
	POP	BC
	LD	A,C
	ADD	A,8
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_llxu.mac
; ============================================================
; lc_printf_llxu.mac - printf %llX handler (long long hex, upper case)
;
; The compiler writes no table entry for 'llX'.  The printf hook of uc80
; (printf_hook.py) adds one to the long long table when a format has %llX.


	CSEG

	PUBLIC	__printf_handle_llxu
__printf_handle_llxu:
	LD	A,1
	LD	(_printf_upper),A
	JP	__printf_handle_llx


	CSEG
; ============================================================
; lc_printf_lo.mac
; ============================================================
; lc_printf_lo.mac - printf %lo handler (unsigned long octal)



	CSEG

	PUBLIC	__printf_handle_lo
__printf_handle_lo:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = value
	; Store DEHL to work area
	LD	(_plo_val),HL
	LD	(_plo_val+2),DE
	PUSH	IX
	LD	IX,_printf_decbuf+24
	LD	B,0		; digit counter
_plo_cvt:
	LD	A,(_plo_val)
	AND	07h		; remainder = value & 7
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	; Shift 32-bit _plo_val right by 3 (divide by 8)
	; Byte order: _plo_val+0 (low) .. _plo_val+3 (high)
	; Do 3 single-bit right shifts
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Second shift
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Third shift
	LD	A,(_plo_val+3)
	SRL	A
	LD	(_plo_val+3),A
	LD	A,(_plo_val+2)
	RRA
	LD	(_plo_val+2),A
	LD	A,(_plo_val+1)
	RRA
	LD	(_plo_val+1),A
	LD	A,(_plo_val)
	RRA
	LD	(_plo_val),A
	; Check if quotient is zero
	LD	HL,(_plo_val)
	LD	A,H
	OR	L
	JR	NZ,_plo_cvt
	LD	HL,(_plo_val+2)
	LD	A,H
	OR	L
	JR	NZ,_plo_cvt
	; '#' flag: force the first digit to be '0'
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_plo_set
	LD	A,(IX+0)
	CP	'0'
	JR	Z,_plo_set_z
	DEC	IX
	LD	(IX+0),'0'
	INC	B
	JR	_plo_set
_plo_set_z:
	; value 0 with '#': "%#.0o" still prints "0"
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_plo_set
	INC	A
	LD	(_printf_prec),A
_plo_set:
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	IX
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop

	COMMON	/lc_printf_lo/
_plo_val:	DS	4


	CSEG
; ============================================================
; lc_printf_lu.mac
; ============================================================
; lc_printf_lu.mac - printf %lu handler (unsigned long decimal)


	CSEG

	PUBLIC	__printf_handle_lu
__printf_handle_lu:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = value
	CALL	_printf_dec32
	CALL	_printf_numout
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_lx.mac
; ============================================================
; lc_printf_lx.mac - printf %lx and %lX handlers (long hex)



	CSEG

	PUBLIC	__printf_handle_lx
	PUBLIC	__printf_handle_lxu

; %lX / %X-under-int32: set uppercase flag, fall through to %lx path
__printf_handle_lxu:
	LD	A,1
	LD	(_printf_upper),A
	; fall through

__printf_handle_lx:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	EX	DE,HL		; DEHL = value (DE=high, HL=low)

	; 8 nibbles, high word first, into _printf_hexbuf
	PUSH	HL		; low word
	EX	DE,HL		; HL = high word
	LD	DE,_printf_hexbuf
	CALL	_printf_hexword
	POP	HL
	CALL	_printf_hexword
	LD	B,8
	CALL	_printf_hexfin
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_n.mac
; ============================================================
; lc_printf_n.mac - printf %n handler
;
; Stores the number of characters written so far in the int that the next
; argument points to.  The compiler writes no table entry for 'n'.  The
; printf hook of uc80 (printf_hook.py) adds one when a format string has %n.


	CSEG

	PUBLIC	__printf_handle_n
__printf_handle_n:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = the pointer
	INC	C
	INC	C
	LD	HL,(_printf_count)
	EX	DE,HL
	LD	(HL),E
	INC	HL
	LD	(HL),D
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_o.mac
; ============================================================
; lc_printf_o.mac - printf %o handler (unsigned int octal)


	CSEG

	PUBLIC	__printf_handle_o
__printf_handle_o:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL		; HL = value
	PUSH	IX
	PUSH	BC
	LD	B,0
	LD	IX,_printf_decbuf+24
_pho_cvt:
	LD	A,L
	AND	07h		; remainder = value & 7
	ADD	A,'0'
	DEC	IX
	LD	(IX+0),A
	INC	B
	; Shift HL right by 3 (divide by 8)
	SRL	H
	RR	L
	SRL	H
	RR	L
	SRL	H
	RR	L
	LD	A,H
	OR	L
	JR	NZ,_pho_cvt
	; Alternative form (# flag): C 7.21.6.1 para 6 says force the first
	; digit to be '0'.  Value 0 already gives "0".
	LD	A,(_printf_alt)
	OR	A
	JR	Z,_pho_set
	LD	A,(IX+0)
	CP	'0'
	JR	Z,_pho_set_z
	DEC	IX
	LD	(IX+0),'0'
	INC	B
	JR	_pho_set
_pho_set_z:
	; value 0 with '#': "%#.0o" still prints "0"
	LD	A,(_printf_prec)
	OR	A
	JR	NZ,_pho_set
	INC	A
	LD	(_printf_prec),A
_pho_set:
	LD	(_printf_dstart),IX
	LD	A,B
	LD	(_printf_dcnt),A
	POP	BC
	POP	IX
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_s.mac
; ============================================================
; lc_printf_s.mac - printf %s handler


	CSEG

	PUBLIC	__printf_handle_s
__printf_handle_s:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = string pointer

	XOR	A
	LD	(_phs_pad),A
	LD	A,(_printf_width)
	OR	A
	JR	Z,_phs_print	; no field width: nothing to count

	; Count the characters that will be printed, but never more than
	; the width: B = min(width, precision if any).
	LD	B,A
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_cnt
	LD	A,(_printf_prec)
	CP	B
	JR	NC,_phs_cnt
	LD	B,A
_phs_cnt:
	LD	H,D
	LD	L,E
	LD	C,0
_phs_c1:
	LD	A,C
	CP	B
	JR	NC,_phs_cd
	LD	A,(HL)
	OR	A
	JR	Z,_phs_cd
	INC	HL
	INC	C
	JR	_phs_c1
_phs_cd:
	LD	A,(_printf_width)
	SUB	C		; padding = width - printed characters
	LD	(_phs_pad),A
	LD	B,A
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_phs_print
	PUSH	DE
	LD	E,' '
	CALL	_printf_padn
	POP	DE

_phs_print:
	; Load precision limit into B
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_nop
	LD	A,(_printf_prec)
	LD	B,A
	JR	_phs_loop
_phs_nop:
	LD	B,0

_phs_loop:
	LD	A,(_printf_hasprec)
	OR	A
	JR	Z,_phs_nolim
	LD	A,B
	OR	A
	JR	Z,_phs_done
	DEC	B
_phs_nolim:
	LD	A,(DE)
	OR	A
	JR	Z,_phs_done
	PUSH	DE
	PUSH	BC
	LD	E,A
	CALL	_printf_putc
	POP	BC
	POP	DE
	INC	DE
	JR	_phs_loop

_phs_done:
	LD	A,(_printf_left)
	OR	A
	JR	Z,_phs_ret
	LD	A,(_phs_pad)
	LD	B,A
	LD	E,' '
	CALL	_printf_padn
_phs_ret:
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop

	COMMON	/lc_printf_s/
_phs_pad:	DS	1


	CSEG
; ============================================================
; lc_printf_skip.mac
; ============================================================
; lc_printf_skip.mac - printf: a length modifier that changes nothing
;
; The table entry of a modifier that has no effect on the argument: 't'
; (ptrdiff_t is an int) and 'l' before a float conversion (C 7.23.6.1p7).
; The handler goes on with the character after the modifier.  The printf hook
; of uc80 (printf_hook.py) adds these entries to the dispatch table.


	CSEG

	PUBLIC	__printf_handle_skip
__printf_handle_skip:
	DEC	HL		; back on the modifier; _printf_skip steps past it
	JP	_printf_skip


	CSEG
; ============================================================
; lc_printf_u.mac
; ============================================================
; lc_printf_u.mac - printf %u handler


	CSEG

	PUBLIC	__printf_handle_u
__printf_handle_u:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL		; HL = value
	CALL	_printf_dec16
	CALL	_printf_numout
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_printf_x.mac
; ============================================================
; lc_printf_x.mac - printf %x, %X, %p handlers


	CSEG

	PUBLIC	__printf_handle_x
	PUBLIC	__printf_handle_xu
	PUBLIC	__printf_handle_p

__printf_handle_xu:
	; %X handler - set uppercase flag and fall through
	LD	A,1
	LD	(_printf_upper),A
	JR	__printf_handle_x

__printf_handle_p:
	; Pointer: 0x and the hex digits, also for a null pointer (0x0).
	; C leaves the format of %p to the implementation.
	LD	A,2
	LD	(_printf_pfxlen),A

__printf_handle_x:
	PUSH	HL
	LD	H,0
	LD	L,C
	PUSH	BC
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	; _printf_prt_hex also handles the '#' prefix (0x / 0X) per
	; C 7.21.6.1 para 6, plus width, flags and precision.
	CALL	_printf_prt_hex
	POP	BC
	INC	C
	INC	C
	POP	HL
	JP	_printf_loop


	CSEG
; ============================================================
; lc_prt_dec32.mac
; ============================================================
; lc_prt_dec32.mac - print DEHL as 32-bit decimal


; Output goes through _printf_putc, not straight to __conout, so the
; digits are counted in _printf_count and the printf family returns the
; number of bytes it actually wrote.  Writing directly meant printf("%ld")
; returned 3 for a ten-byte "[1234567]\n".  Every caller of _prt_dec32
; (printf core, %ld, %lu, fprintf) links the printf core that defines it.

	CSEG

	PUBLIC	_prt_dec32
	PUBLIC	_printf_dec32

; _printf_dec32: DEHL -> decimal digits in _printf_decbuf, described by
; _printf_dstart/_printf_dcnt.  _prt_dec32 prints them.
_printf_dec32:
	PUSH	BC
	PUSH	IX

	; Store value in work area
	LD	(_prt32_val),HL
	LD	(_prt32_val+2),DE

	LD	B,0		; Digit counter

_prt32_loop:
	CALL	_div32_10
	PUSH	AF		; Save digit (remainder)
	INC	B

	; Check if quotient is zero
	LD	HL,(_prt32_val)
	LD	A,H
	OR	L
	JR	NZ,_prt32_loop
	LD	HL,(_prt32_val+2)
	LD	A,H
	OR	L
	JR	NZ,_prt32_loop

	LD	HL,_printf_decbuf
	LD	(_printf_dstart),HL
	LD	A,B
	LD	(_printf_dcnt),A
_prt32_out:
	POP	AF
	ADD	A,'0'
	LD	(HL),A
	INC	HL
	DJNZ	_prt32_out

	POP	IX
	POP	BC
	RET

_prt_dec32:
	CALL	_printf_dec32
	PUSH	BC
	LD	HL,(_printf_dstart)
	LD	A,(_printf_dcnt)
	LD	B,A
_prt32_raw:
	LD	E,(HL)
	CALL	_printf_putc
	INC	HL
	DJNZ	_prt32_raw
	POP	BC
	RET

; Internal: divide _prt32_val by 10
; Returns remainder in A, quotient stored back in _prt32_val
	PUBLIC	_div32_10
_div32_10:
	; Value in DE:HL (DE = high word), A = running remainder.  The 32 bit
	; value stays in registers; only the start and end touch _prt32_val.
	PUSH	BC
	PUSH	DE
	PUSH	HL

	LD	HL,(_prt32_val)
	LD	DE,(_prt32_val+2)
	LD	B,32
	XOR	A
_div32_10_loop:
	ADD	HL,HL
	RL	E
	RL	D
	RLA			; remainder is at most 18, so A cannot overflow
	CP	10
	JR	C,_div32_10_ns
	SUB	10
	INC	L		; quotient bit (bit 0 of HL is free after ADD HL,HL)
_div32_10_ns:
	DJNZ	_div32_10_loop

	LD	(_prt32_val),HL
	LD	(_prt32_val+2),DE

	POP	HL
	POP	DE
	POP	BC
	RET

	COMMON	/lc_prt_dec32/
	PUBLIC	_prt32_val
_prt32_val:	DS	4


	CSEG
; ============================================================
; lc_prt_dec64.mac
; ============================================================
; lc_prt_dec64.mac - print 64-bit value as unsigned decimal


	CSEG

	PUBLIC	_printf_dec64
; Input: 8-byte value already stored in _prt64_val.
; Output: decimal digits in _printf_decbuf (_printf_dstart/_printf_dcnt).
_printf_dec64:
	PUSH	BC
	PUSH	IX

	LD	B,0		; Digit counter

_prt64_loop:
	CALL	_div64_10
	PUSH	AF		; Save digit (remainder)
	INC	B

	; Check if quotient is zero (all 8 bytes)
	LD	HL,(_prt64_val)
	LD	A,H
	OR	L
	JR	NZ,_prt64_loop
	LD	HL,(_prt64_val+2)
	LD	A,H
	OR	L
	JR	NZ,_prt64_loop
	LD	HL,(_prt64_val+4)
	LD	A,H
	OR	L
	JR	NZ,_prt64_loop
	LD	HL,(_prt64_val+6)
	LD	A,H
	OR	L
	JR	NZ,_prt64_loop

	LD	HL,_printf_decbuf
	LD	(_printf_dstart),HL
	LD	A,B
	LD	(_printf_dcnt),A
_prt64_out:
	POP	AF
	ADD	A,'0'
	LD	(HL),A
	INC	HL
	DJNZ	_prt64_out

	POP	IX
	POP	BC
	RET

; Internal: divide _prt64_val (8 bytes) by 10
; Returns remainder in A, quotient stored back in _prt64_val
_div64_10:
	PUSH	BC
	PUSH	DE
	PUSH	HL

	LD	DE,0		; DE = running remainder
	LD	B,64

_div64_10_loop:
	; Shift remainder left by 1
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL

	; Shift _prt64_val left by 1 (64 bits, MSB first carries into DE)
	LD	HL,(_prt64_val)
	ADD	HL,HL
	LD	(_prt64_val),HL
	LD	HL,(_prt64_val+2)
	ADC	HL,HL
	LD	(_prt64_val+2),HL
	LD	HL,(_prt64_val+4)
	ADC	HL,HL
	LD	(_prt64_val+4),HL
	LD	HL,(_prt64_val+6)
	ADC	HL,HL
	LD	(_prt64_val+6),HL
	JR	NC,_div64_10_nc
	INC	DE
_div64_10_nc:

	; Check if DE >= 10
	LD	A,D
	OR	A
	JR	NZ,_div64_10_sub
	LD	A,E
	CP	10
	JR	C,_div64_10_nosub

_div64_10_sub:
	LD	A,E
	SUB	10
	LD	E,A
	LD	A,D
	SBC	A,0
	LD	D,A

	; Set bit 0 of quotient (lowest byte of _prt64_val)
	LD	HL,(_prt64_val)
	INC	HL
	LD	(_prt64_val),HL

_div64_10_nosub:
	DJNZ	_div64_10_loop

	LD	A,E		; Remainder

	POP	HL
	POP	DE
	POP	BC
	RET

	PUBLIC	_prt64_val
	COMMON	/lc_prt_dec64/
_prt64_val:	DS	8


	CSEG
; ============================================================
; lc_prt_float.mac
; ============================================================
; lc_prt_float.mac - the float conversions of printf: %f %F %e %E %g %G
;
; One engine for all six conversions.  It does no float arithmetic.  A
; binary32 value is M * 2^E (M has 24 bits), so its decimal form is exact and
; this module makes the exact digits with integer arithmetic:
;
;   - E >= 0: start with M as decimal digits and double the digit string E
;     times (at most 104 times, at most 39 digits);
;   - E < 0:  halve the digit string -E times (at most 149 times; each halving
;     adds at most one digit after the decimal point).
;
; The digits are in _pf_dg, one digit in each byte.  The byte with index 39 is
; the units digit, so the byte with index i has the weight 10^(39-i).  Index
; 40 is the first digit after the decimal point.  Then the digits are rounded
; to the precision (to nearest, a tie to the even digit, like glibc) and
; printed.  The result is the same as the result of glibc for the same float
; value, for every precision.
;
; The handlers are the table entries that the compiler writes beside main()
; (and that lc_printf_all lists).  This module needs no float arithmetic, so
; it does not link the soft float runtime.
;
; Handler ABI (see lc_printf_core.mac): entered by a tail JP with HL = format
; pointer past the specifier, C = vararg offset from IX, IX = printf's frame.
; The engine does not change IX and IY.



	CSEG

	PUBLIC	__printf_handle_f
	PUBLIC	__printf_handle_fu
	PUBLIC	__printf_handle_e
	PUBLIC	__printf_handle_eu
	PUBLIC	__printf_handle_g
	PUBLIC	__printf_handle_gu

DIGITS	EQU	190		; digits that _pf_dg holds (index 0 to 189)
POINT	EQU	40		; index of the first digit after the point

__printf_handle_f:
	LD	A,'f'
	JR	_printf_fl
__printf_handle_fu:
	LD	A,'F'
	JR	_printf_fl
__printf_handle_e:
	LD	A,'e'
	JR	_printf_fl
__printf_handle_eu:
	LD	A,'E'
	JR	_printf_fl
__printf_handle_g:
	LD	A,'g'
	JR	_printf_fl
__printf_handle_gu:
	LD	A,'G'

; A = conversion character, HL = format pointer, C = vararg offset
_printf_fl:
	PUSH	HL
	PUSH	BC
	LD	B,A
	AND	20H
	XOR	20H		; 0 for a lower case conversion
	LD	(_printf_upper),A
	LD	A,B
	OR	20H
	LD	(_pf_mode),A	; f, e or g
	LD	H,0
	LD	L,C
	PUSH	IX
	POP	DE
	ADD	HL,DE
	LD	DE,_pf_val
	LD	BC,4
	LDIR
	CALL	_pf_main
	POP	BC
	LD	A,C
	ADD	A,4
	LD	C,A
	POP	HL
	JP	_printf_loop

; ============================================================
; _pf_main: print the float in _pf_val.
; ============================================================
_pf_main:
	; ---- the sign character: '-', '+', ' ' or none ----
	LD	A,(_pf_val+3)
	LD	B,'-'
	OR	A
	JP	M,_pm_sign
	LD	B,'+'
	LD	A,(_printf_plus)
	OR	A
	JR	NZ,_pm_sign
	LD	B,' '
	LD	A,(_printf_space)
	OR	A
	JR	NZ,_pm_sign
	LD	B,0
_pm_sign:
	LD	A,B
	LD	(_pf_sign),A

	; ---- B = the biased exponent ----
	LD	A,(_pf_val+3)
	ADD	A,A
	LD	B,A
	LD	A,(_pf_val+2)
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A
	CP	255
	JR	NZ,_pm_fin

	; infinity or NaN: the field is padded with spaces
	LD	A,(_pf_val+2)
	AND	7FH
	LD	C,A
	LD	A,(_pf_val+1)
	OR	C
	LD	C,A
	LD	A,(_pf_val)
	OR	C
	LD	HL,_pf_sinf
	JR	Z,_pm_spec
	LD	HL,_pf_snan
_pm_spec:
	LD	(_pf_sptr),HL
	LD	A,2
	LD	(_pf_kind),A
	XOR	A
	LD	(_printf_zero),A
	JP	_pf_emit

	; ---- a finite value: the mantissa M in _pf_m ----
_pm_fin:
	LD	A,(_pf_val)
	LD	(_pf_m),A
	LD	A,(_pf_val+1)
	LD	(_pf_m+1),A
	LD	A,(_pf_val+2)
	AND	7FH
	LD	C,A		; the high mantissa bits
	LD	A,B
	OR	A
	JR	Z,_pm_sub
	LD	A,C
	OR	80H		; the hidden bit
	LD	C,A
_pm_sub:
	LD	A,C
	LD	(_pf_m+2),A
	; clear the digits
	LD	HL,_pf_dg
	LD	DE,_pf_dg+1
	LD	BC,DIGITS+1
	LD	(HL),0
	LDIR
	LD	A,39
	LD	(_pf_dstart),A
	LD	A,POINT
	LD	(_pf_dlen),A
	LD	A,(_pf_m)
	LD	HL,_pf_m+1
	OR	(HL)
	INC	HL
	OR	(HL)
	JR	Z,_pm_digits	; the value is zero: all digits stay zero

	; Horner: the digit string = M, one bit at a time, high bit first
	LD	B,24
_pm_h:
	PUSH	BC
	LD	HL,_pf_m
	SLA	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	LD	A,0
	RLA
	CALL	_pf_dbl
	POP	BC
	DJNZ	_pm_h

	; the binary exponent: E = e - 150, and e = 0 means E = -149
	LD	A,(_pf_val+3)
	ADD	A,A
	LD	B,A
	LD	A,(_pf_val+2)
	RLCA
	LD	A,B
	ADC	A,0		; A = e
	LD	B,A
	OR	A
	JR	Z,_pm_sn
	CP	150
	JR	C,_pm_neg
	SUB	150
	JR	Z,_pm_digits
	LD	B,A
_pm_dd:
	PUSH	BC
	XOR	A
	CALL	_pf_dbl
	POP	BC
	DJNZ	_pm_dd
	JR	_pm_digits
_pm_sn:
	LD	A,149		; a subnormal value: M * 2^-149
	JR	_pm_hv
_pm_neg:
	LD	B,A
	LD	A,150
	SUB	B
_pm_hv:
	LD	B,A
_pm_hh:
	PUSH	BC
	CALL	_pf_halve
	POP	BC
	DJNZ	_pm_hh

_pm_digits:
	LD	A,(_pf_mode)
	CP	'f'
	JR	Z,_pm_f
	CP	'e'
	JR	Z,_pm_e

	; ---- %g: P significant digits ----
	CALL	_pf_prec6
	OR	A
	JR	NZ,_pg_p
	LD	A,1
_pg_p:
	LD	(_pf_gp),A
	CALL	_pf_scan0
	LD	L,A
	LD	H,0
	LD	A,(_pf_gp)
	LD	E,A
	LD	D,0
	ADD	HL,DE		; round after the digit with the index f0 + P - 1
	CALL	_pf_round
	CALL	_pf_scan0	; A = f0
	LD	(_pf_f0),A
	LD	B,A
	LD	A,39
	SUB	B
	LD	(_pf_x),A	; X = the decimal exponent
	LD	C,A
	BIT	7,A
	JR	Z,_pg_nn
	ADD	A,4
	JP	M,_pg_exp	; X < -4
	JR	_pg_fix
_pg_nn:
	LD	A,(_pf_gp)
	CP	C
	JR	Z,_pg_exp	; X >= P
	JR	C,_pg_exp
_pg_fix:
	; style f, P-1-X digits after the point (at most 255)
	LD	A,(_pf_gp)
	DEC	A
	LD	L,A
	LD	H,0
	LD	A,(_pf_x)
	LD	E,A
	LD	D,0
	BIT	7,A
	JR	Z,_pg_f0
	DEC	D
_pg_f0:
	OR	A
	SBC	HL,DE
	LD	A,H
	OR	A
	LD	A,L
	JR	Z,_pg_f1
	LD	A,255
_pg_f1:
	LD	B,A
_pg_fx:
	LD	A,(_printf_alt)
	OR	A
	JR	NZ,_pg_fk
	LD	DE,POINT
	CALL	_pf_strip
_pg_fk:
	LD	A,B
	LD	(_pf_nf),A
	LD	A,(_pf_f0)
	CP	POINT
	JR	C,_pg_fs
	LD	A,39
_pg_fs:
	LD	(_pf_ifirst),A
	LD	A,39
	LD	(_pf_ilast),A
	XOR	A
	LD	(_pf_kind),A
	CALL	_pf_setdot
	JP	_pf_emit
_pg_exp:
	LD	A,(_pf_gp)
	DEC	A
	LD	B,A
	LD	A,(_printf_alt)
	OR	A
	JR	NZ,_pge_k
	LD	A,(_pf_f0)
	INC	A
	LD	E,A
	LD	D,0		; DE = f0 + 1
	CALL	_pf_strip
_pge_k:
	LD	A,B
	LD	(_pf_nf),A
	JR	_pe_set

_pm_f:
	CALL	_pf_prec6
	LD	(_pf_nf),A
	LD	L,A
	LD	H,0
	LD	DE,POINT
	ADD	HL,DE
	CALL	_pf_round
	CALL	_pf_scan0
	CP	POINT
	JR	C,_pf_s
	LD	A,39
_pf_s:
	LD	(_pf_ifirst),A
	LD	A,39
	LD	(_pf_ilast),A
	XOR	A
	LD	(_pf_kind),A
	CALL	_pf_setdot
	JP	_pf_emit

_pm_e:
	CALL	_pf_prec6
	LD	(_pf_nf),A
	CALL	_pf_scan0
	LD	L,A
	LD	H,0
	INC	HL
	LD	A,(_pf_nf)
	LD	E,A
	LD	D,0
	ADD	HL,DE		; round after the digit with the index f0 + p
	CALL	_pf_round
	CALL	_pf_scan0
	LD	(_pf_f0),A
	LD	B,A
	LD	A,39
	SUB	B
	LD	(_pf_x),A
_pe_set:
	LD	A,(_pf_f0)
	LD	(_pf_ifirst),A
	LD	(_pf_ilast),A
	LD	A,1
	LD	(_pf_kind),A
	CALL	_pf_setdot
	JP	_pf_emit

; ---- helper: A = the precision, 6 when there is none ----
_pf_prec6:
	LD	A,(_printf_hasprec)
	OR	A
	LD	A,6
	RET	Z
	LD	A,(_printf_prec)
	RET

; ---- helper: _pf_dot = 1 when _pf_nf is not 0 or the # flag is set ----
_pf_setdot:
	LD	A,(_pf_nf)
	LD	HL,_printf_alt
	OR	(HL)
	JR	Z,_psd
	LD	A,1
_psd:
	LD	(_pf_dot),A
	RET

; ---- helper: A = the index of the first digit that is not 0, or 39 ----
_pf_scan0:
	LD	HL,_pf_dg
	LD	A,(_pf_dlen)
	LD	B,A
	LD	C,0
_ps0:
	LD	A,(HL)
	OR	A
	JR	NZ,_ps0f
	INC	HL
	INC	C
	DJNZ	_ps0
	LD	A,39
	RET
_ps0f:
	LD	A,C
	RET

; ---- helper: A = the digit with the index HL (0 outside the buffer) ----
; Keeps BC, DE and HL.
_pf_getdig:
	PUSH	HL
	PUSH	DE
	LD	A,H
	OR	A
	JR	NZ,_pgd0
	LD	A,L
	CP	DIGITS
	JR	NC,_pgd0
	LD	DE,_pf_dg
	ADD	HL,DE
	LD	A,(HL)
	POP	DE
	POP	HL
	RET
_pgd0:
	XOR	A
	POP	DE
	POP	HL
	RET

; ---- helper: remove the zeros at the end of a fraction ----
; DE = the index of the first digit of the fraction, B = its length.
; Returns the shorter length in B.
_pf_strip:
	LD	A,B
	OR	A
	RET	Z
	LD	L,B
	LD	H,0
	ADD	HL,DE
	DEC	HL
	CALL	_pf_getdig
	OR	A
	RET	NZ
	DJNZ	_pf_strip
	RET

; ---- helper: double the digit string, A = the carry in (0 or 1) ----
; The digits with the indexes _pf_dstart to 39 are in use.
_pf_dbl:
	LD	C,A
	LD	A,40
	LD	HL,_pf_dstart
	SUB	(HL)
	LD	B,A
	LD	HL,_pf_dg+39
_pd_lp:
	LD	A,(HL)
	ADD	A,A
	ADD	A,C
	LD	C,0
	CP	10
	JR	C,_pd_nc
	SUB	10
	LD	C,1
_pd_nc:
	LD	(HL),A
	DEC	HL
	DJNZ	_pd_lp
	LD	A,C
	OR	A
	RET	Z
	LD	(HL),1		; one more digit on the left
	LD	A,(_pf_dstart)
	DEC	A
	LD	(_pf_dstart),A
	RET

; ---- helper: halve the digit string ----
; The digits with the indexes _pf_dstart to _pf_dlen - 1 are in use.  A
; halving can add one digit (a 5) at the end.
_pf_halve:
	LD	A,(_pf_dlen)
	LD	HL,_pf_dstart
	SUB	(HL)
	LD	B,A
	LD	E,(HL)
	LD	D,0
	LD	HL,_pf_dg
	ADD	HL,DE
	LD	C,0		; the carry
_ph_lp:
	LD	A,(HL)
	INC	C
	DEC	C
	JR	Z,_ph_n
	ADD	A,10
_ph_n:
	SRL	A
	LD	(HL),A
	LD	C,0
	RL	C
	INC	HL
	DJNZ	_ph_lp
	INC	C
	DEC	C
	JR	Z,_ph_nd
	LD	(HL),5
	LD	A,(_pf_dlen)
	INC	A
	LD	(_pf_dlen),A
_ph_nd:
	LD	A,(_pf_dstart)
	LD	E,A
	LD	D,0
	LD	HL,_pf_dg
	ADD	HL,DE
	LD	A,(HL)
	OR	A
	RET	NZ
	LD	A,E
	INC	A
	LD	(_pf_dstart),A	; the first digit became 0
	RET

; ---- helper: round the digit string, HL = the index of the first digit ----
; that is dropped.  To nearest; an exact tie goes to the even digit.
_pf_round:
	LD	A,H
	OR	A
	RET	NZ
	LD	A,L
	CP	DIGITS
	RET	NC
	LD	E,L
	LD	D,0
	LD	HL,_pf_dg
	ADD	HL,DE
	LD	A,(HL)
	CP	5
	RET	C
	JR	NZ,_prd_up
	LD	A,DIGITS-1
	SUB	E
	JR	Z,_prd_tie
	LD	B,A
	PUSH	HL
_prd_sc:
	INC	HL
	LD	A,(HL)
	OR	A
	JR	NZ,_prd_ups
	DJNZ	_prd_sc
	POP	HL
_prd_tie:
	DEC	HL
	BIT	0,(HL)
	RET	Z		; an exact tie and the digit before is even
	JR	_prd_inc
_prd_ups:
	POP	HL
_prd_up:
	DEC	HL
_prd_inc:
	LD	A,(HL)
	INC	A
	CP	10
	JR	Z,_prd_9
	LD	(HL),A
	RET
_prd_9:
	LD	(HL),0
	DEC	HL
	JR	_prd_inc

; ============================================================
; _pf_emit: print the sign, the body and the padding.
; The body is: the digits _pf_ifirst to _pf_ilast, a point when _pf_dot,
; _pf_nf digits after that, and for _pf_kind 1 the exponent.  _pf_kind 2
; is the text of an infinity or a NaN.
; ============================================================
_pf_emit:
	; HL = the length of the sign and the body
	LD	A,(_pf_kind)
	CP	2
	LD	HL,3
	JR	Z,_pe_len
	LD	A,(_pf_ilast)
	LD	HL,_pf_ifirst
	SUB	(HL)
	INC	A
	LD	L,A
	LD	H,0
	LD	A,(_pf_dot)
	LD	E,A
	LD	D,0
	ADD	HL,DE
	LD	A,(_pf_nf)
	LD	E,A
	ADD	HL,DE
	LD	A,(_pf_kind)
	OR	A
	JR	Z,_pe_len
	LD	DE,4		; e, the sign and two digits
	ADD	HL,DE
_pe_len:
	LD	A,(_pf_sign)
	OR	A
	JR	Z,_pe_ns
	INC	HL
_pe_ns:
	; the padding = width - length, or 0
	LD	A,(_printf_width)
	LD	E,A
	LD	D,0
	EX	DE,HL
	OR	A
	SBC	HL,DE
	LD	A,0
	JR	C,_pe_p
	LD	A,L
_pe_p:
	LD	(_pf_pad),A
	LD	A,(_printf_left)
	OR	A
	JR	NZ,_pe_left
	LD	A,(_printf_zero)
	OR	A
	JR	NZ,_pe_zero
	LD	E,' '
	CALL	_pf_padout
	CALL	_pf_signout
	JR	_pf_body
_pe_zero:
	CALL	_pf_signout
	LD	E,'0'
	CALL	_pf_padout
	JR	_pf_body
_pe_left:
	CALL	_pf_signout
	CALL	_pf_body
	LD	E,' '
_pf_padout:
	LD	A,(_pf_pad)
	LD	B,A
	JP	_printf_padn
_pf_signout:
	LD	A,(_pf_sign)
	OR	A
	RET	Z
	LD	E,A
	JP	_printf_putc

_pf_body:
	LD	A,(_pf_kind)
	CP	2
	JR	Z,_pb_spec
	LD	A,(_pf_ifirst)
	LD	L,A
	LD	H,0
	LD	A,(_pf_ilast)
	SUB	L
	INC	A
	LD	B,A
_pb_int:
	CALL	_pf_digout
	INC	HL
	DJNZ	_pb_int
	LD	A,(_pf_dot)
	OR	A
	JR	Z,_pb_nd
	LD	E,'.'
	CALL	_printf_putc
_pb_nd:
	LD	A,(_pf_nf)
	OR	A
	JR	Z,_pb_ex
	LD	B,A
_pb_fr:
	CALL	_pf_digout
	INC	HL
	DJNZ	_pb_fr
_pb_ex:
	LD	A,(_pf_kind)
	OR	A
	RET	Z
	LD	E,'e'
	LD	A,(_printf_upper)
	OR	A
	JR	Z,_pb_e
	LD	E,'E'
_pb_e:
	CALL	_printf_putc
	LD	A,(_pf_x)
	LD	E,'+'
	BIT	7,A
	JR	Z,_pb_xp
	NEG
	LD	E,'-'
_pb_xp:
	LD	C,A
	CALL	_printf_putc
	LD	A,C
	LD	E,'0'
_pb_tens:
	SUB	10
	JR	C,_pb_td
	INC	E
	JR	_pb_tens
_pb_td:
	ADD	A,10
	LD	C,A
	CALL	_printf_putc
	LD	A,C
	ADD	A,'0'
	LD	E,A
	JP	_printf_putc

_pb_spec:
	LD	HL,(_pf_sptr)
	LD	B,3
_pb_sl:
	LD	A,(HL)
	LD	E,A
	LD	A,(_printf_upper)
	OR	A
	LD	A,E
	JR	Z,_pb_su
	AND	0DFH
_pb_su:
	LD	E,A
	CALL	_printf_putc
	INC	HL
	DJNZ	_pb_sl
	RET

; print the digit with the index HL; keeps HL and BC
_pf_digout:
	PUSH	BC
	PUSH	HL
	CALL	_pf_getdig
	ADD	A,'0'
	LD	E,A
	CALL	_printf_putc
	POP	HL
	POP	BC
	RET

_pf_sinf:	DB	'inf'
_pf_snan:	DB	'nan'

	COMMON	/lc_prt_float/	; BSS: every variable is set before it is read

_pf_val:	DS	4	; the float to print
_pf_m:		DS	3	; its mantissa
_pf_sptr:	DS	2
_pf_sign:	DS	1
_pf_mode:	DS	1
_pf_kind:	DS	1	; 0 digits, 1 digits and exponent, 2 inf or nan
_pf_ifirst:	DS	1
_pf_ilast:	DS	1
_pf_nf:		DS	1	; digits after the point
_pf_dot:	DS	1
_pf_x:		DS	1	; the decimal exponent, as a signed byte
_pf_f0:		DS	1	; index of the first digit that is not 0
_pf_gp:		DS	1	; %g: the number of significant digits
_pf_pad:	DS	1
_pf_dstart:	DS	1
_pf_dlen:	DS	1
_pf_dg:		DS	DIGITS+2


	CSEG
; ============================================================
; lc_prt_hex.mac
; ============================================================
; lc_prt_hex.mac - hex printing helpers
;
; _prt_hex and _prt_hex4 honor the _printf_upper flag: when nonzero,
; hex digits A-F are uppercase; otherwise lowercase.  The flag is
; defined in lc_printf_core.mac and set by %X / %lX / %llX handlers.



	CSEG

; Convert nibble 0-15 in A to ASCII hex, honoring _printf_upper.
; Preserves BC; clobbers flags.
_prt_hex_nib:
	ADD	A,'0'
	CP	'9'+1
	RET	C		; 0-9: done
	PUSH	HL
	LD	H,A		; stash A
	LD	A,(_printf_upper)
	OR	A
	LD	A,H
	POP	HL
	JR	Z,_prt_hex_nib_lo
	ADD	A,7		; 'A'..'F'
	RET
_prt_hex_nib_lo:
	ADD	A,39		; 'a'..'f'
	RET

; Print HL as hex (no leading zeros)
	PUBLIC	_prt_hex
_prt_hex:
	PUSH	BC
	LD	B,0		; B=1 means we've printed a non-zero digit
	LD	A,H
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_prt_hexd
	LD	A,H
	AND	0FH
	CALL	_prt_hexd
	LD	A,L
	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	CALL	_prt_hexd
	LD	A,L
	AND	0FH
	OR	A
	JR	NZ,_prt_hexf
	PUSH	AF
	LD	A,B
	OR	A
	POP	AF
	JR	NZ,_prt_hexf
	LD	A,'0'
	LD	E,A
	CALL	__conout
	POP	BC
	RET
_prt_hexf:
	LD	B,1
	CALL	_prt_hex_nib
	LD	E,A
	CALL	__conout
	POP	BC
	RET

_prt_hexd:
	OR	A
	JR	NZ,_prt_hexd1
	LD	A,B
	OR	A
	RET	Z
	XOR	A
_prt_hexd1:
	LD	B,1
	CALL	_prt_hex_nib
	LD	E,A
	PUSH	BC
	CALL	__conout
	POP	BC
	RET

; Print HL as 4-digit hex (always all 4 digits, with leading zeros)
	PUBLIC	_prt_hex4
_prt_hex4:
	PUSH	BC
	LD	A,H
	CALL	_prt_hex4_byte
	LD	A,L
	CALL	_prt_hex4_byte
	POP	BC
	RET
_prt_hex4_byte:
	PUSH	AF
	RRCA
	RRCA
	RRCA
	RRCA
	CALL	_prt_hex4_nib
	POP	AF
_prt_hex4_nib:
	AND	0FH
	CALL	_prt_hex_nib
	LD	E,A
	CALL	__conout
	RET


	CSEG
; ============================================================
; lc_putc.mac
; ============================================================
; lc_putc.mac - split from lc_file.mac



	CSEG

; ============================================================
; int putc(int c, FILE *stream)
; Put character to stream (equivalent to fputc)
; ============================================================
	PUBLIC	_putc
_putc:
	JP	_fputc		; Just tail-call fputc


	CSEG
; ============================================================
; lc_putchar.mac
; ============================================================
; lc_putchar.mac - putchar



	CSEG

; ============================================================
; int putchar(int c)
; Output a character to console
; Argument: character on stack at IX+4
; Returns: the character written, or EOF (-1) on error
; ============================================================
	PUBLIC	_putchar
_putchar:
	; Minimal implementation - doesn't touch IX.  __conout preserves
	; BC, DE and HL, so DE still holds the character on return.
	LD	HL,2
	ADD	HL,SP		; Points to arg (after ret addr)
	LD	E,(HL)		; character in E

	CALL	__conout

	LD	L,E		; return value is the character
	LD	H,0
	RET


	CSEG
; ============================================================
; lc_puts.mac
; ============================================================
; lc_puts.mac - split from lc_puts.mac



	CSEG

; ============================================================
; int puts(const char *s)
; Output a string followed by newline
; Argument: pointer to string on stack at IX+4
; Returns: non-negative on success, EOF (-1) on error
; ============================================================
	PUBLIC	_puts
_puts:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	; Get string pointer
	LD	L,(IX+4)
	LD	H,(IX+5)

_puts_loop:
	LD	A,(HL)
	OR	A
	JR	Z,_puts_newline	; End of string

	LD	E,A		; Character in E
	CALL	__conout	; preserves HL
	INC	HL
	JR	_puts_loop

_puts_newline:
	; Output newline.  __conout supplies the CR when ___crlf_mode is
	; set; puts() used to hard-code CR LF here while printf/putchar/
	; fputs emitted a bare LF, so one program printed two different
	; line terminators depending on which stdio call it used.
	LD	E,0AH
	CALL	__conout

	; Return 0 (success)
	LD	HL,0

	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_qsort.mac
; ============================================================
; lc_qsort.mac - qsort (bsearch is in lc_bsearch.mac)


	CSEG

; ============================================================
; void qsort(void *base, size_t nmemb, size_t size,
;            int (*compar)(const void *, const void *))
;
; Calling convention (uc80): arguments are pushed right to left, so the
; FIRST argument is the LAST one pushed and sits nearest the return
; address; the result comes back in HL.  To call compar(a, b):
;	PUSH b / PUSH a / CALL compar / POP / POP
; The comparator may clobber every register except IX and SP, and it may
; also change its own argument slots (C parameters are writable), so a
; value that must survive the call is pushed separately, under the
; arguments, and popped after them.
;
; Algorithm:
;  - nmemb <= QS_THR: insertion sort only.
;  - Otherwise first check for one run: if the array is already in
;    order (non-decreasing), return; if it is in reverse order
;    (non-increasing), reverse it and return.  This costs nmemb-1
;    comparisons at most, and on random input it stops after two or three.
;  - Then a non-recursive quicksort: parts of more than QS_THR elements
;    are split with a Hoare partition around a median-of-three pivot.
;    The pivot stays in the array (QS_MID follows it when it is swapped).
;    Both scans stop on keys equal to the pivot, so all-equal input splits
;    in the middle and stays O(n log n).
;  - The larger part is pushed on the machine stack as (lo, hi) and the
;    loop continues with the smaller part, so the stack holds at most
;    log2(nmemb) entries (4 bytes each, at most 64 bytes).
;  - Parts of QS_THR elements or fewer are left alone; one final
;    insertion sort over the whole array finishes them (each element is
;    then less than QS_THR places from its final position).
;  - Elements are addressed with byte pointers stepped by size.  There is
;    no multiplication or division in the loops: part lengths are kept in
;    bytes, and the middle element is lo + ((hi-lo) - (k odd ? size : 0))/2
;    where k = (hi-lo)/size; k is odd when (hi-lo) AND (size AND -size)
;    is not zero.
;
; Reentrancy: the working variables live in static storage (fast 16-bit
; absolute loads), but qsort copies them to its stack frame on entry and
; copies them back on exit.  So a comparator that itself calls qsort (or
; calls a function that calls qsort) works.  An interrupt handler that
; calls qsort while another qsort runs is NOT supported (the static copy
; is live between the save and the restore).
;
; Stack on entry (after PUSH IX): base(IX+4), nmemb(IX+6), size(IX+8),
; compar(IX+10).  Preserves BC and IX.
; ============================================================
QS_THR	EQU	8		; parts of <= QS_THR elements go to insertion sort

	PUBLIC	_qsort
_qsort:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC

	; Save the static working area on the stack (for nested calls).
	LD	HL,-QS_NV
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL			; DE = save area
	LD	HL,QS_VARS
	LD	BC,QS_NV
	LDIR

	; size == 0 or nmemb < 2: nothing to do
	LD	L,(IX+8)
	LD	H,(IX+9)
	LD	A,H
	OR	L
	JP	Z,qs_exit
	LD	(QS_SIZE),HL
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	DE,2
	OR	A
	SBC	HL,DE
	JP	C,qs_exit

	; Trampolines: QS_TRAMP: JP compar; QS_SWJ: JP qs_sw2 or qs_swg
	LD	A,0C3H
	LD	(QS_TRAMP),A
	LD	(QS_SWJ),A
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	(QS_TRAMP+1),HL
	LD	HL,(QS_SIZE)
	LD	DE,qs_swg
	DEC	H
	INC	H
	JR	NZ,qs_e1
	LD	A,L
	CP	2
	JR	NZ,qs_e1
	LD	DE,qs_sw2
qs_e1:
	LD	(QS_SWJ+1),DE

	; QS_MASK = size AND -size (lowest set bit of size)
	LD	HL,(QS_SIZE)
	XOR	A
	SUB	L
	LD	E,A
	LD	A,0
	SBC	A,H
	LD	D,A			; DE = -size
	LD	A,E
	AND	L
	LD	E,A
	LD	A,D
	AND	H
	LD	D,A
	LD	(QS_MASK),DE

	; QS_THB = QS_THR*size, 0FFFFH if that overflows
	LD	DE,(QS_SIZE)
	LD	HL,0
	LD	B,QS_THR
qs_e2:
	ADD	HL,DE
	JR	C,qs_e3
	DJNZ	qs_e2
	JR	qs_e4
qs_e3:
	LD	HL,0FFFFH
qs_e4:
	LD	(QS_THB),HL

	; lo = base, hi = base + (nmemb-1)*size
	LD	L,(IX+6)
	LD	H,(IX+7)
	DEC	HL
	CALL	qs_mul
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(QS_LO),DE
	LD	(QS_BASE),DE
	ADD	HL,DE
	LD	(QS_HI),HL
	LD	(QS_LAST),HL
	LD	HL,0
	ADD	HL,SP
	LD	(QS_SP0),HL		; SP with an empty partition stack

	; Small array: straight to insertion sort.
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	DE,QS_THR+1
	OR	A
	SBC	HL,DE
	JP	C,qs_ins

; ---- run check: already sorted, or reverse sorted? ----
	LD	HL,(QS_LO)
	CALL	qs_cnext		; compar(p, p+size), p = lo
	BIT	7,H
	JR	NZ,qs_asc1		; < 0: ascending so far
	LD	A,H
	OR	L
	JR	NZ,qs_desc		; > 0: try descending
qs_asc1:
	; ascending: check compar(p, p+size) <= 0 for all p < hi
	LD	HL,(QS_LO)
qs_asc:
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JP	Z,qs_exit		; p == hi: all in order
	EX	DE,HL			; HL = p
	PUSH	HL
	CALL	qs_cnext
	POP	DE			; DE = p
	BIT	7,H
	EX	DE,HL
	JR	NZ,qs_asc		; < 0
	LD	A,D
	OR	E
	JR	Z,qs_asc		; == 0
	JR	qs_part			; > 0: not sorted
qs_desc:
	; descending: check compar(p, p+size) >= 0 for all p < hi
	LD	HL,(QS_LO)
qs_dsc:
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JR	Z,qs_rev		; p == hi: all in reverse order
	EX	DE,HL			; HL = p
	PUSH	HL
	CALL	qs_cnext
	POP	DE			; DE = p
	BIT	7,H
	EX	DE,HL
	JR	Z,qs_dsc		; >= 0
	JR	qs_part			; < 0: not in reverse order
qs_rev:
	; reverse the array: swap lo and hi, step inward
	LD	HL,(QS_LO)
	LD	DE,(QS_HI)
qs_rev1:
	PUSH	HL
	PUSH	DE
	CALL	QS_SWJ
	POP	HL
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE			; hi -= size
	EX	(SP),HL			; HL = lo
	ADD	HL,DE			; lo += size
	POP	DE			; DE = hi
	PUSH	HL
	OR	A
	SBC	HL,DE
	POP	HL
	JR	C,qs_rev1		; while lo < hi
	JP	qs_exit

; ---- partition [QS_LO..QS_HI], more than QS_THR elements ----
qs_part:
	; mid = lo + (d - (k odd ? size : 0)) / 2, d = hi - lo = k*size
	LD	HL,(QS_HI)
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	LD	A,(QS_MASK)
	AND	L
	LD	B,A
	LD	A,(QS_MASK+1)
	AND	H
	OR	B
	JR	Z,qs_p1
	LD	BC,(QS_SIZE)
	SBC	HL,BC			; CY is clear after OR B
qs_p1:
	SRL	H
	RR	L
	ADD	HL,DE
	LD	(QS_MID),HL

	; Median of three: order *lo <= *mid <= *hi.
	CALL	qs_ord			; mid < lo: swap
	LD	HL,(QS_HI)
	LD	DE,(QS_MID)
	CALL	qs_ord			; hi < mid: swap
	JR	Z,qs_m3
	LD	HL,(QS_MID)
	LD	DE,(QS_LO)
	CALL	qs_ord			; mid < lo: swap
qs_m3:
	; l = lo + size, r = hi - size
	LD	DE,(QS_SIZE)
	LD	HL,(QS_LO)
	ADD	HL,DE
	LD	(QS_L),HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	LD	(QS_R),HL

qs_scan:
	; while (compar(l, mid) < 0) l += size;
	LD	HL,(QS_L)
qs_sl:
	PUSH	HL			; keep l
	LD	DE,(QS_MID)
	PUSH	DE			; b = mid
	PUSH	HL			; a = l
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	DE			; DE = l
	JR	Z,qs_sl9
	LD	HL,(QS_SIZE)
	ADD	HL,DE
	JP	qs_sl
qs_sl9:
	LD	(QS_L),DE

	; while (compar(mid, r) < 0) r -= size;
	LD	HL,(QS_R)
qs_sr:
	PUSH	HL			; keep r
	PUSH	HL			; b = r
	LD	HL,(QS_MID)
	PUSH	HL			; a = mid
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	HL			; HL = r
	JR	Z,qs_sr9
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE
	JP	qs_sr
qs_sr9:
	LD	(QS_R),HL
	EX	DE,HL			; DE = r
	LD	HL,(QS_L)
	OR	A
	SBC	HL,DE
	JR	Z,qs_eq			; l == r: step both and stop
	JR	NC,qs_split		; l > r: done
	; l < r: swap, keep QS_MID on the pivot
	ADD	HL,DE			; HL = l, DE = r
	CALL	QS_SWJ
	LD	HL,(QS_MID)
	LD	DE,(QS_L)
	OR	A
	SBC	HL,DE
	JR	NZ,qs_pv1
	LD	HL,(QS_R)
	LD	(QS_MID),HL
	JR	qs_adv
qs_pv1:
	LD	HL,(QS_MID)
	LD	DE,(QS_R)
	OR	A
	SBC	HL,DE
	JR	NZ,qs_adv
	LD	HL,(QS_L)
	LD	(QS_MID),HL
qs_adv:
	CALL	qs_step
	; loop while l <= r  (qs_step leaves DE = l, HL = r)
	OR	A
	SBC	HL,DE
	JP	NC,qs_scan
	JR	qs_split

qs_eq:
	CALL	qs_step

qs_split:
	; Parts: [lo..r] and [l..hi]; byte lengths ld = r-lo, rd = hi-l
	; (a part has QS_THR elements or fewer when its length < QS_THB).
	LD	HL,(QS_R)
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	LD	(QS_LD),HL
	LD	HL,(QS_HI)
	LD	DE,(QS_L)
	OR	A
	SBC	HL,DE
	LD	(QS_RD),HL
	LD	DE,(QS_THB)
	OR	A
	SBC	HL,DE
	JR	NC,qs_rbig
	; right part small: if the left part is small too, pop
	LD	HL,(QS_LD)
	OR	A
	SBC	HL,DE
	JR	C,qs_pop
qs_goleft:
	LD	HL,(QS_R)
	LD	(QS_HI),HL
	JP	qs_part
qs_rbig:
	; right part big.  Left part small: continue with the right part.
	LD	HL,(QS_LD)
	OR	A
	SBC	HL,DE
	JR	C,qs_goright
	; both big: push the larger, continue with the smaller
	LD	HL,(QS_LD)
	LD	DE,(QS_RD)
	OR	A
	SBC	HL,DE
	JR	C,qs_pushr		; ld < rd: push right
	; push left (lo, r), continue with the right part
	LD	HL,(QS_R)
	PUSH	HL
	LD	HL,(QS_LO)
	PUSH	HL
qs_goright:
	LD	HL,(QS_L)
	LD	(QS_LO),HL
	JP	qs_part
qs_pushr:
	; push right (l, hi), continue with the left part
	LD	HL,(QS_HI)
	PUSH	HL
	LD	HL,(QS_L)
	PUSH	HL
	JR	qs_goleft

qs_pop:
	LD	HL,(QS_SP0)
	OR	A
	SBC	HL,SP
	JR	Z,qs_ins0
	POP	HL
	LD	(QS_LO),HL
	POP	HL
	LD	(QS_HI),HL
	JP	qs_part

; ---- final insertion sort over the whole array ----
qs_ins0:
	; lo = base, hi = last element
	LD	HL,(QS_BASE)
	LD	(QS_LO),HL
	LD	HL,(QS_LAST)
	LD	(QS_HI),HL
qs_ins:
	LD	HL,(QS_LO)
	LD	(QS_L),HL		; p = lo
qs_iouter:
	LD	HL,(QS_L)
	LD	DE,(QS_SIZE)
	ADD	HL,DE			; p += size
	LD	(QS_L),HL
	EX	DE,HL
	LD	HL,(QS_HI)
	OR	A
	SBC	HL,DE
	JR	C,qs_exit		; p > hi: done
	EX	DE,HL			; HL = q = p
qs_iinner:
	; while (q > lo && compar(q - size, q) > 0) { swap; q -= size; }
	LD	DE,(QS_LO)
	OR	A
	SBC	HL,DE
	JR	Z,qs_iouter		; q == lo
	ADD	HL,DE
	PUSH	HL			; keep q
	PUSH	HL			; b = q
	LD	DE,(QS_SIZE)
	OR	A
	SBC	HL,DE
	PUSH	HL			; a = q - size
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	JR	NZ,qs_ino		; < 0: in place
	LD	A,H
	OR	L
	JR	Z,qs_ino		; == 0: in place
	POP	DE			; DE = q
	LD	HL,(QS_SIZE)
	EX	DE,HL			; HL = q, DE = size
	OR	A
	SBC	HL,DE			; HL = q - size
	PUSH	HL			; new q
	ADD	HL,DE
	EX	DE,HL			; DE = q
	POP	HL			; HL = q - size
	PUSH	HL
	CALL	QS_SWJ
	POP	HL			; HL = new q
	JR	qs_iinner
qs_ino:
	POP	DE
	JP	qs_iouter

qs_exit:
	; Restore the static working area and return.
	PUSH	IX
	POP	HL
	LD	DE,-(QS_NV+2)
	ADD	HL,DE
	LD	SP,HL			; SP = save area
	LD	DE,QS_VARS
	LD	BC,QS_NV
	LDIR
	LD	HL,QS_NV
	ADD	HL,SP
	LD	SP,HL
	POP	BC
	POP	IX
	RET

; If compar(HL, DE) < 0, swap the elements at HL and DE.
; Returns NZ if it swapped, Z if not.  Clobbers A, BC, DE, HL.
qs_ord:
	PUSH	HL
	PUSH	DE
	PUSH	DE			; b
	PUSH	HL			; a
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	BIT	7,H
	POP	DE
	POP	HL
	RET	Z
	CALL	QS_SWJ
	OR	1			; NZ: swapped
	RET

; HL = compar(HL, HL + size)
qs_cnext:
	EX	DE,HL
	LD	HL,(QS_SIZE)
	ADD	HL,DE
	PUSH	HL			; b = p + size
	PUSH	DE			; a = p
	CALL	QS_TRAMP
	POP	DE
	POP	DE
	RET

; l += size; r -= size.  Returns DE = l, HL = r.
qs_step:
	LD	DE,(QS_SIZE)
	LD	HL,(QS_L)
	ADD	HL,DE
	LD	(QS_L),HL
	LD	HL,(QS_R)
	OR	A
	SBC	HL,DE
	LD	(QS_R),HL
	LD	DE,(QS_L)
	RET

; HL = HL * QS_SIZE  (clobbers A, BC, DE)
qs_mul:
	EX	DE,HL
	LD	BC,(QS_SIZE)
	LD	HL,0
qs_mul1:
	SRL	B
	RR	C
	JR	NC,qs_mul2
	ADD	HL,DE
qs_mul2:
	LD	A,B
	OR	C
	RET	Z
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL
	JR	qs_mul1

; Swap the elements at HL and DE (reached through QS_SWJ).
; Clobbers A, BC, DE, HL.
qs_sw2:
	; size 2
	LD	C,(HL)
	LD	A,(DE)
	LD	(HL),A
	LD	A,C
	LD	(DE),A
	INC	HL
	INC	DE
	LD	C,(HL)
	LD	A,(DE)
	LD	(HL),A
	LD	A,C
	LD	(DE),A
	RET
qs_swg:
	; any size
	LD	BC,(QS_SIZE)
qs_swg1:
	LD	A,(DE)
	LDI				; (DE) <- (HL), DE++, HL++, BC--
	DEC	HL
	LD	(HL),A
	INC	HL
	JP	PE,qs_swg1		; P/V set while BC != 0
	RET

	COMMON	/lc_qsort/
; qsort working storage.  qsort saves these QS_NV bytes on its stack on
; entry and restores them on exit (see "Reentrancy" above).
QS_VARS:
QS_TRAMP:	DS	3	; JP compar
QS_SWJ:		DS	3	; JP qs_sw2 or qs_swg
QS_SIZE:	DS	2	; element size
QS_MASK:	DS	2	; lowest set bit of the element size
QS_THB:		DS	2	; QS_THR * size (bytes), 0FFFFH on overflow
QS_LO:		DS	2	; current part: first element
QS_HI:		DS	2	; current part: last element
QS_MID:		DS	2	; pivot element
QS_L:		DS	2	; left scan pointer (insertion sort: p)
QS_R:		DS	2	; right scan pointer
QS_LD:		DS	2	; left part length - size, in bytes
QS_RD:		DS	2	; right part length - size, in bytes
QS_SP0:		DS	2	; SP with an empty partition stack
QS_BASE:	DS	2	; first element of the array
QS_LAST:	DS	2	; last element of the array
QS_END:
QS_NV	EQU	QS_END-QS_VARS


	CSEG
; ============================================================
; lc_quick_exit.mac
; ============================================================
; lc_quick_exit.mac - quick_exit and at_quick_exit (C11)
;
; quick_exit calls the functions that at_quick_exit registered, last
; registered first, and then does what _Exit does.  It does not run the
; atexit functions and does not close the files.

MAX_QEXIT	EQU	32	; the minimum that C 7.24.4.3 requires

	CSEG

; int at_quick_exit(void (*func)(void))
; Returns 0, or 1 when 32 functions are registered.
	PUBLIC	_at_quick_exit
_at_quick_exit:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	A,(_qexit_cnt)
	CP	MAX_QEXIT
	JR	NC,_atq_fail
	LD	L,A
	LD	H,0
	ADD	HL,HL
	LD	DE,_qexit_tab
	ADD	HL,DE
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	LD	HL,_qexit_cnt
	INC	(HL)
	LD	HL,0
	POP	IX
	RET
_atq_fail:
	LD	HL,1
	POP	IX
	RET

; void quick_exit(int status)
; A function that calls at_quick_exit adds a function that runs next.
	PUBLIC	_quick_exit
_quick_exit:
	LD	A,(_qexit_cnt)
	OR	A
	JP	Z,0		; no more functions: warm boot
	DEC	A
	LD	(_qexit_cnt),A
	LD	L,A
	LD	H,0
	ADD	HL,HL
	LD	DE,_qexit_tab
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = function
	LD	HL,_quick_exit	; the function returns to the start of the loop
	PUSH	HL
	PUSH	DE
	RET			; "call" the function

	COMMON	/lc_quick_exit/

_qexit_cnt:	DS	1
_qexit_tab:	DS	64


	CSEG
; ============================================================
; lc_rand.mac
; ============================================================
; lc_rand.mac - split from lc_stdlib.mac



	CSEG

; ============================================================
; int rand(void)
; Returns pseudo-random number 0 to RAND_MAX (32767)
; Uses 16-bit linear congruential generator
; seed = (seed * 25173 + 13849) & 0x7FFF
; ============================================================
	PUBLIC	_rand
_rand:
	PUSH	BC
	LD	BC,(_rand_seed)
	LD	HL,0
	LD	DE,25173
rand_lp:			; HL = seed * 25173 by shift and add; no
	SRL	D		; runtime module (__mul16 pulled ~600 bytes)
	RR	E
	JR	NC,rand_sk
	ADD	HL,BC
rand_sk:
	SLA	C
	RL	B
	LD	A,D
	OR	E
	JR	NZ,rand_lp
	POP	BC
	LD	DE,13849
	ADD	HL,DE		; HL = seed * 25173 + 13849
	LD	A,H
	AND	7FH		; Mask to 0-32767
	LD	H,A
	LD	(_rand_seed),HL
	RET


	CSEG
; ============================================================
; lc_rand_data.mac
; ============================================================
; lc_rand_data.mac - split from lc_stdlib.mac


	PUBLIC	_rand_seed


	DSEG


; rand seed
_rand_seed:	DW	1	; Default seed = 1


	CSEG
; ============================================================
; lc_realloc.mac
; ============================================================
; lc_realloc.mac - split from lc_malloc.mac



	CSEG

; ============================================================
; void *realloc(void *ptr, size_t size)
; NULL ptr: malloc.  Size 0: free, return NULL.  A block that is
; already big enough is returned as is; otherwise allocate, copy the old
; contents and free the old block (the old block stays valid when the
; allocation fails).
; ============================================================
	PUBLIC	_realloc
_realloc:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = ptr
	LD	E,(IX+6)
	LD	D,(IX+7)	; DE = size
	LD	A,H
	OR	L
	JR	NZ,_rea_have
	CALL	__malloc_de
	POP	IX
	RET
_rea_have:
	LD	A,D
	OR	E
	JR	NZ,_rea_do
	CALL	__free_hl
	LD	HL,0
	POP	IX
	RET
_rea_do:
	DEC	HL
	DEC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)		; BC = size of the old block
	INC	HL		; HL = payload
	PUSH	HL		; old payload
	PUSH	BC		; old size
	LD	H,B
	LD	L,C
	OR	A
	SBC	HL,DE		; old size - requested size
	JR	NC,_rea_same
