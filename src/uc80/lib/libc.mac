; ============================================================
; lc_vm.mac
; ============================================================
; lc_vm.mac - GENERATED from vmsrc/lc_vm.mac.in by gen_vm_modules.py
; Do not edit this file: edit the two source files and run the script.
;
; The float interpreter of the math library.  A math function (sin, exp,
; pow, ...) is a short program for a stack machine with 32-bit float
; elements.  An operation is one byte, so a float operation costs one or two
; bytes of program instead of the 25 to 40 bytes that the compiler writes
; for it.  The interpreter is shared by all functions.  The programs are in
; vmsrc/*.vc (a small subset of C); gen_vm_modules.py compiles them.
; docs/libm_vm.md describes the machine.
;
; Registers: BC = the program counter, IX = the address of the top element
; of the stack.  The routines of the runtime keep BC and IX.  An element has
; 4 bytes: the float, low byte first.
;
; A program starts with two bytes: the number of float arguments and the
; number of constants.  The constants (4 bytes each) and the code follow.
; A C function calls a program through __vm_run: the stub of the function
; loads the address of the program in HL and jumps to __vm_run.  A program
; calls another program with the operation CALL.
;
; Operations (see the table at the end):
;   RET k         return the top element, remove k elements below it
;   RET2 k        return the top 2 elements, remove k elements below them
;   ADD SUB MUL DIV NEG ABS DROP
;   POLY f,n      x -> c[f] + c[f+1]*x + ... + c[f+n-1]*x^(n-1)
;   TBL f         i -> c[f + int(i)]
;   TRUNC         x -> float(int(x))
;   CLS           x -> 0 for a zero, 1 other finite, 2 infinity, 3 NaN
;   SGN           x -> 1 if the sign bit is set, else 0
;   EXPO          x -> the biased exponent of x
;   CALL p        call the program at p (its arguments are on the stack)
;   CALLU r       x -> r(x)       routine r: DEHL = x, result in DEHL
;   CALLB r       a b -> r(a, b)  routine r: DEHL = a, (__tmp32) = b
;   CALLU2 r      x -> r1 r2      routine r: result in DEHL and (__tmp32)
;   CALLN p,n     a1 ... an -> f(a1, ..., an) for a C function p
;   PICK n        push a copy of the element n below the top
;   PUT n         pop, store into the element n below the new top
;   LDC n         push constant n; n from 24 to 31: a constant of the interpreter
;   Jcc d         pop b, a; jump by d (a signed byte) when a cc b
;   JMP d, JMPL d

	CSEG

	EXTRN	__fadd
	EXTRN	__fsub
	EXTRN	__fmul
	EXTRN	__fcmp
	EXTRN	__ftoi
	EXTRN	__itof
	EXTRN	__tmp32

	PUBLIC	__vm_run

; ------------------------------------------------------------
; __vm_run: HL = the program.  The C arguments are on the stack.
; ------------------------------------------------------------
__vm_run:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	CALL	_vm_enter	; A = the number of arguments, BC = the code
	ADD	A,A
	ADD	A,A
	PUSH	BC
	LD	C,A
	LD	B,0
	PUSH	IX
	POP	HL
	LD	DE,4
	ADD	HL,DE		; HL = the first argument
	LD	DE,_vm_stk
	LDIR
	LD	HL,-4
	ADD	HL,DE
	PUSH	HL
	POP	IX		; IX = the last argument
	POP	BC
	CALL	_vm_next
	CALL	_vm_top
	POP	IX
	RET

; HL = a program.  Sets the constants, A = the number of arguments,
; BC = the code.
_vm_enter:
	LD	A,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	(_vm_pool),HL
	LD	B,0
	SLA	C
	RL	B
	SLA	C
	RL	B
	ADD	HL,BC
	LD	B,H
	LD	C,L
	RET

; DEHL = the top element
_vm_top:
	LD	L,(IX+0)
	LD	H,(IX+1)
	LD	E,(IX+2)
	LD	D,(IX+3)
	RET

; replace the top element with DEHL
_vm_store:
	LD	(IX+0),L
	LD	(IX+1),H
	LD	(IX+2),E
	LD	(IX+3),D
	JR	_vm_next

; ------------------------------------------------------------
; The loop: run the program at BC until a RET
; ------------------------------------------------------------
_vm_next:
	LD	A,(BC)
	INC	BC
	CP	20H
	JR	C,_vm_tab
	LD	D,A
	CP	80H
	JR	NC,_vm_hi
	CP	40H
	JR	C,_vm_pick
	CP	60H
	JR	C,_vm_put

; LDC n: push constant n
_vm_ldc:
	LD	A,D
	AND	1FH
_vm_ldcn:
	LD	L,A
	LD	H,0
	ADD	HL,HL
	ADD	HL,HL
	LD	DE,(_vm_pool)
	CP	24
	JR	C,_vm_ld1
	LD	DE,_vm_gk-96	; LDC 24 and up: a constant of the interpreter
_vm_ld1:
	ADD	HL,DE
	JR	_vm_push

_vm_ldcx:
	LD	A,(BC)
	INC	BC
	LD	L,A
	LD	H,0
	ADD	HL,HL
	ADD	HL,HL
	LD	DE,(_vm_pool)
	JR	_vm_ld1

_vm_hi:
	AND	1FH
	ADD	A,22
_vm_tab:
	ADD	A,A
	LD	L,A
	LD	H,0
	LD	DE,_vm_tbl
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	EX	DE,HL
	JP	(HL)

; PICK n: push a copy of the element n below the top
_vm_pick:
	LD	A,D
	AND	1FH
_vm_pickn:
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	PUSH	IX
	POP	HL
	OR	A
	SBC	HL,DE
; push the 4 bytes at HL
_vm_push:
	LD	DE,4
	ADD	IX,DE
	PUSH	IX
	POP	DE
	CALL	_vm_cp4
	JR	_vm_next

_vm_pickx:
	LD	A,(BC)
	INC	BC
	JR	_vm_pickn

_vm_cp4:
	PUSH	BC
	LD	BC,4
	LDIR
	POP	BC
	RET

; PUT n: pop, store the value into the element n below the new top
_vm_put:
	LD	A,D
	AND	1FH
_vm_putn:
	INC	A
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	PUSH	IX
	POP	HL
	PUSH	HL
	OR	A
	SBC	HL,DE
	EX	DE,HL
	POP	HL
	CALL	_vm_cp4
_vm_drop:
	LD	DE,-4
	ADD	IX,DE
	JR	_vm_next

_vm_putx:
	LD	A,(BC)
	INC	BC
	JR	_vm_putn

; ------------------------------------------------------------
; Arithmetic.  The top element goes to (__tmp32), the next one to DEHL.
; ------------------------------------------------------------
_vm_getab:
	CALL	_vm_top
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,-4
	ADD	IX,DE
	JR	_vm_top

_vm_add:
	LD	HL,__fadd
	JR	_vm_bin
_vm_sub:
	LD	HL,__fsub
	JR	_vm_bin
_vm_mul:
	LD	HL,__fmul
	JR	_vm_bin
; HL = a routine for two floats
_vm_bin:
	LD	DE,_vm_store
	PUSH	DE
	PUSH	HL
	JR	_vm_getab	; the RET of getab calls the routine

_vm_neg:
	LD	A,(IX+3)
	XOR	80H
	LD	(IX+3),A
	JR	_vm_next
_vm_abs:
	RES	7,(IX+3)
	JR	_vm_next

; TRUNC: x -> float(int(x))
_vm_trunc:
	CALL	_vm_top
	CALL	__ftoi
	CALL	__itof
	JR	_vm_store

; the top element = the small integer A as a float
_vm_atof:
	LD	L,A
	LD	H,0
	LD	D,H
	LD	E,H
	CALL	__itof
	JR	_vm_store

; the biased exponent of the top element, in A
_vm_exp:
	LD	A,(IX+2)
	RLCA
	LD	A,(IX+3)
	RLA
	RET

_vm_expo:
	CALL	_vm_exp
	JR	_vm_atof

_vm_sgn:
	LD	A,(IX+3)
	RLCA
	AND	1
	JR	_vm_atof

; TBL f: i -> c[f + int(i)]
_vm_tbl_op:
	LD	A,(BC)
	INC	BC
	PUSH	AF
	CALL	_vm_top
	CALL	__ftoi
	POP	AF
	LD	E,A
	LD	D,0
	ADD	HL,DE
	ADD	HL,HL
	ADD	HL,HL
	LD	DE,(_vm_pool)
	ADD	HL,DE
	PUSH	IX
	POP	DE
	CALL	_vm_cp4
	JR	_vm_next

; the conditional jumps: A = the conditions that make the jump, as bits
; 1 (a < b), 2 (a = b), 4 (a > b)
_vm_jlt:
	LD	A,1
	JR	_vm_jcc
_vm_jle:
	LD	A,3
	JR	_vm_jcc
_vm_jgt:
	LD	A,4
	JR	_vm_jcc
_vm_jge:
	LD	A,6
	JR	_vm_jcc
_vm_jeq:
	LD	A,2
	JR	_vm_jcc
_vm_jne:
	LD	A,5
_vm_jcc:
	PUSH	AF
	CALL	_vm_getab
	CALL	__fcmp
	LD	A,2
	JR	NZ,_vm_j0
	JR	NC,_vm_j1		; equal
	LD	A,4			; Z and C: unordered counts as greater, so
	JR	_vm_j1			; fabs(x) > inf is true for a NaN
_vm_j0:
	LD	A,1
	JR	C,_vm_j1
	LD	A,4
_vm_j1:
	LD	DE,-4
	ADD	IX,DE
	POP	HL
	AND	H
	JR	NZ,_vm_jmp
	INC	BC
	JR	_vm_next
_vm_jmp:
	LD	A,(BC)
	INC	BC
	LD	L,A
	ADD	A,A
	SBC	A,A
	LD	H,A
	ADD	HL,BC
	LD	B,H
	LD	C,L
	JR	_vm_next
_vm_jmpl:
	LD	A,(BC)
	INC	BC
	LD	L,A
	LD	A,(BC)
	INC	BC
	LD	H,A
	ADD	HL,BC
	LD	B,H
	LD	C,L
	JR	_vm_next

; POLY f,n: x -> c[f] + c[f+1]*x + ... (Horner's rule)
_vm_poly:
	CALL	_vm_top
	LD	(_vm_x),HL
	LD	(_vm_x+2),DE
	LD	A,(BC)
	INC	BC
	LD	E,A		; E = the first constant
	LD	A,(BC)
	INC	BC
	LD	(_vm_cnt),A
	ADD	A,E
	DEC	A
	LD	L,A
	LD	H,0
	ADD	HL,HL
	ADD	HL,HL
	LD	DE,(_vm_pool)
	ADD	HL,DE
	PUSH	IX
	PUSH	HL
	POP	IX		; IX = the last constant
	CALL	_vm_top
_vm_pl:
	LD	A,(_vm_cnt)
	DEC	A
	LD	(_vm_cnt),A
	JR	Z,_vm_pd
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_vm_x)
	LD	DE,(_vm_x+2)
	CALL	__fmul
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	DE,-4
	ADD	IX,DE
	CALL	_vm_top
	CALL	__fadd
	JR	_vm_pl
_vm_pd:
	POP	IX
	JR	_vm_store

; CALL p
_vm_call:
	LD	A,(BC)
	INC	BC
	LD	L,A
	LD	A,(BC)
	INC	BC
	LD	H,A
_vm_callhl:
	LD	DE,(_vm_pool)
	PUSH	DE
	PUSH	BC
	CALL	_vm_enter
	CALL	_vm_next
	POP	BC
	POP	HL
	LD	(_vm_pool),HL
	JR	_vm_next

; RET k, RET2 k and RET3 k: return the top 1, 2 or 3 elements and remove
; the k elements below them
_vm_ret:
	LD	HL,4
	JR	_vm_retn
_vm_ret2:
	LD	HL,8
	JR	_vm_retn
_vm_ret3:
	LD	HL,12
_vm_retn:
	LD	A,(BC)
	OR	A
	RET	Z
	PUSH	HL		; the bytes to move
	PUSH	IX
	POP	HL
	LD	DE,4
	ADD	HL,DE
	POP	DE
	OR	A
	SBC	HL,DE		; HL = the first element to move
	PUSH	DE
	ADD	A,A
	ADD	A,A
	LD	E,A
	LD	D,0
	PUSH	HL
	OR	A
	SBC	HL,DE		; HL = where it goes
	EX	DE,HL
	POP	HL
	POP	BC
	PUSH	DE
	LDIR			; DE ends after the moved elements
	LD	HL,-4
	ADD	HL,DE
	PUSH	HL
	POP	IX
	POP	DE
	RET

; CALLU r, CALLB r, CALLU2 r: a routine of the library
_vm_callu:
	LD	DE,_vm_store
	JR	_vm_cu
_vm_callu2:
	LD	DE,_vm_store2
_vm_cu:
	LD	A,(BC)
	INC	BC
	LD	L,A
	LD	A,(BC)
	INC	BC
	LD	H,A
	PUSH	DE
	PUSH	HL
	JR	_vm_top		; the RET of _vm_top calls the routine
_vm_callb:
	LD	A,(BC)
	INC	BC
	LD	L,A
	LD	A,(BC)
	INC	BC
	LD	H,A
	JR	_vm_bin
_vm_store2:
	LD	(IX+0),L
	LD	(IX+1),H
	LD	(IX+2),E
	LD	(IX+3),D
	LD	HL,__tmp32
	JR	_vm_push

_vm_tbl:
	DW	_vm_ret, _vm_ret2, _vm_ret3, _vm_add
	DW	_vm_sub, _vm_mul, _vm_neg, _vm_abs
	DW	_vm_drop, _vm_poly, _vm_trunc, _vm_call
	DW	_vm_callu, _vm_callb, _vm_callu2, _vm_sgn
	DW	_vm_expo, _vm_tbl_op, _vm_pickx, _vm_putx
	DW	_vm_ldcx, _vm_jmpl
	DW	_vm_jlt, _vm_jle, _vm_jgt, _vm_jge
	DW	_vm_jeq, _vm_jne, _vm_jmp

; the constants that most programs use: 0, 1, 255, inf, NaN, 1/2, 114, 2
_vm_gk:
	DW	00000H,00000H	; 0.0
	DW	00000H,03F80H	; 1.0
	DW	00000H,0437FH	; 255.0
	DW	00000H,07F80H	; inf
	DW	00000H,07FC0H	; nan
	DW	00000H,03F00H	; 0.5
	DW	00000H,042E4H	; 114.0
	DW	00000H,04000H	; 2.0

	COMMON	/lc_vm/
_vm_pool:
	DS	2
_vm_x:
	DS	4
_vm_cnt:
	DS	1
_vm_stk:
	DS	256


	CSEG
; ============================================================
; lc_vm_frexp.mac
; ============================================================
; lc_vm_frexp.mac - __vm_frexp1, a routine of the float interpreter
;
; DEHL = x, a finite number that is not zero.  The routine returns
; DEHL = m, with 1 <= m < 2 (the sign of x is lost), and (__tmp32) = n as a
; float, where |x| = m * 2^n.  It keeps BC and IX.  A subnormal x gives the
; normalized m and an n below -126.

	CSEG

	EXTRN	__itof
	EXTRN	__tmp32

	PUBLIC	__vm_frexp1
__vm_frexp1:
	PUSH	BC
	LD	A,E
	RLA
	LD	A,D
	RLA			; A = the exponent field
	LD	C,A
	LD	B,0
	OR	A
	JR	NZ,_vfx_n
	INC	C		; the exponent field of the subnormal numbers is 1
	LD	A,E
	OR	H
	OR	L
	JR	Z,_vfx_n	; a zero (not allowed): do not loop
_vfx_s:
	BIT	7,E
	JR	NZ,_vfx_n
	ADD	HL,HL
	RL	E
	DEC	BC
	JR	_vfx_s
_vfx_n:
	LD	D,3FH
	SET	7,E
	PUSH	HL
	PUSH	DE
	LD	HL,-127
	ADD	HL,BC
	LD	A,H
	ADD	A,A
	SBC	A,A
	LD	E,A
	LD	D,A
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	POP	DE
	POP	HL
	POP	BC
	RET


	CSEG
; ============================================================
; lc_vm_ldexp.mac
; ============================================================
; lc_vm_ldexp.mac - __vm_ldexp, a routine of the float interpreter, and
; __sbn_core, the code of scalbn
;
; __sbn_core: DEHL = x, BC = n (-600 to 600).  Result in DEHL = x * 2^n.
; An infinity, a NaN and a zero are the result.  Else the routine takes the
; sign, the mantissa (24 bits, a subnormal x is shifted left until bit 23
; is set) and the exponent e + n.  An exponent from 1 to 254 is stored; a
; larger one gives infinity; a smaller one shifts the mantissa right, with
; rounding to nearest even, which gives a subnormal number or zero.
;
; __vm_ldexp: DEHL = x, (__tmp32) = n as a float.  It keeps BC and IX.

	CSEG

	EXTRN	__ftoi
	EXTRN	__tmp32

	PUBLIC	__vm_ldexp
	PUBLIC	__sbn_core

__vm_ldexp:
	PUSH	BC
	PUSH	HL
	PUSH	DE
	LD	HL,(__tmp32)
	LD	DE,(__tmp32+2)
	CALL	__ftoi
	LD	B,H
	LD	C,L
	POP	DE
	POP	HL
	CALL	__sbn_core
	POP	BC
	RET

; DEHL = x, BC = n.  Result in DEHL.  Changes AF and BC.
__sbn_core:
	LD	A,E
	RLA
	LD	A,D
	RLA			; A = the exponent field
	CP	255
	RET	Z		; an infinity or a NaN
	OR	A
	JR	Z,_sbn_sub
	PUSH	HL
	LD	L,A
	LD	H,0
	ADD	HL,BC		; HL = the new exponent
	LD	B,H
	LD	C,L
	POP	HL
	SET	7,E		; the implicit bit
_sbn_pk:
	LD	A,D
	AND	80H
	LD	D,A		; D = the sign
	LD	A,B
	OR	A
	JP	M,_sbn_neg	; the exponent is below zero
	JR	NZ,_sbn_inf	; 256 or more
	LD	A,C
	CP	255
	JR	NC,_sbn_inf
	OR	A
	JR	Z,_sbn_sh0
	; 1 to 254: the exponent field
	LD	B,A
	SRL	A
	OR	D
	LD	D,A
	RES	7,E
	BIT	0,B
	RET	Z
	SET	7,E
	RET
_sbn_inf:
	LD	A,D
	OR	7FH
	LD	D,A
	LD	E,80H
	LD	HL,0
	RET
_sbn_neg:
	LD	A,B
	INC	A
	JR	NZ,_sbn_zero	; -256 or below
	LD	A,C
	CP	233
	JR	C,_sbn_zero	; below -23
	NEG
	INC	A		; the shift count, 1 - exponent
	JR	_sbn_cnt
_sbn_sh0:
	LD	A,1
_sbn_cnt:
	LD	B,A
	LD	C,0		; C is not zero when a lost bit was set
_sbn_sl:
	SRL	E
	RR	H
	RR	L
	DEC	B
	JR	Z,_sbn_rnd	; the carry is the round bit
	JR	NC,_sbn_sl
	INC	C
	JR	_sbn_sl
_sbn_rnd:
	RET	NC
	LD	A,C
	OR	A
	JR	NZ,_sbn_up
	BIT	0,L
	RET	Z		; a tie goes to the even mantissa
_sbn_up:
	INC	HL
	LD	A,H
	OR	L
	RET	NZ
	INC	E
	RET
_sbn_zero:
	LD	E,0
	LD	HL,0
	RET

; a subnormal number or a zero
_sbn_sub:
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	RET	Z		; a zero
	PUSH	BC
	LD	BC,1
_sbn_nl:
	BIT	7,E
	JR	NZ,_sbn_nd
	ADD	HL,HL
	RL	E
	DEC	BC
	JR	_sbn_nl
_sbn_nd:
	EX	(SP),HL		; HL = n
	ADD	HL,BC
	LD	B,H
	LD	C,L
	POP	HL
	JR	_sbn_pk


	CSEG
