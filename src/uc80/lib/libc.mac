	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

; ccosh: cosh(z) = cosh(re)*cos(im) + i*sinh(re)*sin(im)
_ccosh:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	DE,_cplx_z
	LD	BC,8
	LDIR
	; cosh(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_cosh
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; cos(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_cos
	POP	BC
	POP	BC
	; Real = cosh(re) * cos(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res),HL
	LD	(_cplx_res+2),DE
	; sinh(re)
	LD	HL,(_cplx_z)
	LD	DE,(_cplx_z+2)
	PUSH	DE
	PUSH	HL
	CALL	_sinh
	POP	BC
	POP	BC
	LD	(_cplx_w),HL
	LD	(_cplx_w+2),DE
	; sin(im)
	LD	HL,(_cplx_z+4)
	LD	DE,(_cplx_z+6)
	PUSH	DE
	PUSH	HL
	CALL	_sin
	POP	BC
	POP	BC
	; Imag = sinh(re) * sin(im)
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	LD	HL,(_cplx_w)
	LD	DE,(_cplx_w+2)
	CALL	__fmul
	LD	(_cplx_res+4),HL
	LD	(_cplx_res+6),DE
	LD	HL,_cplx_res
	POP	IX
	RET

