	CSEG
; ============================================================
; lc_strcat.mac
; ============================================================
; lc_strcat.mac - split from lc_string.mac


	CSEG

; ============================================================
; char *strcat(char *dest, const char *src)
; Append src to dest
; Returns: dest
; ============================================================
	PUBLIC	_strcat
_strcat:
	POP	BC		; return address
	POP	DE		; DE = dest
	POP	HL		; HL = src
	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	DE		; return value
	EX	DE,HL		; HL = dest, DE = src
	XOR	A
	LD	B,A
	LD	C,A
	CPIR			; HL = one past the terminator of dest
	DEC	HL
	EX	DE,HL		; DE = end of dest, HL = src
_strcat_loop:
	CP	(HL)		; A = 0
	LDI
	JR	NZ,_strcat_loop
	POP	HL
	RET


	CSEG
; ============================================================
; lc_strchr.mac
; ============================================================
; lc_strchr.mac - split from lc_string.mac


	CSEG

; ============================================================
; char *strchr(const char *s, int c)
; Find first occurrence of c in s
; Returns: pointer to char, or NULL if not found
; ============================================================
	PUBLIC	_strchr
_strchr:
	POP	BC		; return address
	POP	HL		; HL = s
	POP	DE		; E = char to find
	PUSH	DE
	PUSH	HL
	PUSH	BC
_strchr_loop:
	LD	A,(HL)
	CP	E
	RET	Z		; HL points to the char
	INC	HL
	OR	A
	JR	NZ,_strchr_loop
	LD	H,A		; end of string: NULL
	LD	L,A
	RET

; ============================================================
; void *memcpy(void *dest, const void *src, size_t n)
; Copy n bytes from src to dest


	CSEG
; ============================================================
; lc_strcmp.mac
; ============================================================
; lc_strcmp.mac - split from lc_string.mac


	CSEG

; ============================================================
; int strcmp(const char *s1, const char *s2)
; Compare two strings
; Returns: <0 if s1<s2, 0 if s1==s2, >0 if s1>s2
; ============================================================
	PUBLIC	_strcmp
_strcmp:
	POP	BC		; return address
	POP	DE		; DE = s1
	POP	HL		; HL = s2
	PUSH	HL
	PUSH	DE
	PUSH	BC
_strcmp_loop:
	LD	A,(DE)
	CP	(HL)
	JR	NZ,_strcmp_diff
	INC	DE
	INC	HL
	OR	A
	JR	NZ,_strcmp_loop
	LD	H,A		; equal: 0
	LD	L,A
	RET
_strcmp_diff:
	; Return s1[i] - s2[i] as unsigned chars (-255..255)
	SUB	(HL)
	LD	L,A
	SBC	A,A		; borrow: s1[i] < s2[i]
	LD	H,A
	RET


