; ============================================================
; void *memchr(const void *s, int c, size_t n)
; Find first occurrence of c in first n bytes of s
; Returns: pointer to byte, or NULL if not found
; ============================================================
	PUBLIC	_memchr
_memchr:
	POP	AF		; return address
	POP	HL		; HL = s
	POP	DE		; E = char to find
	POP	BC		; BC = n
	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	A,B
	OR	C
	JR	Z,_memchr_notfound
	LD	A,E
	CPIR			; stops after the match, or with BC = 0
	JR	NZ,_memchr_notfound
	DEC	HL
	RET
_memchr_notfound:
	LD	HL,0
	RET

