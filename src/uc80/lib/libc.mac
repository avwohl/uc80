; ============================================================
; lc_fseek.mac
; ============================================================
; lc_fseek.mac - fseek
;
; The position is a byte count.  A file is read and written in records of 128
; bytes with the random access BDOS calls (33 and 34), so a seek is: write
; the pending record, put the record number in r0 r1 of the FCB, and read
; that record when the position is not at the start of a record.  See
; lc_ftell.mac and docs/libraries.md ("Files").

BDOS_WRITER	EQU	34	; Write random
FILE_FLAGS	EQU	1
FILE_UNGET	EQU	2	; pushed back character, or 0FFH


	CSEG

; ============================================================
; int fseek(FILE *stream, long offset, int whence)
; Returns 0, or -1 when the stream is not a file, whence is wrong, or
; the position is below 0 or above 8 MB.  SEEK_END is the end of the data
; of a text file: before the first Ctrl-Z of the last record.
; ============================================================
	PUBLIC	_fseek
_fseek:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	L,(IX+4)
	LD	H,(IX+5)	; stream
	LD	A,H
	OR	L
	JP	Z,_fseek_err

	; Check if file
	LD	A,(HL)
	CP	3
	JP	C,_fseek_err
	LD	(_fsk_fp),HL

	; whence: 0, 1 or 2
	LD	A,(IX+11)
	OR	A
	JP	NZ,_fseek_err
	LD	A,(IX+10)
	CP	3
	JP	NC,_fseek_err

	; Write the pending record of a stream that writes
	INC	HL
	LD	A,(HL)
	DEC	HL
	AND	FLAG_WRITE
	JR	Z,_fsk_nf
	CALL	_fflush_internal
_fsk_nf:
	LD	HL,(_fsk_fp)
	LD	A,(IX+10)
	OR	A
	JR	Z,_fsk_set
	CP	1
	JR	Z,_fsk_cur
	CALL	_fsize		; SEEK_END: DEHL = the size
	JR	_fsk_add
_fsk_cur:
	CALL	_ftell_pos	; SEEK_CUR: DEHL = the position
_fsk_add:
	LD	C,(IX+6)
	LD	B,(IX+7)
	ADD	HL,BC
	EX	DE,HL
	LD	C,(IX+8)
	LD	B,(IX+9)
	ADC	HL,BC
	EX	DE,HL
	JR	_fsk_have
_fsk_set:
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	E,(IX+8)
	LD	D,(IX+9)
_fsk_have:
	; DEHL = the new position, from 0 to 2^23-1
	LD	A,D
	OR	A
	JP	NZ,_fseek_err
	BIT	7,E
	JP	NZ,_fseek_err

	LD	A,L
	AND	7FH
	LD	(_fsk_off),A	; the byte in the record
	LD	A,L
	ADD	A,A		; the carry is bit 7 of L
	LD	A,H
	ADC	A,A
	LD	C,A
	LD	A,E
	ADC	A,A
	LD	B,A		; BC = the record number = position / 128

	; A stream that can write: when the position is after the end of the
	; data, the Ctrl-Z fill of the last record becomes zeros
	LD	HL,(_fsk_fp)
	INC	HL
	BIT	5,(HL)
	CALL	NZ,_fsk_gap

	; A stream that appends goes to the end of the file at its next
	; write, so after the seek it is in the reading state.  (The
	; position above was computed in the state it had.)
	LD	HL,(_fsk_fp)
	INC	HL
	BIT	6,(HL)
	JR	Z,_fsk_na
	RES	3,(HL)
_fsk_na:
	LD	HL,(_fsk_fp)
	LD	DE,5
	ADD	HL,DE
	LD	(HL),1		; moved: fputc keeps the bytes of the next records

	; An empty buffer, no pushed back character, no end of file
	LD	HL,(_fsk_fp)
	PUSH	HL
	LD	DE,FILE_UNGET
	ADD	HL,DE
	LD	(HL),0FFH
	INC	HL
	XOR	A
	LD	(HL),A		; bufpos
	INC	HL
	LD	(HL),A		; bufcnt
	POP	HL
	PUSH	HL
	INC	HL
	LD	A,(HL)
	AND	0FFH-FLAG_EOF
	LD	(HL),A
	POP	HL
	LD	DE,FILE_RECNO
	ADD	HL,DE
	LD	(HL),C
	INC	HL
	LD	(HL),B
	INC	HL
	LD	(HL),0		; r2

	LD	HL,(_fsk_fp)
	INC	HL
	LD	A,(HL)
	AND	FLAG_WRITE
	JR	NZ,_fsk_ld	; a stream that writes keeps the bytes of the record
	LD	A,(_fsk_off)
	OR	A
	JR	Z,_fsk_noload
_fsk_ld:
	CALL	_fsk_load	; inside a record: read it
_fsk_noload:
	LD	HL,0
	JR	_fseek_ret

_fseek_err:
	LD	HL,-1
_fseek_ret:
	POP	DE
	POP	BC
	POP	IX
	RET

; The position (record BC, byte _fsk_off) is after the end of the data of
; the file when the last record has Ctrl-Z fill before it.  Then the fill
; up to the position (or to the end of the record, when the position is in
; a later record) becomes zeros, as a C program expects of a gap, and the
; record is written back.  BC is not changed.
_fsk_gap:
	PUSH	BC
	LD	(_fsk_rec),BC
	LD	HL,(_fsk_fp)
	LD	DE,FILE_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_SIZE
	CALL	BDOS		; r0 r1 = the number of records
	LD	HL,(_fsk_fp)
	LD	DE,FILE_RECNO
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = records
	LD	A,D
	OR	E
	JR	Z,_fgap_end	; an empty file
	DEC	DE		; the last record
	LD	(HL),D
	DEC	HL
	LD	(HL),E
	LD	(_fsk_last),DE
	CALL	_fsk_read
	JR	NZ,_fgap_end
	LD	HL,(_fsk_fp)
	LD	DE,FILE_BUFFER+127
	ADD	HL,DE
	LD	B,128
_fgap_s:
	LD	A,(HL)
	CP	1AH
	JR	NZ,_fgap_f
	DEC	HL
	DJNZ	_fgap_s
_fgap_f:
	LD	A,B		; the bytes before the Ctrl-Z fill
	CP	128
	JR	Z,_fgap_end	; no fill
	LD	(_fsk_t),A
	LD	HL,(_fsk_last)
	LD	DE,(_fsk_rec)
	OR	A
	SBC	HL,DE
	JR	Z,_fgap_same
	JR	NC,_fgap_end	; the position is in the data records
	LD	C,128		; zeros up to the end of the record
	JR	_fgap_fill
_fgap_same:
	LD	A,(_fsk_off)
	LD	C,A		; zeros up to the position
	LD	A,(_fsk_t)
	CP	C
	JR	NC,_fgap_end	; the position is in the data
_fgap_fill:
	LD	HL,(_fsk_fp)
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	LD	A,(_fsk_t)
	LD	E,A
	LD	D,0
	ADD	HL,DE		; the first byte of the fill
	LD	A,C
	SUB	E
	LD	C,A		; the number of zeros
_fgap_z:
	LD	(HL),0
	INC	HL
	DEC	C
	JR	NZ,_fgap_z
	LD	HL,(_fsk_fp)
	LD	DE,FILE_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_WRITER
	CALL	BDOS
_fgap_end:
	POP	BC
	RET

; Read the record r0 r1 into the buffer and put the position in it.  A
; stream that reads goes on with the record after it.  When the file has no
; such record, a stream that reads is at the end of the file, and a stream
; that writes has zeros before the position.
_fsk_load:
	CALL	_fsk_read
	LD	HL,(_fsk_fp)
	LD	C,128		; bufcnt: the whole record is valid
	JR	Z,_fsl_ok
	INC	HL
	LD	A,(HL)
	DEC	HL
	AND	FLAG_WRITE
	RET	Z		; a stream that reads is at the end of the file
	PUSH	HL
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	LD	D,H
	LD	E,L
	INC	DE
	LD	(HL),0
	LD	BC,127
	LDIR
	POP	HL
	LD	A,(_fsk_off)
	LD	C,A		; bufcnt: only the zeros before the position
_fsl_ok:
	PUSH	HL
	LD	DE,FILE_BUFPOS
	ADD	HL,DE
	LD	A,(_fsk_off)
	LD	(HL),A
	INC	HL
	LD	(HL),C
	POP	HL
	INC	HL
	LD	A,(HL)
	DEC	HL
	AND	FLAG_WRITE
	RET	NZ		; a stream that writes stays at this record
	LD	DE,FILE_RECNO
	ADD	HL,DE
	INC	(HL)
	RET	NZ
	INC	HL
	INC	(HL)
	RET

; Read the record r0 r1 of the file _fsk_fp into its buffer.  Z when it was
; read.
_fsk_read:
	LD	HL,(_fsk_fp)
	LD	DE,FILE_BUFFER
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_SETDMA
	CALL	BDOS
	LD	HL,(_fsk_fp)
	LD	DE,FILE_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_READR
	CALL	BDOS
	OR	A
	RET

; The size of the file _fsk_fp in bytes (DEHL): the records before the
; last one, and the bytes of the last record before its first Ctrl-Z.
; r0 r1 are not changed.
_fsize:
	LD	HL,(_fsk_fp)
	LD	DE,FILE_RECNO
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(_fsk_old),DE	; r0 r1 now
	LD	HL,(_fsk_fp)
	LD	DE,FILE_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_SIZE
	CALL	BDOS		; r0 r1 = the number of records
	LD	HL,(_fsk_fp)
	LD	DE,FILE_RECNO
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = records
	LD	A,D
	OR	E
	LD	B,0
	JR	Z,_fsz_end	; an empty file
	DEC	DE
	DEC	HL
	LD	(HL),E		; read the last record
	INC	HL
	LD	(HL),D
	PUSH	DE
	CALL	_fsk_read
	POP	DE
	LD	B,0
	JR	NZ,_fsz_end
	LD	HL,(_fsk_fp)
	LD	BC,FILE_BUFFER
	ADD	HL,BC
	LD	B,0
_fsz_z:
	LD	A,B
	CP	128
	JR	NC,_fsz_end
	LD	A,(HL)
	CP	1AH
	JR	Z,_fsz_end
	INC	HL
	INC	B
	JR	_fsz_z
_fsz_end:
	PUSH	BC
	PUSH	DE
	LD	HL,(_fsk_fp)
	LD	DE,FILE_RECNO
	ADD	HL,DE
	LD	DE,(_fsk_old)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	POP	DE
	POP	BC
	JP	_fpos_calc

	COMMON	/lc_fseek/

_fsk_fp:	DS	2	; the FILE
_fsk_off:	DS	1	; the byte in the record
_fsk_old:	DS	2	; r0 r1 saved around BDOS 35
_fsk_rec:	DS	2	; the new record number
_fsk_last:	DS	2	; the last record of the file
_fsk_t:		DS	1	; the data bytes of the last record


	CSEG
; ============================================================
; lc_fsetpos.mac
; ============================================================
; lc_fsetpos.mac - split from lc_file.mac



	CSEG

; ============================================================
; int fsetpos(FILE *stream, const fpos_t *pos)
; Set file position
; Returns 0 on success, non-zero on error
; ============================================================
	PUBLIC	_fsetpos
_fsetpos:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Load position from *pos
	LD	L,(IX+6)
	LD	H,(IX+7)	; HL = pos pointer
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)		; BCDE = position
	PUSH	BC		; High word
	PUSH	DE		; Low word

	; Call fseek(stream, pos, SEEK_SET)
	LD	HL,0
	PUSH	HL		; whence = SEEK_SET
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL		; stream
	; Stack: stream, whence(0), pos_low, pos_high
	; fseek expects: stream, offset_low, offset_high, whence
	; Need to rearrange...

	; Actually let's redo this properly
	POP	HL		; stream
	POP	BC		; whence
	POP	DE		; pos low
	POP	BC		; pos high
	; Now push in correct order for fseek(stream, offset, whence)
	LD	A,0
	PUSH	AF		; whence = SEEK_SET (use AF as 16-bit 0)
	INC	SP		; Adjust for 1-byte push
	DEC	SP
	LD	HL,0
	PUSH	HL		; whence = 0
	PUSH	BC		; offset high
	PUSH	DE		; offset low
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL		; stream
	CALL	_fseek
	; Clean up stack (5 words = 10 bytes)
	LD	HL,10
	ADD	HL,SP
	LD	SP,HL

	; fseek returns 0 on success, -1 on error
	; HL already has return value

	POP	DE
	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_fslots.mac
; ============================================================
; lc_fslots.mac - the table of FILE structures that fopen hands out
;
; MAX_FILES files can be open at the same time.  Each one costs
; FILE_SIZE (170) bytes of RAM in the BSS segment: 6 bytes of state, the
; 36-byte FCB and the 128-byte buffer.  The image on disk does not hold the
; table.  A build can set another number: UC80_MAX_FILES=n uc80 --build-libs
; (see docs/exit_and_files.md).  Only this file has the number; fopen reads
; the byte _file_nmax.

MAX_FILES	EQU	8

	PUBLIC	_file_slots
	PUBLIC	_file_nmax

	DSEG

_file_nmax:	DB	MAX_FILES

	COMMON	/lc_fslots/

_file_slots:	DS	MAX_FILES*FILE_SIZE


	CSEG
; ============================================================
; lc_ftell.mac
; ============================================================
; lc_ftell.mac - ftell, and the position code that fseek shares
;
; A file is read and written in records of 128 bytes with the random access
; BDOS calls.  r0 and r1 of the FCB hold the number of the next record to
; read, or the number of the record that is in the buffer for a stream that
; is open for writing.  See docs/libraries.md ("Files").


	CSEG

; ============================================================
; long ftell(FILE *stream)
; Return the position: the number of bytes before the next byte that
; fgetc reads or fputc writes.  Returns -1L for a stream that is not a
; file.  Carriage returns count, because fgetc skips them but the
; file holds them.
; ============================================================
	PUBLIC	_ftell
_ftell:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP

	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	A,H
	OR	L
	JR	Z,_ftell_err

	LD	A,(HL)
	CP	3
	JR	C,_ftell_err

	CALL	_ftell_pos
	POP	IX
	RET

_ftell_err:
	LD	HL,-1
	LD	D,H
	LD	E,L
	POP	IX
	RET

; ============================================================
; Internal: the position of a file.  HL = FILE*, returns DEHL.
;
; A stream that reads has the record before the next one in the buffer
; when the buffer is not empty (bufcnt is not 0).  A stream that writes has
; the record that it will write in the buffer.
; ============================================================
	PUBLIC	_ftell_pos
_ftell_pos:
	PUSH	HL
	LD	DE,FILE_RECNO
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)		; DE = r0 r1
	POP	HL
	PUSH	HL
	INC	HL
	LD	C,(HL)		; C = flags
	INC	HL		; unget
	INC	HL		; bufpos
	LD	B,(HL)		; B = bufpos
	INC	HL
	LD	A,(HL)		; A = bufcnt
	BIT	3,C		; FLAG_WRITE
	JR	NZ,_ftp_calc
	OR	A
	JR	NZ,_ftp_rd
	LD	B,0		; empty buffer: the start of record DE
	JR	_ftp_calc
_ftp_rd:
	DEC	DE		; the buffer holds the record before DE
_ftp_calc:
	CALL	_fpos_calc
	POP	BC		; BC = FILE*
	PUSH	HL
	LD	H,B
	LD	L,C
	INC	HL
	INC	HL
	LD	A,(HL)		; unget
	POP	HL
	CP	0FFH
	RET	Z
	LD	A,H		; a pushed back character: one byte less
	OR	L
	DEC	HL
	RET	NZ
	DEC	DE
	RET

; ============================================================
; Internal: DE = record number, B = byte in the record (0 to 128).
; Returns DEHL = DE * 128 + B.  Keeps B.
; ============================================================
	PUBLIC	_fpos_calc
_fpos_calc:
	LD	H,D
	LD	L,E
	LD	DE,0
	LD	A,7
_fpc_sh:
	SLA	L
	RL	H
	RL	E
	RL	D
	DEC	A
	JR	NZ,_fpc_sh
	LD	A,L
	ADD	A,B
	LD	L,A
	RET	NC
	INC	H
	RET	NZ
	INC	E
	RET	NZ
	INC	D
	RET


	CSEG
; ============================================================
; lc_ftoread.mac
; ============================================================
; lc_ftoread.mac - change a file stream from writing to reading
;
; The two states of a file stream are described in lc_ftowrite.mac.


; offsets from the start of the FILE (the register IX holds it)


; ============================================================
; Internal: _file_toread.  HL = FILE*.  Returns Z when the stream is in
; the reading state, NZ (and the error flag) when it cannot read, or when
; the last record cannot be written.
; ============================================================
	PUBLIC	_file_toread
_file_toread:
	PUSH	IX
	PUSH	HL
	POP	IX
	BIT	4,(IX+F_FLAGS)	; can read?
	JR	Z,_ftr_err
	PUSH	IX
	POP	HL
	CALL	_fflush_internal	; writes the record when it changed
	LD	A,H
	OR	L
	JR	NZ,_ftr_ret
	LD	A,(IX+F_BUFPOS)	; A = valid bytes: the larger of bufpos, bufcnt
	CP	(IX+F_BUFCNT)
	JR	NC,_ftr_v
	LD	A,(IX+F_BUFCNT)
_ftr_v:
	OR	A
	JR	Z,_ftr_done	; empty buffer: r0 r1 is the next record
	LD	B,A
	LD	A,128
	SUB	B
	JR	Z,_ftr_full
	LD	C,A		; C = bytes after the valid ones
	LD	A,B
	PUSH	IX
	POP	HL
	LD	DE,F_BUFFER
	ADD	HL,DE
	LD	E,B
	LD	D,0
	ADD	HL,DE		; HL = buffer[valid]
	LD	B,C
	LD	A,1AH
_ftr_pad:
	LD	(HL),A		; Ctrl-Z after the valid bytes: end of file
	INC	HL
	DJNZ	_ftr_pad
_ftr_full:
	INC	(IX+F_R0)	; the buffer holds the record before r0 r1
	JR	NZ,_ftr_cnt
	INC	(IX+F_R1)
_ftr_cnt:
	LD	(IX+F_BUFCNT),128
_ftr_done:
	RES	3,(IX+F_FLAGS)
	XOR	A
	POP	IX
	RET
_ftr_err:
	SET	2,(IX+F_FLAGS)
_ftr_ret:
	OR	1		; NZ
	POP	IX
	RET


	CSEG
; ============================================================
; lc_ftowrite.mac
; ============================================================
; lc_ftowrite.mac - change a file stream from reading to writing
;
; A FILE is in one of two states, and flag bit 3 (FLAG_WRITE) tells which:
;
;   reading (bit 3 clear): r0 r1 of the FCB is the number of the NEXT record
;       to read.  When bufcnt is not 0 the buffer holds the record before
;       r0 r1, and bufpos is the position in it.
;   writing (bit 3 set): r0 r1 is the number of the record that is IN the
;       buffer, and bufpos is the position in it.  bufcnt is the number of
;       valid bytes (the high water mark).  Flag bit 7 is set when fputc
;       changed the buffer since the last write.
;
; A stream that only reads or only writes never changes state.  A stream
; opened with "+" does it here (reading to writing, called by fputc) and in
; lc_ftoread.mac (writing to reading, called by fgetc).  This is what C needs
; fflush, fseek or rewind for between a write and a read; the library does it
; by itself, so the program works without them too.  A stream opened with "a"
; starts in the reading state at the start of the file.  The first fputc puts
; it at the end of the file, here, and so does the first fputc after each
; fseek, rewind or read.  So each write goes to the end of the file.
;
; With the compiler hook of file_hook.py, a program that opens no file in
; an update mode or an append mode links lc_f_lite.mac instead of this
; module and lc_ftoread.mac.
;
; Flags: 01 open, 02 end of file, 04 error, 08 writing, 10 can read,
; 20 can write, 40 append, 80 buffer changed.


; offsets from the start of the FILE (the register IX holds it)



	CSEG

; ============================================================
; Internal: _file_towrite.  HL = FILE*.  Returns Z when the stream is in
; the writing state, NZ (and the error flag) when it cannot write.
; ============================================================
	PUBLIC	_file_towrite
_file_towrite:
	PUSH	IX
	PUSH	HL
	POP	IX
	BIT	5,(IX+F_FLAGS)	; can write?
	JR	Z,_ftw_err
	RES	1,(IX+F_FLAGS)	; no end of file
	LD	A,0FFH
	CP	(IX+F_UNGET)
	JR	Z,_ftw_nou
	LD	(IX+F_UNGET),A	; a pushed back character: back up one byte
	LD	A,(IX+F_BUFPOS)
	OR	A
	JR	Z,_ftw_nou
	DEC	(IX+F_BUFPOS)
_ftw_nou:
	BIT	6,(IX+F_FLAGS)	; append?
	JR	NZ,_ftw_end
	LD	A,(IX+F_BUFCNT)
	OR	A
	JR	Z,_ftw_load	; empty buffer: the record r0 r1 is next
	LD	L,(IX+F_R0)	; the buffer holds the record before r0 r1
	LD	H,(IX+F_R1)
	DEC	HL
	LD	(IX+F_R0),L
	LD	(IX+F_R1),H
	JR	_ftw_done
_ftw_load:
	PUSH	IX
	POP	HL
	CALL	_file_loadrec	; keep the bytes that the record has
	JR	_ftw_done
_ftw_end:
	CALL	_file_toend
_ftw_done:
	SET	3,(IX+F_FLAGS)
	XOR	A
	POP	IX
	RET
_ftw_err:
	SET	2,(IX+F_FLAGS)
	OR	1		; NZ
	POP	IX
	RET

; ============================================================
; Internal: _file_toend.  IX = FILE*.  Put the stream at the end of the
; data of the file, in the writing state: the last record is in the buffer
; and bufpos is the place of its first Ctrl-Z.
; ============================================================
_file_toend:
	PUSH	IX
	POP	HL
	LD	DE,F_FCB
	ADD	HL,DE
	EX	DE,HL
	LD	C,BDOS_SIZE
	CALL	BDOS		; r0 r1 = the number of records
	LD	(IX+F_R2),0
	LD	L,(IX+F_R0)
	LD	H,(IX+F_R1)
	LD	A,H
	OR	L
	JR	Z,_fte_empty
	DEC	HL		; the last record
	LD	(IX+F_R0),L
	LD	(IX+F_R1),H
	PUSH	IX
	POP	HL
	CALL	_file_loadrec
	JR	NZ,_fte_empty2
	PUSH	IX
	POP	HL
	LD	DE,F_BUFFER
	ADD	HL,DE
	LD	B,0
_fte_scan:
	LD	A,B
	CP	128
	JR	NC,_fte_set
	LD	A,(HL)
	CP	1AH
	JR	Z,_fte_set
	INC	HL
	INC	B
	JR	_fte_scan
_fte_set:
	LD	(IX+F_BUFPOS),B
	RET
_fte_empty:
	LD	(IX+F_R0),0
	LD	(IX+F_R1),0
_fte_empty2:
	LD	(IX+F_BUFPOS),0
	LD	(IX+F_BUFCNT),0
	RET


	CSEG
; ============================================================
; lc_fwrite.mac
; ============================================================
; lc_fwrite.mac - split from lc_file.mac


	EXTRN	__div16
	EXTRN	__mul16

	CSEG

; ============================================================
; size_t fwrite(const void *ptr, size_t size, size_t nmemb, FILE *stream)
; Write data to stream
; ============================================================
	PUBLIC	_fwrite
_fwrite:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; Simple implementation - write byte by byte
	LD	L,(IX+6)
	LD	H,(IX+7)	; size
	LD	E,(IX+8)
	LD	D,(IX+9)	; nmemb
	CALL	__mul16		; HL = total bytes
	LD	B,H
	LD	C,L		; BC = bytes to write

	LD	A,B
	OR	C
	JR	Z,_fwrite_done

	LD	L,(IX+4)
	LD	H,(IX+5)	; HL = ptr (source)
	LD	(_fwrite_ptr),HL
	LD	HL,0
	LD	(_fwrite_cnt),HL

_fwrite_loop:
	LD	A,B
	OR	C
	JR	Z,_fwrite_done

	; Get byte from source
	LD	HL,(_fwrite_ptr)
	LD	A,(HL)
	INC	HL
	LD	(_fwrite_ptr),HL

	; Write to stream
	PUSH	BC
	LD	L,(IX+10)
	LD	H,(IX+11)	; stream
	PUSH	HL
	LD	L,A
	LD	H,0
	PUSH	HL
	CALL	_fputc
	POP	HL
	POP	HL
	POP	BC

	; Check error
	LD	A,H
	INC	A
	JR	Z,_fwrite_done	; Error

	LD	HL,(_fwrite_cnt)
	INC	HL
	LD	(_fwrite_cnt),HL
	DEC	BC
	JR	_fwrite_loop

_fwrite_done:
	; Return items written (cnt / size)
	; __div16 does HL = DE / HL, so DE = cnt, HL = size
	LD	E,(IX+6)
	LD	D,(IX+7)	; DE = size (temporarily)
	LD	A,D
	OR	E
	JR	Z,_fwrite_ret
	LD	HL,(_fwrite_cnt)	; HL = cnt
	EX	DE,HL		; Now DE = cnt, HL = size
	CALL	__div16		; HL = cnt / size
_fwrite_ret:
	POP	DE
	POP	BC
	POP	IX
	RET


	COMMON	/lc_fwrite/

_fwrite_ptr:	DS	2	; fwrite source pointer temp
_fwrite_cnt:	DS	2	; fwrite byte counter temp


	CSEG
; ============================================================
; lc_getc.mac
; ============================================================
; lc_getc.mac - split from lc_file.mac



	CSEG

; ============================================================
; int getc(FILE *stream)
; Get character from stream (equivalent to fgetc)
; ============================================================
	PUBLIC	_getc
_getc:
	JP	_fgetc		; Just tail-call fgetc


	CSEG
; ============================================================
; lc_getchar.mac
; ============================================================
; lc_getchar.mac - getchar


	CSEG

; ============================================================
; int getchar(void)
; Read a character from console
; Returns: character read, or EOF (-1) on error
; ============================================================
	PUBLIC	_getchar
_getchar:
	LD	C,CONIN
	CALL	BDOS
	LD	L,A
	LD	H,0
	RET



	CSEG
; ============================================================
; lc_getenv.mac
; ============================================================
; lc_getenv.mac - split from lc_misc.mac


	CSEG

; ============================================================
; char *getenv(const char *name)
; Get environment variable (stub - returns NULL on CP/M)
; ============================================================
	PUBLIC	_getenv
_getenv:
	LD	HL,0		; Always return NULL
	RET


	CSEG
; ============================================================
; lc_gets.mac
; ============================================================
; lc_gets.mac - gets


	CSEG

; ============================================================
; char *gets(char *s)
; Read line from stdin into buffer (DANGEROUS - no size limit)
; Returns s, or NULL on EOF/error
; ============================================================
	PUBLIC	_gets
_gets:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	LD	E,(IX+4)	; DE = buffer pointer
	LD	D,(IX+5)
	PUSH	DE		; Save for return

_gets_loop:
	LD	C,CONIN
	CALL	BDOS		; A = char
	CP	0DH		; CR?
	JR	Z,_gets_done
	CP	0AH		; LF?
	JR	Z,_gets_done
	LD	(DE),A
	INC	DE
	JR	_gets_loop

_gets_done:
	XOR	A
	LD	(DE),A		; Null terminate
	POP	HL		; Return original pointer
	POP	DE
	POP	BC
	POP	IX
	RET


	CSEG
; ============================================================
; lc_hypot.mac
; ============================================================
; lc_hypot.mac - GENERATED from vmsrc/lc_hypot.vc by gen_vm_modules.py
; Do not edit this file: edit the .vc file and run the script.

	CSEG
	EXTRN	__fdiv
	PUBLIC	__v_hypot
	PUBLIC	_hypot
	PUBLIC	_hypotf
	PUBLIC	_hypotl

; hypot (1 constants, 172 bytes of program)
;STACK __v_hypot 23 __v_m_2prod __v_m_2sum
_hypot:
_hypotf:
_hypotl:
	LD	HL,__v_hypot
	JP	__vm_run
__v_hypot:
	DB	2,1
	DW	00000H,041F0H	; 0: 30.0
	DB	078H,078H,078H,078H,078H,078H,078H,078H,078H,078H,078H,078H
