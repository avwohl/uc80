	CALL	_scn_nx
	BIT	7,H
	JR	NZ,_scn_ieof
	LD	A,L
	CP	'-'
	JR	Z,_scn_sm
	CP	'+'
	JR	NZ,_scn_nsg
	JR	_scn_sg
_scn_sm:
	LD	A,1
	LD	(_scn_neg),A
_scn_sg:
	CALL	_scn_nx
_scn_nsg:
	; HL = the first character after the sign
	LD	A,H
	OR	A
	JR	NZ,_scn_nz
	LD	A,L
	CP	'0'
	JR	NZ,_scn_nz
	LD	A,(_scn_base)
	OR	A
	JR	Z,_scn_z
	CP	16
	JR	Z,_scn_z
	CP	2
	JR	NZ,_scn_nz
_scn_z:
	; a zero: a number already, and maybe a prefix 0x or 0b
	LD	A,1
	LD	(_scn_any),A
	CALL	_scn_nx
	BIT	7,H
	JR	NZ,_scn_oct
	LD	A,L
	OR	20H
	CP	'x'
	JR	NZ,_scn_tb
	LD	A,(_scn_base)
	CP	2
	JR	Z,_scn_oct
	LD	E,16
	JR	_scn_pre
_scn_tb:
	CP	'b'
	JR	NZ,_scn_oct
	LD	A,(_scn_base)
	CP	16
	JR	Z,_scn_oct
	LD	E,2
_scn_pre:
	LD	A,E
	LD	(_scn_nb2),A
	LD	(_scn_xc),HL
	CALL	_scn_nx
	BIT	7,H
	JR	NZ,_scn_pf
	LD	A,L
	PUSH	HL
	CALL	__sc_dv
	LD	HL,_scn_nb2
	CP	(HL)
	POP	HL
	JR	NC,_scn_pf
	LD	A,(_scn_nb2)
	LD	(_scn_base),A
	XOR	A
	LD	(_scn_any),A
	JR	_scn_digits
_scn_pf:
