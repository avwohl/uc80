; ============================================================
; lc_snprintf.mac
; ============================================================
; lc_snprintf.mac - snprintf(): the shared printf engine, bounded buffer.
;
; Was a third copy of the formatter, and the most threadbare of them: it
; knew no float conversion at all, so %f, %e, %g and %F each emitted an
; empty field and left the vararg offset alone, which desynced every
; later conversion in the same call.  See lc_sprintf.mac for why there is
; only one formatter now.


	CSEG

	PUBLIC	_snprintf

; int snprintf(char *str, size_t size, const char *fmt, ...)
;
; C 7.21.6.5: write at most size-1 characters plus a terminating NUL, and
; return the number that WOULD have been written had size been big
; enough.  _printf_count counts everything the engine produced, whether
; the sink stored it or dropped it, so it is that return value already.
_snprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; str at IX+4, size at IX+6, fmt at IX+8, first vararg at IX+10
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(_snprintf_out),DE
	LD	E,(IX+6)
	LD	D,(IX+7)
	LD	(_snprintf_max),DE

	LD	HL,(_printf_sink)
	PUSH	HL
	LD	HL,_snprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+8)
	LD	H,(IX+9)		; HL = format string
	LD	C,10			; first vararg at IX+10
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL

	; Terminate, unless the caller left no room at all.
	LD	HL,(_snprintf_max)
	LD	A,H
	OR	L
	JR	Z,_snp_noterm
	LD	HL,(_snprintf_out)
	LD	(HL),0
_snp_noterm:

	LD	HL,(_printf_count)
	POP	DE
	POP	BC
	POP	IX
	RET

; Sink: character in E, dropped once the buffer is full.  _printf_putc
; counts it either way, which is what makes the return value right.
_snprintf_sink:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,(_snprintf_max)
	LD	A,H
	OR	L
	JR	Z,_snp_drop		; size 0: not even the NUL fits
	LD	B,H
	LD	C,L
	DEC	BC			; keep one byte back for the NUL
	LD	HL,(_printf_count)	; bytes produced so far
	OR	A
	SBC	HL,BC
	JR	NC,_snp_drop		; already at the limit
	LD	HL,(_snprintf_out)
	LD	(HL),E
	INC	HL
	LD	(_snprintf_out),HL
_snp_drop:
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

	COMMON	/lc_snprintf/

_snprintf_out:	DS	2
_snprintf_max:	DS	2


	CSEG
; ============================================================
; lc_sprintf.mac
; ============================================================
; lc_sprintf.mac - sprintf(): the shared printf engine, writing to a buffer.
;
; This file used to carry a second, independent formatter: its own
; CP/JR-Z chain over the conversion characters, its own width and
; precision handling, its own integer and float printers.  It knew %d %u
; %x %s %c %f and little else, so %e, %g and %F reached printf and no
; other member of the family -- they emitted an empty field and, because
; the miss path was `INC HL / JP _sprintf_loop`, did not advance the
; vararg offset either, so every later conversion in the same call read
; the wrong argument.  That is the bug uc80 set out to fix in printf, and
; four of the five entry points still had it.
;
; There is one formatter now.  lc_printf_core's _printf_engine takes the
; frame, the format string, the offset of the first vararg and a sink
; routine; the entry points below are those four things and nothing else,
; so a conversion added to the table is available to all of them at once.


	CSEG

	PUBLIC	_sprintf
	PUBLIC	_sprintf_sink
	PUBLIC	_sprintf_out

; int sprintf(char *str, const char *fmt, ...)
_sprintf:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE

	; str at IX+4, fmt at IX+6, first vararg at IX+8
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(_sprintf_out),DE

	LD	HL,(_printf_sink)
	PUSH	HL			; the caller's sink, restored below
	LD	HL,_sprintf_sink
	LD	(_printf_sink),HL

	LD	L,(IX+6)
	LD	H,(IX+7)		; HL = format string
	LD	C,8			; first vararg at IX+8
	CALL	_printf_engine

	POP	HL
	LD	(_printf_sink),HL	; restore before anything can print

	LD	HL,(_sprintf_out)
	LD	(HL),0			; NUL terminate

	LD	HL,(_printf_count)	; C 7.21.6.6: bytes written, sans NUL
	POP	DE
	POP	BC
	POP	IX
	RET

; Sink: the character is in E.  _printf_putc has already saved every
; register and counts the byte itself once we return.
_sprintf_sink:
	PUSH	HL
	LD	HL,(_sprintf_out)
	LD	(HL),E
	INC	HL
	LD	(_sprintf_out),HL
	POP	HL
	RET

	COMMON	/lc_sprintf/

_sprintf_out:	DS	2	; next byte of the caller's buffer


	CSEG
; ============================================================
; lc_sqrt.mac
; ============================================================
; lc_sqrt.mac - sqrt, sqrtf, sqrtl
;
; Correctly rounded square root with integer arithmetic.  The mantissa is
; shifted so that the exponent is even, the digit-by-digit method gives a
; 26-bit root, and the last bits and the remainder round to nearest even.

	CSEG

; ============================================================
; double sqrt(double x)
; ============================================================
	PUBLIC	_sqrt
	PUBLIC	_sqrtf
	PUBLIC	_sqrtl
_sqrt:
_sqrtf:
_sqrtl:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+4)
	LD	H,(IX+5)
	LD	E,(IX+6)
	LD	D,(IX+7)

	; B = the biased exponent
	LD	A,D
	AND	7FH
	ADD	A,A
	LD	B,A
	LD	A,E
	RLCA
	LD	A,B
	ADC	A,0
	LD	B,A
	JR	Z,_sqrt_z	; zero or subnormal
	CP	255
	JR	Z,_sqrt_sp	; inf or NaN
	BIT	7,D
	JR	NZ,_sqrt_nan	; negative
	LD	A,E
	OR	80H		; the implied bit
	LD	E,A
	LD	D,0		; DEHL = the mantissa, 24 bits
	LD	C,0		; C = 0: normal number
_sqrt_go:
	; B = exponent, C = 64 for a subnormal number
	LD	A,B
	SRL	A
	ADD	A,63
	SUB	C
	LD	(_sqrt_e),A	; the exponent of a root with 25 bits
	BIT	0,B
	JR	Z,_sqrt_ev
	ADD	HL,HL		; the unbiased exponent is even: mantissa * 2
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
_sqrt_ev:
	LD	B,6
_sqrt_sh6:
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	DJNZ	_sqrt_sh6
	LD	(_sqrt_s),HL
	LD	(_sqrt_s+2),DE
	LD	HL,0
	LD	(_sqrt_r),HL
	LD	(_sqrt_r+2),HL
	LD	(_sqrt_q),HL
	LD	(_sqrt_q+2),HL
	EXX
	LD	B,26		; B' = loop counter
	EXX
_sqrt_lp:
	; C = the next two bits of S, S = S << 2
	LD	A,(_sqrt_s+3)
	RLCA
	RLCA
	AND	3
	LD	C,A
	LD	HL,(_sqrt_s)
	LD	DE,(_sqrt_s+2)
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	LD	(_sqrt_s),HL
	LD	(_sqrt_s+2),DE
	; R = R << 2 | C
	LD	HL,(_sqrt_r)
	LD	DE,(_sqrt_r+2)
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	LD	A,L
	OR	C
	LD	L,A
	LD	(_sqrt_r),HL
	LD	(_sqrt_r+2),DE
	; DE:HL = T = Q << 2 | 1
	LD	HL,(_sqrt_q)
	LD	DE,(_sqrt_q+2)
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	INC	HL
	; R - T
	LD	BC,(_sqrt_r)
	LD	A,C
	SUB	L
	LD	C,A
	LD	A,B
	SBC	A,H
	LD	B,A
	PUSH	BC
	LD	HL,(_sqrt_r+2)
	SBC	HL,DE		; carry if R < T
	POP	BC
	JR	C,_sqrt_no
	LD	(_sqrt_r),BC
	LD	(_sqrt_r+2),HL
	SCF
	JR	_sqrt_q2
_sqrt_no:
	OR	A
_sqrt_q2:
	; Q = Q * 2 + carry
	LD	HL,(_sqrt_q)
	LD	DE,(_sqrt_q+2)
	ADC	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	LD	(_sqrt_q),HL
	LD	(_sqrt_q+2),DE
	EXX
	DEC	B
	EXX
	JP	NZ,_sqrt_lp

	; C = 1 when the remainder is not zero
	LD	BC,(_sqrt_r)
	LD	A,B
	OR	C
	LD	BC,(_sqrt_r+2)
	OR	B
	OR	C
	ADD	A,255
	SBC	A,A
	AND	1
	LD	C,A
	LD	HL,(_sqrt_q)
	LD	DE,(_sqrt_q+2)
	; Q has 25 or 26 bits
	BIT	1,D
	JR	NZ,_sqrt_26
	LD	A,L
	AND	1
	ADD	A,A
	LD	B,A		; bit 1 of B = the round bit
	SRL	D
	RR	E
	RR	H
	RR	L
	LD	D,0		; exponent increment
	JR	_sqrt_rnd
_sqrt_26:
	LD	A,L
	AND	3
	LD	B,A		; bit 1 = the round bit, bit 0 = sticky
	SRL	D
	RR	E
	RR	H
	RR	L
	SRL	D
	RR	E
	RR	H
	RR	L
	LD	D,1
_sqrt_rnd:
	BIT	1,B
	JR	Z,_sqrt_pack
	LD	A,B
	AND	1
	OR	C
	LD	B,A
	LD	A,L
	AND	1
	OR	B
	JR	Z,_sqrt_pack	; a tie goes to the even mantissa
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,_sqrt_pack
	INC	E
	JR	NZ,_sqrt_pack
	LD	E,80H		; the mantissa carried to 2^24
	INC	D
_sqrt_pack:
	LD	A,(_sqrt_e)
	ADD	A,D
	SRL	A
	LD	D,A
	JR	C,_sqrt_ret
	RES	7,E
_sqrt_ret:
	POP	IX
	RET

_sqrt_nan:
	LD	DE,7FC0H
	LD	HL,0
	JR	_sqrt_ret

_sqrt_sp:
	; exponent 255: inf or NaN.  A NaN and +inf are the result, -inf is NaN.
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	JR	NZ,_sqrt_ret	; a NaN
	BIT	7,D
	JR	NZ,_sqrt_nan
	JR	_sqrt_ret

_sqrt_z:
	; exponent 0: zero, or a subnormal number
	LD	A,E
	AND	7FH
	OR	H
	OR	L
	JR	Z,_sqrt_ret	; +-0
	BIT	7,D
	JR	NZ,_sqrt_nan
	LD	A,E
	AND	7FH
	LD	E,A
	LD	D,0
	LD	B,129
_sqrt_nl:
	ADD	HL,HL
	RL	E
	DEC	B
	BIT	7,E
	JR	Z,_sqrt_nl
	LD	C,64
	JP	_sqrt_go

	COMMON	/lc_sqrt/
_sqrt_s:
	DS	4
_sqrt_r:
	DS	4
_sqrt_q:
	DS	4
_sqrt_e:
	DS	1


	CSEG
