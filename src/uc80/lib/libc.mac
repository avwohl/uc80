; ============================================================
; lc_m_pack.mac
; ============================================================
; lc_m_pack.mac - _m_pack (see csrc/m.h)
;
; float _m_pack(int neg, unsigned long mant, int e)
; The value (-1)^neg * mant * 2^(e-150) for a normalized mant (2^23 to
; 2^24-1).  For e from 1 to 254 the result is (e << 23) + mant - 2^23, so a
; mant of 2^24 (a carry of the caller) raises the exponent.  A larger e
; gives infinity.  For e of 0 or less the mantissa is shifted right by
; 1 - e places and rounded to nearest even, which gives a subnormal number
; or zero.  A zero mant gives a zero.

	CSEG

	PUBLIC	__m_pack
__m_pack:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	L,(IX+6)
	LD	H,(IX+7)
	LD	E,(IX+8)
	LD	D,(IX+9)	; DEHL = mant
	LD	C,(IX+10)
	LD	B,(IX+11)	; BC = e
	LD	A,D
	OR	E
	OR	H
	OR	L
	JR	Z,_mpk_sign	; mant = 0
	LD	A,B
	OR	A
	JP	M,_mpk_sub	; e < 0
	JR	NZ,_mpk_inf	; e >= 256
	LD	A,C
	CP	255
	JR	NC,_mpk_inf
	OR	A
	JR	Z,_mpk_sub	; e = 0
	; 1 <= e <= 254: add (e - 1) << 7 to the high half of mant, the
	; exponent field is then e - 1 + the exponent bits of mant (1)
	PUSH	HL
	DEC	A
	SRL	A
	LD	H,A
	LD	A,0
	RRA
	LD	L,A		; HL = (e - 1) << 7
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	JR	_mpk_sign
_mpk_inf:
	LD	DE,7F80H
	LD	HL,0
	JR	_mpk_sign

_mpk_sub:
	; e <= 0.  The shift count is 1 - e, and a count above 24 gives 0.
	LD	A,B
	OR	C
	LD	A,1
	JR	Z,_mpk_cnt	; e = 0: the count is 1
	LD	A,B
	INC	A
	JR	NZ,_mpk_zero	; e <= -256
	LD	A,C
	CP	0E9H
	JR	C,_mpk_zero	; e < -23
	NEG
	INC	A
_mpk_cnt:
	LD	B,A
	LD	C,0		; C is not zero when a lost bit was set
_mpk_shr:
	SRL	D
	RR	E
	RR	H
	RR	L
	DEC	B
	JR	Z,_mpk_rnd	; the carry is the round bit
	JR	NC,_mpk_shr
	INC	C
	JR	_mpk_shr
_mpk_rnd:
	JR	NC,_mpk_sign
	LD	A,C
	OR	A
	JR	NZ,_mpk_up
	BIT	0,L
	JR	Z,_mpk_sign	; a tie goes to the even mantissa
_mpk_up:
	INC	HL
	LD	A,H
	OR	L
	JR	NZ,_mpk_sign
	INC	DE
	JR	_mpk_sign
_mpk_zero:
	LD	DE,0
	LD	HL,0
_mpk_sign:
	LD	A,(IX+4)
	OR	(IX+5)
	JR	Z,_mpk_ret
	SET	7,D
_mpk_ret:
	POP	IX
	RET


