; ============================================================
; lc_m_phred.mac
; ============================================================
; lc_m_phred.mac - __vm_phred, the Payne-Hanek argument reduction for
; sin, cos and tan (see lc_m_reduce.vc)
;
; A routine of the float interpreter (see lc_vm.mac): DEHL = ax, a finite
; number of 6000 or more.  ax = n * pi/2 + r with |r| <= pi/4.  The routine
; returns DEHL = r and (__tmp32) = n modulo 4, as a float.  It keeps BC and
; IX.
;
; ax = M * 2^(e-150) with a 24-bit M.  A window of 104 bits of 2/pi,
; which starts at the place of the exponent, is multiplied by M modulo
; 2^104.  The top two bits of the product are the quadrant, the other 102
; bits are the fraction of ax * 2/pi.  The method adds 1/2 to get the
; nearest integer and takes the absolute value of the rest.  The top 32 bits
; of the rest, from its leading one, become a float that is multiplied by
; pi/2 (in two parts).

	CSEG

	EXTRN	__uitof
	EXTRN	__itof
	EXTRN	__fmul
	EXTRN	__fadd
	EXTRN	__tmp32

	PUBLIC	__vm_phred
__vm_phred:
	PUSH	BC
	; the mantissa with the implied bit
	LD	A,L
	LD	(_mph_m),A
	LD	A,H
	LD	(_mph_m+1),A
	LD	A,E
	OR	80H
	LD	(_mph_m+2),A
	; e = the biased exponent; s = e - 152 is the number of the first bit
	LD	A,E
	RLA
	LD	A,D
	RLA
	LD	L,A
	LD	H,0
	LD	DE,-152
	ADD	HL,DE		; HL = s
	LD	A,L
	AND	7
	LD	C,A		; C = s mod 8, the shift count
	SRA	H
	RR	L
	SRA	H
	RR	L
	SRA	H
	RR	L		; HL = s div 8, from -2 to 12
	LD	DE,_mph_tp+2
	ADD	HL,DE
	; copy 14 bytes of 2/pi and shift them left by C bits
	LD	DE,_mph_w
	PUSH	BC
	LD	BC,14
	LDIR
	POP	BC
	INC	C
	JR	_mph_sh1
_mph_shl:
	LD	HL,_mph_w+13
	LD	B,14
	OR	A
_mph_shb:
	RL	(HL)
	DEC	HL
	DJNZ	_mph_shb
_mph_sh1:
	DEC	C
	JR	NZ,_mph_shl
	; acc = 0
	LD	HL,_mph_a
	LD	DE,_mph_a+1
	LD	BC,12
	LD	(HL),0
	LDIR
	; acc = M * window mod 2^104, from the top bit of M
	LD	C,24
_mph_mul:
	LD	HL,_mph_m
	SLA	(HL)
	INC	HL
	RL	(HL)
	INC	HL
	RL	(HL)
	PUSH	AF
	LD	HL,_mph_a+12
	LD	B,13
	OR	A
_mph_dbl:
	RL	(HL)
	DEC	HL
	DJNZ	_mph_dbl
	POP	AF
	JR	NC,_mph_nob
	LD	HL,_mph_a+12
	LD	DE,_mph_w+12
	LD	B,13
	OR	A
_mph_add:
	LD	A,(DE)
	ADC	A,(HL)
	LD	(HL),A
	DEC	DE
	DEC	HL
	DJNZ	_mph_add
_mph_nob:
	DEC	C
	JR	NZ,_mph_mul
	; add 1/2: the nearest integer is the quadrant
	LD	A,(_mph_a)
	ADD	A,20H
	LD	B,A
	RLCA
	RLCA
	AND	3
	LD	C,A		; C = n
	LD	A,B
	AND	3FH
	LD	(_mph_a),A	; the fraction plus 1/2
	LD	B,0		; B = 0: the rest is positive
	BIT	5,A
	JR	NZ,_mph_pos
	; the rest is negative: take 2^104 - the fraction
	INC	B
	LD	HL,_mph_a+12
	LD	E,13
	OR	A
_mph_neg:
	LD	A,0
	SBC	A,(HL)
	LD	(HL),A
	DEC	HL
	DEC	E
	JR	NZ,_mph_neg
_mph_pos:
	LD	A,(_mph_a)
	AND	1FH
	LD	(_mph_a),A
	LD	A,B
	LD	(_mph_neg_flag),A
	LD	A,C
	LD	(_mph_n),A
	; find the leading one: shift left until bit 7 of the top byte is set
	LD	C,0		; C = the number of shifts
_mph_lead:
	LD	A,(_mph_a)
	BIT	7,A
	JR	NZ,_mph_found
	LD	HL,_mph_a+12
	LD	B,13
	OR	A
_mph_nrm:
	RL	(HL)
	DEC	HL
	DJNZ	_mph_nrm
	INC	C
	LD	A,C
	CP	104
	JR	C,_mph_lead
	; the rest is zero
	LD	HL,0
	LD	D,H
	LD	E,L
	JR	_mph_out
_mph_found:
	LD	A,C
	LD	(_mph_c),A
	LD	A,(_mph_a)
	LD	D,A
	LD	A,(_mph_a+1)
	LD	E,A
	LD	A,(_mph_a+2)
	LD	H,A
	LD	A,(_mph_a+3)
	LD	L,A
	CALL	__uitof		; the top 32 bits as a float
	; multiply by 2^(-30-c): add (-30-c) << 7 to the high half
	LD	A,(_mph_c)
	ADD	A,30
	LD	C,A
	LD	B,0
	PUSH	HL
	LD	HL,0
	OR	A
	SBC	HL,BC		; HL = -30 - c
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	LD	(_mph_df),HL
	LD	(_mph_df+2),DE
	; r = df * 1.57079637 + df * -4.37113883e-08
	LD	HL,0FDBH
	LD	(__tmp32),HL
	LD	HL,3FC9H
	LD	(__tmp32+2),HL
	LD	HL,(_mph_df)
	LD	DE,(_mph_df+2)
	CALL	__fmul
	PUSH	DE
	PUSH	HL
	LD	HL,0BD2EH
	LD	(__tmp32),HL
	LD	HL,0B33BH
	LD	(__tmp32+2),HL
	LD	HL,(_mph_df)
	LD	DE,(_mph_df+2)
	CALL	__fmul
	POP	BC
	LD	(__tmp32),BC
	POP	BC
	LD	(__tmp32+2),BC
	CALL	__fadd
	LD	A,(_mph_neg_flag)
	OR	A
	JR	Z,_mph_out
	SET	7,D
_mph_out:
	PUSH	DE
	PUSH	HL
	LD	A,(_mph_n)
	LD	L,A
	LD	H,0
	LD	D,H
	LD	E,H
	CALL	__itof
	LD	(__tmp32),HL
	LD	(__tmp32+2),DE
	POP	HL
	POP	DE
	POP	BC
	RET

