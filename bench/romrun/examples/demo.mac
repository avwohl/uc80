; A small Neo Geo style sound ROM: vectors, an NMI command reader, a YM timer.
	.Z80
	PUBLIC	START,ISR,NMI
	ASEG
	ORG	0000H
	DI
	IM	1
	JP	START
	ORG	0038H
	JP	ISR
	ORG	0066H
	JP	NMI
	ORG	0100H
START:	LD	SP,0FFFFH
	XOR	A
	LD	(TICKS),A
	LD	A,24H
	OUT	(04H),A
	LD	A,0FCH
	OUT	(05H),A
	LD	A,27H
	OUT	(04H),A
	LD	A,15H
	OUT	(05H),A
	EI
MAIN:	HALT
	JR	MAIN
ISR:	PUSH	AF
	LD	A,27H
	OUT	(04H),A
	LD	A,15H
	OUT	(05H),A
	LD	A,(TICKS)
	INC	A
	LD	(TICKS),A
	POP	AF
	EI
	RETI
NMI:	PUSH	AF
	IN	A,(00H)
	LD	(CMD),A
	OUT	(0CH),A
	POP	AF
	RETN
TICKS	EQU	0F800H
CMD	EQU	0F801H
	END
