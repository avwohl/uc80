; qw2.mac - candidate __qsort_w: Wirth quicksort with pivot value, 2-byte elements
; stack ABI by default; -DQW_REG: comparator gets HL=a, DE=b
	.Z80
	CSEG

	PUBLIC	__qsort_w
; stack: base(IX+4) nmemb(IX+6) size(IX+8, ignored) compar(IX+10)
__qsort_w:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	LD	HL,-QW_NV		; save static area
	ADD	HL,SP
	LD	SP,HL
	EX	DE,HL
	LD	HL,QW_VARS
	LD	BC,QW_NV
	LDIR
	LD	L,(IX+6)		; nmemb
	LD	H,(IX+7)
	LD	DE,2
	OR	A
	SBC	HL,DE			; nmemb-2
	JP	C,qw_exit
	INC	HL
	ADD	HL,HL			; 2*(nmemb-1)
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(QW_LO),DE
	ADD	HL,DE
	LD	(QW_HI),HL
	LD	A,0C3H
	LD	(QW_TR),A
	LD	L,(IX+10)
	LD	H,(IX+11)
	LD	(QW_TR+1),HL
	LD	HL,0
	ADD	HL,SP
	LD	(QW_SP0),HL
; ---- run check ----
	LD	HL,(QW_LO)
	CALL	qw_cn			; cmp(lo, lo+2)
	XOR	A
	LD	(QW_M),A
	BIT	7,H
	JR	NZ,qw_rc1		; < 0: ascending
	LD	A,H
	OR	L
	JR	Z,qw_rc1		; == 0: ascending
	LD	A,80H
	LD	(QW_M),A		; > 0: descending
qw_rc1:
	LD	HL,(QW_LO)
qw_rc2:
	INC	HL
	INC	HL			; p += 2
	EX	DE,HL
	LD	HL,(QW_HI)
	OR	A
	SBC	HL,DE
	JR	Z,qw_rc9		; p == hi: whole array is a run
	EX	DE,HL
	PUSH	HL
	CALL	qw_cn
	POP	DE
	LD	A,(QW_M)
	XOR	H
	EX	DE,HL			; HL = p (flags kept)
	JP	M,qw_rc2		; ok: sign set after xor
	LD	A,D
	OR	E
	JR	Z,qw_rc2		; == 0
	JR	qw_top			; not a run: sort
qw_rc9:
	LD	A,(QW_M)
	OR	A
	JR	Z,qw_exit
	LD	HL,(QW_LO)		; reverse
	LD	DE,(QW_HI)
qw_rv:
	PUSH	HL
	PUSH	DE
	CALL	qw_swp
	POP	DE
	POP	HL
	INC	HL
	INC	HL
	DEC	DE
	DEC	DE
	OR	A
	SBC	HL,DE
	JR	NC,qw_exit
	ADD	HL,DE
	JR	qw_rv

; ---- sort [LO..HI] ----
qw_top:
	LD	HL,(QW_HI)
	LD	DE,(QW_LO)
	OR	A
	SBC	HL,DE
	JR	C,qw_pop
	JR	Z,qw_pop
	SRL	H
	RR	L
	RES	0,L
	ADD	HL,DE			; HL = mid
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(QW_PV),DE		; pivot value
	LD	HL,(QW_LO)
	LD	(QW_I),HL
	LD	HL,(QW_HI)
	LD	(QW_J),HL
qw_si:
	LD	HL,(QW_I)		; while (cmp(i,pv) < 0) i += 2
	LD	DE,QW_PV
	CALL	qw_cmp
	BIT	7,H
	JR	Z,qw_sj
	LD	HL,(QW_I)
	INC	HL
	INC	HL
	LD	(QW_I),HL
	JR	qw_si
qw_sj:
	LD	HL,QW_PV		; while (cmp(pv,j) < 0) j -= 2
	LD	DE,(QW_J)
	CALL	qw_cmp
	BIT	7,H
	JR	Z,qw_sx
	LD	HL,(QW_J)
	DEC	HL
	DEC	HL
	LD	(QW_J),HL
	JR	qw_sj
qw_sx:
	LD	HL,(QW_J)		; if (i <= j) { swap; i += 2; j -= 2 }
	LD	DE,(QW_I)
	OR	A
	SBC	HL,DE			; j - i
	JR	C,qw_done
	ADD	HL,DE
	CALL	qw_swp			; HL = j, DE = i
	LD	HL,(QW_I)
	INC	HL
	INC	HL
	LD	(QW_I),HL
	LD	HL,(QW_J)
	DEC	HL
	DEC	HL
	LD	(QW_J),HL
	JR	qw_si
qw_done:
	; ranges [lo, j] and [i, hi]; push the larger, loop on the smaller
	LD	HL,(QW_J)
	LD	DE,(QW_LO)
	OR	A
	SBC	HL,DE			; HL = j - lo
	EX	DE,HL
	LD	HL,(QW_HI)
	LD	BC,(QW_I)
	OR	A
	SBC	HL,BC			; HL = hi - i
	OR	A
	SBC	HL,DE			; carry: right smaller
	JR	C,qw_gr
	LD	HL,(QW_HI)		; push right (i, hi), go left
	PUSH	HL
	LD	HL,(QW_I)
	PUSH	HL
	LD	HL,(QW_J)
	LD	(QW_HI),HL
	JR	qw_top
qw_gr:
	LD	HL,(QW_J)		; push left (lo, j), go right
	PUSH	HL
	LD	HL,(QW_LO)
	PUSH	HL
	LD	HL,(QW_I)
	LD	(QW_LO),HL
	JR	qw_top
qw_pop:
	LD	HL,(QW_SP0)
	OR	A
	SBC	HL,SP
	JR	Z,qw_exit
	POP	HL
	LD	(QW_LO),HL
	POP	HL
	LD	(QW_HI),HL
	JR	qw_top

qw_exit:
	PUSH	IX
	POP	HL
	LD	DE,-(QW_NV+2)
	ADD	HL,DE
	LD	SP,HL			; SP = save area
	LD	DE,QW_VARS
	LD	BC,QW_NV
	LDIR
	LD	SP,HL			; HL = end of the save area
	POP	BC
	POP	IX
	RET

qw_cn:	LD	D,H			; HL = cmp(HL, HL+2)
	LD	E,L
	INC	DE
	INC	DE
qw_cmp:
IFNDEF QW_REG
	PUSH	DE			; HL = compar(HL, DE)
	PUSH	HL
	CALL	QW_TR
	POP	DE
	POP	DE
	RET
ELSE
	JP	QW_TR
ENDIF

qw_swp:	LD	A,(DE)			; swap the words at HL and DE
	LDI
	DEC	HL
	LD	(HL),A
	INC	HL
	LD	A,(DE)
	LDI
	DEC	HL
	LD	(HL),A
	RET

	COMMON	/lc_qsortw/
QW_VARS:
QW_TR:	DS	3
QW_LO:	DS	2
QW_HI:	DS	2
QW_I:	DS	2
QW_J:	DS	2
QW_SP0:	DS	2
QW_PV:	DS	2
QW_M:	DS	1
QW_END:
QW_NV	EQU	QW_END-QW_VARS
	END
