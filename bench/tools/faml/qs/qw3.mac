; qw3.mac - __qsort_wr: register ABI. HL=base DE=nmemb BC=compar; compar(HL=a, DE=b)
; flags (-D): QW_DESC keep the descending-run test and the reverse
;             QW_SMALL recurse on the smaller part (else always on the left part)
	.Z80
	CSEG

	PUBLIC	__qsort_wr
__qsort_wr:
	LD	(QW_TR+1),BC
	LD	A,0C3H
	LD	(QW_TR),A
	LD	(QW_LO),HL
	EX	DE,HL
	DEC	HL			; nmemb-1
	BIT	7,H
	RET	NZ
	LD	A,H
	OR	L
	RET	Z
	ADD	HL,HL
	ADD	HL,DE			; hi = base + 2*(nmemb-1)
	LD	(QW_HI),HL
; ---- run check ----
IFDEF QW_DESC
	LD	HL,(QW_LO)
	CALL	qw_cn			; cmp(lo, lo+2)
	XOR	A
	LD	(QW_M),A
	BIT	7,H
	JR	NZ,qw_rc1		; < 0: ascending
	LD	A,H
	OR	L
	JR	Z,qw_rc1		; == 0: ascending
	LD	A,80H
	LD	(QW_M),A		; > 0: descending
qw_rc1:
	LD	HL,(QW_LO)
qw_rc2:
	INC	HL
	INC	HL			; p += 2
	EX	DE,HL
	LD	HL,(QW_HI)
	OR	A
	SBC	HL,DE
	JR	Z,qw_rc9		; p == hi: whole array is a run
	EX	DE,HL
	PUSH	HL
	CALL	qw_cn
	POP	DE
	LD	A,(QW_M)
	XOR	H
	EX	DE,HL			; HL = p (flags kept)
	JP	M,qw_rc2		; ok: sign set after xor
	LD	A,D
	OR	E
	JR	Z,qw_rc2		; == 0
	JR	qw_top			; not a run: sort
qw_rc9:
	LD	A,(QW_M)
	OR	A
	RET	Z
	LD	HL,(QW_LO)		; reverse
	LD	DE,(QW_HI)
qw_rv:
	PUSH	HL
	PUSH	DE
	CALL	qw_swp
	POP	DE
	POP	HL
	INC	HL
	INC	HL
	DEC	DE
	DEC	DE
	OR	A
	SBC	HL,DE
	RET	NC
	ADD	HL,DE
	JR	qw_rv
ELSE
	LD	HL,(QW_LO)		; ascending run test only
qw_rc2:
	LD	(QW_I),HL
	INC	HL
	INC	HL
	EX	DE,HL
	LD	HL,(QW_HI)
	OR	A
	SBC	HL,DE
	RET	C
	LD	HL,(QW_I)
	CALL	qw_cmp
	LD	A,H
	OR	L
	JR	Z,qw_rcn
	BIT	7,H
	JR	Z,qw_top
qw_rcn:	LD	HL,(QW_I)
	INC	HL
	INC	HL
	JR	qw_rc2
ENDIF

; ---- sort [LO..HI] (recursive) ----
qw_top:
	LD	HL,(QW_HI)
	LD	DE,(QW_LO)
	OR	A
	SBC	HL,DE
	RET	C
	RET	Z
	SRL	H
	RR	L
	RES	0,L
	ADD	HL,DE			; HL = mid
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	(QW_PV),DE		; pivot value
	LD	HL,(QW_LO)
	LD	(QW_I),HL
	LD	HL,(QW_HI)
	LD	(QW_J),HL
qw_si:
	LD	HL,(QW_I)		; while (cmp(i,pv) < 0) i += 2
	LD	DE,QW_PV
	CALL	qw_cmp
	BIT	7,H
	JR	Z,qw_sj
	LD	HL,(QW_I)
	INC	HL
	INC	HL
	LD	(QW_I),HL
	JR	qw_si
qw_sj:
	LD	HL,QW_PV		; while (cmp(pv,j) < 0) j -= 2
	LD	DE,(QW_J)
	CALL	qw_cmp
	BIT	7,H
	JR	Z,qw_sx
	LD	HL,(QW_J)
	DEC	HL
	DEC	HL
	LD	(QW_J),HL
	JR	qw_sj
qw_sx:
	LD	HL,(QW_J)		; if (i <= j) { swap; i += 2; j -= 2 }
	LD	DE,(QW_I)
	OR	A
	SBC	HL,DE			; j - i
	JR	C,qw_done
	ADD	HL,DE
	CALL	qw_swp			; HL = j, DE = i
	LD	HL,(QW_I)
	INC	HL
	INC	HL
	LD	(QW_I),HL
	LD	HL,(QW_J)
	DEC	HL
	DEC	HL
	LD	(QW_J),HL
	JR	qw_si
qw_done:
IFDEF QW_SMALL
	LD	HL,(QW_J)
	LD	DE,(QW_LO)
	OR	A
	SBC	HL,DE			; HL = j - lo
	EX	DE,HL
	LD	HL,(QW_HI)
	LD	BC,(QW_I)
	OR	A
	SBC	HL,BC			; HL = hi - i
	OR	A
	SBC	HL,DE			; carry: right smaller
	JR	NC,qw_dl
	LD	HL,(QW_LO)		; recurse right [i,hi]; loop on [lo,j]
	PUSH	HL
	LD	HL,(QW_J)
	PUSH	HL
	LD	HL,(QW_I)
	LD	(QW_LO),HL
	CALL	qw_top
	POP	HL
	LD	(QW_HI),HL
	POP	HL
	LD	(QW_LO),HL
	JR	qw_top
qw_dl:
ENDIF
	LD	HL,(QW_I)		; recurse left [lo,j]; loop on [i,hi]
	PUSH	HL
	LD	HL,(QW_HI)
	PUSH	HL
	LD	HL,(QW_J)
	LD	(QW_HI),HL
	CALL	qw_top
	POP	HL
	LD	(QW_HI),HL
	POP	HL
	LD	(QW_LO),HL
	JR	qw_top

qw_cn:	LD	D,H			; HL = cmp(HL, HL+2)
	LD	E,L
	INC	DE
	INC	DE
qw_cmp:	JP	QW_TR

qw_swp:	LD	A,(DE)			; swap the words at HL and DE
	LDI
	DEC	HL
	LD	(HL),A
	INC	HL
	LD	A,(DE)
	LDI
	DEC	HL
	LD	(HL),A
	RET

	COMMON	/lc_qsortw/
QW_VARS:
QW_TR:	DS	3
QW_LO:	DS	2
QW_HI:	DS	2
QW_I:	DS	2
QW_J:	DS	2
QW_PV:	DS	2
QW_M:	DS	1
QW_END:
	END
