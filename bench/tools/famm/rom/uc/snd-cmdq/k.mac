; Implicit external functions

; Global variables

__div16b:
	PUSH	BC
	LD	C,L
	EX	DE,HL		; HL = dividend
	LD	A,H
	CP	C
	JR	NC,__div16b_f	; H >= divisor: 16 steps
	LD	B,8
	or	H
	JR	NZ,__div16b_s	; 0 < H < divisor: 8 steps, remainder H
	LD	A,L
	CP	C
	JR	C,__div16b_q	; dividend < divisor
	xor	L
__div16b_s:
	LD	H,L		; the 8 bits of L are the dividend
	LD	L,0
	JR	__div16b_l
__div16b_q:
	EX	DE,HL		; quotient 0, remainder = dividend
	LD	HL,0
	POP	BC
	RET
__div16b_f:
	XOR	A
	LD	B,16
__div16b_l:
	ADD	HL,HL		; next dividend bit out, quotient bit 0 in
	RLA
	JR	C,__div16b_u	; remainder passed 255: above the divisor
	CP	C
	JR	C,__div16b_n
__div16b_u:
	SUB	C
	INC	L
__div16b_n:
	DJNZ	__div16b_l
	LD	E,A
	LD	D,0
	POP	BC
	RET


; ============================================================
; rt_div32.mac
; ============================================================
; rt_div32.mac - __div32
; Split from rt_arith32.mac



; ============================================================
; 32-bit unsigned division: DEHL = DEHL / (__tmp32)
; Also stores remainder in __rem32.
; Division by zero: quotient 0FFFFFFFFH, remainder = dividend.
; Preserves BC, IX, IY.  __tmp32 is not changed.
;
; A dividend below 65536 with a divisor of 65536 or more returns at once
; (lines tagged rt-shortcut; uc80 --no-rt-shortcuts drops them from the
; embedded copy).
;
; Divisor < 65536: long division one dividend byte at a time
; (__dv8n for an 8-bit divisor, __dv8w for a 16-bit one), with a
; 16-bit running remainder; leading bytes below the divisor cost
; almost nothing.  Divisor >= 65536: the quotient has at most 16
; bits (8 when the divisor is >= 2^24), so only that many steps of
; 32-bit restoring division run.
; ============================================================
__mod16b:
	CALL	__div16b	; remainder in DE
	EX	DE,HL
	RET


; ============================================================
; rt_mod32.mac
; ============================================================
; rt_mod32.mac - __mod32
; Split from rt_arith32.mac



; ============================================================
; 32-bit unsigned modulo: DEHL = DEHL % (__tmp32)
; ============================================================

; Included assembly file
; __UC80_ASM_BEGIN__ FILE-SCOPE
	cseg
; z80io.mac - out (port, value) and in (port) as real Z80 port instructions.
; Part of the uc80 benchmark harness.  SPDX-License-Identifier: GPL-3.0-or-later
;
; The register convention of uc80 (#pragma uc80 regcall out in, in snd.h):
; the first byte argument is in A, the second in E, a char result is
; returned in A.  z80io_stack.mac has the stack-convention version for a
; build with --no-regcall.
;
; void out (uint8_t port, uint8_t value)
; uint8_t in (uint8_t port)
; B is 0, so the 16-bit port address is the port number.

	CSEG

	PUBLIC	_out
_out:	LD	C,A
	LD	A,E
	LD	B,0
	OUT	(C),A
	RET

	PUBLIC	_in
_in:	LD	C,A
	LD	B,0
	IN	A,(C)
	RET

; __UC80_ASM_END__

	CSEG
@STR1:
